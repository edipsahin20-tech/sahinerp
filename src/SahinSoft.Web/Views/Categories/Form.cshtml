@model SahinSoft.Web.Models.CategoryFormViewModel
@using SahinSoft.Domain.Entities
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Kategoriyi Düzenle" : "Yeni Kategori";
    var tree = (List<ProductCategory>)(ViewBag.Tree ?? new List<ProductCategory>());
    var mergeOptions = tree.SelectMany(t => new[] { t }.Concat(t.SubCategories)).Where(c => c.Id != Model.Id).OrderBy(c => c.Name).ToList();
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1><i class="fa-solid fa-tags"></i> Kategori Tanımla</h1>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="category-manager">
    <div class="category-tree-panel">
        <div class="category-tree-header">
            <div class="category-tree-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="categoryTreeSearch" autocomplete="off" placeholder="Kategori kodu veya adı ara..." />
            </div>
            <a asp-action="Create" class="btn-erp-list-new">+ Yeni</a>
        </div>
        <div class="category-tree-list" id="categoryTreeList">
            @foreach (var top in tree)
            {
                <div class="category-tree-group">
                    <a asp-action="Edit" asp-route-id="@top.Id"
                       class="category-tree-item @(top.Id == Model.Id ? "active" : "")"
                       style="--cat-color:@top.Color"
                       data-search="@($"{top.Code} {top.Name}".ToLowerInvariant())">
                        <span class="cat-dot"></span>
                        <span class="cat-name">@top.Name</span>
                        <span class="cat-meta">
                            @if (top.DisplayOrder != 0) { <span class="cat-order">@top.DisplayOrder</span> }
                            @if (top.IsActive) { <i class="fa-solid fa-check cat-active"></i> } else { <i class="fa-solid fa-xmark cat-inactive"></i> }
                        </span>
                    </a>
                    @foreach (var sub in top.SubCategories)
                    {
                        <a asp-action="Edit" asp-route-id="@sub.Id"
                           class="category-tree-item sub @(sub.Id == Model.Id ? "active" : "")"
                           style="--cat-color:@sub.Color"
                           data-search="@($"{sub.Code} {sub.Name}".ToLowerInvariant())">
                            <span class="cat-dot"></span>
                            <span class="cat-name">@sub.Name</span>
                            <span class="cat-meta">
                                @if (sub.DisplayOrder != 0) { <span class="cat-order">@sub.DisplayOrder</span> }
                                @if (sub.IsActive) { <i class="fa-solid fa-check cat-active"></i> } else { <i class="fa-solid fa-xmark cat-inactive"></i> }
                            </span>
                        </a>
                    }
                </div>
            }
            @if (!tree.Any())
            {
                <div class="text-secondary small p-3">Henüz kategori yok.</div>
            }
            <div class="text-secondary small p-3" id="categoryTreeEmpty" style="display:none;">Sonuç bulunamadı.</div>
        </div>
    </div>

    <div class="category-form-panel">
        <form id="evrak-form" method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="erp-panel">
                <div class="erp-panel-header">@(isEdit ? "Kategoriyi Düzenle" : "Yeni Kategori")</div>
                <div class="erp-panel-body">
                    <div class="erp-field-grid">
                        <div class="erp-field">
                            <label asp-for="Code"></label>
                            <input asp-for="Code" class="form-control" autofocus />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>
                        <div class="erp-field" style="grid-column: span 2;">
                            <label asp-for="Name"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="erp-field">
                            <label asp-for="AlternateName"></label>
                            <input asp-for="AlternateName" class="form-control" />
                        </div>
                        <div class="erp-field">
                            <label asp-for="ParentCategoryId"></label>
                            <select asp-for="ParentCategoryId" class="form-select">
                                <option value="">Yok (Ana Kategori)</option>
                                @foreach (var option in Model.ParentCategoryOptions)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </select>
                            <span asp-validation-for="ParentCategoryId" class="text-danger small"></span>
                        </div>
                        <div class="erp-field">
                            <label asp-for="DisplayOrder"></label>
                            <input asp-for="DisplayOrder" class="form-control" />
                        </div>
                        <div class="erp-field">
                            <label asp-for="Unit"></label>
                            <input asp-for="Unit" class="form-control" placeholder="Adet" />
                        </div>
                        <div class="erp-field">
                            <label asp-for="Color"></label>
                            <input asp-for="Color" type="color" class="form-control form-control-color" />
                            <span asp-validation-for="Color" class="text-danger small"></span>
                            <div class="form-text">Satış programında bu kategori için gösterilecek renk.</div>
                        </div>
                        <div class="erp-field" style="grid-column: 1 / -1;">
                            <label asp-for="WebsitePath"></label>
                            <input asp-for="WebsitePath" class="form-control" />
                        </div>
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="erp-panel mt-3">
                <div class="erp-panel-header">İskonto ve Puan</div>
                <div class="erp-panel-body">
                    <div class="erp-field-grid">
                        <div class="erp-field">
                            <label asp-for="DiscountPercentSale"></label>
                            <input asp-for="DiscountPercentSale" type="number" step="0.01" min="0" max="100" class="form-control" />
                        </div>
                        <div class="erp-field">
                            <label asp-for="DiscountPercentPurchase"></label>
                            <input asp-for="DiscountPercentPurchase" type="number" step="0.01" min="0" max="100" class="form-control" />
                        </div>
                        <div class="erp-field">
                            <label asp-for="LoyaltyPoints"></label>
                            <input asp-for="LoyaltyPoints" type="number" min="0" class="form-control" />
                            <div class="form-text">Sabit/TL bazlı puan.</div>
                        </div>
                        <div class="erp-field">
                            <label asp-for="LoyaltyPointsPercent"></label>
                            <input asp-for="LoyaltyPointsPercent" type="number" step="0.01" min="0" max="100" class="form-control" />
                            <div class="form-text">Satış tutarının yüzdesi bazlı puan.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="erp-panel mt-3">
                <div class="erp-panel-header">Görünürlük ve Kısıtlamalar</div>
                <div class="erp-panel-body">
                    <div class="erp-field-grid">
                        <div class="form-check form-switch">
                            <input asp-for="ShowAsShortcut" class="form-check-input" />
                            <label asp-for="ShowAsShortcut" class="form-check-label"></label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="ShowInMobile" class="form-check-input" />
                            <label asp-for="ShowInMobile" class="form-check-label"></label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="ShowInOnlineOrder" class="form-check-input" />
                            <label asp-for="ShowInOnlineOrder" class="form-check-label"></label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="VisibleInBranches" class="form-check-input" />
                            <label asp-for="VisibleInBranches" class="form-check-label"></label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="ShowInReceiptImage" class="form-check-input" />
                            <label asp-for="ShowInReceiptImage" class="form-check-label"></label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="DiscountNotApplicable" class="form-check-input" />
                            <label asp-for="DiscountNotApplicable" class="form-check-label"></label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="PromotionNotApplicable" class="form-check-input" />
                            <label asp-for="PromotionNotApplicable" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="erp-panel mt-3">
                <div class="erp-panel-header">Bu Kategorideki Stoklara Toplu Uygula</div>
                <div class="erp-panel-body">
                    <p class="text-secondary small">
                        Varsayılan KDV ve Mutfak İstasyonu (Yazıcı), "Kaydet" ile her kategori
                        kaydında bu kategorideki TÜM ürünlere otomatik olarak yazılır - ayrı bir
                        onay gerekmez. Yukarıdaki "Görünürlük ve Kısıtlamalar" ayarları ise
                        otomatik uygulanmaz; onları ürünlere yansıtmak için önce "Kaydet"e basıp
                        ardından aşağıdaki "Stoklara Kaydet"i kullanın.
                    </p>
                    <div class="erp-field-grid">
                        <div class="erp-field">
                            <label asp-for="TaxRateId"></label>
                            <select asp-for="TaxRateId" class="form-select">
                                <option value="">Seçiniz...</option>
                                @foreach (var option in Model.TaxRateOptions)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </select>
                        </div>
                        <div class="erp-field">
                            <label asp-for="DefaultKitchenStationId"></label>
                            <select asp-for="DefaultKitchenStationId" class="form-select">
                                <option value="">Seçiniz...</option>
                                @foreach (var option in Model.KitchenStationOptions)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3 mb-2 d-flex gap-2">
                <button type="submit" class="btn btn-erp">Kaydet</button>
                <a asp-action="Create" class="btn btn-erp-outline">Yeni</a>
            </div>
        </form>

        @if (isEdit)
        {
            <form method="post" asp-action="ApplyToProducts" asp-route-id="@Model.Id" class="mb-2"
                  onsubmit="return confirm('Bu kategorideki TÜM ürünlerin KDV/Yazıcı/görünürlük/indirim-promosyon ayarları, kategoride kayıtlı değerlerle değiştirilecek. Devam edilsin mi?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-erp-outline">Stoklara Kaydet</button>
            </form>

            @if (mergeOptions.Any())
            {
                <form asp-action="MergeInto" asp-route-id="@Model.Id" method="post" class="d-flex align-items-center gap-2 mb-2"
                      onsubmit="return confirm('&quot;' + '@Model.Name'.replace(/'/g,'') + '&quot; kategorisindeki tüm ürünler seçilen kategoriye taşınacak ve bu kategori silinecek. Emin misiniz?');">
                    @Html.AntiForgeryToken()
                    <select name="targetCategoryId" class="form-select form-select-sm" style="width: auto;" required>
                        <option value="">Birleştir →</option>
                        @foreach (var other in mergeOptions)
                        {
                            <option value="@other.Id">@other.Code - @other.Name</option>
                        }
                    </select>
                    <button type="submit" class="btn-erp-list-delete">Birleştir</button>
                </form>
            }
        }

        <partial name="_EvrakToolbar" model="(SahinSoft.Web.Models.EvrakToolbarViewModel?)ViewBag.Toolbar" />
    </div>
</div>

<style>
    /* Kategori Tanımla - solda ağaç, sağda form (Edip'in 2026-09-03 referansı: Dinosoft kategori
       ekranı). Sadece bu sayfaya özel - erp.css'in genel kurallarına dokunmaz. */
    .category-manager {
        display: grid;
        grid-template-columns: minmax(260px, 320px) 1fr;
        gap: 1rem;
        align-items: start;
    }

    @@media (max-width: 900px) {
        .category-manager {
            grid-template-columns: 1fr;
        }
    }

    .category-tree-panel {
        background: #fff;
        border: 1px solid #E3E8EF;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(15, 35, 55, .06);
        overflow: hidden;
        position: sticky;
        top: 1rem;
        max-height: calc(100vh - 140px);
        display: flex;
        flex-direction: column;
    }

    .category-tree-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem;
        border-bottom: 1px solid #E3E8EF;
    }

    .category-tree-search {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        border: 1px solid #E3E8EF;
        border-radius: 8px;
        padding: 0.35rem 0.6rem;
        color: #6F7F92;
    }

    .category-tree-search input {
        border: none;
        outline: none;
        flex: 1;
        font-size: 0.85rem;
    }

    .category-tree-list {
        overflow-y: auto;
        padding: 0.5rem;
    }

    .category-tree-group {
        margin-bottom: 0.15rem;
    }

    .category-tree-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 0.5rem;
        border-radius: 8px;
        text-decoration: none;
        color: #132238;
        font-size: 0.85rem;
        transition: background-color 100ms ease;
    }

    .category-tree-item.sub {
        margin-left: 1.15rem;
        font-size: 0.8rem;
        color: #4b5a6c;
    }

    .category-tree-item:hover {
        background: #F4F6F9;
    }

    .category-tree-item.active {
        background: #0B2239;
        color: #fff;
    }

    .category-tree-item .cat-dot {
        width: 9px;
        height: 9px;
        border-radius: 999px;
        background: var(--cat-color, #6c757d);
        flex-shrink: 0;
    }

    .category-tree-item .cat-name {
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .category-tree-item .cat-meta {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.72rem;
    }

    .category-tree-item .cat-order {
        color: #6F7F92;
    }

    .category-tree-item.active .cat-order {
        color: #cdd6e0;
    }

    .category-tree-item .cat-active {
        color: #22A86A;
    }

    .category-tree-item.active .cat-active {
        color: #6be3a8;
    }

    .category-tree-item .cat-inactive {
        color: #b9c2cd;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var input = document.getElementById('categoryTreeSearch');
            var list = document.getElementById('categoryTreeList');
            var empty = document.getElementById('categoryTreeEmpty');
            if (!input || !list) return;
            input.addEventListener('input', function () {
                var term = input.value.trim().toLowerCase();
                var anyVisible = false;
                list.querySelectorAll('.category-tree-group').forEach(function (group) {
                    var groupMatch = false;
                    group.querySelectorAll('.category-tree-item').forEach(function (item) {
                        var match = !term || (item.getAttribute('data-search') || '').indexOf(term) !== -1;
                        item.style.display = match ? '' : 'none';
                        if (match) groupMatch = true;
                    });
                    group.style.display = groupMatch ? '' : 'none';
                    if (groupMatch) anyVisible = true;
                });
                if (empty) empty.style.display = anyVisible ? 'none' : '';
            });
        })();
    </script>
}
