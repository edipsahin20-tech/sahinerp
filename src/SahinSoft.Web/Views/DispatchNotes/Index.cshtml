@using SahinSoft.Domain.Enums
@model IReadOnlyList<SahinSoft.Domain.Entities.DispatchNote>
@{
    ViewData["Title"] = "İrsaliyeler";
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-truck"></i> İrsaliyeler</h2>
        <div class="d-flex gap-2">
            <a asp-action="Create" asp-route-type="@InvoiceType.Purchase" class="btn-erp-list-new">+ Alış İrsaliyesi</a>
            <a asp-action="Create" asp-route-type="@InvoiceType.Sales" class="btn-erp-list-new">+ Satış İrsaliyesi</a>
        </div>
    </div>
    <div class="erp-list-body">
        <div class="erp-list-topbar">
            <div class="erp-list-topbar-left">
                <div class="erp-list-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" class="form-control" autocomplete="off" placeholder="İrsaliye no veya cari ara..." data-live-search="#dispatchNotesTable">
                </div>
                <form method="get" class="erp-list-filter d-flex gap-2">
                    <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<InvoiceType>()" onchange="this.form.submit()">
                        <option value="">Tüm türler</option>
                    </select>
                    <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<BusinessDocumentStatus>()" onchange="this.form.submit()">
                        <option value="">Tüm durumlar</option>
                    </select>
                </form>
            </div>
            <span class="text-secondary">Toplam <strong>@Model.Count</strong> kayıt.</span>
        </div>

        <div class="erp-table-wrap">
            <table class="erp-table" id="dispatchNotesTable">
                <thead>
                    <tr>
                        <th>İrsaliye No</th>
                        <th>Tür</th>
                        <th>Tarih</th>
                        <th>Cari</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var statusClass = item.Status switch
                    {
                        BusinessDocumentStatus.Draft => "gray",
                        BusinessDocumentStatus.Approved or BusinessDocumentStatus.Fulfilled => "green",
                        BusinessDocumentStatus.PartiallyFulfilled => "amber",
                        _ => "red"
                    };
                    var statusText = item.Status switch
                    {
                        BusinessDocumentStatus.Draft => "Taslak",
                        BusinessDocumentStatus.Approved => "Onaylı",
                        BusinessDocumentStatus.PartiallyFulfilled => "Kısmi",
                        BusinessDocumentStatus.Fulfilled => "Tamamlandı",
                        _ => "İptal"
                    };
                    <tr>
                        <td><span class="erp-code-badge">@item.DispatchNumber</span></td>
                        <td>@(item.DispatchType == InvoiceType.Sales ? "Satış" : "Alış")</td>
                        <td>@item.DispatchDateUtc.ToString("dd.MM.yyyy")</td>
                        <td class="fw-semibold">@item.Customer.Name</td>
                        <td><span class="erp-status-pill @statusClass">@statusText</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-erp-list-action">Görüntüle</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
