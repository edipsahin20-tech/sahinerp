@model SahinSoft.Web.Models.FinancialAccountFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Hesabı Düzenle" : "Yeni Kasa/Banka Hesabı";
}

<form id="evrak-form" method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <input asp-for="Id" type="hidden" />

    <div class="erp-toolbar">
        <div class="erp-toolbar-title"><h1>@ViewData["Title"]</h1></div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="erp-panel">
        <div class="erp-panel-header">Hesap Bilgileri</div>
        <div class="erp-panel-body">
            <div class="erp-field-grid">
                <div class="erp-field">
                    <label asp-for="Code"></label>
                    <input asp-for="Code" class="form-control" autofocus placeholder="Boş bırakılırsa otomatik atanır" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="erp-field" style="grid-column: span 2;">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="erp-field">
                    <label asp-for="AccountType"></label>
                    <select asp-for="AccountType" asp-items="Html.GetEnumSelectList<SahinSoft.Domain.Enums.FinancialAccountType>()" class="form-select"></select>
                </div>
                <div class="erp-field">
                    <label asp-for="CurrencyCode"></label>
                    <input asp-for="CurrencyCode" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="BankName"></label>
                    <input asp-for="BankName" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="BranchName"></label>
                    <input asp-for="BranchName" class="form-control" />
                </div>
                <div class="erp-field" style="grid-column: 1 / -1;">
                    <label asp-for="Iban"></label>
                    <input asp-for="Iban" class="form-control" />
                </div>
            </div>
            <div class="form-check form-switch mt-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>
</form>

<partial name="_EvrakToolbar" model="(SahinSoft.Web.Models.EvrakToolbarViewModel?)ViewBag.Toolbar" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
