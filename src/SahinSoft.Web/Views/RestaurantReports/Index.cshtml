@model SahinSoft.Web.Models.RestaurantReportsViewModel
@{
    Layout = "_RestaurantShellLayout";
    ViewData["Title"] = "Raporlar";
    // Üst kısım (özet/KPI/grafikler/sekme başlıkları) sabit kalır, yalnızca aktif sekmenin
    // içeriği (Günlük Fişler/X/Z/Z Listesi) kendi içinde kayar (Edip, 2026-09-04: "raporlar
    // kısmı tam otursun sadece alt taraf ... kaysın").
    ViewData["MainFixed"] = true;

    static string SourceTypeLabel(string type) => type switch
    {
        "self" => "Self",
        "package" => "Paket",
        _ => "Masa"
    };

    // Madde 28 - ortak dönem filtresi Kasiyer Raporu, Fiş Hareketleri (eski "Günlük Fişler") ve
    // dahil olduğu diğer standart raporlarda geçerli; X/Z/Z Listesi spec'in kendisi tarafından
    // HARİÇ tutuluyor ("Kasiyer Raporu, X Raporu, Z Raporu ve Z Listesi hariç" - X/Z/Z Listesi
    // için, Kasiyer için değil - Kasiyer'in kendisi dönem filtresi KULLANIR, sadece X/Z/Z Listesi
    // kullanmaz).
    var periodAwareTabs = new[] { "daily", "kasiyer" };
    var usesPeriodFilter = periodAwareTabs.Contains(Model.ActiveTab);

    // ◁/▷ ile bir önceki/sonraki DÖNEME atla (gün seçiliyken bir gün, hafta seçiliyken bir
    // hafta, ay seçiliyken bir ay, yıl seçiliyken bir yıl) - period ile TUTARLI gezinme.
    DateOnly StepDate(int direction) => Model.PeriodFilter switch
    {
        "week" => Model.ReportDate.AddDays(7 * direction),
        "month" => Model.ReportDate.AddMonths(1 * direction),
        "year" => Model.ReportDate.AddYears(1 * direction),
        _ => Model.ReportDate.AddDays(1 * direction)
    };
}

<div class="toolbar">
    <div>
        <div class="eyebrow">RAPOR MERKEZİ</div>
        <div class="h1">Restoran Raporları</div>
        <div class="sub">Satış, ödeme, fiş ve vardiya kapanışlarını tek ekrandan takip edin.</div>
    </div>
    <div class="actions no-print">
        <!-- Tarih pili (2026-09-06, onaylı Raporlar mockup'ı "birebir uygulama") - altta yatan
             mekanizma (◁/▷ ile StepDate, Model.PeriodRangeLabel) AYNEN korunuyor, sadece görsel
             olarak tek bir takvim-ikonlu pil haline getirildi - mevcut Günlük/Haftalık/Aylık/Yıllık
             gezinmesi bozulmadı. -->
        <div class="rdate-pill">
            <a class="rdate-step" asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-source="@Model.SourceFilter" asp-route-period="@Model.PeriodFilter" asp-route-date="@StepDate(-1).ToString("yyyy-MM-dd")">◁</a>
            <span class="rdate-label">📅 @Model.PeriodRangeLabel</span>
            <a class="rdate-step" asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-source="@Model.SourceFilter" asp-route-period="@Model.PeriodFilter" asp-route-date="@StepDate(1).ToString("yyyy-MM-dd")">▷</a>
        </div>
        <button type="button" class="rbtn gold" onclick="window.print()">▣ Yazdır</button>
        <!-- Onaylı mockup'taki Excel/PDF butonları (madde birebir-uygulama) - Excel GERÇEK bir
             .csv indirir (mevcut tablo görünür satırlarından, bkz. aşağıdaki inline script - site.js'teki
             data-csv-export gerçek <table> bekliyor, buradaki raporlar div-grid olduğu için AYRI
             küçük bir dışa aktarma yazıldı, ikisi de AYNI CSV mantığını kullanıyor). PDF için ayrı
             bir sunucu tarafı üretim altyapısı YOK - tarayıcının kendi "Yazdır > PDF olarak kaydet"
             hedefi zaten gerçek bir PDF üretimi, o yüzden PDF de aynı yazdırma diyaloğunu açıyor -
             uydurma bir "PDF oluşturuldu" mesajı YOK. -->
        <button type="button" class="rbtn excel" id="report-excel-btn">📊 Excel</button>
        <button type="button" class="rbtn pdf" onclick="window.print()">📄 PDF</button>
    </div>
</div>

<div class="report-scroll-area">

@if (usesPeriodFilter)
{
    <!-- Ortak dönem filtresi (madde 28) - Günlük/Haftalık/Aylık/Yıllık. Seçilen döneme göre
         kartlar/grafik/tablo/fiş hareketleri BİRLİKTE güncellenir (aynı sunucu isteği). -->
    <div class="report-nav2" style="margin-bottom:12px;">
        <a class="rnav @(Model.PeriodFilter == "day" ? "active" : "")" asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-source="@Model.SourceFilter" asp-route-period="day"><b>Günlük</b></a>
        <a class="rnav @(Model.PeriodFilter == "week" ? "active" : "")" asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-source="@Model.SourceFilter" asp-route-period="week"><b>Haftalık</b></a>
        <a class="rnav @(Model.PeriodFilter == "month" ? "active" : "")" asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-source="@Model.SourceFilter" asp-route-period="month"><b>Aylık</b></a>
        <a class="rnav @(Model.PeriodFilter == "year" ? "active" : "")" asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-source="@Model.SourceFilter" asp-route-period="year"><b>Yıllık</b></a>
    </div>
}

<!-- Onaylı Restoran Raporları mockup'ının BİREBİR 2 satırlı rapor türü sekmesi (madde
     birebir-uygulama, 2026-09-05; 2026-09-06'da sekme içeriğinden ÖNCE gelecek şekilde
     taşındı - onaylı mockup'ta sekme çubuğu her zaman en üstte). -->
<div class="report-tabgrid">
    <a class="rnavgrid @(Model.ActiveTab == "overview" ? "active" : "")" asp-action="Index" asp-route-tab="overview" asp-route-period="@Model.PeriodFilter" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")"><i class="ico">◷</i><span><b>Günlük / Aylık</b><small>Dönem özeti</small></span></a>
    <a class="rnavgrid @(Model.ActiveTab == "payment" ? "active" : "")" asp-action="Index" asp-route-tab="payment" asp-route-period="@Model.PeriodFilter" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")"><i class="ico">◔</i><span><b>Ödeme Dağılımı</b><small>Ödeme türü kırılımı</small></span></a>
    <a class="rnavgrid @(Model.ActiveTab == "bestsellers" ? "active" : "")" asp-action="Index" asp-route-tab="bestsellers" asp-route-period="@Model.PeriodFilter" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")"><i class="ico">♨</i><span><b>En Çok Satanlar</b><small>Ürün bazlı</small></span></a>
    <a class="rnavgrid @(Model.ActiveTab == "categories" ? "active" : "")" asp-action="Index" asp-route-tab="categories" asp-route-period="@Model.PeriodFilter" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")"><i class="ico">▦</i><span><b>Kategori Satışları</b><small>Kategori bazlı</small></span></a>
    <a class="rnavgrid @(Model.ActiveTab == "vat" ? "active" : "")" asp-action="Index" asp-route-tab="vat" asp-route-period="@Model.PeriodFilter" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")"><i class="ico">%</i><span><b>KDV Dökümü</b><small>Oran bazlı</small></span></a>
    <a class="rnavgrid @(Model.ActiveTab == "discount" ? "active" : "")" asp-action="Index" asp-route-tab="discount" asp-route-period="@Model.PeriodFilter" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")"><i class="ico">◈</i><span><b>İndirim &amp; İkram</b><small>Fiş bazlı</small></span></a>
    <a class="rnavgrid @(Model.ActiveTab == "kasiyer" ? "active" : "")" asp-action="Index" asp-route-tab="kasiyer" asp-route-period="@Model.PeriodFilter" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")"><i class="ico">◈</i><span><b>Kasiyer Raporu</b><small>Kullanıcı bazlı</small></span></a>
    <a class="rnavgrid @(Model.ActiveTab == "daily" ? "active" : "")" asp-action="Index" asp-route-tab="daily" asp-route-period="@Model.PeriodFilter" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")"><i class="ico">▥</i><span><b>Günlük Fişler</b><small>Seçilen dönemin satışları</small></span></a>
    <a class="rnavgrid @(Model.ActiveTab == "x" ? "active" : "")" asp-action="Index" asp-route-tab="x" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")"><i class="ico">X</i><span><b>X Raporu</b><small>Anlık, vardiyayı kapatmaz</small></span></a>
    <a class="rnavgrid @(Model.ActiveTab == "z" ? "active" : "")" asp-action="Index" asp-route-tab="z" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")"><i class="ico">Z</i><span><b>Z Raporu</b><small>Gün sonu kapanışı</small></span></a>
    <a class="rnavgrid @(Model.ActiveTab == "zlist" ? "active" : "")" asp-action="Index" asp-route-tab="zlist" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")"><i class="ico">▦</i><span><b>Z Listesi</b><small>Geçmiş kapanışlar</small></span></a>
</div>

<!-- Sabit üst / kayan alt (2026-09-06, Edip: "bu alan sabit olsun diğer alanlar aşağıya doğru
     kaysın... sekmelerdeki işlemler hareketli alanda çalışsın") - dönem pilleri + sekme ızgarası
     (yukarıda) HER ZAMAN sabit kalır; hangi sekmeye tıklanırsa tıklansın o sekmenin KENDİ
     içeriği (Günlük Fişler'in KPI/filtre/tablosu dahil) bu YENİ iç kaydırma alanında çalışır -
     .report-scroll-area artık kendisi kaymıyor (bkz. CSS), kaydırma BURAYA taşındı. -->
<div class="report-tab-scroll">
@if (Model.ActiveTab == "overview")
{
    <div class="report-hero" style="margin-top:16px;">
        <div class="rcard report-hero-main">
            <div class="eyebrow">DÖNEM RAPOR ÖZETİ</div>
            <h2 style="margin:6px 0;">@Model.PeriodRangeLabel satış özeti</h2>
            <div class="report-hero-metrics">
                <div><small>NET CİRO</small><strong>@Model.NetRevenue.ToString("N0") ₺</strong></div>
                <div><small>FİŞ</small><strong>@Model.ReceiptCount</strong></div>
                <div><small>ORT. FİŞ</small><strong>@Model.AverageReceipt.ToString("N0") ₺</strong></div>
                <div><small>İPTAL ORANI</small><strong>%@Model.CancelRatePercent.ToString("0.0")</strong></div>
            </div>
        </div>
        <div class="rcard report-close-card">
            <div class="close-status">
                <div><b>Vardiya Durumu</b><div class="sub">@(Model.IsShiftOpen ? $"{Model.ShiftOpenedAtUtc!.Value.ToLocalTime():HH:mm}'den beri açık ({Model.FinancialAccountName})" : "Vardiya kapalı")</div></div>
                <span class="rest-pill @(Model.IsShiftOpen ? "green" : "")">@(Model.IsShiftOpen ? "● AÇIK" : "● KAPALI")</span>
            </div>
            <div class="close-grid">
                <div class="close-mini"><small>Son Z No</small><b>@(Model.LastZNumber ?? "—")</b></div>
                <div class="close-mini"><small>Son Z Kapanış</small><b>@(Model.LastZClosedAtUtc?.ToLocalTime().ToString("dd.MM HH:mm") ?? "—")</b></div>
            </div>
        </div>
    </div>

    <div class="report-kpis2">
        <div class="rcard report-kpi2" style="--soft:#E8F6F3"><small>NET CİRO</small><strong>@Model.NetRevenue.ToString("N2") ₺</strong><em>@Model.ReceiptCount tamamlanan fiş</em></div>
        @foreach (var item in Model.PaymentBreakdown)
        {
            <div class="rcard report-kpi2" style="--soft:#F2F2F2"><small>@item.Label.ToUpperInvariant()</small><strong>@item.Amount.ToString("N2") ₺</strong><em>%@(item.Percent.ToString("0.0")) pay</em></div>
        }
        <div class="rcard report-kpi2" style="--soft:#EDF3F9"><small>FİŞ SAYISI</small><strong>@Model.ReceiptCount</strong><em>Ort. @Model.AverageReceipt.ToString("N2") ₺</em></div>
    </div>

    <div class="report-analytics">
        <div class="rcard analytics-card">
            <div class="analytics-head">
                <div><h3>Ciro Akışı</h3><small>@Model.PeriodRangeLabel satış ritmi</small></div>
            </div>
            @{ var maxHourly = Model.HourlyRevenue.Count > 0 ? Math.Max(Model.HourlyRevenue.Max(), 1) : 1; }
            @if (Model.HourlyRevenue.Count == 0 || Model.HourlyRevenue.Sum() == 0)
            {
                <div class="analytics-empty">Bu dönemde satış verisi yok.</div>
            }
            else
            {
                <div class="premium-chart">
                    @for (var i = 0; i < Model.HourlyRevenue.Count; i++)
                    {
                        var v = Model.HourlyRevenue[i];
                        var heightPct = Math.Max(2, (int)Math.Round(v / maxHourly * 100));
                        var isPeak = v == Model.HourlyRevenue.Max() && v > 0;
                        <div class="pc-col @(isPeak ? "hot" : "")">
                            <div class="pc-value">@(v > 0 ? v.ToString("N0") + " ₺" : "")</div>
                            <div class="pc-bar" style="height:@(heightPct)%"></div>
                            <div class="pc-label">@(i < Model.HourlyRevenueLabels.Count ? Model.HourlyRevenueLabels[i] : "")</div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="rcard analytics-card">
            <div class="analytics-head"><div><h3>Ödeme Dağılımı</h3><small>Ödeme türlerine göre dağılım</small></div></div>
            @if (Model.PaymentBreakdownTotal <= 0)
            {
                <div class="analytics-empty">Bu dönemde ödeme verisi yok.</div>
            }
            else
            {
                <!-- Ödenmez iş kuralı (2026-09-06, Edip): finansal karşılığı olmadığı için Net Ciro'ya
                     dahil değildir - bu yüzden merkez etiket kasıtlı olarak "Net Ciro" DEĞİL, "Toplam
                     Tahsilat/İşlem" (Ödenmez dahil TÜM ödeme türlerinin toplamı) olarak gösterilir; aksi
                     halde bu donut'un merkezindeki rakam üstteki NET CİRO kutusuyla ÇELİŞİRDİ. -->
                <div class="donut2-wrap">
                    <div class="donut2" style="background:@Model.PaymentBreakdownConicGradient">
                        <div class="donut2-center"><strong>@Model.PaymentBreakdownTotal.ToString("N0") ₺</strong><small>Toplam İşlem</small></div>
                    </div>
                </div>
                <div class="payment-legend">
                    @foreach (var item in Model.PaymentBreakdown)
                    {
                        <div class="legend-row"><span class="dot" style="background:@item.ColorVar"></span><span>@item.Label</span><b>%@(item.Percent.ToString("0.0"))</b></div>
                    }
                </div>
            }
        </div>
    </div>
}
else if (Model.ActiveTab == "payment")
{
    <div class="rcard" style="margin-top:12px; padding:20px;">
        <h4>Ödeme Dağılımı</h4>
        <p class="sub">@Model.PeriodRangeLabel dönemi - ödeme türü bazında tutar ve pay.</p>
        @if (Model.PaymentBreakdown.Count == 0)
        {
            <div class="analytics-empty">Bu dönemde ödeme verisi yok.</div>
        }
        else
        {
            <div class="report-table-wrap" id="paymentBreakdownTable" style="border-top:1px solid var(--rs-border); border-radius:10px;">
                <div class="rthead"><span>ÖDEME TÜRÜ</span><span>TUTAR</span><span>PAY</span><span></span></div>
                @foreach (var item in Model.PaymentBreakdown)
                {
                    <a class="rrow2" style="grid-template-columns:1fr 1fr 1fr auto;text-decoration:none;color:inherit;" asp-action="Index" asp-route-tab="payment" asp-route-period="@Model.PeriodFilter" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")" asp-route-selectedPaymentMethod="@item.Method">
                        <span><b>@item.Label</b></span><span>@item.Amount.ToString("N2") ₺</span><span>%@(item.Percent.ToString("0.0"))</span><span>Detay ▷</span>
                    </a>
                }
            </div>
        }
    </div>
}
else if (Model.ActiveTab == "bestsellers")
{
    <div class="rcard" style="margin-top:12px; padding:0;">
        <div style="padding:16px 16px 0;"><h4>En Çok Satanlar</h4><p class="sub">@Model.PeriodRangeLabel dönemi - tutara göre ilk 15 ürün.</p></div>
        @if (Model.BestSellers.Count == 0)
        {
            <div class="p-3 text-secondary small">Bu dönemde satış verisi yok.</div>
        }
        else
        {
            <div class="report-table-wrap" id="bestSellersTable">
                <div class="rthead"><span>ÜRÜN</span><span>MİKTAR</span><span>TUTAR</span><span></span></div>
                @foreach (var row in Model.BestSellers)
                {
                    <a class="rrow2" style="grid-template-columns:1fr 1fr 1fr auto;text-decoration:none;color:inherit;" asp-action="Index" asp-route-tab="bestsellers" asp-route-period="@Model.PeriodFilter" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")" asp-route-selectedProduct="@row.ProductId">
                        <span><b>@row.ProductName</b></span><span>@row.Quantity.ToString("N0")</span><span>@row.Total.ToString("N2") ₺</span><span>Detay ▷</span>
                    </a>
                }
            </div>
        }
    </div>
}
else if (Model.ActiveTab == "categories")
{
    <div class="rcard" style="margin-top:12px; padding:0;">
        <div style="padding:16px 16px 0;"><h4>Kategori Satışları</h4><p class="sub">@Model.PeriodRangeLabel dönemi.</p></div>
        @if (Model.CategorySales.Count == 0)
        {
            <div class="p-3 text-secondary small">Bu dönemde satış verisi yok.</div>
        }
        else
        {
            <div class="report-table-wrap" id="categorySalesTable">
                <div class="rthead"><span>KATEGORİ</span><span>MİKTAR</span><span>TUTAR</span><span>PAY</span></div>
                @foreach (var row in Model.CategorySales)
                {
                    <div class="rrow2"><span><b>@row.CategoryName</b></span><span>@row.Quantity.ToString("N0")</span><span>@row.Total.ToString("N2") ₺</span><span>%@(row.Percent.ToString("0.0"))</span></div>
                }
            </div>
        }
    </div>
}
else if (Model.ActiveTab == "vat")
{
    <div class="rcard" style="margin-top:12px; padding:0;">
        <div style="padding:16px 16px 0;"><h4>KDV Dökümü</h4><p class="sub">@Model.PeriodRangeLabel dönemi - oran bazında matrah/KDV/brüt.</p></div>
        @if (Model.VatBreakdown.Count == 0)
        {
            <div class="p-3 text-secondary small">Bu dönemde satış verisi yok.</div>
        }
        else
        {
            <div class="report-table-wrap" id="vatTable">
                <div class="rthead"><span>KDV ORANI</span><span>MATRAH</span><span>KDV TUTARI</span><span>BRÜT</span></div>
                @foreach (var row in Model.VatBreakdown)
                {
                    <div class="rrow2"><span><b>%@row.TaxRate.ToString("N0")</b></span><span>@row.Matrah.ToString("N2") ₺</span><span>@row.VatAmount.ToString("N2") ₺</span><span>@row.Gross.ToString("N2") ₺</span></div>
                }
                <div class="rrow2" style="font-weight:800;"><span>TOPLAM</span><span>@Model.VatBreakdown.Sum(x => x.Matrah).ToString("N2") ₺</span><span>@Model.VatBreakdown.Sum(x => x.VatAmount).ToString("N2") ₺</span><span>@Model.VatBreakdown.Sum(x => x.Gross).ToString("N2") ₺</span></div>
            </div>
        }
    </div>
}
else if (Model.ActiveTab == "discount")
{
    <div class="report-kpis2" style="margin-top:12px;">
        <div class="rcard report-kpi2" style="--soft:#EEE9FF"><small>İNDİRİM TOPLAMI</small><strong>@Model.DiscountTotal.ToString("N2") ₺</strong></div>
        <div class="rcard report-kpi2" style="--soft:#FFF1CC"><small>İKRAM TOPLAMI</small><strong>@Model.ComplimentaryTotal.ToString("N2") ₺</strong></div>
    </div>
    <div class="rcard" style="margin-top:12px; padding:0;">
        <div style="padding:16px 16px 0;"><h4>İndirim &amp; İkram</h4><p class="sub">@Model.PeriodRangeLabel dönemi - fiş bazında.</p></div>
        @if (Model.DiscountComplimentaryRows.Count == 0)
        {
            <div class="p-3 text-secondary small">Bu dönemde indirim/ikram yok.</div>
        }
        else
        {
            <div class="report-table-wrap" id="discountTable">
                <div class="rthead"><span>SAAT / FİŞ NO</span><span>MASA / KAYNAK</span><span>TÜR</span><span>TUTAR</span></div>
                @foreach (var row in Model.DiscountComplimentaryRows)
                {
                    <div class="rrow2">
                        <div><b>@row.IssuedAtUtc.ToLocalTime().ToString("HH:mm")</b><small>@row.DocumentNumber</small></div>
                        <span>@row.SourceLabel</span>
                        <span class="@(row.IsComplimentary ? "ok-badge2" : "")">@(row.IsComplimentary ? "İkram" : "İndirim")</span>
                        <b>@row.Amount.ToString("N2") ₺</b>
                    </div>
                }
            </div>
        }
    </div>
}

@if (Model.ActiveTab == "daily")
{
    <!-- Kompakt 5 kartlı KPI satırı (2026-09-06, onaylı Raporlar mockup'ı) - Nakit/Kredi Kartı
         Model.PaymentBreakdown'dan (o dönemde GERÇEKTEN var olan ödeme türlerinden, madde 30)
         okunuyor, KDV Toplamı Model.VatBreakdown'ın (KDV Dökümü sekmesiyle AYNI kaynak) toplamı -
         yeni bir hesap İCAT EDİLMEDİ, mevcut doğrulanmış verilerin yeniden düzenlenmiş görünümü. -->
    <div class="report-kpis-compact">
        <div class="rcard rkpi-compact"><span class="ico" style="background:#EAF3FF;color:#2563EB;">▤</span><div><small>NET CİRO</small><strong>@Model.NetRevenue.ToString("N2") ₺</strong></div></div>
        <div class="rcard rkpi-compact"><span class="ico" style="background:#F1EEFF;color:#6D5AE0;">▥</span><div><small>FİŞ SAYISI</small><strong>@Model.ReceiptCount</strong></div></div>
        <div class="rcard rkpi-compact"><span class="ico" style="background:#E8F6EE;color:#1F9D55;">₺</span><div><small>NAKİT</small><strong>@((Model.PaymentBreakdown.FirstOrDefault(x => x.Label == "Nakit")?.Amount ?? 0m).ToString("N2")) ₺</strong></div></div>
        <div class="rcard rkpi-compact"><span class="ico" style="background:#FFF3E0;color:#C77700;">▣</span><div><small>KREDİ KARTI</small><strong>@((Model.PaymentBreakdown.FirstOrDefault(x => x.Label == "Kredi Kartı")?.Amount ?? 0m).ToString("N2")) ₺</strong></div></div>
