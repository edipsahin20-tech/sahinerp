@model SahinSoft.Web.Models.CustomerStatementViewModel
@{
    ViewData["Title"] = "Cari Ekstresi";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Cari Ekstresi</h1>
        <p class="text-secondary mb-0">@Model.CustomerCode &middot; @Model.CustomerName</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Cari listesine dön</a>
</div>

<form method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-end">
        <input type="hidden" name="id" value="@Model.CustomerId" />
        <div>
            <label class="form-label">Başlangıç</label>
            <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div>
            <label class="form-label">Bitiş</label>
            <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <button class="btn btn-outline-primary">Filtrele</button>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Devreden bakiye</div>
                <div class="h4 mb-0">@Model.OpeningBalance.ToString("N2") ₺</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Kapanış bakiyesi</div>
                <div class="h4 mb-0 @(Model.ClosingBalance >= 0 ? "text-danger" : "text-success")">@Model.ClosingBalance.ToString("N2") ₺</div>
                <div class="text-secondary small">@(Model.ClosingBalance >= 0 ? "Cari borçlu" : "Cari alacaklı")</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tarih</th>
                    <th>İşlem</th>
                    <th>Belge no</th>
                    <th>Açıklama</th>
                    <th class="text-end">Borç</th>
                    <th class="text-end">Alacak</th>
                    <th class="text-end">Bakiye</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.OpeningBalance != 0)
            {
                <tr class="table-light">
                    <td colspan="6" class="fw-semibold">Devreden bakiye</td>
                    <td class="text-end fw-semibold">@Model.OpeningBalance.ToString("N2")</td>
                </tr>
            }
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.TransactionDateUtc.ToString("dd.MM.yyyy")</td>
                    <td>@line.TransactionType</td>
                    <td>@line.DocumentNumber</td>
                    <td>@line.Description</td>
                    <td class="text-end">@(line.Debit > 0 ? line.Debit.ToString("N2") : "")</td>
                    <td class="text-end">@(line.Credit > 0 ? line.Credit.ToString("N2") : "")</td>
                    <td class="text-end">@line.RunningBalance.ToString("N2")</td>
                </tr>
            }
            @if (Model.Lines.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-secondary py-4">Bu tarih aralığında hareket bulunmuyor.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
