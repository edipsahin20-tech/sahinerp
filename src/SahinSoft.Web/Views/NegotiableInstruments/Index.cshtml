@using SahinSoft.Domain.Enums
@model IReadOnlyList<SahinSoft.Domain.Entities.NegotiableInstrument>
@{
    ViewData["Title"] = "Çek/Senet";
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-money-check"></i> Çek/Senet Yönetimi</h2>
        <div class="d-flex gap-2">
            <a asp-action="Create" asp-route-type="@NegotiableInstrumentType.Cheque" class="btn-erp-list-new">+ Çek</a>
            <a asp-action="Create" asp-route-type="@NegotiableInstrumentType.PromissoryNote" class="btn-erp-list-new">+ Senet</a>
        </div>
    </div>
    <div class="erp-list-body">
        <div class="erp-list-topbar">
            <div class="erp-list-topbar-left">
                <div class="erp-list-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" class="form-control" autocomplete="off" placeholder="Belge no veya cari ara..." data-live-search="#negotiableInstrumentsTable">
                </div>
                <form method="get" class="erp-list-filter d-flex gap-2">
                    <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<NegotiableInstrumentType>()" onchange="this.form.submit()">
                        <option value="">Tümü</option>
                    </select>
                    <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<InstrumentStatus>()" onchange="this.form.submit()">
                        <option value="">Tümü</option>
                    </select>
                </form>
            </div>
            <span class="text-secondary">Toplam <strong>@Model.Count</strong> kayıt.</span>
        </div>

        <div class="erp-table-wrap">
            <table class="erp-table" id="negotiableInstrumentsTable">
                <thead>
                    <tr>
                        <th>Belge No</th>
                        <th>Tür</th>
                        <th>Yön</th>
                        <th>Cari</th>
                        <th>Vade</th>
                        <th class="text-end">Tutar</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="erp-code-badge">@item.InstrumentNumber</span></td>
                        <td>@(item.InstrumentType == NegotiableInstrumentType.Cheque ? "Çek" : "Senet")</td>
                        <td>@(item.Direction == InstrumentDirection.Received ? "Alınan" : "Verilen")</td>
                        <td class="fw-semibold">@item.Customer.Name</td>
                        <td>@item.DueDateUtc.ToString("dd.MM.yyyy")</td>
                        <td class="text-end fw-semibold">@item.Amount.ToString("N2") @item.CurrencyCode</td>
                        <td><span class="erp-status-pill gray">@item.Status.GetDisplayName()</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-erp-list-action">Görüntüle</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
