@model SahinSoft.Web.Models.GrossProfitViewModel
@{
    ViewData["Title"] = "Brüt Kâr Raporu";
}
<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-chart-line"></i> Brüt Kâr Raporu</h2>
        <div class="d-flex gap-2 no-print"><button type="button" class="btn-erp-list-new" onclick="window.print()">Yazdır</button></div>
    </div>
    <div class="erp-list-body">
        <p class="text-secondary small">Satış = onaylı satış faturaları (KDV hariç, iade dahil) + isteğe bağlı restoran satışları. Maliyet = satış anındaki hareket maliyeti, yoksa ağırlıklı ortalama maliyet.</p>
        <form method="get" class="erp-filter-bar">
            <div class="erp-field"><label>İlk Tarih</label><input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="erp-field"><label>Son Tarih</label><input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="erp-field"><label>Şube</label><select name="branchId" class="form-select" asp-items="Model.Branches"><option value="">Tüm şubeler</option></select></div>
            <div class="erp-field"><label>Restoran satışları</label><select name="includeRestaurant" class="form-select"><option value="true" selected="@Model.IncludeRestaurant">Dahil</option><option value="false" selected="@(!Model.IncludeRestaurant)">Hariç</option></select></div>
            <button class="btn btn-erp-primary">Filtrele</button>
        </form>
        <div class="erp-summary-row">
            <div class="erp-summary-box"><div class="erp-summary-label">Net Satış</div><div class="erp-summary-value">@Model.TotalSales.ToString("N2") ₺</div></div>
            <div class="erp-summary-box"><div class="erp-summary-label">Maliyet</div><div class="erp-summary-value">@Model.TotalCost.ToString("N2") ₺</div></div>
            <div class="erp-summary-box"><div class="erp-summary-label">Brüt Kâr</div><div class="erp-summary-value" style="color: @(Model.TotalProfit >= 0 ? "#1f8a4c" : "#c62828");">@Model.TotalProfit.ToString("N2") ₺</div></div>
            <div class="erp-summary-box"><div class="erp-summary-label">Kâr Oranı</div><div class="erp-summary-value">% @Model.TotalMargin.ToString("N2")</div></div>
        </div>
        <div class="erp-list-search mb-2" style="max-width: 320px;"><i class="fa-solid fa-magnifying-glass"></i><input type="text" class="form-control" autocomplete="off" placeholder="Stok ara..." data-live-search="#profitTable"></div>
        <div class="erp-table-wrap">
            <table class="erp-table" id="profitTable" data-sortable>
                <thead><tr><th data-sort="text">Stok Kodu</th><th data-sort="text">Stok Adı</th><th class="text-end" data-sort="number">Miktar</th><th class="text-end" data-sort="number">Net Satış</th><th class="text-end" data-sort="number">Maliyet</th><th class="text-end" data-sort="number">Brüt Kâr</th><th class="text-end" data-sort="number">Kâr %</th></tr></thead>
                <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr><td><span class="erp-code-badge">@r.StockCode</span></td><td>@r.Name</td><td class="text-end">@r.Quantity.ToString("N3")</td><td class="text-end">@r.NetSales.ToString("N2")</td><td class="text-end">@r.Cost.ToString("N2")</td>
                        <td class="text-end fw-semibold" style="color: @(r.Profit >= 0 ? "#1f8a4c" : "#c62828");">@r.Profit.ToString("N2")</td><td class="text-end">@r.Margin.ToString("N2")</td></tr>
                }
                @if (Model.Rows.Count == 0) { <tr data-live-search-empty><td colspan="7" class="text-center text-secondary py-4">Bu aralıkta satış yok.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
<style media="print">
    @@page { size: A4 landscape; margin: 8mm; }
    .erp-list-header .no-print, .erp-filter-bar, .erp-list-search { display: none !important; }
    .erp-table-wrap { overflow: visible !important; }
    .erp-table { font-size: 8pt; }
    .erp-table th, .erp-table td { padding: 2px 4px !important; }
</style>
