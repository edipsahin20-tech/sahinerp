@using SahinSoft.Domain.Enums
@model IReadOnlyList<SahinSoft.Domain.Entities.StockSlip>
@{
    ViewData["Title"] = "Stok Fişleri";
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-box"></i> Stok Fişleri</h2>
        <div class="d-flex gap-2">
            <a asp-action="Create" asp-route-type="@StockSlipType.Issue" class="btn-erp-list-new">+ Stok Çıkış Fişi</a>
            <a asp-action="Create" asp-route-type="@StockSlipType.Receipt" class="btn-erp-list-new">+ Stok Giriş Fişi</a>
        </div>
    </div>
    <div class="erp-list-body">
        <div class="erp-list-topbar">
            <div class="erp-list-topbar-left">
                <div class="erp-list-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" class="form-control" autocomplete="off" placeholder="Fiş no ara..." data-live-search="#stockSlipsTable">
                </div>
                <form method="get" class="erp-list-filter d-flex gap-2">
                    <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<StockSlipType>()" onchange="this.form.submit()">
                        <option value="">Tüm türler</option>
                    </select>
                    <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<StockSlipStatus>()" onchange="this.form.submit()">
                        <option value="">Tüm durumlar</option>
                    </select>
                </form>
            </div>
            <span class="text-secondary">Toplam <strong>@Model.Count</strong> kayıt.</span>
        </div>

        <div class="erp-table-wrap">
            <table class="erp-table" id="stockSlipsTable">
                <thead>
                    <tr>
                        <th>Fiş No</th>
                        <th>Tür</th>
                        <th>Tarih</th>
                        <th>Depo</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var statusClass = item.Status switch
                    {
                        StockSlipStatus.Draft => "gray",
                        StockSlipStatus.Approved => "green",
                        _ => "red"
                    };
                    var statusText = item.Status switch
                    {
                        StockSlipStatus.Draft => "Taslak",
                        StockSlipStatus.Approved => "Onaylı",
                        _ => "İptal"
                    };
                    <tr>
                        <td><span class="erp-code-badge">@item.SlipNumber</span></td>
                        <td>@(item.SlipType == StockSlipType.Receipt ? "Giriş" : "Çıkış")</td>
                        <td>@item.SlipDateUtc.ToString("dd.MM.yyyy")</td>
                        <td>@item.Warehouse.Name</td>
                        <td><span class="erp-status-pill @statusClass">@statusText</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-erp-list-action">Görüntüle</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
