@using SahinSoft.Domain.Enums
@model IReadOnlyList<SahinSoft.Domain.Entities.Invoice>
@{
    ViewData["Title"] = "Faturalar";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Faturalar</h1>
        <p class="text-secondary mb-0">@Model.Count kayıt listeleniyor.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" asp-route-type="@InvoiceType.Purchase" class="btn btn-outline-primary">+ Alış faturası</a>
        <a asp-action="Create" asp-route-type="@InvoiceType.Sales" class="btn btn-primary">+ Satış faturası</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2">
        <select name="type" class="form-select" style="max-width: 160px;" asp-items="Html.GetEnumSelectList<InvoiceType>()">
            <option value="">Tüm türler</option>
        </select>
        <select name="status" class="form-select" style="max-width: 160px;" asp-items="Html.GetEnumSelectList<InvoiceStatus>()">
            <option value="">Tüm durumlar</option>
        </select>
        <input name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Fatura no veya cari ara..." />
        <button class="btn btn-outline-primary">Ara</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Fatura no</th>
                    <th>Tür</th>
                    <th>Tarih</th>
                    <th>Cari</th>
                    <th>Durum</th>
                    <th class="text-end">Tutar</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.InvoiceNumber</td>
                    <td>@(item.InvoiceType == InvoiceType.Sales ? "Satış" : "Alış")</td>
                    <td>@item.InvoiceDateUtc.ToString("dd.MM.yyyy")</td>
                    <td>@item.Customer.Name</td>
                    <td>
                        @{
                            var badgeClass = item.Status switch
                            {
                                InvoiceStatus.Draft => "text-bg-secondary-subtle text-secondary-emphasis",
                                InvoiceStatus.Approved => "text-bg-success-subtle text-success-emphasis",
                                _ => "text-bg-danger-subtle text-danger-emphasis"
                            };
                            var statusText = item.Status switch
                            {
                                InvoiceStatus.Draft => "Taslak",
                                InvoiceStatus.Approved => "Onaylı",
                                _ => "İptal"
                            };
                        }
                        <span class="badge @badgeClass">@statusText</span>
                    </td>
                    <td class="text-end">@item.GrandTotal.ToString("N2") ₺</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Görüntüle</a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-secondary py-4">Kayıt bulunamadı.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
