@model SahinSoft.Web.Models.CustomerFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Cariyi Düzenle" : "Yeni Cari";
}

<form id="evrak-form" method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <input asp-for="Id" type="hidden" />

    <div class="erp-toolbar">
        <div class="erp-toolbar-title">
            <h1>Cari Hesap Tanıtım Kartı</h1>
            <span class="erp-toolbar-meta">@(isEdit ? "Düzenleniyor" : "Yeni cari")</span>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="erp-panel">
        <div class="erp-panel-header">Kimlik Bilgileri</div>
        <div class="erp-panel-body">
            <div class="erp-field-grid">
                <div class="erp-field">
                    <label asp-for="Code"></label>
                    <input asp-for="Code" class="form-control" placeholder="Boş bırakılırsa otomatik atanır" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="erp-field" style="grid-column: span 2;">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" class="form-control" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="erp-field">
                    <label asp-for="TaxOffice"></label>
                    <input asp-for="TaxOffice" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="TaxNumber"></label>
                    <input asp-for="TaxNumber" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="IdentityNumber"></label>
                    <input asp-for="IdentityNumber" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="erp-panel">
        <div class="erp-panel-header">İletişim</div>
        <div class="erp-panel-body">
            <div class="erp-field-grid">
                <div class="erp-field">
                    <label asp-for="Phone"></label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="erp-field">
                    <label asp-for="City"></label>
                    <input asp-for="City" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="District"></label>
                    <input asp-for="District" class="form-control" />
                </div>
                <div class="erp-field" style="grid-column: 1 / -1;">
                    <label asp-for="Address"></label>
                    <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                </div>
                <div class="erp-field" style="grid-column: 1 / -1;">
                    <label asp-for="Notes"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
        <div class="erp-panel-body pt-0 d-flex flex-wrap gap-4">
            <div class="form-check form-switch">
                <input asp-for="IsCustomer" class="form-check-input" />
                <label asp-for="IsCustomer" class="form-check-label"></label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="IsSupplier" class="form-check-input" />
                <label asp-for="IsSupplier" class="form-check-label"></label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>
</form>

<partial name="_EvrakToolbar" model="(SahinSoft.Web.Models.EvrakToolbarViewModel?)ViewBag.Toolbar" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
