<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- SahinSoft.FiscalAgent ile AYNI şekil (kasa PC'sinde çalışan küçük, bağımsız yerel
         servis, web uygulamasına GÖMÜLEMEZ) - ama FiscalAgent'in x86 kısıtı BURADA yok, çünkü
         Windows Print Spooler P/Invoke'u (winspool.drv) x64'te de normal çalışır. Web app
         render ettiği ESC/POS baytları buraya POST eder, bu servis SADECE OS yazıcı kuyruğuna
         RAW veri olarak yazar - render mantığının TAMAMI web app'te kalır. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SahinSoftPrintAgent</AssemblyName>
    <RootNamespace>SahinSoft.PrintAgent</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Include="agent.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yüklü Windows yazıcı kuyruklarını listelemek için (PrinterSettings.InstalledPrinters) -
         .NET Core'da çekirdekten ayrıldı, ayrı paket gerekiyor. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

</Project>
