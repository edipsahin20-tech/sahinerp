@using SahinSoft.Domain.Enums
@using SahinSoft.Web.Models
@model SahinSoft.Domain.Entities.NegotiableInstrument
@{
    ViewData["Title"] = $"{(Model.InstrumentType == NegotiableInstrumentType.Cheque ? "Çek" : "Senet")} {Model.InstrumentNumber}";
    var statusClass = Model.Status switch
    {
        InstrumentStatus.Portfolio => "erp-status-draft",
        InstrumentStatus.Collected or InstrumentStatus.Paid or InstrumentStatus.Endorsed => "erp-status-approved",
        _ => "erp-status-cancelled"
    };
    var isAdmin = User.IsInRole(SahinSoft.Domain.Constants.AppRoles.Administrator);
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>@(Model.InstrumentType == NegotiableInstrumentType.Cheque ? "Çek" : "Senet")</h1>
        <span class="erp-doc-no">@Model.InstrumentNumber</span>
        <span class="erp-status-badge @statusClass">@Model.Status.GetDisplayName()</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-action="Index" class="btn btn-erp-outline btn-sm">Liste</a>
        @if (Model.Status == InstrumentStatus.Portfolio)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-erp-outline btn-sm">Düzenle</a>
        }
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="erp-panel">
    <div class="erp-panel-header">@Model.Customer.Name &middot; @(Model.Direction == InstrumentDirection.Received ? "Alınan" : "Verilen")</div>
    <div class="erp-panel-body">
        <div class="erp-field-grid">
            <div class="erp-field"><label>Düzenleme Tarihi</label><div>@Model.IssueDateUtc.ToString("dd.MM.yyyy")</div></div>
            <div class="erp-field"><label>Vade Tarihi</label><div>@Model.DueDateUtc.ToString("dd.MM.yyyy")</div></div>
            <div class="erp-field"><label>Tutar</label><div class="fw-semibold">@Model.Amount.ToString("N2") @Model.CurrencyCode</div></div>
            <div class="erp-field"><label>Banka</label><div>@Model.BankName</div></div>
            <div class="erp-field"><label>Şube</label><div>@Model.BranchName</div></div>
            <div class="erp-field"><label>Hesap No</label><div>@Model.AccountNumber</div></div>
            <div class="erp-field"><label>Keşideci</label><div>@Model.DrawerName</div></div>
            <div class="erp-field" style="grid-column: 1 / -1;"><label>Açıklama</label><div>@Model.Description</div></div>
        </div>
    </div>
</div>

@if (Model.Status is InstrumentStatus.Collected or InstrumentStatus.Paid)
{
    <div class="erp-panel">
        <div class="erp-panel-header">Tahsilat/Ödeme Bilgisi</div>
        <div class="erp-panel-body">
            <div class="erp-field-grid">
                <div class="erp-field"><label>Kasa/Banka</label><div>@Model.SettlementFinancialAccount?.Name</div></div>
                <div class="erp-field"><label>Tarih</label><div>@Model.SettledAtUtc?.ToString("dd.MM.yyyy HH:mm")</div></div>
            </div>
        </div>
    </div>
}

@if (Model.Status == InstrumentStatus.Endorsed || Model.EndorsedToCustomerId is not null)
{
    <div class="erp-panel">
        <div class="erp-panel-header">Ciro Bilgisi</div>
        <div class="erp-panel-body">
            <div class="erp-field-grid">
                <div class="erp-field"><label>Devralan Cari</label><div>@Model.EndorsedToCustomer?.Name</div></div>
                <div class="erp-field"><label>Tarih</label><div>@Model.EndorsedAtUtc?.ToString("dd.MM.yyyy HH:mm")</div></div>
            </div>
        </div>
    </div>
}

@if (Model.Status == InstrumentStatus.Cancelled)
{
    <div class="erp-panel">
        <div class="erp-panel-header">İptal Bilgisi</div>
        <div class="erp-panel-body">
            <div class="erp-field-grid">
                <div class="erp-field"><label>Gerekçe</label><div>@Model.CancellationReason</div></div>
                <div class="erp-field"><label>Tarih</label><div>@Model.CancelledAtUtc?.ToString("dd.MM.yyyy HH:mm")</div></div>
            </div>
        </div>
    </div>
}

@if (Model.Status is InstrumentStatus.Portfolio or InstrumentStatus.Endorsed)
{
    <div class="erp-panel">
        <div class="erp-panel-header">Durum Güncelle</div>
        <div class="erp-panel-body d-flex flex-wrap gap-3">
            @if (Model.Status == InstrumentStatus.Portfolio)
            {
                <form method="post" asp-action="Settle" asp-route-id="@Model.Id" class="d-flex align-items-end gap-2">
                    <div style="min-width: 240px;">
                        <label class="form-label small mb-1">@(Model.Direction == InstrumentDirection.Received ? "Tahsil Edilecek Kasa/Banka" : "Ödemenin Yapılacağı Kasa/Banka")</label>
                        <partial name="_LookupField" model="@(new LookupFieldViewModel {
                            Name = "settlementFinancialAccountId", Id = "settlementFinancialAccountId",
                            Endpoint = Url.Action("FinancialAccounts", "Lookup")!,
                            Title = "Kasa/Banka Hesabı Seç", Placeholder = "Hesap seçin" })" />
                    </div>
                    <button type="submit" class="btn btn-erp-primary">@(Model.Direction == InstrumentDirection.Received ? "Tahsil Edildi" : "Ödendi")</button>
                </form>

                @if (Model.Direction == InstrumentDirection.Received)
                {
                    <form method="post" asp-action="Endorse" asp-route-id="@Model.Id" class="d-flex align-items-end gap-2">
                        <div style="min-width: 240px;">
                            <label class="form-label small mb-1">Devralan Cari</label>
                            <partial name="_LookupField" model="@(new LookupFieldViewModel {
                                Name = "endorsedToCustomerId", Id = "endorsedToCustomerId",
                                Endpoint = Url.Action("Customers", "Lookup")!,
                                Title = "Cari Seç", Placeholder = "Cari seçin" })" />
                        </div>
                        <button type="submit" class="btn btn-erp-outline">Ciro Edildi</button>
                    </form>

                    <form method="post" asp-action="Protest" asp-route-id="@Model.Id">
                        <button type="submit" class="btn btn-erp-danger">Karşılıksız/Protesto</button>
                    </form>
                }
            }

            <form method="post" asp-action="Return" asp-route-id="@Model.Id">
                <button type="submit" class="btn btn-erp-outline">İade Edildi</button>
            </form>

            @if (isAdmin)
            {
                <form method="post" asp-action="Cancel" asp-route-id="@Model.Id" class="d-flex align-items-end gap-2"
                      onsubmit="var r = prompt('İptal gerekçesini yazın:'); if (!r) return false; document.getElementById('ni-cancel-reason').value = r; return true;">
                    <input type="hidden" id="ni-cancel-reason" name="reason" value="" />
                    <button type="submit" class="btn btn-erp-danger">İptal Et</button>
                </form>
            }
        </div>
    </div>
}
else if (Model.Status is InstrumentStatus.Collected or InstrumentStatus.Paid or InstrumentStatus.Protested or InstrumentStatus.Returned)
{
    @if (isAdmin)
    {
        <div class="erp-panel">
            <div class="erp-panel-header">Yönetici İşlemleri</div>
            <div class="erp-panel-body">
                <form method="post" asp-action="Cancel" asp-route-id="@Model.Id"
                      onsubmit="var r = prompt('İptal gerekçesini yazın:'); if (!r) return false; document.getElementById('ni-cancel-reason-2').value = r; return true;">
                    <input type="hidden" id="ni-cancel-reason-2" name="reason" value="" />
                    <button type="submit" class="btn btn-erp-danger">İptal Et (terminal durumdan)</button>
                </form>
            </div>
        </div>
    }
}
