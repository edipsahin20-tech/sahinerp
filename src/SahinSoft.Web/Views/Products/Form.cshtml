@model SahinSoft.Web.Models.ProductFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Stok Kartını Düzenle" : "Yeni Stok Kartı";
}

<form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <input asp-for="Id" type="hidden" />
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
        <div>
            <h1 class="h3 mb-1">@ViewData["Title"]</h1>
            <p class="text-secondary mb-0">Ürünün tüm temel bilgilerini tek ekrandan yönetin.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            <button type="submit" class="btn btn-primary px-4">Kaydet</button>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-3 p-lg-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="StockCode" class="form-label"></label>
                    <input asp-for="StockCode" class="form-control" />
                    <span asp-validation-for="StockCode" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">Kategori seçin</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="TaxRateId" class="form-label"></label>
                    <select asp-for="TaxRateId" asp-items="Model.TaxRates" class="form-select">
                        <option value="">KDV seçin</option>
                    </select>
                    <span asp-validation-for="TaxRateId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ProductType" class="form-label"></label>
                    <select asp-for="ProductType" class="form-select">
                        <option>Donanım</option>
                        <option>Yazılım</option>
                        <option>Hizmet</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="Brand" class="form-label"></label>
                    <input asp-for="Brand" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Model" class="form-label"></label>
                    <input asp-for="Model" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Barcode" class="form-label"></label>
                    <input asp-for="Barcode" class="form-control" inputmode="numeric" />
                    <span asp-validation-for="Barcode" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Unit" class="form-label"></label>
                    <select asp-for="Unit" class="form-select">
                        <option>Adet</option>
                        <option>Paket</option>
                        <option>Takım</option>
                        <option>Hizmet</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="PurchasePrice" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="PurchasePrice" class="form-control" />
                        <span class="input-group-text">₺</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <label asp-for="SalePrice" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="SalePrice" class="form-control" />
                        <span class="input-group-text">₺</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <label asp-for="StockQuantity" class="form-label"></label>
                    @if (isEdit)
                    {
                        <input asp-for="StockQuantity" class="form-control" readonly />
                        <div class="form-text">Mevcut stok yalnızca stok fişi, fatura, sevk veya sayım ile değişir.</div>
                    }
                    else
                    {
                        <input asp-for="StockQuantity" class="form-control" />
                        <div class="form-text">Girilen değer varsayılan depoya açılış hareketi oluşturur.</div>
                    }
                </div>

                <div class="col-md-3">
                    <label asp-for="MinimumStockQuantity" class="form-label"></label>
                    <input asp-for="MinimumStockQuantity" class="form-control" />
                </div>
                <div class="col-md-9">
                    <label asp-for="ImagePath" class="form-label"></label>
                    <input asp-for="ImagePath" class="form-control" placeholder="/images/products/urun.jpg" />
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-12 d-flex flex-wrap gap-4 pt-2">
                    <div class="form-check form-switch">
                        <input asp-for="TrackStock" class="form-check-input" />
                        <label asp-for="TrackStock" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white d-flex justify-content-end gap-2 py-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            <button type="submit" class="btn btn-primary px-4">Kaydet</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
