@model SahinSoft.Web.Models.FinancialTransactionReportViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-money-bill-transfer"></i> @Model.PageTitle</h2>
        <span class="text-white-50" style="font-size: 0.8rem;">Son 500 kayıt</span>
    </div>
    <div class="erp-list-body">
        <form method="get" class="erp-filter-bar">
            <input type="hidden" name="accountType" value="@Model.AccountType" />
            <div class="erp-field">
                <label>Hesap</label>
                <select name="financialAccountId" class="form-select" style="min-width: 220px;" asp-items="Model.FinancialAccounts" onchange="this.form.submit()">
                    <option value="">Tüm hesaplar</option>
                </select>
            </div>
            <div class="erp-field">
                <label>Şube</label>
                <select name="branchId" class="form-select" style="min-width: 180px;" asp-items="Model.Branches" onchange="this.form.submit()">
                    <option value="">Tüm şubeler</option>
                </select>
            </div>
            <div class="erp-field">
                <label>Başlangıç</label>
                <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="erp-field">
                <label>Bitiş</label>
                <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <button class="btn btn-erp-primary">Filtrele</button>
        </form>

        <div class="erp-summary-row">
            <div class="erp-summary-box">
                <div class="erp-summary-label">Giriş</div>
                <div class="erp-summary-value" id="summary-in" style="color: #1f7a4d;">+@Model.TotalIn.ToString("N2")</div>
            </div>
            <div class="erp-summary-box">
                <div class="erp-summary-label">Çıkış</div>
                <div class="erp-summary-value" id="summary-out" style="color: #8a2a2a;">-@Model.TotalOut.ToString("N2")</div>
            </div>
            <div class="erp-summary-box" style="border-color: var(--erp-gold);">
                <div class="erp-summary-label">Net Değişim</div>
                <div class="erp-summary-value" id="summary-net">@(Model.NetChange >= 0 ? "+" : "")@Model.NetChange.ToString("N2")</div>
            </div>
        </div>

        <div class="erp-list-search mb-2" style="max-width: 320px;">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" class="form-control" autocomplete="off" placeholder="Hesap, hareket, cari veya belge no ara..." data-live-search="#financialTransactionsTable">
        </div>

        <div class="erp-table-wrap">
            <table class="erp-table" id="financialTransactionsTable" data-sortable>
                <thead>
                    <tr>
                        <th data-sort="date">Tarih</th>
                        <th data-sort="text">Hesap</th>
                        <th data-sort="text">Şube</th>
                        <th data-sort="text">Hareket</th>
                        <th data-sort="text">Cari</th>
                        <th data-sort="text">Belge No</th>
                        <th data-sort="text">Z No</th>
                        <th data-sort="text">Açıklama</th>
                        <th class="text-end" data-sort="number">Tutar</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.TransactionDateUtc.ToString("dd.MM.yyyy")</td>
                        <td class="fw-semibold">@line.AccountName</td>
                        <td>@(line.BranchName ?? "—")</td>
                        <td>@line.TransactionType</td>
                        <td>@line.CustomerName</td>
                        <td><span class="erp-code-badge">@line.DocumentNumber</span></td>
                        <td>
                            @if (line.RestaurantZNo is not null)
                            {
                                <!-- Talimat 1 (2026-09-06) - "muhasebe tarafından da ADS ve Z'ye
                                     geri gidilebilmeli": Z Listesi'nin kendi Detay/Fişi Gör
                                     ekranına doğrudan atlar (bkz. RestaurantReportsController). -->
                                <a asp-controller="RestaurantReports" asp-action="Index" asp-route-tab="zlist" asp-route-zShiftId="@line.RestaurantZPeriodId" asp-route-selected="@line.RestaurantRetailSaleId" class="erp-code-badge" style="text-decoration:none;" title="Z Detay ve fişe git">@line.RestaurantZNo</a>
                            }
                        </td>
                        <td>@line.Description</td>
                        <td class="text-end fw-semibold" style="color: @(line.IsIncoming ? "#1f7a4d" : "#8a2a2a");">
                            @(line.IsIncoming ? "+" : "-")@line.Amount.ToString("N2")
                        </td>
                    </tr>
                }
                @if (Model.Lines.Count == 0)
                {
                    <tr data-live-search-empty><td colspan="9" class="text-center text-secondary py-4">Bu filtrelerde hareket bulunamadı.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var table = document.getElementById('financialTransactionsTable');
            if (!table) return;
            var tbody = table.tBodies[0];
            var inEl = document.getElementById('summary-in');
            var outEl = document.getElementById('summary-out');
            var netEl = document.getElementById('summary-net');

            function parseAmount(text) {
                var cleaned = String(text || '').replace(/\./g, '').replace(',', '.').replace(/[^\d.+-]/g, '');
                return parseFloat(cleaned) || 0;
            }

            function fmt(n) {
                return n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function recalc() {
                var rows = Array.from(tbody.rows).filter(function (r) {
                    return !r.hasAttribute('data-live-search-empty') && r.style.display !== 'none';
                });
                var totalIn = 0, totalOut = 0;
                rows.forEach(function (row) {
                    var amount = parseAmount(row.cells[row.cells.length - 1].textContent);
                    if (amount >= 0) totalIn += amount; else totalOut += -amount;
                });
                inEl.textContent = '+' + fmt(totalIn);
                outEl.textContent = '-' + fmt(totalOut);
                var net = totalIn - totalOut;
                netEl.textContent = (net >= 0 ? '+' : '') + fmt(net);
            }

            table.addEventListener('erp:rowschange', recalc);
        })();
    </script>
}
