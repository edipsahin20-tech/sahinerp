@using SahinSoft.Domain.Enums
@model SahinSoft.Web.Models.DispatchNoteFormViewModel
@{
    var isEdit = Model.Id > 0;
    var isSales = Model.DispatchType == InvoiceType.Sales;
    ViewData["Title"] = (isEdit ? "Düzenle: " : "Yeni ") + (isSales ? "Satış İrsaliyesi" : "Alış İrsaliyesi");
}

<form id="evrak-form" method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <input asp-for="Id" type="hidden" />
    <input asp-for="DispatchType" type="hidden" />

    <div class="erp-toolbar">
        <div class="erp-toolbar-title">
            <h1>@(isSales ? "Satış İrsaliyesi" : "Alış İrsaliyesi")</h1>
            <span class="erp-toolbar-meta">@(isEdit ? "Taslak düzenleniyor" : "Yeni evrak")</span>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="erp-panel">
        <div class="erp-panel-header">Evrak Bilgileri</div>
        <div class="erp-panel-body">
            <div class="erp-field-grid">
                <div class="erp-field">
                    <label asp-for="CustomerId"></label>
                    <partial name="_LookupField" model="@(new LookupFieldViewModel {
                        Name = nameof(Model.CustomerId), Id = nameof(Model.CustomerId),
                        Value = Model.CustomerId?.ToString(),
                        DisplayValue = Model.CustomerDisplay,
                        Endpoint = Url.Action("Customers", "Lookup", new { type = isSales ? "Customer" : "Supplier" })!,
                        Title = "Cari Seç", Placeholder = "Cari seçin" })" />
                    <span asp-validation-for="CustomerId" class="text-danger small"></span>
                </div>
                <div class="erp-field">
                    <label asp-for="WarehouseId"></label>
                    <partial name="_LookupField" model="@(new LookupFieldViewModel {
                        Name = nameof(Model.WarehouseId), Id = nameof(Model.WarehouseId),
                        Value = Model.WarehouseId?.ToString(),
                        DisplayValue = Model.WarehouseDisplay,
                        Endpoint = Url.Action("Warehouses", "Lookup")!,
                        Title = "Depo Seç", Placeholder = "Depo seçin" })" />
                    <span asp-validation-for="WarehouseId" class="text-danger small"></span>
                </div>
                <div class="erp-field">
                    <label asp-for="DispatchDateUtc"></label>
                    <input asp-for="DispatchDateUtc" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="VehiclePlate"></label>
                    <input asp-for="VehiclePlate" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="CarrierName"></label>
                    <input asp-for="CarrierName" class="form-control" />
                </div>
                <div class="erp-field" style="grid-column: 1 / -1;">
                    <label asp-for="Notes"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="erp-panel">
        <div class="erp-panel-header d-flex justify-content-between align-items-center">
            <span>Satırlar</span>
            <button type="button" id="add-line" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.75rem;">+ Satır Ekle</button>
        </div>
        <div class="erp-panel-body p-0">
            <div class="erp-table-wrap">
                <table class="erp-table" id="lines-table">
                    <thead>
                        <tr>
                            <th style="width: 140px;">Stok Kodu</th>
                            <th style="min-width: 240px;">Ürün Adı</th>
                            <th style="width: 140px;">Miktar</th>
                            <th style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="lines-body">
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        var rawDisplay = Model.Lines[i].ProductDisplay ?? "";
                        var codeVal = rawDisplay.Contains(" - ") ? rawDisplay.Split(" - ")[0] : "";
                        var nameVal = rawDisplay.Contains(" - ") ? string.Join(" - ", rawDisplay.Split(" - ").Skip(1)) : rawDisplay;
                        <tr class="line-row">
                            <input type="hidden" name="Lines.Index" value="@i" />
                            <td>
                                <input type="text" class="form-control stock-code-input lookup-quicksearch" 
                                       placeholder="Stok Kodu/Barkod" autocomplete="off" value="@codeVal"
                                       data-lookup-endpoint="@Url.Action("Products", "Lookup")"
                                       data-lookup-title="Ürün Seç"
                                       data-target-hidden="Lines_@(i)__ProductId"
                                       data-target-display="Lines_@(i)__ProductId_display" />
                            </td>
                            <td>
                                <partial name="_LookupField" model="@(new LookupFieldViewModel {
                                    Name = $"Lines[{i}].ProductId", Id = $"Lines_{i}__ProductId",
                                    Value = Model.Lines[i].ProductId?.ToString(),
                                    DisplayValue = nameVal,
                                    Endpoint = Url.Action("Products", "Lookup")!,
                                    Title = "Ürün Seç", Placeholder = "Ürün adı/kod/barkod",
                                    AllowQuickSearch = true })" />
                            </td>
                            <td><input type="text" name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity" class="form-control quantity-input" /></td>
                            <td><button type="button" class="btn btn-erp-danger remove-line" style="padding: 0.15rem 0.5rem; font-size: 0.75rem;">Sil</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>

<partial name="_EvrakToolbar" model="(SahinSoft.Web.Models.EvrakToolbarViewModel?)ViewBag.Toolbar" />

<template id="line-row-template">
    <tr class="line-row">
        <input type="hidden" name="Lines.Index" value="__index__" />
        <td>
            <input type="text" class="form-control stock-code-input lookup-quicksearch"
                   placeholder="Stok Kodu/Barkod" autocomplete="off"
                   data-lookup-endpoint="@Url.Action("Products", "Lookup")"
                   data-lookup-title="Ürün Seç"
                   data-target-hidden="Lines___index____ProductId"
                   data-target-display="Lines___index____ProductId_display" />
        </td>
        <td>
            <div class="input-group">
                <input type="hidden" name="Lines[__index__].ProductId" id="Lines___index____ProductId" value="" />
                <input type="text" id="Lines___index____ProductId_display" class="form-control lookup-quicksearch product-name-input"
                       placeholder="Ürün adı/kod/barkod" autocomplete="off"
                       data-lookup-endpoint="@Url.Action("Products", "Lookup")"
                       data-lookup-title="Ürün Seç"
                       data-target-hidden="Lines___index____ProductId"
                       data-target-display="Lines___index____ProductId_display" />
                <button type="button" class="btn btn-outline-secondary lookup-trigger"
                        data-lookup-endpoint="@Url.Action("Products", "Lookup")"
                        data-lookup-title="Ürün Seç"
                        data-target-hidden="Lines___index____ProductId"
                        data-target-display="Lines___index____ProductId_display">
                    ...
                </button>
            </div>
        </td>
        <td><input type="text" name="Lines[__index__].Quantity" value="1" class="form-control quantity-input" /></td>
        <td><button type="button" class="btn btn-erp-danger remove-line" style="padding: 0.15rem 0.5rem; font-size: 0.75rem;">Sil</button></td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var linesBody = document.getElementById('lines-body');
            var template = document.getElementById('line-row-template');
            var addButton = document.getElementById('add-line');
            var nextIndex = @Model.Lines.Count;

            function addRow() {
                var html = template.innerHTML.split('__index__').join(nextIndex);
                var wrapper = document.createElement('tbody');
                wrapper.innerHTML = html;
                var row = wrapper.firstElementChild;
                linesBody.appendChild(row);
                nextIndex++;
                return row;
            }

            addButton.addEventListener('click', function () {
                addRow();
            });

            linesBody.addEventListener('click', function (event) {
                if (event.target.classList.contains('remove-line')) {
                    var row = event.target.closest('tr');
                    if (linesBody.querySelectorAll('.line-row').length > 1) {
                        row.remove();
                    }
                }
            });

            linesBody.addEventListener('lookup:selected', function (event) {
                var row = event.target.closest('tr');
                if (!row) return;
                var item = event.detail.item;
                if (item.code) {
                    var codeInput = row.querySelector('.stock-code-input');
                    if (codeInput) codeInput.value = item.code;
                }
                var qtyInput = row.querySelector('.quantity-input');
                if (qtyInput) {
                    qtyInput.focus();
                    qtyInput.select();
                }
            });

            var rowFieldOrder = ['.stock-code-input', '.lookup-quicksearch', '.quantity-input'];

            linesBody.addEventListener('keydown', function (event) {
                if (event.key !== 'Enter') return;
                
                var dropdownOpen = document.querySelector('.lookup-quick-dropdown') && document.querySelector('.lookup-quick-dropdown').style.display === 'block';
                if (dropdownOpen) return;

                var fieldClass = rowFieldOrder.find(function (cls) { return event.target.classList.contains(cls.slice(1)); });
                if (!fieldClass) return;
                event.preventDefault();

                var row = event.target.closest('tr');
                var fieldIndex = rowFieldOrder.indexOf(fieldClass);

                if (fieldIndex < rowFieldOrder.length - 1) {
                    var nextField = row.querySelector(rowFieldOrder[fieldIndex + 1]);
                    if (nextField) {
                        nextField.focus();
                        if (typeof nextField.select === 'function') nextField.select();
                        return;
                    }
                }

                var allRows = Array.from(linesBody.querySelectorAll('.line-row'));
                var isLastRow = allRows[allRows.length - 1] === row;

                var targetRow;
                if (isLastRow) {
                    targetRow = addRow();
                    addRow();
                } else {
                    targetRow = allRows[allRows.indexOf(row) + 1];
                }

                var firstInput = targetRow.querySelector('.stock-code-input') || targetRow.querySelector('.lookup-quicksearch');
                if (firstInput) {
                    firstInput.focus();
                    if (typeof firstInput.select === 'function') firstInput.select();
                }
            });
        })();
    </script>
}
