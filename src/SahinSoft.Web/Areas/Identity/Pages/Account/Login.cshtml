@page
@model LoginModel

@{
    ViewData["Title"] = "Giriş Yap";
    ViewData["Subtitle"] = "";
}

<form id="account" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

    <div class="auth-field">
        <label asp-for="Input.Email" class="form-label">E-posta</label>
        <div class="auth-field-control">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ornek@sahinsoft.com.tr" />
            <svg class="auth-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
        </div>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>
    <div class="auth-field">
        <label asp-for="Input.Password" class="form-label">Şifre</label>
        <div class="auth-field-control">
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
            <svg class="auth-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
        </div>
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="form-check">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label asp-for="Input.RememberMe" class="form-check-label small">
                @Html.DisplayNameFor(m => m.Input.RememberMe)
            </label>
        </div>
        <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none">Şifremi unuttum</a>
    </div>

    <button id="login-submit" type="submit" class="btn btn-auth-primary">Giriş Yap</button>
</form>

<div class="auth-divider">ya da</div>

<a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-auth-secondary">Hesap Oluştur</a>

@{
    if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <div class="auth-divider">veya</div>
        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            @foreach (var provider in Model.ExternalLogins!)
            {
                <button type="submit" class="btn btn-auth-secondary mb-2" name="provider" value="@provider.Name" title="@provider.DisplayName ile giriş yap">@provider.DisplayName ile Giriş Yap</button>
            }
        </form>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
