            <a class="rbtn" style="text-align:center;text-decoration:none;" href="@Url.Action("Receipt", "Restaurant", new { id = Model.SelectedReceiptId })" target="_blank">🖥 Fişi Ekrana Al</a>
            <button type="button" class="rbtn" id="copy-receipt-btn">📋 Fişi Kopyala</button>
            <button type="button" class="rbtn" onclick="window.print()">🖨 Yazdır</button>
            @if (!r.IsCancelled && User.IsInRole(SahinSoft.Domain.Constants.AppRoles.Administrator))
            {
                <form method="post" asp-action="CancelReceipt" id="cancel-receipt-form" style="display:contents;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="retailSaleId" value="@Model.SelectedReceiptId" />
                    <input type="hidden" name="returnTab" value="@Model.ActiveTab" />
                    <input type="hidden" name="date" value="@Model.ReportDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="zShiftId" value="@Model.SelectedZShiftId" />
                    <input type="hidden" name="reason" id="cancel-receipt-reason" />
                    <button type="button" class="rbtn" style="color:var(--rs-red);" onclick="submitCancelReceipt()">✕ Fişi İptal Et</button>
                </form>
            }
            <a href="@closeUrl" class="rbtn gold" style="text-align:center;text-decoration:none;">Kapat</a>
        </div>
    </div>
}
@if (Model.SelectedProduct is not null)
{
    var pr = Model.SelectedProduct;
    var closeProductUrl = Url.Action("Index", new { tab = Model.ActiveTab, period = Model.PeriodFilter, date = Model.ReportDate.ToString("yyyy-MM-dd") });
    var maxDayQty = pr.Last7DaysQuantity.Count > 0 ? Math.Max(pr.Last7DaysQuantity.Max(), 1) : 1;
    <div class="detail-overlay open no-print" id="product-detail-overlay"></div>
    <div class="detail-panel open no-print" id="product-detail-panel">
        <div class="detail-head">
            <div class="detail-head-row">
                <div>
                    <div class="detail-title">@pr.ProductName
                        @if (pr.Rank > 0)
                        {
                            <span class="detail-badge info">◔ En Çok Satan #@pr.Rank</span>
                        }
                    </div>
                    <div class="detail-sub">
                        <span>Kategori: @pr.CategoryName</span>
                        <span>Stok Kodu: @pr.StockCode</span>
                        @if (!string.IsNullOrWhiteSpace(pr.Barcode))
                        {
                            <span>Barkod: @pr.Barcode</span>
                        }
                    </div>
                </div>
                <a href="@closeProductUrl" class="detail-close">✕</a>
            </div>
            <div class="detail-tabs">
                <button type="button" class="detail-tab active" data-pane="genel">Genel Bilgi</button>
                <button type="button" class="detail-tab" data-pane="grafik">Satış Grafiği</button>
                <button type="button" class="detail-tab" data-pane="hareketler">Satış Hareketleri (@pr.PeriodSales.Count)</button>
            </div>
        </div>
        <div class="detail-body">
            <div class="detail-pane active" data-pane="genel">
                <div class="report-kpis-compact" style="grid-template-columns:repeat(4,1fr);">
                    <div class="rcard rkpi-compact"><span class="ico" style="background:#EAF3FF;color:#2563EB;">🛒</span><div><small>TOPLAM SATIŞ ADEDİ</small><strong>@pr.PeriodQuantity.ToString("N0")</strong></div></div>
                    <div class="rcard rkpi-compact"><span class="ico" style="background:#F1EEFF;color:#6D5AE0;">₺</span><div><small>TOPLAM CİRO</small><strong>@pr.PeriodRevenue.ToString("N2") ₺</strong></div></div>
                    <div class="rcard rkpi-compact"><span class="ico" style="background:#FFF3E0;color:#C77700;">🏷</span><div><small>ORTALAMA FİYAT</small><strong>@(pr.PeriodQuantity > 0 ? (pr.PeriodRevenue / pr.PeriodQuantity).ToString("N2") : "0,00") ₺</strong></div></div>
                    <div class="rcard rkpi-compact"><span class="ico" style="background:#E8F6EE;color:#1F9D55;">%</span><div><small>CİRO PAYI</small><strong>%@pr.PeriodSharePercent.ToString("0.0")</strong></div></div>
                </div>
                <div class="detail-cols" style="margin-top:14px;grid-template-columns:1fr;">
                    <div class="detail-info-list">
                        <div class="detail-info-row"><span class="ico" style="background:#EAF3FF;color:#2563EB;">🏷</span><div><small>BİRİM FİYAT</small><strong>@pr.SalePrice.ToString("N2") ₺</strong></div></div>
                        <div class="detail-info-row"><span class="ico" style="background:#F1EEFF;color:#6D5AE0;">▦</span><div><small>KATEGORİ</small><strong>@pr.CategoryName</strong></div></div>
                        @if (!string.IsNullOrWhiteSpace(pr.Description))
                        {
                            <div class="detail-info-row"><span class="ico" style="background:#FFF3E0;color:#C77700;">📝</span><div><small>AÇIKLAMA</small><strong>@pr.Description</strong></div></div>
                        }
                    </div>
                </div>
                <h6 style="margin:14px 0 6px;font-size:12px;color:var(--rs-muted);">HIZLI İŞLEMLER</h6>
                <a class="rbtn" style="display:inline-block;text-decoration:none;text-align:center;" asp-controller="Products" asp-action="Edit" asp-route-id="@pr.ProductId" target="_blank">✎ Ürünü Düzenle</a>
            </div>
            <div class="detail-pane" data-pane="grafik">
                <h6 style="margin:0 0 8px;font-size:12px;color:var(--rs-muted);">Son 7 Güne Ait Satış Adedi</h6>
                @if (pr.Last7DaysQuantity.Sum() == 0)
                {
                    <div class="analytics-empty">Son 7 günde satış yok.</div>
                }
                else
                {
                    <div class="premium-chart">
                        @for (var i = 0; i < pr.Last7DaysQuantity.Count; i++)
                        {
                            var v = pr.Last7DaysQuantity[i];
                            var heightPct = Math.Max(2, (int)Math.Round(v / maxDayQty * 100));
                            <div class="pc-col @(v == pr.Last7DaysQuantity.Max() && v > 0 ? "hot" : "")">
                                <div class="pc-value">@(v > 0 ? v.ToString("N0") : "")</div>
                                <div class="pc-bar" style="height:@(heightPct)%"></div>
                                <div class="pc-label">@pr.Last7DaysLabels[i]</div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="detail-pane" data-pane="hareketler">
                <table class="detail-table">
                    <tr><th>TARİH/SAAT</th><th>FİŞ NO</th><th>ADET</th><th>TUTAR</th></tr>
                    @foreach (var s in pr.PeriodSales)
                    {
                        <tr><td>@s.IssuedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td>@s.DocumentNumber</td><td>@s.Quantity.ToString("0.##")</td><td>@s.LineTotal.ToString("N2") ₺</td></tr>
                    }
                </table>
            </div>
        </div>
        <div class="detail-foot">
            <a href="@closeProductUrl" class="rbtn gold" style="text-align:center;text-decoration:none;">Kapat</a>
        </div>
    </div>
}
