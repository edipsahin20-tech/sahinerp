@model List<SahinSoft.Domain.Entities.DocumentLog>
@{
    ViewData["Title"] = "Evrak Kayıt Günlüğü";
    var actionText = (Func<string, string>)ViewBag.ActionText;
    var entityText = (Func<string, string>)ViewBag.EntityText;
    var local = (Func<DateTime, string>)ViewBag.Local;
    int total = ViewBag.Total, pageNo = ViewBag.Page, size = ViewBag.Size;
    var pages = (int)Math.Ceiling(total / (double)size);
}
<div class="erp-list-panel">
    <div class="erp-list-header"><h2><i class="fa-solid fa-clock-rotate-left"></i> Evrak Kayıt Günlüğü</h2><span class="text-white-50" style="font-size:.8rem;">Kim, hangi evrakı, ne zaman girdi / değiştirdi / onayladı / iptal etti / sildi</span></div>
    <div class="erp-list-body">
        <form method="get" class="erp-filter-bar">
            <div class="erp-field"><label>Evrak türü</label>
                <select name="entity" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var e in new[] { "Invoice", "PaymentReceipt", "DispatchNote", "BusinessOrder", "Expense", "Quote" })
                    {
                        <option value="@e" selected="@((string?)ViewBag.Entity == e)">@entityText(e)</option>
                    }
                </select></div>
            <div class="erp-field"><label>Belge no (150* gibi)</label><input name="q" value="@ViewBag.Q" class="form-control" /></div>
            <div class="erp-field"><label>Kullanıcı</label><input name="user" value="@ViewBag.User" class="form-control" /></div>
            <div class="erp-field"><label>İlk tarih</label><input type="date" name="from" value="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
            <div class="erp-field"><label>Son tarih</label><input type="date" name="to" value="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
            <button class="btn btn-erp-primary">Filtrele</button>
        </form>
        <span class="text-secondary d-block mb-2">Toplam <strong>@total</strong> kayıt</span>
        <div class="erp-table-wrap">
            <table class="erp-table" data-sortable>
                <thead><tr><th data-sort="text">Tarih / Saat</th><th data-sort="text">Evrak</th><th data-sort="text">Belge No</th><th data-sort="text">İşlem</th><th data-sort="text">Kullanıcı</th><th>Not</th><th>IP</th></tr></thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr><td>@local(r.CreatedAtUtc)</td><td>@entityText(r.EntityName)</td><td><span class="erp-code-badge">@r.DocumentNumber</span></td>
                        <td style="@(r.Action is "Deleted" or "Cancelled" ? "color:#c62828;font-weight:700;" : "")">@actionText(r.Action)</td><td>@r.UserName</td><td>@r.Details</td><td>@r.IpAddress</td></tr>
                }
                @if (Model.Count == 0) { <tr data-live-search-empty><td colspan="7" class="text-center text-secondary py-4">Kayıt yok.</td></tr> }
                </tbody>
            </table>
        </div>
        @if (pages > 1)
        {
            <div class="d-flex gap-2 mt-2">
                @if (pageNo > 1) { <a class="btn btn-erp-outline" asp-route-page="@(pageNo - 1)" asp-route-entity="@ViewBag.Entity" asp-route-q="@ViewBag.Q" asp-route-user="@ViewBag.User">‹ Önceki</a> }
                <span class="align-self-center">Sayfa @pageNo / @pages</span>
                @if (pageNo < pages) { <a class="btn btn-erp-outline" asp-route-page="@(pageNo + 1)" asp-route-entity="@ViewBag.Entity" asp-route-q="@ViewBag.Q" asp-route-user="@ViewBag.User">Sonraki ›</a> }
            </div>
        }
    </div>
</div>
