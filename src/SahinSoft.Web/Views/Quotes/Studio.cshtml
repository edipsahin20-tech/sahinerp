@model SahinSoft.Web.Models.QuoteStudioViewModel
@{
    ViewData["Title"] = "Teklif Stüdyosu";
}

@section Head {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/pdf-document.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/quote-studio.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3 no-print">
    <div>
        <h1 class="h3 mb-1">Teklif Stüdyosu</h1>
        <p class="text-secondary mb-0">Ürün kataloğu ve carilerden seçerek profesyonel PDF teklif oluşturun.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-erp-outline btn-sm" onclick="openStockModal()">Stok & Kategoriler</button>
        <a class="btn btn-erp-outline btn-sm" asp-controller="Quotes" asp-action="Index">Teklif Listesi</a>
        <button type="button" class="btn btn-erp-primary btn-sm" onclick="resetFormWithNewNo()">+ Yeni Teklif</button>
    </div>
</div>

<div class="quote-studio-page admin-theme light-theme">

  <section class="metrics-bar">
    <div class="container-fluid grid-metrics">
      <div class="metric-card">
        <div class="m-icon gold"><i class="fa-solid fa-file-signature"></i></div>
        <div class="m-data">
          <span class="m-label">Toplam Oluşturulan Teklif</span>
          <h3 class="m-val" id="metric-total-proposals">0</h3>
        </div>
      </div>

      <div class="metric-card">
        <div class="m-icon green"><i class="fa-solid fa-turkish-lira-sign"></i></div>
        <div class="m-data">
          <span class="m-label">Toplam Teklif Hacmi</span>
          <h3 class="m-val" id="metric-total-volume">0 ₺</h3>
        </div>
      </div>

      <div class="metric-card">
        <div class="m-icon blue"><i class="fa-solid fa-check-double"></i></div>
        <div class="m-data">
          <span class="m-label">Onaylanan Teklifler</span>
          <h3 class="m-val" id="metric-approved-count">0</h3>
        </div>
      </div>
    </div>
  </section>

  <main class="workspace">
    <div class="container-fluid workspace-grid">

      <section class="form-panel">
        <div class="panel-header">
          <h2><i class="fa-solid fa-sliders"></i> Teklif Detayları ve Ürün Seçimi</h2>
          <span class="badge-tag">ŞahinSoft</span>
        </div>

        <form id="quote-form" onsubmit="event.preventDefault();">

          <div class="card-section">
            <h3 class="card-title"><i class="fa-solid fa-building-user"></i> Müşteri & Firma Bilgileri</h3>

            <div class="form-row grid-3">
              <div class="form-group">
                <label for="cust-company">Firma Unvanı / Adı *</label>
                <input type="text" id="cust-company" class="form-control" placeholder="Örn: ABC Lojistik A.Ş. (F9 ile cari ara)" required oninput="updatePdfPreview()" list="cust-company-list" onkeydown="handleCustomerFieldKeydown(event, this, 'cust-contact')">
                <datalist id="cust-company-list"></datalist>
              </div>
              <div class="form-group">
                <label for="cust-contact">İlgili / Yetkili Kişi *</label>
                <input type="text" id="cust-contact" class="form-control" placeholder="Örn: Ahmet Yılmaz" required oninput="updatePdfPreview()" onkeydown="focusNextOnEnter(event, 'cust-phone')">
              </div>
              <div class="form-group">
                <label for="cust-phone">Telefon</label>
                <input type="text" id="cust-phone" class="form-control" placeholder="Örn: 0532 000 00 00" oninput="updatePdfPreview()" onkeydown="focusNextOnEnter(event, 'cust-email')">
              </div>
            </div>

            <div class="form-row grid-3">
              <div class="form-group">
                <label for="cust-email">E-posta Adresi</label>
                <input type="email" id="cust-email" class="form-control" placeholder="ahmet@abclojistik.com" oninput="updatePdfPreview()" onkeydown="focusNextOnEnter(event, 'cust-tax-office')">
              </div>
              <div class="form-group">
                <label for="cust-tax-office">Vergi Dairesi & No</label>
                <input type="text" id="cust-tax-office" class="form-control" placeholder="Örn: Kadıköy V.D. 1234567890" oninput="updatePdfPreview()" onkeydown="focusNextOnEnter(event, 'cust-address')">
              </div>
              <div class="form-group">
                <label for="cust-address">Adres / Şehir</label>
                <input type="text" id="cust-address" class="form-control" placeholder="Örn: Ataşehir, İstanbul" oninput="updatePdfPreview()" onkeydown="focusNextOnEnter(event, 'quote-date')">
              </div>
            </div>

            <div class="form-row grid-4">
              <div class="form-group">
                <label for="quote-no">Teklif No</label>
                <input type="text" id="quote-no" class="form-control gold-text-input" readonly>
              </div>
              <div class="form-group">
                <label for="quote-date">Teklif Tarihi</label>
                <input type="date" id="quote-date" class="form-control" onchange="updatePdfPreview()" onkeydown="focusNextOnEnter(event, 'quote-validity')">
              </div>
              <div class="form-group">
                <label for="quote-validity">Geçerlilik Süresi</label>
                <select id="quote-validity" class="form-control" onchange="updatePdfPreview()" onkeydown="focusNextOnEnter(event, 'quote-currency')">
                  <option value="7 Gün">7 Gün</option>
                  <option value="15 Gün" selected>15 Gün</option>
                  <option value="30 Gün">30 Gün</option>
                  <option value="60 Gün">60 Gün</option>
                </select>
              </div>
              <div class="form-group">
                <label for="quote-currency">Para Birimi</label>
                <select id="quote-currency" class="form-control" onchange="handleCurrencyChange()" onkeydown="focusNextOnEnter(event, 'picker-product-search')">
                  <option value="TRY" selected>TRY (₺ Türk Lirası)</option>
                  <option value="USD">USD ($ ABD Doları)</option>
                  <option value="EUR">EUR (€ Euro)</option>
                </select>
              </div>
            </div>
          </div>

          <div class="card-section">
            <div class="card-title-between">
              <h3 class="card-title"><i class="fa-solid fa-cart-plus"></i> Stok Kataloğundan Ekle</h3>
              <button type="button" class="btn btn-sm btn-outline-gold" onclick="openStockModal()">
                <i class="fa-solid fa-boxes-packing"></i> Tüm Stok Listesi
              </button>
            </div>

            <div class="add-item-box">
              <div class="form-row">
                <div class="form-group">
                  <label for="picker-category">Kategori Seçin</label>
                  <select id="picker-category" class="form-control" onchange="filterProductDropdown()" onkeydown="focusNextOnEnter(event, 'picker-product-search')">
                    <option value="ALL">Tüm Kategoriler</option>
                  </select>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group" style="position: relative;">
                  <label for="picker-product-search">Ürün / Stok Ara * <span class="text-muted" style="font-weight: 400;">(yazınca anında benzer kayıtlar listelenir; F9 tüm eşleşmeleri büyük bir pencerede getirir)</span></label>
                  <div class="input-group">
                      <input type="text" id="picker-product-search" class="form-control" autocomplete="off" placeholder="Ürün adı, kodu veya barkod yazın..."
                             oninput="runProductSearch(this.value)" onkeydown="handleProductSearchKeydown(event, this)">
                      <button type="button" id="picker-product-lookup-trigger" class="btn btn-outline-gold"
                              onclick="openQuickSearchModal('product', document.getElementById('picker-product-search').value)"
                              title="Tüm ürünlerde ara (F9)">
                          F9
                      </button>
                  </div>
                  <input type="hidden" id="picker-product-value">
                  <div id="picker-product-results" class="product-search-results"></div>
                </div>
              </div>

              <div class="form-row grid-5 item-inputs">
                <div class="form-group">
                  <label for="item-qty">Miktar</label>
                  <input type="number" id="item-qty" class="form-control" value="1" min="1" step="1" onkeydown="focusNextOnEnter(event, 'item-unit')">
                </div>
                <div class="form-group">
                  <label for="item-unit">Birim</label>
                  <select id="item-unit" class="form-control" onkeydown="focusNextOnEnter(event, 'item-price')">
                    <option value="Adet">Adet</option>
                    <option value="Paket">Paket</option>
                    <option value="Lisans">Lisans</option>
                    <option value="Set">Set</option>
                    <option value="Saat">Saat</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="item-price">Birim Fiyat (<span class="curr-symbol">₺</span>)</label>
                  <input type="number" id="item-price" class="form-control" placeholder="0.00" step="0.01" onkeydown="focusNextOnEnter(event, 'item-kdv')">
                </div>
                <div class="form-group">
                  <label for="item-kdv">KDV %</label>
                  <select id="item-kdv" class="form-control" onkeydown="focusNextOnEnter(event, 'item-discount')">
                    <option value="20" selected>%20</option>
                    <option value="10">%10</option>
                    <option value="1">%1</option>
                    <option value="0">%0 (KDV Muaf)</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="item-discount">İskonto %</label>
                  <input type="number" id="item-discount" class="form-control" value="0" min="0" max="100" onkeydown="handleDiscountKeydown(event)">
                </div>
              </div>

              <div class="item-actions">
                <button type="button" class="btn btn-gold" onclick="addItemToQuote()">
                  <i class="fa-solid fa-plus-circle"></i> Teklife Ekle
                </button>
                <button type="button" class="btn btn-outline" onclick="addCustomLineItem()">
                  <i class="fa-solid fa-pen-to-square"></i> Özel Hizmet / Kalem Ekle
                </button>
              </div>
            </div>
          </div>

          <div class="card-section">
            <h3 class="card-title"><i class="fa-solid fa-list-check"></i> Teklif Kalemleri (<span id="items-count-badge">0</span>)</h3>

            <div class="table-responsive">
              <table class="table admin-table" id="quote-items-table">
                <thead>
                  <tr>
                    <th style="width: 40px;">#</th>
                    <th>Ürün Kodu & Adı / Açıklama</th>
                    <th style="width: 70px;">Birim</th>
                    <th style="width: 70px;">Miktar</th>
                    <th style="width: 110px;">Birim Fiyat</th>
                    <th style="width: 75px;">KDV</th>
                    <th style="width: 75px;">İsk. %</th>
                    <th style="width: 120px;">Net Toplam</th>
                    <th style="width: 60px;">İşlem</th>
                  </tr>
                </thead>
                <tbody id="quote-items-body"></tbody>
              </table>
            </div>

            <div class="totals-summary-box">
              <div class="summary-left">
                <label for="quote-note">Teklife Özel Not / Açıklama</label>
                <textarea id="quote-note" class="form-control" rows="3" placeholder="Örn: Teklifimiz dahilindeki ürünler 2 yıl Şahin Bilişim garantisi altındadır. Kurulum ve e-Fatura entegrasyonu dahildir." oninput="updatePdfPreview()"></textarea>
              </div>
              <div class="summary-right">
                <div class="calc-line">
                  <span>Brüt Ara Toplam:</span>
                  <strong id="calc-subtotal">0.00 ₺</strong>
                </div>
                <div class="calc-line text-red" id="calc-discount-row" style="display: none;">
                  <span>Toplam İskonto Tutarı:</span>
                  <strong id="calc-discount-total">-0.00 ₺</strong>
                </div>
                <div class="calc-line">
                  <span>Toplam KDV Tutarı:</span>
                  <strong id="calc-kdv">0.00 ₺</strong>
                </div>
                <div class="calc-line grand-total">
                  <span>GENEL TOPLAM:</span>
                  <strong id="calc-grand-total">0.00 ₺</strong>
                </div>
              </div>
            </div>
          </div>

          <div class="card-section">
            <h3 class="card-title"><i class="fa-solid fa-file-contract"></i> Ödeme Koşulları</h3>

            <div class="form-row grid-2">
              <div class="form-group">
                <label for="terms-payment">Ödeme Şekli</label>
                <select id="terms-payment" class="form-control" onchange="updatePdfPreview()">
                  <option value="%50 Peşin, %50 Teslimatta Bakiyesi">%50 Peşin, %50 Teslimatta Bakiyesi</option>
                  <option value="Peşin Havale / EFT (%5 İskontolu)">Peşin Havale / EFT (%5 İskontolu)</option>
                  <option value="Kredi Kartı 6 Taksit">Kredi Kartı 6 Taksit</option>
                  <option value="Vadeli Çek (30 Gün)">Vadeli Çek (30 Gün)</option>
                </select>
              </div>

              <div class="form-group">
                <label for="terms-delivery">Teslimat & Kurulum</label>
                <select id="terms-delivery" class="form-control" onchange="updatePdfPreview()">
                  <option value="Stoktan Hemen Teslim & Ücretsiz Kurulum">Stoktan Hemen Teslim & Ücretsiz Kurulum</option>
                  <option value="3-5 İş Günü İçerisinde Teslimat">3-5 İş Günü İçerisinde Teslimat</option>
                  <option value="Kargo / Lojistik ile Adrese Teslim">Kargo / Lojistik ile Adrese Teslim</option>
                </select>
              </div>
            </div>
          </div>

          <div class="form-action-bar">
            <button type="button" class="btn btn-lg btn-gold-pulse" onclick="saveQuote()">
              <i class="fa-solid fa-floppy-disk"></i> Kaydet
            </button>
            <button type="button" class="btn btn-lg btn-secondary" onclick="resetFormWithNewNo()">
              <i class="fa-solid fa-file-circle-plus"></i> Yeni
            </button>
            <button type="button" class="btn btn-lg btn-outline" onclick="deleteQuote()" style="color: var(--accent-red, #b91c1c); border-color: var(--accent-red, #b91c1c);">
              <i class="fa-solid fa-trash-can"></i> Sil
            </button>
            <button type="button" class="btn btn-lg btn-outline" onclick="printQuote()">
              <i class="fa-solid fa-print"></i> Yazdır
            </button>
            <button type="button" class="btn btn-lg btn-outline" onclick="exportQuotePdf()">
              <i class="fa-solid fa-file-pdf"></i> PDF'ye Dönüştür
            </button>
          </div>

        </form>
      </section>

      <section class="preview-panel pdf-export-scope">
        <div class="panel-header">
          <h2><i class="fa-solid fa-eye"></i> Canlı A4 PDF Belge Önizlemesi</h2>
          <span class="pdf-indicator"><i class="fa-solid fa-file-circle-check"></i> ŞahinSoft Formatı</span>
        </div>

        <div class="pdf-wrapper">
          <div id="pdf-template" class="pdf-document">

            <div class="pdf-watermark">ŞAHİNSOFT</div>

            <div class="pdf-header">
              <div class="pdf-brand">
                <div class="pdf-logo-box">
                  <img src="~/images/logo-icon.png" alt="ŞahinSoft Logo" class="pdf-logo-img">
                </div>
                <div class="pdf-brand-sub">
                  <strong>@Model.CompanyName</strong><br>
                  @{
                    var webEmailParts = new List<string>();
                    if (!string.IsNullOrWhiteSpace(Model.Website)) { webEmailParts.Add($"Web: {Model.Website}"); }
                    if (!string.IsNullOrWhiteSpace(Model.Email)) { webEmailParts.Add($"E-posta: {Model.Email}"); }
                  }
                  @if (webEmailParts.Count > 0)
                  {
                    <span>@string.Join(" | ", webEmailParts)</span>
                    <br>
                  }
                  @if (!string.IsNullOrWhiteSpace(Model.Phone))
                  {
                    <span>Tel: @Model.Phone</span>
                  }
                </div>
              </div>
              <div class="pdf-doc-title-box">
                <h2 class="pdf-doc-title">FİYAT TEKLİFİ</h2>
                <div class="pdf-meta-pill">
                  <span>Teklif No:</span> <strong id="pdf-val-no">TEK-2026-0842</strong>
                </div>
                <div class="pdf-meta-pill">
                  <span>Tarih:</span> <strong id="pdf-val-date">28.07.2026</strong>
                </div>
                <div class="pdf-meta-pill">
                  <span>Geçerlilik:</span> <strong id="pdf-val-validity">15 Gün</strong>
                </div>
              </div>
            </div>

            <hr class="pdf-divider">

            <div class="pdf-info-grid">
              <div class="pdf-info-block customer">
                <div class="block-head"><i class="fa-solid fa-building"></i> TEKLİF SUNULAN MÜŞTERİ</div>
                <div class="block-body">
                  <h4 id="pdf-val-company">ABC Lojistik ve Ticaret A.Ş.</h4>
                  <p><strong>Yetkili:</strong> <span id="pdf-val-contact">Ahmet Yılmaz</span></p>
                  <p><strong>E-posta:</strong> <span id="pdf-val-email">ahmet@abclojistik.com</span></p>
                  <p><strong>Telefon:</strong> <span id="pdf-val-phone">0532 000 00 00</span></p>
                  <p><strong>Vergi Dairesi/No:</strong> <span id="pdf-val-tax">Kadıköy V.D. 1234567890</span></p>
                  <p><strong>Adres:</strong> <span id="pdf-val-address">Ataşehir, İstanbul</span></p>
                  <p><strong>Para Birimi:</strong> <span id="pdf-val-currency">TRY (₺ Türk Lirası)</span></p>
                </div>
              </div>
            </div>

            <div class="pdf-table-wrapper">
              <table class="pdf-table">
                <thead>
                  <tr>
                    <th style="width: 30px;">#</th>
                    <th style="width: 90px;">Ürün Kodu</th>
                    <th>Ürün & Hizmet Açıklaması</th>
                    <th style="width: 50px;">Birim</th>
                    <th style="width: 45px;">Mkt</th>
                    <th style="width: 90px; text-align: right;">B. Fiyat</th>
                    <th style="width: 45px; text-align: center;">KDV</th>
                    <th style="width: 45px; text-align: center;">İsk.</th>
                    <th style="width: 100px; text-align: right;">Toplam Tutar</th>
                  </tr>
                </thead>
                <tbody id="pdf-items-body"></tbody>
              </table>
            </div>

            <div class="pdf-bottom-grid">

              <div class="pdf-terms-box">
                <div class="terms-title"><i class="fa-solid fa-clipboard-check"></i> TEKLİF KOŞULLARI VE ŞARTLARI</div>
                <ul class="terms-list">
                  <li><strong>Ödeme Koşulu:</strong> <span id="pdf-val-payment">%50 Peşin, %50 Teslimatta Bakiyesi</span></li>
                  <li><strong>Teslimat Süresi:</strong> <span id="pdf-val-delivery">Stoktan Hemen Teslim & Ücretsiz Kurulum</span></li>
                  <li><strong>Garanti:</strong> Tüm donanımlar 24 ay Şahin Bilişim distribütör garantilidir.</li>
                  @if (!string.IsNullOrWhiteSpace(Model.Iban))
                  {
                    <li><strong>Banka Hesabı:</strong> @(string.IsNullOrWhiteSpace(Model.BankName) ? Model.Iban : $"{Model.BankName} - {Model.Iban}")</li>
                  }
                </ul>

                <div class="pdf-note-box" id="pdf-note-container">
                  <strong>Not:</strong> <span id="pdf-val-note">Kurulum ve e-Fatura entegrasyonu dahildir.</span>
                </div>
              </div>

              <div class="pdf-totals-box">
                <div class="pdf-total-row">
                  <span>Ara Toplam:</span>
                  <strong id="pdf-val-subtotal">0.00 ₺</strong>
                </div>
                <div class="pdf-total-row discount" id="pdf-discount-row" style="display: none;">
                  <span>İskonto Tutarı:</span>
                  <strong id="pdf-val-discount">-0.00 ₺</strong>
                </div>
                <div class="pdf-total-row">
                  <span>KDV Tutarı (%20):</span>
                  <strong id="pdf-val-kdv">0.00 ₺</strong>
                </div>
                <div class="pdf-total-row grand">
                  <span>GENEL TOPLAM:</span>
                  <strong id="pdf-val-grand">0.00 ₺</strong>
                </div>
              </div>
            </div>

            <div class="pdf-footer-signatures">
              <div class="sig-box">
                <span class="sig-title">TEKLİF HAZIRLAYAN</span>
                <span class="sig-company">@Model.CompanyName</span>
                <div class="sig-space">
                  <span class="stamp-badge"><i class="fa-solid fa-stamp"></i> ONAYLI</span>
                </div>
                <span class="sig-name">Satış & Proje Departmanı</span>
              </div>

              <div class="sig-box">
                <span class="sig-title">MÜŞTERİ ONAY / İMZA</span>
                <span class="sig-company" id="pdf-sig-customer-name">ABC Lojistik ve Ticaret A.Ş.</span>
                <div class="sig-space">
                  <span class="sig-placeholder">Kaşe / İmza / Tarih</span>
                </div>
                <span class="sig-name">Yetkili İmzası</span>
              </div>
            </div>

            <div class="pdf-page-footer">
              <span>@Model.CompanyName — Teklif Sistemi</span>
              <span>Sayfa 1 / 1</span>
            </div>

          </div>
        </div>
      </section>

    </div>
  </main>

  <div id="stock-modal" class="modal-overlay">
    <div class="modal-content modal-lg">
      <div class="modal-header">
        <h3><i class="fa-solid fa-boxes-stacked"></i> Stok ve Kategori Yönetimi</h3>
        <button class="close-btn" onclick="closeStockModal()">&times;</button>
      </div>
      <div class="modal-body">

        <div class="modal-top-actions">
          <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="stock-search-input" class="form-control" placeholder="Stok adı, kodu veya kategori ara..." oninput="renderStockManagementTable()">
          </div>
          <span class="history-info-text">Ürünler ŞahinSoft stok kartlarından canlı olarak çekilir. Ekleme/düzenleme için <a asp-controller="Products" asp-action="Index" target="_blank">Stok Kartları</a> ekranını kullanın.</span>
        </div>

        <div class="table-responsive modal-table-wrap">
          <table class="table admin-table">
            <thead>
              <tr>
                <th>Ürün Kodu</th>
                <th>Ürün Adı</th>
                <th>Kategori</th>
                <th>Birim Fiyat</th>
                <th>Stok Adedi</th>
                <th>Durum</th>
                <th>İşlem</th>
              </tr>
            </thead>
            <tbody id="stock-manage-body"></tbody>
          </table>
        </div>

      </div>
    </div>
  </div>

  <form id="studio-delete-form" method="post" asp-controller="Quotes" asp-action="Delete" class="d-none">
      <input type="hidden" name="id" id="studio-delete-id" />
  </form>

  <div id="quick-search-modal" class="modal-overlay">
    <div class="modal-content modal-md">
      <div class="modal-header">
        <h3 id="quick-search-title"><i class="fa-solid fa-magnifying-glass"></i> Ara (F9)</h3>
        <button class="close-btn" onclick="closeQuickSearchModal()">&times;</button>
      </div>
      <div class="modal-body">
        <div class="modal-top-actions">
          <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="quick-search-input" class="form-control" placeholder="Yazmaya başlayın..." autocomplete="off"
                   oninput="runQuickSearch(this.value)" onkeydown="handleQuickSearchKeydown(event)">
          </div>
        </div>

        <div class="table-responsive modal-table-wrap quick-search-table-wrap">
          <table class="table admin-table quick-search-table">
            <thead id="quick-search-thead"></thead>
            <tbody id="quick-search-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="~/js/pdf-export.js" asp-append-version="true"></script>
    <script src="~/js/quote-studio.js" asp-append-version="true"></script>
}
