@model SahinSoft.Web.Models.RestaurantTerminalSettingsViewModel
@using SahinSoft.Domain.Enums
@{
    Layout = "_RestaurantShellLayout";
    ViewData["Title"] = "Terminal ve Kasa Ayarları";
}
<div class="ts-body">
    <h1 class="ts-title">Terminal ve Kasa Ayarları</h1>
    <p class="ts-sub">Bu terminalin şubesini ve ödeme hesaplarını düzenleyin.</p>

        @if (Model.Branches.Count == 0)
        {
            <div class="ts-card"><div class="ts-empty">Henüz şube tanımlı değil.</div></div>
        }

        <div class="ts-tabs" role="tablist">
            <button type="button" class="ts-tab active" data-tab="terminal"><i class="fa-regular fa-building"></i> Terminal ve Şube</button>
            <button type="button" class="ts-tab" data-tab="kasa"><i class="fa-solid fa-cash-register"></i> Kasa Tanımları</button>
            <button type="button" class="ts-tab" data-tab="hesaplar"><i class="fa-regular fa-credit-card"></i> Hesaplar</button>
            <button type="button" class="ts-tab" data-tab="yazarkasa"><i class="fa-solid fa-print"></i> Yazar Kasa</button>
        </div>

        <div class="ts-tab-panel active" data-tab-panel="terminal">
        <div class="ts-cols">
        <div class="ts-col">
        <div class="ts-card">
            <h2><span class="ts-ico"><i class="fa-regular fa-building"></i></span> Bu terminalin çalışma ayarları</h2>
            <p class="ts-card-sub">Seçim bu tarayıcı için kaydedilir. Üst çubukta bu seçim görünür.</p>
            <form method="post" asp-action="SetTerminal" id="terminal-form">
                @Html.AntiForgeryToken()
                <div class="ts-grid2">
                    <div class="ts-field">
                        <label>Terminal şubesi</label>
                        <select name="branchId" id="term-branch" required>
                            <option value="">— Şube seçin —</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id" selected="@(Model.TerminalBranchId == b.Id)">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="ts-field">
                        <label>Çalışan kasa</label>
                        <select name="registerId" id="term-register">
                            <option value="">— Kasa seçilmedi —</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="ts-btn gold"><i class="fa-regular fa-floppy-disk"></i> Terminali Kaydet</button>
            </form>
        </div>

        <div class="ts-card ts-info" id="branch-info-card">
            <h2><span class="ts-ico round"><i class="fa-solid fa-circle-info"></i></span> Seçili şube</h2>
            @for (var i = 0; i < Model.Branches.Count; i++)
            {
                var b = Model.Branches[i];
                <form method="post" asp-action="SaveBranch" class="ts-branch-panel" data-branch-panel="@b.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@b.Id" />
                    <div class="ts-branch-name"><span class="ts-code">@b.Code</span> <span>@b.Name</span></div>
                    <div class="ts-grid2">
                        <div class="ts-field"><label><i class="fa-solid fa-location-dot"></i> Şube Adı</label><input name="name" value="@b.Name" required /></div>
                        <div class="ts-field"><label><i class="fa-solid fa-phone"></i> Telefon</label><input name="phone" value="@b.Phone" placeholder="Telefon tanımlanmamış" /></div>
                    </div>
                    <div class="ts-field"><label><i class="fa-solid fa-location-dot"></i> Adres</label><input name="address" value="@b.Address" placeholder="Şube adresi tanımlanmamış" /></div>
                    <button type="submit" class="ts-btn outline">Şube Bilgilerini Kaydet</button>
                </form>
            }
        </div>
        </div>

        <div class="ts-col">
        <div class="ts-card" id="map-card">
            <div class="ts-card-head">
                <h2><span class="ts-ico"><i class="fa-solid fa-cash-register"></i></span> <span id="map-title">Hesap eşleştirmeleri</span></h2>
                <span class="ts-badge ok" id="map-active">Aktif</span>
            </div>
            <div id="map-rows"></div>
            <button type="button" class="ts-btn outline wide" id="map-edit-btn"><i class="fa-solid fa-pen"></i> Kasayı Düzenle</button>
        </div>

        <div class="ts-card">
            <div class="ts-card-head">
                <h2><span class="ts-ico"><i class="fa-solid fa-print"></i></span> Yazar kasa bağlantısı</h2>
                <span class="ts-badge @(Model.FiscalDeviceType == FiscalDeviceType.None ? "off" : "ok")">@(Model.FiscalDeviceType == FiscalDeviceType.None ? "Kapalı" : "Açık")</span>
            </div>
            <div class="ts-field ts-inline"><label>Cihaz</label><input readonly value="@(Model.FiscalDeviceType == FiscalDeviceType.None ? "Tanımlı değil" : "İnpos M530")" /></div>
            <button type="button" class="ts-btn outline wide" data-goto-tab="yazarkasa"><i class="fa-solid fa-gear"></i> Yazar Kasa Ayarları</button>
        </div>
        </div>
        </div>

        <div class="ts-card">
            <h2><span class="ts-ico"><i class="fa-solid fa-cash-register"></i></span> Kayıtlı kasalar</h2>
            <div class="ts-empty ts-hidden" id="reg-empty-note-2">Bu şubede henüz kasa tanımı yok.</div>
            @foreach (var r in Model.CashRegisters)
            {
                <div class="ts-reg-line reg-row" data-register-branch="@r.BranchId"
                     data-reg-id="@r.Id" data-reg-branch="@r.BranchId" data-reg-name="@r.Name"
                     data-reg-cash="@r.CashFinancialAccountId" data-reg-credit="@r.CreditCardFinancialAccountId"
                     data-reg-meal="@r.MealCardFinancialAccountId">
                    <span class="ts-reg-ico"><i class="fa-solid fa-cash-register"></i></span>
                    <b class="ts-reg-name">@r.Name</b>
                    <span class="ts-reg-branch">@r.Branch.Name</span>
                    <span class="ts-badge @(r.IsActive ? "ok" : "off")">@(r.IsActive ? "Aktif" : "Pasif")</span>
                    <span class="ts-reg-actions">
                        <button type="button" class="ts-btn soft reg-edit-btn"><i class="fa-solid fa-pen"></i> Düzenle</button>
                        <form method="post" asp-action="DeactivateCashRegister" onsubmit="return confirm('Bu kasa pasif yapılsın mı?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="ts-btn danger"><i class="fa-solid fa-pause"></i> Pasif Yap</button>
                        </form>
                    </span>
                </div>
            }
            <div class="ts-reg-new"><button type="button" class="ts-btn gold" id="reg-new-btn"><i class="fa-solid fa-plus"></i> Yeni Kasa</button></div>
        </div>

        </div>

        <div class="ts-tab-panel" data-tab-panel="kasa">
        <!-- 3 · Kasa tanımı -->
        <div class="ts-card">
            <h2><span class="ts-ico"><i class="fa-solid fa-cash-register"></i></span> Kasa Tanımları</h2>
            <p class="ts-card-sub">Kasanın adını yazın. Şube, yukarıda seçili şubedir; kasa ve hesap seçenekleri yalnızca o şubenin hesaplarıdır (ortak hesaplar her şubede görünür).</p>
            <div class="ts-register-row ts-register-head" id="reg-list-head">
                <span>Kasa</span><span>Şube</span><span>Nakit Hesabı</span><span>Kredi Kartı Hesabı</span><span></span>
            </div>
            @foreach (var r in Model.CashRegisters)
            {
                <div class="ts-register-row reg-row" data-register-branch="@r.BranchId"
                     data-reg-id="@r.Id" data-reg-branch="@r.BranchId" data-reg-name="@r.Name"
                     data-reg-cash="@r.CashFinancialAccountId" data-reg-credit="@r.CreditCardFinancialAccountId"
                     data-reg-meal="@r.MealCardFinancialAccountId">
                    <span>@r.Name</span>
                    <span>@r.Branch.Name</span>
                    <span>@r.CashFinancialAccount.Name</span>
                    <span>@r.CreditCardFinancialAccount.Name</span>
                    <span style="display:flex;gap:6px;">
                        <button type="button" class="ts-btn outline reg-edit-btn" style="padding:6px 10px;">Düzenle</button>
                        <form method="post" asp-action="DeactivateCashRegister" onsubmit="return confirm('Bu kasa pasif yapılsın mı?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="ts-btn danger" style="padding:6px 10px;">Pasif Yap</button>
                        </form>
                        <form method="post" asp-action="DeleteCashRegister" onsubmit="return confirm('Bu kasa KALICI OLARAK silinsin mi? Bu işlem geri alınamaz.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="ts-btn danger" style="padding:6px 10px;">Sil</button>
                        </form>
                    </span>
                </div>
            }
            <div class="ts-empty ts-hidden" id="reg-empty-note">Bu şubede henüz kasa tanımı yok.</div>

            <h3 style="font-size:13px;margin:18px 0 10px;" id="reg-form-title">Yeni Kasa Ekle</h3>
            <form method="post" asp-action="SaveCashRegister" id="cash-register-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="reg-id-input" value="0" />
                <div class="ts-grid2">
                    <div class="ts-field">
                        <label>Kasa adı</label>
                        <input name="name" id="reg-name-input" placeholder="Örn: Kasa 1" required />
                    </div>
                    <div class="ts-field">
                        <label>Şube (seçili terminal şubesi)</label>
                        <input id="reg-branch-display" value="" readonly />
                        <input type="hidden" name="branchId" id="reg-branch-input" />
                    </div>
                </div>
                <div class="ts-grid3">
                    <div class="ts-field">
                        <label>Nakit hesabı</label>
                        <select name="cashFinancialAccountId" id="reg-cash-select" required></select>
                    </div>
                    <div class="ts-field">
                        <label>Kredi kartı hesabı</label>
                        <select name="creditCardFinancialAccountId" id="reg-credit-select" required></select>
                    </div>
                    <div class="ts-field">
                        <label>Yemek kartı hesabı (opsiyonel)</label>
                        <select name="mealCardFinancialAccountId" id="reg-meal-select"></select>
                    </div>
                </div>
                <button type="submit" class="ts-btn gold">Kasayı Kaydet</button>
                <button type="button" class="ts-btn outline" id="reg-cancel-edit-btn" style="display:none;">Vazgeç / Yeni Ekle</button>
            </form>
        </div>

        </div>

        <div class="ts-tab-panel" data-tab-panel="hesaplar">
        <!-- 4 · Seçili şubenin hesapları -->
        <div class="ts-card">
            <h2><span class="ts-ico"><i class="fa-regular fa-credit-card"></i></span> Kasa ve Banka Hesapları</h2>
            <p class="ts-card-sub">Seçili şubenin hesapları ve ortak hesaplar. Yeni hesap tanımı Ayarlar › Finans Hesapları ekranından yapılır.</p>
            <div id="account-list"></div>
        </div>

        </div>

        <div class="ts-tab-panel" data-tab-panel="yazarkasa">
        <!-- 5 · Yazar kasa -->
        <div class="ts-card">
            <h2><span class="ts-ico"><i class="fa-solid fa-print"></i></span> Yazar Kasa Ayarları</h2>
            <p class="ts-card-sub">Fiskal cihaz (yazar kasa) bağlantısı — kapalıyken satışlar cihaza hiç gönderilmez.</p>
            <form method="post" asp-action="SaveFiscal">
                @Html.AntiForgeryToken()
                <div class="ts-grid2">
                    <div class="ts-field">
                        <label>Cihaz</label>
                        <select name="fiscalDeviceType" id="fiscal-device-select">
                            @foreach (FiscalDeviceType t in Enum.GetValues<FiscalDeviceType>())
                            {
                                <option value="@t" selected="@(t == Model.FiscalDeviceType)">@(t == FiscalDeviceType.None ? "Yok" : "İnpos M530")</option>
                            }
                        </select>
                    </div>
                    <div class="ts-field">
                        <label>Yazar Kasa Ajan Adresi (URL)</label>
                        <input name="fiscalAgentUrl" id="fiscal-url-input" value="@Model.FiscalAgentUrl" placeholder="http://localhost:9200" @(Model.FiscalDeviceType == FiscalDeviceType.None ? "disabled" : "") />
                    </div>
                </div>
                <button type="submit" class="ts-btn gold">Yazar Kasa Ayarlarını Kaydet</button>
            </form>
        </div>

        </div>
    </div>
    <script type="application/json" id="accounts-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FinancialAccounts.Select(a => new { id = a.Id, name = a.Name, branchId = a.BranchId, shared = a.IsShared })))</script>
    <script type="application/json" id="registers-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CashRegisters.Select(r => new { id = r.Id, active = r.IsActive, name = r.Name, branchId = r.BranchId, cash = r.CashFinancialAccountId, credit = r.CreditCardFinancialAccountId, meal = r.MealCardFinancialAccountId })))</script>
    <script type="application/json" id="branches-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Branches.Select(b => new { id = b.Id, name = b.Name })))</script>
    <script>
        (function () {
            var accounts = JSON.parse(document.getElementById('accounts-data').textContent);
            var registers = JSON.parse(document.getElementById('registers-data').textContent);
            var branches = JSON.parse(document.getElementById('branches-data').textContent);
            var termBranch = document.getElementById('term-branch');
            var termRegister = document.getElementById('term-register');
            var regBranchDisplay = document.getElementById('reg-branch-display');
            var regBranchInput = document.getElementById('reg-branch-input');
            var regCash = document.getElementById('reg-cash-select');
            var regCredit = document.getElementById('reg-credit-select');
            var regMeal = document.getElementById('reg-meal-select');
            var regForm = document.getElementById('cash-register-form');
            var regIdInput = document.getElementById('reg-id-input');
            var regName = document.getElementById('reg-name-input');
            var regTitle = document.getElementById('reg-form-title');
            var regCancel = document.getElementById('reg-cancel-edit-btn');
            var currentTerminalRegister = @(Model.TerminalRegisterId?.ToString() ?? "null");

            function branchName(id) {
                var b = branches.find(function (x) { return String(x.id) === String(id); });
                return b ? b.name : '';
            }

            // Seçili şubenin hesapları: şubeye ait + ortak olanlar. Seçenekler her seferinde yeniden kurulur.
            function accountsFor(branchId) {
                return accounts.filter(function (a) { return a.shared || String(a.branchId) === String(branchId); });
            }

            function fillSelect(sel, list, selectedValue, emptyLabel) {
                sel.innerHTML = '';
                if (emptyLabel !== undefined) {
                    var empty = document.createElement('option');
                    empty.value = ''; empty.textContent = emptyLabel;
                    sel.appendChild(empty);
                }
                list.forEach(function (a) {
                    var o = document.createElement('option');
                    o.value = a.id; o.textContent = a.name + (a.shared ? ' (ortak)' : '');
                    if (String(a.id) === String(selectedValue)) o.selected = true;
                    sel.appendChild(o);
                });
            }

            function renderBranch(branchId, keepRegisterId) {
                // Terminal kasa listesi
                var regs = registers.filter(function (r) { return String(r.branchId) === String(branchId); });
                fillSelect(termRegister, regs.map(function (r) { return { id: r.id, name: r.name, shared: false }; }), keepRegisterId, '— Kasa seçilmedi —');

                // Kasa tanımı formu: şube otomatik, hesap listeleri şubeye göre
                regBranchInput.value = branchId || '';
                regBranchDisplay.value = branchName(branchId);
                var list = accountsFor(branchId);
                fillSelect(regCash, list, null, undefined);
                fillSelect(regCredit, list, null, undefined);
                fillSelect(regMeal, list, null, '— Kredi kartı hesabı kullanılsın —');

                // Kasa listesi satırları
                document.querySelectorAll('.reg-row').forEach(function (row) {
                    row.classList.toggle('ts-hidden', String(row.getAttribute('data-register-branch')) !== String(branchId));
                });
                document.getElementById('reg-empty-note').classList.toggle('ts-hidden', regs.length > 0);
                document.getElementById('reg-empty-note-2').classList.toggle('ts-hidden', regs.length > 0);
                renderMap(branchId, keepRegisterId);
                document.getElementById('reg-list-head').classList.toggle('ts-hidden', regs.length === 0);

                // Şube bilgisi formu
                document.querySelectorAll('[data-branch-panel]').forEach(function (p) {
                    p.classList.toggle('ts-hidden', String(p.getAttribute('data-branch-panel')) !== String(branchId));
                });
                document.getElementById('branch-info-card').classList.toggle('ts-hidden', !branchId);

                // Hesap listesi (salt okunur)
                var acc = document.getElementById('account-list');
                acc.innerHTML = '';
                if (!branchId) { acc.innerHTML = '<div class="ts-empty">Önce terminal şubesini seçin.</div>'; return; }
                if (list.length === 0) { acc.innerHTML = '<div class="ts-empty">Bu şube için hesap tanımı yok.</div>'; return; }
                list.forEach(function (a) {
                    var d = document.createElement('div');
                    d.className = 'ts-register-row';
                    d.style.gridTemplateColumns = '1fr auto';
                    var n = document.createElement('span'); n.textContent = a.name;
                    var t = document.createElement('span');
                    t.className = 'ts-chip' + (a.shared ? ' shared' : '');
                    t.textContent = a.shared ? 'Ortak' : branchName(a.branchId);
                    d.appendChild(n); d.appendChild(t);
                    acc.appendChild(d);
                });
            }

            termBranch.addEventListener('change', function () { renderBranch(termBranch.value, ''); });
            termRegister.addEventListener('change', function () { renderMap(termBranch.value, termRegister.value); });

            function accountName(id) {
                var a = accounts.find(function (x) { return String(x.id) === String(id); });
                return a ? a : null;
            }

            // Sağ üst kart: seçili (yoksa şubenin ilk) kasanın nakit / kredi kartı / yemek kartı hesap eşleştirmeleri.
            var mapRegisterId = null;
            function renderMap(branchId, preferredRegisterId) {
                var regs = registers.filter(function (r) { return String(r.branchId) === String(branchId); });
                var reg = regs.find(function (r) { return String(r.id) === String(preferredRegisterId); }) || regs[0];
                var rows = document.getElementById('map-rows');
                mapRegisterId = reg ? reg.id : null;
                document.getElementById('map-title').textContent = reg ? reg.name + ' • Hesap eşleştirmeleri' : 'Hesap eşleştirmeleri';
                var badge = document.getElementById('map-active');
                badge.textContent = reg && reg.active ? 'Aktif' : 'Pasif';
                badge.className = 'ts-badge ' + (reg && reg.active ? 'ok' : 'off');
                document.getElementById('map-edit-btn').style.display = reg ? '' : 'none';
                rows.innerHTML = '';
                if (!reg) { rows.innerHTML = '<div class="ts-empty">Bu şubede kasa tanımı yok.</div>'; return; }
                [['Nakit', 'fa-money-bill-wave', 'cash', reg.cash], ['Kredi kartı', 'fa-credit-card', 'credit', reg.credit], ['Yemek kartı', 'fa-utensils', 'meal', reg.meal]].forEach(function (m) {
                    var acc = accountName(m[3]);
                    var d = document.createElement('div');
                    d.className = 'ts-map-row';
                    d.innerHTML = '<span class="ts-map-ico ' + m[2] + '"><i class="fa-solid ' + m[1] + '"></i></span><span class="ts-map-label">' + m[0] + '</span>' +
                        '<span class="ts-map-acc">' + (acc ? acc.name.replace(/</g, '&lt;') : (m[2] === 'meal' ? 'Kredi kartı hesabı kullanılır' : '—')) + '</span>' +
                        (acc ? '<span class="ts-chip' + (acc.shared ? ' shared' : '') + '">' + (acc.shared ? 'Ortak' : branchName(acc.branchId)) + '</span>' : '');
                    rows.appendChild(d);
                });
            }

            function activateTab(key) {
                document.querySelectorAll('.ts-tab').forEach(function (t) { t.classList.toggle('active', t.getAttribute('data-tab') === key); });
                document.querySelectorAll('[data-tab-panel]').forEach(function (p) { p.classList.toggle('active', p.getAttribute('data-tab-panel') === key); });
            }
            document.querySelectorAll('[data-goto-tab]').forEach(function (b) {
                b.addEventListener('click', function () { activateTab(b.getAttribute('data-goto-tab')); });
            });
            document.getElementById('map-edit-btn').addEventListener('click', function () {
                if (mapRegisterId === null) return;
                var row = document.querySelector('.reg-edit-btn');
                var target = document.querySelector('[data-reg-id="' + mapRegisterId + '"] .reg-edit-btn');
                if (target) target.click();
            });
            document.getElementById('reg-new-btn').addEventListener('click', function () {
                activateTab('kasa');
                if (regCancel) regCancel.click();
                regForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
            });

            // Düzenle: satırdaki değerleri forma taşır
            document.querySelectorAll('.reg-edit-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var row = btn.closest('[data-reg-id]');
                    var bid = row.getAttribute('data-reg-branch');
                    if (termBranch.value !== bid) { termBranch.value = bid; renderBranch(bid, ''); }
                    regIdInput.value = row.getAttribute('data-reg-id');
                    regName.value = row.getAttribute('data-reg-name') || '';
                    regCash.value = row.getAttribute('data-reg-cash') || '';
                    regCredit.value = row.getAttribute('data-reg-credit') || '';
                    regMeal.value = row.getAttribute('data-reg-meal') || '';
                    regTitle.textContent = 'Kasayı Düzenle';
                    regCancel.style.display = '';
                    activateTab('kasa');
                    regForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
                });
            });
            if (regCancel) {
                regCancel.addEventListener('click', function () {
                    regForm.reset();
                    regIdInput.value = '0';
                    regTitle.textContent = 'Yeni Kasa Ekle';
                    regCancel.style.display = 'none';
                    renderBranch(termBranch.value, '');
                });
            }

            // Sayfa açılışı: mevcut terminal şubesi
            var initialBranch = termBranch.value;
            renderBranch(initialBranch, currentTerminalRegister || '');

            document.querySelectorAll('.ts-tab').forEach(function (tab) {
                tab.addEventListener('click', function () { activateTab(tab.getAttribute('data-tab')); });
            });

            var fiscalSelect = document.getElementById('fiscal-device-select');
            var fiscalUrlInput = document.getElementById('fiscal-url-input');
            if (fiscalSelect && fiscalUrlInput) {
                fiscalSelect.addEventListener('change', function () { fiscalUrlInput.disabled = fiscalSelect.value === 'None'; });
            }
        })();
    </script>

<style>
    .ts-body { max-width: 1180px; padding-bottom: 28px; color: #0f1f3a; }
    .ts-title { font-size: 32px; font-weight: 800; margin: 0; letter-spacing: -.01em; }
    .ts-sub { margin: 4px 0 18px; font-size: 17px; color: #475569; }
    .ts-tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 18px; }
    .ts-tab { display: flex; align-items: center; justify-content: center; gap: 12px; height: 56px; border-radius: 12px; border: 1px solid #e3e9f2; background: #fff; font-weight: 600; font-size: 16px; cursor: pointer; color: #0f1f3a; box-shadow: 0 1px 3px rgba(16,24,40,.05); }
    .ts-tab i { font-size: 20px; }
    .ts-tab.active { background: #12305a; color: #fff; border-color: #12305a; box-shadow: 0 4px 10px rgba(18,48,90,.3); }
    .ts-tab-panel { display: none; }
    .ts-tab-panel.active { display: block; }
    .ts-cols { display: grid; grid-template-columns: 1.15fr 1fr; gap: 18px; margin-bottom: 18px; align-items: start; }
    .ts-col { display: flex; flex-direction: column; gap: 18px; }
