@model IReadOnlyList<SahinSoft.Domain.Entities.ProductCategory>
@{
    ViewData["Title"] = "Kategoriler";
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}

<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-tags"></i> Kategori Tanımla</h2>
        <a asp-action="Create" class="btn-erp-list-new">+ Yeni Kategori</a>
    </div>
    <div class="erp-list-body">
        <div class="erp-list-topbar">
            <div class="erp-list-topbar-left">
                <div class="erp-list-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" class="form-control" autocomplete="off" placeholder="Kategori kodu veya adı ara..." data-live-search="#categoriesTable">
                </div>
            </div>
            <span class="text-secondary">Toplam <strong>@Model.Count</strong> kayıt.</span>
        </div>

        <div class="erp-table-wrap">
            <table class="erp-table" id="categoriesTable" data-sortable>
                <thead>
                    <tr>
                        <th data-sort="text">Kod</th>
                        <th data-sort="text">Ad</th>
                        <th data-sort="text">Web Yolu</th>
                        <th data-sort="text">Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.IsActive ? "" : "text-secondary")">
                        <td><span class="erp-code-badge">@item.Code</span></td>
                        <td class="fw-semibold">@item.Name</td>
                        <td>@item.WebsitePath</td>
                        <td>
                            @if (item.IsActive) { <span class="erp-status-pill green">Aktif</span> }
                            else { <span class="erp-status-pill red">Pasif</span> }
                        </td>
                        <td class="text-end d-flex justify-content-end align-items-center gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-erp-list-action">Düzenle</a>
                            <form asp-action="MergeInto" asp-route-id="@item.Id" method="post" class="d-flex align-items-center gap-1"
                                  onsubmit="return confirm('&quot;' + '@item.Name'.replace(/'/g,'') + '&quot; kategorisindeki tüm ürünler seçilen kategoriye taşınacak ve bu kategori silinecek. Emin misiniz?');">
                                <select name="targetCategoryId" class="form-select form-select-sm" style="width: auto; font-size: 0.78rem;" required>
                                    <option value="">Birleştir →</option>
                                    @foreach (var other in Model.Where(x => x.Id != item.Id))
                                    {
                                        <option value="@other.Id">@other.Code - @other.Name</option>
                                    }
                                </select>
                                <button type="submit" class="btn-erp-list-delete">Birleştir</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
