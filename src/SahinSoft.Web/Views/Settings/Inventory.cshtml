@model SahinSoft.Web.Models.InventorySettingsViewModel
@{
    ViewData["Title"] = "Stok Parametreleri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Stok Parametreleri</h1>
        <p class="text-secondary mb-0">Buradaki değişiklikler fatura, stok fişi, transfer ve sayım kontrollerine uygulanır.</p>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">Barkod</div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label asp-for="DefaultBarcodeType" class="form-label"></label>
                <select asp-for="DefaultBarcodeType" class="form-select">
                    <option value="EAN13">EAN-13</option>
                    <option value="EAN8">EAN-8</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="DefaultScalePrefix" class="form-label"></label>
                <select asp-for="DefaultScalePrefix" class="form-select">
                    <option value="27">27</option>
                    <option value="28">28</option>
                    <option value="29">29</option>
                </select>
            </div>
            <div class="col-12 d-flex flex-wrap gap-4">
                <div class="form-check form-switch"><input asp-for="RequireBarcode" class="form-check-input" /><label asp-for="RequireBarcode" class="form-check-label"></label></div>
                <div class="form-check form-switch"><input asp-for="AutoGenerateBarcode" class="form-check-input" /><label asp-for="AutoGenerateBarcode" class="form-check-label"></label></div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">Stok kontrolü</div>
        <div class="card-body d-flex flex-column gap-3">
            <div class="form-check form-switch"><input asp-for="EnforceStockLevel" class="form-check-input" /><label asp-for="EnforceStockLevel" class="form-check-label"></label></div>
            <div class="form-check form-switch"><input asp-for="AllowNegativeStock" class="form-check-input" /><label asp-for="AllowNegativeStock" class="form-check-label"></label></div>
            <div class="form-check form-switch"><input asp-for="AllowSaleWhenOutOfStock" class="form-check-input" /><label asp-for="AllowSaleWhenOutOfStock" class="form-check-label"></label></div>
            <div class="form-check form-switch"><input asp-for="EnableMinimumStockWarning" class="form-check-input" /><label asp-for="EnableMinimumStockWarning" class="form-check-label"></label></div>
            <div class="form-check form-switch"><input asp-for="RequireTransferApproval" class="form-check-input" /><label asp-for="RequireTransferApproval" class="form-check-label"></label></div>
            <div class="form-check form-switch"><input asp-for="AllowSaleBelowCost" class="form-check-input" /><label asp-for="AllowSaleBelowCost" class="form-check-label"></label></div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">Renk ve varyant <span class="badge text-bg-secondary ms-2">Varsayılan kapalı</span></div>
        <div class="card-body">
            <p class="text-secondary small">Varyant takibi öncelikli değildir. Gerektiğinde buradan açılabilir.</p>
            <div class="d-flex flex-column gap-3">
                <div class="form-check form-switch"><input asp-for="TrackStockByVariant" class="form-check-input" /><label asp-for="TrackStockByVariant" class="form-check-label"></label></div>
                <div class="form-check form-switch"><input asp-for="RequireProductVariant" class="form-check-input" /><label asp-for="RequireProductVariant" class="form-check-label"></label></div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">Restoran Modülü</div>
        <div class="card-body">
            <p class="text-secondary small">Açıldığında Stok Tanıtım Kartı'nda Puan, Kısayol/Mobil/Online Sipariş görünürlüğü ve Yazıcı alanları görünür olur.</p>
            <div class="form-check form-switch"><input asp-for="IsRestaurantModuleEnabled" class="form-check-input" /><label asp-for="IsRestaurantModuleEnabled" class="form-check-label"></label></div>
            <div class="mt-3" style="max-width:280px;">
                <label asp-for="DailyRevenueTarget" class="form-label"></label>
                <input asp-for="DailyRevenueTarget" type="number" step="0.01" min="0" class="form-control" placeholder="Örn: 68000" />
                <div class="form-text">Restoran Dashboard'daki "Günün Hedefi" halkası için. Boş bırakılırsa o bölüm hiç gösterilmez.</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">Yazar Kasa Entegrasyonu</div>
        <div class="card-body">
            <p class="text-secondary small">Bir yazar kasa seçilip adresi girilirse, restoran Kapat/Öde ekranındaki nakit/kredi kartı/yemek çeki ödemeleri doğrudan fiziksel yazar kasaya gönderilir (fatura kesilen satışlar hariç). "Yok" seçiliyken (varsayılan) hiçbir değişiklik olmaz, bugünkü gibi çalışır.</p>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FiscalDeviceType" class="form-label"></label>
                    <select asp-for="FiscalDeviceType" asp-items="Html.GetEnumSelectList<SahinSoft.Domain.Enums.FiscalDeviceType>()" class="form-select"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="FiscalAgentUrl" class="form-label"></label>
                    <input asp-for="FiscalAgentUrl" class="form-control" placeholder="http://localhost:9595" />
                    <span asp-validation-for="FiscalAgentUrl" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">Belge Dönüşümü Otomatik Onay</div>
        <div class="card-body">
            <p class="text-secondary small">Açılırsa, ilgili dönüşümle oluşturulan belge kaydedilir ve hemen ardından otomatik onaylanır (mevcut onay servisi üzerinden — stok/cari hareketleri normal onay gibi işlenir). Yalnızca yönetici kullanıcılarda çalışır; kapalıyken (varsayılan) belge Taslak olarak kalır. Otomatik onay başarısız olursa belge Taslak olarak korunur, hiçbir kısmi hareket oluşmaz.</p>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-check form-switch"><input asp-for="OrderToDispatchPurchaseAutoApprove" class="form-check-input" /><label asp-for="OrderToDispatchPurchaseAutoApprove" class="form-check-label"></label></div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch"><input asp-for="OrderToDispatchSalesAutoApprove" class="form-check-input" /><label asp-for="OrderToDispatchSalesAutoApprove" class="form-check-label"></label></div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch"><input asp-for="OrderToInvoicePurchaseAutoApprove" class="form-check-input" /><label asp-for="OrderToInvoicePurchaseAutoApprove" class="form-check-label"></label></div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch"><input asp-for="OrderToInvoiceSalesAutoApprove" class="form-check-input" /><label asp-for="OrderToInvoiceSalesAutoApprove" class="form-check-label"></label></div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch"><input asp-for="DispatchToInvoicePurchaseAutoApprove" class="form-check-input" /><label asp-for="DispatchToInvoicePurchaseAutoApprove" class="form-check-label"></label></div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch"><input asp-for="DispatchToInvoiceSalesAutoApprove" class="form-check-input" /><label asp-for="DispatchToInvoiceSalesAutoApprove" class="form-check-label"></label></div>
                </div>
            </div>
        </div>
    </div>

    <button class="btn btn-primary px-4" type="submit">Parametreleri Kaydet</button>
</form>
