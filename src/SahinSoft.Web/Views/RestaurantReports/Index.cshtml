            <div><small>SATIŞLAR</small><strong>@Model.Kasiyer.NetRevenue.ToString("N2") ₺</strong></div>
            <div><small>FİŞ SAYISI</small><strong>@Model.Kasiyer.ReceiptCount</strong></div>
            <div><small>NAKİT</small><strong>@Model.Kasiyer.Cash.ToString("N2") ₺</strong></div>
            <div><small>KREDİ KARTI</small><strong>@Model.Kasiyer.Card.ToString("N2") ₺</strong></div>
            <div><small>ÖDENMEZ</small><strong>@Model.Kasiyer.Unpaid.ToString("N2") ₺</strong></div>
            <div><small>DİĞER TAHSİLATLAR</small><strong>@Model.Kasiyer.OtherCollections.ToString("N2") ₺</strong></div>
            <div><small>İNDİRİM</small><strong>@Model.Kasiyer.DiscountAmount.ToString("N2") ₺</strong></div>
            <div><small>İKRAM</small><strong>@Model.Kasiyer.ComplimentaryAmount.ToString("N2") ₺</strong></div>
            <!-- "İade" için ayrı bir kayıt mekanizması bu sistemde YOK - dönüş her zaman aynı
                 iptal/reversal akışından geçiyor (bkz. RestaurantPostingService.CancelRetailSaleAsync),
                 bu yüzden ayrı bir sayı UYDURULMADI, İptal ile birleşik gösteriliyor. -->
            <div><small>İPTAL / İADE</small><strong>@Model.Kasiyer.CancelledCount</strong></div>
        </div>
    </div>
}
else if (Model.ActiveTab == "x")
{
