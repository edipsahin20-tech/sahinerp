@model SahinSoft.Web.Models.CustomerFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Cariyi Düzenle" : "Yeni Cari";
}

<form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <input asp-for="Id" type="hidden" />
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
        <div>
            <h1 class="h3 mb-1">@ViewData["Title"]</h1>
            <p class="text-secondary mb-0">Cari kimlik, iletişim ve vergi bilgilerini yönetin.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            <button type="submit" class="btn btn-primary px-4">Kaydet</button>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-3 p-lg-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="TaxOffice" class="form-label"></label>
                    <input asp-for="TaxOffice" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="TaxNumber" class="form-label"></label>
                    <input asp-for="TaxNumber" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="IdentityNumber" class="form-label"></label>
                    <input asp-for="IdentityNumber" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="District" class="form-label"></label>
                    <input asp-for="District" class="form-control" />
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label"></label>
                    <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>

                <div class="col-12 d-flex flex-wrap gap-4 pt-2">
                    <div class="form-check form-switch">
                        <input asp-for="IsCustomer" class="form-check-input" />
                        <label asp-for="IsCustomer" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsSupplier" class="form-check-input" />
                        <label asp-for="IsSupplier" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white d-flex justify-content-end gap-2 py-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            <button type="submit" class="btn btn-primary px-4">Kaydet</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
