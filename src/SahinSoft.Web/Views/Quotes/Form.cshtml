@model SahinSoft.Web.Models.QuoteFormViewModel
@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? "Teklifi Düzenle" : "Yeni Teklif";
}

<link rel="stylesheet" href="~/css/sahin_quote.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div class="admin-theme light-theme" style="margin: -1.5rem -1.5rem 0 -1.5rem;">

  <!-- TOP HEADER / NAVBAR -->
  <header class="top-nav">
    <div class="nav-container">
      <div class="brand-box">
        <div class="logo-image-wrap">
          <img src="data:image/png;base64," onerror="this.src='/css/sahinsoft_logo.png'" alt="ŞahinSoft Logo" class="brand-logo-img">
        </div>
        <div class="brand-info">
          <span class="subdomain">admin.sahinbilisim.com.tr</span>
          <h1 class="portal-title">TEKLİF & PDF PORTALI</h1>
        </div>
      </div>

      <div class="live-exchange-rates">
        <div class="rate-pill" title="Garanti BBVA Dolar Satış Kuru">
          <i class="fa-solid fa-dollar-sign"></i> <span>USD Satış:</span> <strong id="rate-usd">36.50 ₺</strong>
        </div>
        <div class="rate-pill" title="Garanti BBVA Euro Satış Kuru">
          <i class="fa-solid fa-euro-sign"></i> <span>EUR Satış:</span> <strong id="rate-eur">39.80 ₺</strong>
        </div>
        <button id="sync-rates-btn" class="btn btn-sm btn-secondary" onclick="fetchExchangeRates()" title="Garanti BBVA Canlı Kurları Güncelle">
          <i class="fa-solid fa-rotate-right"></i> Canlı Kur Al
        </button>
      </div>

      <div class="top-actions">
        <button class="btn btn-secondary" onclick="openStockModal()">
          <i class="fa-solid fa-boxes-stacked"></i> Stok & Kategoriler
        </button>
        <button class="btn btn-secondary" onclick="openHistoryModal()">
          <i class="fa-solid fa-folder-open"></i> Teklif Geçmişi (<span id="saved-count">0</span>)
        </button>
        <button class="btn btn-gold" onclick="resetFormWithNewNo()">
          <i class="fa-solid fa-plus"></i> Yeni Teklif
        </button>
      </div>
    </div>
  </header>

  <!-- DASHBOARD METRICS SUMMARY -->
  <section class="metrics-bar">
    <div class="container-fluid grid-metrics">
      <div class="metric-card">
        <div class="m-icon gold"><i class="fa-solid fa-file-signature"></i></div>
        <div class="m-data">
          <span class="m-label">Toplam Oluşturulan Teklif</span>
          <h3 class="m-val" id="metric-total-proposals">0</h3>
        </div>
      </div>

      <div class="metric-card">
        <div class="m-icon green"><i class="fa-solid fa-turkish-lira-sign"></i></div>
        <div class="m-data">
          <span class="m-label">Toplam Teklif Hacmi</span>
          <h3 class="m-val" id="metric-total-volume">0 ₺</h3>
        </div>
      </div>

      <div class="metric-card">
        <div class="m-icon blue"><i class="fa-solid fa-check-double"></i></div>
        <div class="m-data">
          <span class="m-label">Onaylanan Teklifler</span>
          <h3 class="m-val" id="metric-approved-count">0</h3>
        </div>
      </div>

      <div class="metric-card">
        <div class="m-icon purple"><i class="fa-solid fa-cubes"></i></div>
        <div class="m-data">
          <span class="m-label">Canlı SQL Veritabanı Stoğu</span>
          <h3 class="m-val" id="metric-stock-count">Yükleniyor...</h3>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN WORKSPACE: FORM & LIVE PDF PREVIEW -->
  <main class="workspace">
    <div class="container-fluid workspace-grid">
      
      <!-- LEFT COLUMN: PROPOSAL BUILDER FORM -->
      <section class="form-panel">
        <div class="panel-header">
          <h2><i class="fa-solid fa-sliders"></i> Teklif Detayları ve Ürün Seçimi</h2>
          <span class="badge-tag">SQL Veritabanı Entegre</span>
        </div>

        <form id="quote-form" onsubmit="event.preventDefault();">
          
          <!-- 1. MÜŞTERİ & TEKLİF ÜST BİLGİLERİ -->
          <div class="card-section">
            <h3 class="card-title"><i class="fa-solid fa-building-user"></i> Müşteri & Firma Bilgileri</h3>
            
            <div class="form-row grid-3">
              <div class="form-group">
                <label for="cust-company">Firma Unvanı / Adı *</label>
                <input type="text" id="cust-company" class="form-control" placeholder="Örn: ABC Lojistik A.Ş." required oninput="updatePdfPreview()">
              </div>
              <div class="form-group">
                <label for="cust-contact">İlgili / Yetkili Kişi *</label>
                <input type="text" id="cust-contact" class="form-control" placeholder="Örn: Ahmet Yılmaz" required oninput="updatePdfPreview()">
              </div>
              <div class="form-group">
                <label for="cust-phone">Telefon</label>
                <input type="text" id="cust-phone" class="form-control" placeholder="Örn: 0532 000 00 00" oninput="updatePdfPreview()">
              </div>
            </div>

            <div class="form-row grid-3">
              <div class="form-group">
                <label for="cust-email">E-posta Adresi</label>
                <input type="email" id="cust-email" class="form-control" placeholder="ahmet@abclojistik.com" oninput="updatePdfPreview()">
              </div>
              <div class="form-group">
                <label for="cust-tax-office">Vergi Dairesi & No</label>
                <input type="text" id="cust-tax-office" class="form-control" placeholder="Örn: Kadıköy V.D. 1234567890" oninput="updatePdfPreview()">
              </div>
              <div class="form-group">
                <label for="cust-address">Adres / Şehir</label>
                <input type="text" id="cust-address" class="form-control" placeholder="Örn: Ataşehir, İstanbul" oninput="updatePdfPreview()">
              </div>
            </div>

            <div class="form-row grid-4">
              <div class="form-group">
                <label for="quote-no">Teklif No</label>
                <input type="text" id="quote-no" class="form-control gold-text-input" readonly>
              </div>
              <div class="form-group">
                <label for="quote-date">Teklif Tarihi</label>
                <input type="date" id="quote-date" class="form-control" onchange="updatePdfPreview()">
              </div>
              <div class="form-group">
                <label for="quote-validity">Geçerlilik Süresi</label>
                <select id="quote-validity" class="form-control" onchange="updatePdfPreview()">
                  <option value="7 Gün">7 Gün</option>
                  <option value="15 Gün" selected>15 Gün</option>
                  <option value="30 Gün">30 Gün</option>
                  <option value="60 Gün">60 Gün</option>
                </select>
              </div>
              <div class="form-group">
                <label for="quote-currency">Para Birimi</label>
                <select id="quote-currency" class="form-control" onchange="handleCurrencyChange()">
                  <option value="TRY" selected>TRY (₺ Türk Lirası)</option>
                  <option value="USD">USD ($ ABD Doları)</option>
                  <option value="EUR">EUR (€ Euro)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- 2. STOK VE KATEGORİDEN ÜRÜN EKLEME -->
          <div class="card-section">
            <div class="card-title-between">
              <h3 class="card-title"><i class="fa-solid fa-cart-plus"></i> SQL Veritabanı Stok Kataloğundan Ekle</h3>
              <button type="button" class="btn btn-sm btn-outline-gold" onclick="openStockModal()">
                <i class="fa-solid fa-boxes-packing"></i> Tüm Stok Listesi
              </button>
            </div>

            <div class="add-item-box">
              <div class="form-row grid-catalog-picker">
                <div class="form-group span-2">
                  <label for="picker-category">Kategori Seçin</label>
                  <select id="picker-category" class="form-control" onchange="filterProductDropdown()">
                    <option value="ALL">Tüm Kategoriler (SQL Veritabanı)</option>
                  </select>
                </div>
                <div class="form-group span-3">
                  <label for="picker-product">Ürün / Stok Seçin *</label>
                  <select id="picker-product" class="form-control" onchange="onProductSelected()">
                    <option value="">-- Lütfen Ürün Seçiniz --</option>
                  </select>
                </div>
              </div>

              <div class="form-row grid-5 item-inputs">
                <div class="form-group">
                  <label for="item-qty">Miktar</label>
                  <input type="number" id="item-qty" class="form-control" value="1" min="1" step="1">
                </div>
                <div class="form-group">
                  <label for="item-unit">Birim</label>
                  <select id="item-unit" class="form-control">
                    <option value="Adet">Adet</option>
                    <option value="Paket">Paket</option>
                    <option value="Lisans">Lisans</option>
                    <option value="Set">Set</option>
                    <option value="Saat">Saat</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="item-price">Birim Fiyat (<span class="curr-symbol">₺</span>)</label>
                  <input type="number" id="item-price" class="form-control" placeholder="0.00" step="0.01">
                </div>
                <div class="form-group">
                  <label for="item-kdv">KDV %</label>
                  <select id="item-kdv" class="form-control">
                    <option value="20" selected>%20</option>
                    <option value="10">%10</option>
                    <option value="0">%0</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="item-discount">İskonto %</label>
                  <input type="number" id="item-discount" class="form-control" value="0" min="0" max="100">
                </div>
              </div>

              <div class="item-actions">
                <button type="button" class="btn btn-gold" onclick="addItemToQuote()">
                  <i class="fa-solid fa-plus-circle"></i> Teklife Ekle
                </button>
                <button type="button" class="btn btn-outline" onclick="addCustomLineItem()">
                  <i class="fa-solid fa-pen-to-square"></i> Özel Hizmet / Kalem Ekle
                </button>
              </div>
            </div>
          </div>

          <!-- 3. EKLENEN TEKLİF KALEMLERİ TABLOSU -->
          <div class="card-section">
            <h3 class="card-title"><i class="fa-solid fa-list-check"></i> Teklif Kalemleri (<span id="items-count-badge">0</span>)</h3>
            
            <div class="table-responsive">
              <table class="table admin-table" id="quote-items-table">
                <thead>
                  <tr>
                    <th style="width: 40px;">#</th>
                    <th>Ürün Kodu & Adı / Açıklama</th>
                    <th style="width: 70px;">Birim</th>
                    <th style="width: 70px;">Miktar</th>
                    <th style="width: 110px;">Birim Fiyat</th>
                    <th style="width: 75px;">KDV</th>
                    <th style="width: 75px;">İsk. %</th>
                    <th style="width: 120px;">Net Toplam</th>
                    <th style="width: 60px;">İşlem</th>
                  </tr>
                </thead>
                <tbody id="quote-items-body">
                </tbody>
              </table>
            </div>

            <!-- DİP HESAP ÖZETİ -->
            <div class="totals-summary-box">
              <div class="summary-left">
                <label for="quote-note">Teklife Özel Not / Açıklama</label>
                <textarea id="quote-note" class="form-control" rows="3" placeholder="Örn: Teklifimiz dahilindeki ürünler 2 yıl Şahin Bilişim garantisi altındadır. Kurulum ve e-Fatura entegrasyonu dahildir." oninput="updatePdfPreview()"></textarea>
              </div>
              <div class="summary-right">
                <div class="calc-line">
                  <span>Brüt Ara Toplam:</span>
                  <strong id="calc-subtotal">0.00 ₺</strong>
                </div>
                <div class="calc-line text-red" id="calc-discount-row" style="display: none;">
                  <span>Toplam İskonto Tutarı:</span>
                  <strong id="calc-discount-total">-0.00 ₺</strong>
                </div>
                <div class="calc-line">
                  <span>Toplam KDV Tutarı:</span>
                  <strong id="calc-kdv">0.00 ₺</strong>
                </div>
                <div class="calc-line grand-total">
                  <span>GENEL TOPLAM:</span>
                  <strong id="calc-grand-total">0.00 ₺</strong>
                </div>
              </div>
            </div>
          </div>

          <!-- 4. ÖDEME & ŞARTLAR & BANKA HESABI -->
          <div class="card-section">
            <h3 class="card-title"><i class="fa-solid fa-file-contract"></i> Ödeme Koşulları ve Banka Hesap Bilgisi</h3>
            
            <div class="form-row grid-3">
              <div class="form-group">
                <label for="terms-payment">Ödeme Şekli</label>
                <select id="terms-payment" class="form-control" onchange="updatePdfPreview()">
                  <option value="%50 Peşin, %50 Teslimatta Bakiyesi">%50 Peşin, %50 Teslimatta Bakiyesi</option>
                  <option value="Peşin Havale / EFT (%5 İskontolu)">Peşin Havale / EFT (%5 İskontolu)</option>
                  <option value="Kredi Kartı 6 Taksit">Kredi Kartı 6 Taksit</option>
                  <option value="Vadeli Çek (30 Gün)">Vadeli Çek (30 Gün)</option>
                </select>
              </div>

              <div class="form-group">
                <label for="terms-delivery">Teslimat & Kurulum</label>
                <select id="terms-delivery" class="form-control" onchange="updatePdfPreview()">
                  <option value="Stoktan Hemen Teslim & Ücretsiz Kurulum">Stoktan Hemen Teslim & Ücretsiz Kurulum</option>
                  <option value="3-5 İş Günü İçerisinde Teslimat">3-5 İş Günü İçerisinde Teslimat</option>
                  <option value="Kargo / Lojistik ile Adrese Teslim">Kargo / Lojistik ile Adrese Teslim</option>
                </select>
            </div>
          </div>

          <!-- FORM BOTTOM ACTION BAR -->
          <div class="form-action-bar">
            <button type="button" class="btn btn-lg btn-gold-pulse" onclick="saveAndExportPdf()">
              <i class="fa-solid fa-file-pdf"></i> KAYDET VE PDF DÖNÜŞTÜR (PDF İNDİR)
            </button>
            <button type="button" class="btn btn-lg btn-secondary" onclick="saveAsDraft()">
              <i class="fa-solid fa-floppy-disk"></i> Taslak Olarak Kaydet (SQL)
            </button>
            <button type="button" class="btn btn-lg btn-outline" onclick="window.print()">
              <i class="fa-solid fa-print"></i> Doğrudan Yazdır
            </button>
          </div>

        </form>
      </section>

      <!-- RIGHT COLUMN: LIVE PDF DOCUMENT PREVIEW CANVAS -->
      <section class="preview-panel">
        <div class="panel-header">
          <h2><i class="fa-solid fa-eye"></i> Canlı A4 PDF Belge Önizlemesi</h2>
          <span class="pdf-indicator"><i class="fa-solid fa-file-circle-check"></i> ŞahinSoft Formatı</span>
        </div>

        <div class="pdf-wrapper">
          <div id="pdf-template" class="pdf-document">
            
            <div class="pdf-watermark">ŞAHİNSOFT</div>

            <div class="pdf-header">
              <div class="pdf-brand">
                <div class="pdf-logo-box">
                  <img src="data:image/png;base64," onerror="this.src='/css/sahinsoft_logo.png'" alt="ŞahinSoft Logo" class="pdf-logo-img">
                </div>
                <div class="pdf-brand-sub">
                  <strong>ŞAHİNSOFT YAZILIM TEKNOLOJİLERİ</strong><br>
                  <span>Web: sahinbilisim.com.tr | E-posta: edip@sahinbilisim.com.tr</span><br>
                  <span>Tel: 0 (533) 278 23 79</span>
                </div>
              </div>
              <div class="pdf-doc-title-box">
                <h2 class="pdf-doc-title">FİYAT TEKLİFİ</h2>
                <div class="pdf-meta-pill">
                  <span>Teklif No:</span> <strong id="pdf-val-no">TEK-2026-0842</strong>
                </div>
                <div class="pdf-meta-pill">
                  <span>Tarih:</span> <strong id="pdf-val-date">28.07.2026</strong>
                </div>
                <div class="pdf-meta-pill">
                  <span>Geçerlilik:</span> <strong id="pdf-val-validity">15 Gün</strong>
                </div>
              </div>
            </div>

            <hr class="pdf-divider">

            <div class="pdf-info-grid">
              <div class="pdf-info-block customer">
                <div class="block-head"><i class="fa-solid fa-building"></i> TEKLİF SUNULAN MÜŞTERİ</div>
                <div class="block-body">
                  <h4 id="pdf-val-company">ABC Lojistik ve Ticaret A.Ş.</h4>
                  <p><strong>Yetkili:</strong> <span id="pdf-val-contact">Ahmet Yılmaz</span></p>
                  <p><strong>E-posta:</strong> <span id="pdf-val-email">ahmet@abclojistik.com</span></p>
                  <p><strong>Telefon:</strong> <span id="pdf-val-phone">0532 000 00 00</span></p>
                  <p><strong>Vergi Dairesi/No:</strong> <span id="pdf-val-tax">Kadıköy V.D. 1234567890</span></p>
                  <p><strong>Adres:</strong> <span id="pdf-val-address">Ataşehir, İstanbul</span></p>
                </div>
              </div>
            </div>

            <div class="pdf-table-wrapper">
              <table class="pdf-table">
                <thead>
                  <tr>
                    <th style="width: 30px;">#</th>
                    <th style="width: 90px;">Ürün Kodu</th>
                    <th>Ürün & Hizmet Açıklaması</th>
                    <th style="width: 50px;">Birim</th>
                    <th style="width: 45px;">Mkt</th>
                    <th style="width: 90px; text-align: right;">B. Fiyat</th>
                    <th style="width: 45px; text-align: center;">KDV</th>
                    <th style="width: 45px; text-align: center;">İsk.</th>
                    <th style="width: 100px; text-align: right;">Toplam Tutar</th>
                  </tr>
                </thead>
                <tbody id="pdf-items-body">
                </tbody>
              </table>
            </div>

            <div class="pdf-bottom-grid">
              <div class="pdf-terms-box">
                <div class="terms-title"><i class="fa-solid fa-clipboard-check"></i> TEKLİF KOŞULLARI VE ŞARTLARI</div>
                <ul class="terms-list">
                  <li><strong>Ödeme Koşulu:</strong> <span id="pdf-val-payment">%50 Peşin, %50 Teslimatta Bakiyesi</span></li>
                  <li><strong>Teslimat Süresi:</strong> <span id="pdf-val-delivery">Stoktan Hemen Teslim & Ücretsiz Kurulum</span></li>
                  <li><strong>Garanti:</strong> Tüm donanımlar 24 ay Şahin Bilişim distribütör garantilidir.</li>
                </ul>

                <div class="pdf-note-box" id="pdf-note-container">
                  <strong>Not:</strong> <span id="pdf-val-note">Kurulum ve e-Fatura entegrasyonu dahildir.</span>
                </div>
              </div>

              <div class="pdf-totals-box">
                <div class="pdf-total-row">
                  <span>Ara Toplam:</span>
                  <strong id="pdf-val-subtotal">0.00 ₺</strong>
                </div>
                <div class="pdf-total-row discount" id="pdf-discount-row" style="display: none;">
                  <span>İskonto Tutarı:</span>
                  <strong id="pdf-val-discount">-0.00 ₺</strong>
                </div>
                <div class="pdf-total-row">
                  <span>KDV Tutarı (%20):</span>
                  <strong id="pdf-val-kdv">0.00 ₺</strong>
                </div>
                <div class="pdf-total-row grand">
                  <span>GENEL TOPLAM:</span>
                  <strong id="pdf-val-grand">0.00 ₺</strong>
                </div>
              </div>
            </div>

            <div class="pdf-footer-signatures">
              <div class="sig-box">
                <span class="sig-title">TEKLİF HAZIRLAYAN</span>
                <span class="sig-company">Şahin Bilişim Teknolojileri</span>
                <div class="sig-space">
                  <span class="stamp-badge"><i class="fa-solid fa-stamp"></i> ŞAHİN BİLİŞİM ONAYLI</span>
                </div>
                <span class="sig-name">Satış & Proje Departmanı</span>
              </div>

              <div class="sig-box">
                <span class="sig-title">MÜŞTERİ ONAY / İMZA</span>
                <span class="sig-company" id="pdf-sig-customer-name">ABC Lojistik ve Ticaret A.Ş.</span>
                <div class="sig-space">
                  <span class="sig-placeholder">Kaşe / İmza / Tarih</span>
                </div>
                <span class="sig-name">Yetkili İmzası</span>
              </div>
            </div>

            <div class="pdf-page-footer">
              <span>Şahin Bilişim Teknolojileri Ltd. Şti. — admin.sahinbilisim.com.tr Teklif Sistemi</span>
              <span>Sayfa 1 / 1</span>
            </div>

          </div>
        </div>
      </section>

    </div>
  </main>

  <!-- MODAL 1: STOK VE KATEGORİ YÖNETİMİ -->
  <div id="stock-modal" class="modal-overlay">
    <div class="modal-content modal-lg">
      <div class="modal-header">
        <h3><i class="fa-solid fa-boxes-stacked"></i> SQL Veritabanı Stok ve Kategori Yönetimi</h3>
        <button class="close-btn" onclick="closeStockModal()">&times;</button>
      </div>
      <div class="modal-body">
        
        <div class="modal-top-actions">
          <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="stock-search-input" class="form-control" placeholder="Stok adı, kodu veya kategori ara..." oninput="renderStockManagementTable()">
          </div>
          <button class="btn btn-gold" onclick="showAddProductSubModal()">
            <i class="fa-solid fa-plus"></i> Yeni Ürün Ekle
          </button>
          <button class="btn btn-outline" onclick="loadLiveDbCatalog()">
            <i class="fa-solid fa-rotate"></i> SQL Veritabanından Yeniden Yükle
          </button>
        </div>

        <div class="table-responsive modal-table-wrap">
          <table class="table admin-table">
            <thead>
              <tr>
                <th>Ürün Kodu</th>
                <th>Ürün Adı</th>
                <th>Kategori</th>
                <th>Birim Fiyat</th>
                <th>Stok Adedi</th>
                <th>Durum</th>
                <th>İşlem</th>
              </tr>
            </thead>
            <tbody id="stock-manage-body">
            </tbody>
          </table>
        </div>

      </div>
    </div>
  </div>

  <!-- MODAL 2: TEKLİF GEÇMİŞİ VE KAYITLI TEKLİFLER -->
  <div id="history-modal" class="modal-overlay">
    <div class="modal-content modal-lg">
      <div class="modal-header">
        <h3><i class="fa-solid fa-folder-closed"></i> Kaydedilen Teklif Geçmişi</h3>
        <button class="close-btn" onclick="closeHistoryModal()">&times;</button>
      </div>
      <div class="modal-body">
        <div class="modal-top-actions">
          <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="history-search-input" class="form-control" placeholder="Teklif no veya firma adı ara..." oninput="renderHistoryTable()">
          </div>
          <span class="history-info-text">Toplam <strong id="history-total-count">0</strong> teklif arşivlendi.</span>
        </div>

        <div class="table-responsive modal-table-wrap">
          <table class="table admin-table">
            <thead>
              <tr>
                <th>Teklif No</th>
                <th>Tarih</th>
                <th>Müşteri Firma</th>
                <th>Yetkili</th>
                <th>Genel Toplam</th>
                <th>Durum</th>
                <th>İşlemler</th>
              </tr>
            </thead>
            <tbody id="history-manage-body">
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 3: YENİ ÜRÜN EKLEME / DÜZENLEME -->
  <div id="product-edit-modal" class="modal-overlay">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="product-modal-title"><i class="fa-solid fa-box-open"></i> Yeni Ürün Ekle</h3>
        <button class="close-btn" onclick="closeProductEditModal()">&times;</button>
      </div>
      <div class="modal-body">
        <form id="product-edit-form" onsubmit="handleSaveProduct(event)">
          <input type="hidden" id="edit-prod-id">
          
          <div class="form-group">
            <label for="edit-prod-code">Ürün Kodu *</label>
            <input type="text" id="edit-prod-code" class="form-control" required placeholder="Örn: SHN-POS-101">
          </div>

          <div class="form-group">
            <label for="edit-prod-name">Ürün Adı *</label>
            <input type="text" id="edit-prod-name" class="form-control" required placeholder="Örn: Dokunmatik POS PC Terminali">
          </div>

          <div class="form-row grid-2">
            <div class="form-group">
              <label for="edit-prod-category">Kategori *</label>
              <select id="edit-prod-category" class="form-control" required>
                <option value="Dokunmatik POS PC">Dokunmatik POS PC</option>
                <option value="El Terminalleri">El Terminalleri</option>
                <option value="Barkod Okuyucular">Barkod Okuyucular</option>
                <option value="Restoran PDA">Restoran PDA</option>
                <option value="Termal Yazıcılar">Termal Yazıcılar</option>
                <option value="Elektronik Teraziler">Elektronik Teraziler</option>
                <option value="Yazılımlar">Yazılımlar</option>
                <option value="E-Dönüşüm">E-Dönüşüm</option>
              </select>
            </div>

            <div class="form-group">
              <label for="edit-prod-unit">Birim</label>
              <select id="edit-prod-unit" class="form-control">
                <option value="Adet">Adet</option>
                <option value="Lisans">Lisans</option>
                <option value="Set">Set</option>
                <option value="Paket">Paket</option>
              </select>
            </div>
          </div>

          <div class="form-row grid-2">
            <div class="form-group">
              <label for="edit-prod-price">Birim Fiyat (TL) *</label>
              <input type="number" id="edit-prod-price" class="form-control" step="0.01" required placeholder="15000">
            </div>

            <div class="form-group">
              <label for="edit-prod-stock">Stok Miktarı *</label>
              <input type="number" id="edit-prod-stock" class="form-control" required value="50">
            </div>
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="closeProductEditModal()">İptal</button>
            <button type="submit" class="btn btn-gold">Stok Oluştur / Kaydet</button>
          </div>
        </form>
      </div>
    </div>
  </div>

</div>

<script src="~/js/sahin_quote.js"></script>
