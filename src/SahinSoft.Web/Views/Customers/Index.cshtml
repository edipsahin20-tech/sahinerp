@model IReadOnlyList<SahinSoft.Web.Models.CustomerListItemViewModel>
@{
    ViewData["Title"] = "Cariler";
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}

<div class="erp-breadcrumb-v2">Cari Yönetimi <span>/</span> Cari Listesi</div>

<div class="erp-page-head">
    <div>
        <h1>Cari Listesi</h1>
        <p>Cari hesapları, bakiyeleri ve risk durumlarını yönetin.</p>
    </div>
    <div class="erp-page-head-actions">
        <button type="button" class="btn-erp-outline-secondary" data-csv-export="#customersTable" data-csv-name="cari-listesi">
            <i class="fa-solid fa-file-arrow-down"></i> Excel'e Aktar
        </button>
        <a asp-action="Create" class="btn-erp-list-new">+ Yeni Kayıt</a>
    </div>
</div>

<div class="erp-list-card">
    <form method="get" class="erp-list-card-toolbar">
        <div class="erp-search-input-group">
            <input type="text" autocomplete="off" placeholder="Kod, ünvan veya vergi no ile ara..." data-live-search="#customersTable" value="@ViewBag.Search" />
            <button type="button" onclick="this.previousElementSibling.focus()">Ara</button>
        </div>
        <select name="isActive" onchange="this.form.submit()">
            <option value="">Tüm Durumlar</option>
            <option value="true" selected="@(ViewBag.IsActive == true)">Aktif</option>
            <option value="false" selected="@(ViewBag.IsActive == false)">Pasif</option>
        </select>
    </form>

    <div class="erp-table-wrap">
        <table class="erp-table" id="customersTable" data-sortable data-paginate="20">
            <thead>
                <tr>
                    <th data-sort="text">Cari Kodu</th>
                    <th data-sort="text">Cari Ünvan</th>
                    <th data-sort="text">Telefon</th>
                    <th class="text-end" data-sort="number">Borç</th>
                    <th class="text-end" data-sort="number">Alacak</th>
                    <th class="text-end" data-sort="number">Bakiye</th>
                    <th data-sort="text">Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(item.IsActive ? "" : "text-secondary")">
                    <td><span class="erp-code-badge">@item.Code</span></td>
                    <td>
                        <a asp-action="Statement" asp-route-id="@item.Id" class="fw-semibold text-decoration-none" title="Cari Hareket Föyünü Görüntüle">@item.Name</a>
                        <div><small class="text-secondary">@item.City @item.District</small></div>
                    </td>
                    <td>@item.Phone</td>
                    <td class="text-end">@item.Debit.ToString("N2") ₺</td>
                    <td class="text-end">@item.Credit.ToString("N2") ₺</td>
                    <td class="text-end fw-semibold">
                        <a asp-action="Statement" asp-route-id="@item.Id" class="text-decoration-none" title="Cari Hareket Föyünü Görüntüle" style="color: inherit;">@item.Balance.ToString("N2") ₺</a>
                    </td>
                    <td>
                        @if (!item.IsActive) { <span class="erp-status-pill red">Pasif</span> }
                        else if (item.IsCustomer && item.IsSupplier) { <span class="erp-status-pill blue">Müşteri/Tedarikçi</span> }
                        else if (item.IsSupplier) { <span class="erp-status-pill gray">Tedarikçi</span> }
                        else { <span class="erp-status-pill green">Aktif</span> }
                    </td>
                    <td>
                        <div class="erp-row-actions">
                            <a asp-action="Statement" asp-route-id="@item.Id" title="Cari Hareket Föyü"><i class="fa-regular fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" title="Düzenle"><i class="fa-solid fa-pen"></i></a>
                            <a asp-action="PriceList" asp-route-id="@item.Id" title="Özel Fiyatlar"><i class="fa-solid fa-tags"></i></a>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr data-live-search-empty>
                    <td colspan="8" class="text-center text-secondary py-4">Kayıt bulunamadı.</td>
                </tr>
            }
            </tbody>
            @if (Model.Count > 0)
            {
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end">Toplam</td>
                        <td class="text-end" data-sum-col="3"></td>
                        <td class="text-end" data-sum-col="4"></td>
                        <td class="text-end" data-sum-col="5"></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>

    <div class="erp-list-card-footer">
        <span data-pagination-count-for="#customersTable">Toplam @Model.Count kayıt gösteriliyor</span>
        <div class="erp-pagination" data-pagination-for="#customersTable"></div>
    </div>
</div>
