@model IReadOnlyList<SahinSoft.Domain.Entities.Customer>
@{
    ViewData["Title"] = "Cariler";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Cariler</h1>
        <p class="text-secondary mb-0">@Model.Count kayıt listeleniyor.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Yeni cari</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<form method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex gap-2">
        <input name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Cari kodu, unvan veya vergi no ara..." />
        <button class="btn btn-outline-primary">Ara</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Cari kodu</th>
                    <th>Unvan</th>
                    <th>Vergi no</th>
                    <th>Telefon</th>
                    <th>Tür</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(item.IsActive ? "" : "text-secondary")">
                    <td class="fw-semibold">@item.Code</td>
                    <td>
                        <div>@item.Name</div>
                        <small class="text-secondary">@item.City @item.District</small>
                    </td>
                    <td>@item.TaxNumber</td>
                    <td>@item.Phone</td>
                    <td>
                        @if (item.IsCustomer) { <span class="badge text-bg-primary-subtle text-primary-emphasis">Müşteri</span> }
                        @if (item.IsSupplier) { <span class="badge text-bg-secondary-subtle text-secondary-emphasis">Tedarikçi</span> }
                        @if (!item.IsActive) { <span class="badge text-bg-danger-subtle text-danger-emphasis">Pasif</span> }
                    </td>
                    <td class="text-end">
                        <a asp-action="Statement" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ekstre</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
