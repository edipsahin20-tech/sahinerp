@model SahinSoft.Web.Models.RestaurantCheckViewModel
@{
    Layout = "_RestaurantShellLayout";
    ViewData["Title"] = $"Adisyon {Model.CheckNumber}";
}

@section Head {
    <link rel="stylesheet" href="~/css/restaurant-pos.css" asp-append-version="true" />
}

<div class="restaurant-pos pos-check-page" id="pos-root"
     data-check-id="@Model.CheckId"
     data-check-number="@Model.CheckNumber"
     data-table-label="@Model.SectionName — @Model.TableName"
     data-is-self-sale="@Model.IsSelfSaleCheck.ToString().ToLowerInvariant()"
     data-hold-url="@Url.Action("Hold", "RestaurantSelfSale")"
     data-send-url="@Url.Action("SendToKitchen")"
     data-close-url="@Url.Action("ClosePayment")"
     data-back-url="@Url.Action("Index")"
     data-today-receipts-url="@Url.Action("TodayReceipts")"
     data-receipt-lines-url="@Url.Action("ReceiptLines")"
     data-cancel-receipt-url="@Url.Action("CancelReceiptForEdit")"
     data-is-admin="@User.IsInRole(SahinSoft.Domain.Constants.AppRoles.Administrator).ToString().ToLowerInvariant()"
     data-require-cancellation-reason="@Model.RequireCancellationReason.ToString().ToLowerInvariant()"
     data-payable-total="@Model.PayableTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     data-fiscal-enabled="@Model.IsFiscalEnabled.ToString().ToLowerInvariant()"
     data-fiscal-agent-url="@Model.FiscalAgentUrl"
     data-cashier-name="@(((SahinSoft.Web.Models.RestaurantShellViewModel)ViewBag.Shell).UserFullName)">
    @Html.AntiForgeryToken()
    <input type="hidden" id="pos-submission-key" value="@Model.SubmissionKey" />
    <input type="hidden" id="pos-close-submission-key" value="@Model.ClosePaymentSubmissionKey" />

    <div class="erp-toolbar">
        <div class="erp-toolbar-title">
            <h1>@Model.SectionName — @Model.TableName</h1>
            <span class="erp-toolbar-meta">Adisyon @Model.CheckNumber · @Model.GuestCount kişi · @Model.OpenedAtUtc.ToLocalTime().ToString("HH:mm")</span>
        </div>
        <!-- "Kapat/Öde" ayrı bir buton/mantık olarak kaldırıldı - ödeme artık masa satışta da
             self satıştaki AYNI tek "Ödemeyi Al" akışı (bkz. cart-footer, #self-pay-btn) -
             (Edip, 2026-09-03: "self satış mantığı ekranı ödeme ekranı masa satışla ortak olsun
             ikisi de aynı mantıkta ... kapat ve ödeme mantığı kalksın"). -->
        <div class="erp-toolbar-actions">
            @if (!Model.IsSelfSaleCheck && Model.PayableTotal > 0)
            {
                @if (Model.BillRequested)
                {
                    <span class="badge text-bg-warning-subtle text-warning-emphasis">Hesap İstendi</span>
                }
                else
                {
                    <form method="post" asp-action="RequestBill" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="checkId" value="@Model.CheckId" />
                        <button type="submit" class="btn btn-erp-outline btn-sm">Hesap İstendi</button>
                    </form>
                }
            }
        </div>
    </div>

    <div id="unrouted-warning" class="alert alert-warning py-2" style="display:none;"></div>

    <div class="pos-layout">
        <div class="product-panel">
            <!-- Masaya Aktar / Masa Durumu üst başlıktan buraya taşındı - üstte yer açılsın
                 (Edip, 2026-09-03: "masa aktar masa durumunu da sol tarafa taşı yer açılsın"). -->
            <div class="product-panel-actions">
                @if (Model.IsSelfSaleCheck)
                {
                    <button type="button" class="btn btn-erp-outline btn-sm" data-bs-toggle="modal" data-bs-target="#transferToTableModal">⇄ Masaya Aktar</button>
                }
                <a asp-action="Index" class="btn btn-erp-outline btn-sm">← Masa Durumu</a>
                @if (!Model.IsSelfSaleCheck && Model.PayableTotal <= 0)
                {
                    <!-- Müşteri hiçbir şey almadan gitti / her şey iptal edildi - normal ödeme
                         akışı "Boş adisyon kapatılamaz" diyip masayı DOLU'da tutardı (Edip,
                         2026-09-03: "masa boşaldı ... o iptal hareketleri gelmesin boş gelsin"). -->
                    <form method="post" asp-action="VoidEmptyCheck" class="d-inline" onsubmit="return confirm('Masa boşaltılsın mı? Bu adisyon iptal edilecek.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="checkId" value="@Model.CheckId" />
                        <button type="submit" class="btn btn-erp-outline btn-sm">✕ Masayı Boşalt</button>
                    </form>
                }
            </div>
            <div class="product-search-row">
                <input type="text" id="product-search" class="product-search-input" placeholder="Ürün ara veya barkod okut..." autocomplete="off" />
            </div>
            <div class="category-tabs" id="category-tabs"></div>
            <div class="product-grid" id="product-grid"></div>
        </div>

        <div class="cart-panel">
            <!-- Sol taraftaki sabit numpad - Edip'in eski POS ekranındaki P/rakam şeridi
                 (Edip, 2026-09-03: "bide sol tarafında olsun turuncu ile işaretlediğim alana
                 koysun"). Rakamlar bir sonraki ürüne eklenecek ADEDİ belirler (örn: 5'e, sonra
                 çorbaya tıklarsa 5 çorba birden eklenir). P (Porsiyon) ise 0.5/1/1.5/Duble gibi
                 kesirli miktar seçtirir - fiyat zaten quantity*unitPrice ile orantılı hesaplandığı
                 için ayrı bir fiyat mantığı gerekmez, sadece miktar kesirli olur. ★'ın eski
                 ekrandaki tam karşılığı belirtilmediği için burada onun yerine o an bekleyen
                 miktarı canlı gösteren bir gösterge var (bkz. yanıt). -->
            <div class="cart-numpad" id="cart-numpad">
                <button type="button" class="cart-numpad-p" id="numpad-p-btn">P</button>
                <div class="cart-numpad-grid" id="numpad-digit-grid">
                    <button type="button" data-digit="1">1</button>
                    <button type="button" data-digit="2">2</button>
                    <button type="button" data-digit="3">3</button>
                    <button type="button" data-digit="4">4</button>
                    <button type="button" data-digit="5">5</button>
                    <button type="button" data-digit="6">6</button>
                </div>
                <div class="cart-numpad-portion-grid" id="numpad-portion-grid" style="display:none;">
                    <button type="button" data-portion="0.5">0.5</button>
                    <button type="button" data-portion="1">1</button>
                    <button type="button" data-portion="1.5">1.5</button>
                    <button type="button" data-portion="2">Duble</button>
                </div>
                <div class="cart-numpad-pending" id="numpad-pending" title="Eklenecek miktar">1</div>
                <button type="button" class="cart-numpad-clear" id="numpad-clear-btn">CL</button>
                <button type="button" class="cart-numpad-back" id="numpad-back-btn">⌫</button>
                <div class="cart-numpad-grid">
                    <button type="button" data-digit="7">7</button>
                    <button type="button" data-digit="8">8</button>
                    <button type="button" data-digit="9">9</button>
                    <button type="button" data-digit="0">0</button>
                </div>
            </div>

            <div class="cart-main">
                <div class="cart-header">
                    <strong>Yeni Sipariş</strong>
                </div>
                <!-- Satır işlem çubuğu SABİT - her satırın altında tekrarlanmaz, seçili satıra
                     uygulanır (Edip, 2026-09-03: "Not İndirim İptal Sil İkram bölümleri sabit
                     olsun sana gönderdiğim resimdeki gibi" - eski POS ekranındaki tek, hep aynı
                     yerde duran işlem şeridi referansı). -->
                <div class="cart-line-toolbar" id="cart-line-toolbar">
                    <div class="cart-qty-stepper">
                        <button type="button" id="line-qty-minus" disabled>−</button>
                        <span id="line-qty-value">–</span>
                        <button type="button" id="line-qty-plus" disabled>+</button>
                    </div>
                    <button type="button" id="line-act-note" disabled>Not</button>
                    <button type="button" id="line-act-discount" disabled>İndirim</button>
                    <button type="button" id="line-act-comp" disabled>İkram</button>
                    <button type="button" id="line-act-remove" class="danger" disabled>Sil</button>
                </div>
                <!-- Gönderilmiş (kalıcı) satırlar - "sepet"le AYNI yerde, ödeme ekranında
                     görünür, ayrı bir "mutfak" paneline hapsedilmez (Edip, 2026-09-03: "masa
                     sipariş girdiğimde ödeme ekranında gözüksün mutfağın içinde değil"). Durum
                     rozeti sadece KDS takibi açıkken anlamlı, kapalıyken hepsi zaten doğrudan
                     Servis Edildi olduğundan gösterilmez. -->
                <!-- Sabit şablon: Ürün Adı | Miktar | Birim Fiyat | Tutar - gönderilmiş ve
                     bekleyen satırlarda AYNI (Edip, 2026-09-03: "şablon bu şekilde sabit kalsın
                     ürün adı miktar birim fiyat tutar şeklinde olsun"). -->
                <div class="cart-lines-header">
                    <span>Ürün Adı</span><span>Miktar</span><span>Birim Fiyat</span><span>Tutar</span><span></span>
                </div>
                @{
                    // İptal edilen satırlar üzeri çizili göstermek yerine listeden TAMAMEN
                    // kaldırılır - kayıt DB'de reversal mantığıyla korunur, sadece ekranda
                    // görünmez (Edip, 2026-09-03: "iptal dediğimde direk silsin ekrandan, üzerini
                    // silmesin").
                    var visibleSentLines = Model.SentOrders.SelectMany(o => o.Lines.Select(l => (order: o, line: l)))
                        .Where(x => x.line.Status != "Cancelled")
                        .ToList();
                }
                @if (visibleSentLines.Count > 0)
                {
                    <div class="cart-sent-lines" id="cart-sent-lines">
                        @foreach (var (order, line) in visibleSentLines)
                        {
                            <div class="cart-line sent">
                                <div class="cart-line-col-name">@line.ProductName
                                    @if (!string.IsNullOrEmpty(line.PortionName)) { <text> (@line.PortionName)</text> }
                                    @if (line.IsComplimentary) { <span class="badge text-bg-info-subtle text-info-emphasis">İKRAM</span> }
                                    @if (line.DiscountAmount > 0 && !line.IsComplimentary) { <span class="badge text-bg-warning-subtle text-warning-emphasis">İndirim</span> }
                                    @if (Model.IsKitchenTrackingEnabled) { <span class="badge text-bg-secondary-subtle">@line.Status</span> }
                                    @if (!string.IsNullOrEmpty(line.KitchenNote)) { <div class="small text-secondary">Not: @line.KitchenNote</div> }
                                </div>
                                <div class="cart-line-col-qty">@line.Quantity.ToString("N0")</div>
                                <div class="cart-line-col-price">@line.UnitPrice.ToString("N2") ₺</div>
                                <div class="cart-line-col-total">@((line.Quantity * line.UnitPrice - line.DiscountAmount).ToString("N2")) ₺</div>
                                <div>
                                    @if (line.CanCancel)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger cancel-line-btn" data-line-id="@line.LineId">İptal</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="cart-lines" id="cart-lines">
                    <p class="text-secondary small p-2">Ürün eklemek için soldan seçim yapın.</p>
                </div>
                <div class="cart-footer">
                    <div class="d-flex justify-content-between">
                        <span>Toplam</span>
                        <span class="cart-total" id="cart-total">0,00 ₺</span>
                    </div>
                    <!-- Self satış ve masa satışta AYNI ödeme mantığı - "Kapat/Öde" ayrı bir buton
                         olarak kaldırıldı, tek "Ödemeyi Al" akışı ikisinde de burada
                         (Edip, 2026-09-03). -->
                    <div class="self-payrow">
                        <button type="button" class="self-payrow-kitchen" id="send-kitchen-btn" disabled>♨ Mutfağa Gönder</button>
                        <button type="button" class="self-payrow-pay" id="self-pay-btn"@(Model.PayableTotal > 0 ? "" : " disabled")>Ödemeyi Al</button>
                    </div>
                    <div class="self-quickpay" id="self-quickpay">
                        <button type="button" class="pay-method-btn n" data-quick-method="1">₺ Nakit</button>
                        <button type="button" class="pay-method-btn c" data-quick-method="2">▣ Kredi Kartı</button>
                        <button type="button" class="pay-method-btn y" data-quick-method="3">◇ Yemek Çeki</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağdaki sabit ikon şeridi - Edip'in eski POS ekranındaki hep aynı yerde duran
             yan panel (Edip, 2026-09-03: "sağ taraftaki sabit alanlar bizde de olsun"). -->
        <div class="pos-side-icons">
            <button type="button" class="pos-side-icon" data-bs-toggle="modal" data-bs-target="#ticketNoteModal">
                <span class="pos-side-icon-glyph">🗒</span>Fiş<br />Notu
            </button>
            @if (Model.IsSelfSaleCheck)
            {
                <button type="button" class="pos-side-icon" data-bs-toggle="modal" data-bs-target="#transferToTableModal">
                    <span class="pos-side-icon-glyph">⇄</span>Masa<br />Transfer
                </button>
            }
            <button type="button" class="pos-side-icon" id="side-kitchen-btn">
                <span class="pos-side-icon-glyph">♨</span>Mutfak
            </button>
            <button type="button" class="pos-side-icon" data-bs-toggle="modal" data-bs-target="#priceCheckModal">
                <span class="pos-side-icon-glyph">🔍</span>Fiyat<br />Gör
            </button>
            <button type="button" class="pos-side-icon" id="side-keyboard-btn">
                <span class="pos-side-icon-glyph">⌨</span>Klavye
            </button>
            <button type="button" class="pos-side-icon" id="side-hold-btn">
                <span class="pos-side-icon-glyph">⏸</span>Fişi<br />Beklet
            </button>
            <button type="button" class="pos-side-icon" data-bs-toggle="modal" data-bs-target="#heldReceiptsModal">
                <span class="pos-side-icon-glyph">📋</span>Bekleyen<br />Fişler
            </button>
            <button type="button" class="pos-side-icon" id="side-ticket-comp-btn">
                <span class="pos-side-icon-glyph">🎁</span>Fiş<br />İkram
            </button>
            <button type="button" class="pos-side-icon" data-bs-toggle="modal" data-bs-target="#receiptListModal">
                <span class="pos-side-icon-glyph">🧾</span>Fiş<br />Listesi
            </button>
        </div>
    </div>
</div>

@if (Model.IsSelfSaleCheck)
{
    <!-- "Fişi Beklet" self satışta BİLEREK yeni bir adisyon açar (bkz. RestaurantSelfSaleController.
         Hold ve restaurant-pos.js) - masa satışta buna gerek yok, masa zaten kendi kalıcı kaydı. -->
    <form method="post" asp-controller="RestaurantSelfSale" asp-action="Hold" id="hold-self-sale-form" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
}

<!-- Bekleyen Fişler - "Fişi Beklet" ile bu tarayıcıda (localStorage) bekletilmiş, henüz mutfağa
     gönderilmemiş sepetlerin listesi (Edip, 2026-09-03). Sunucuya bağlı DEĞİL, sadece bu
     cihazda/tarayıcıda görünür - bkz. restaurant-pos.js. -->
<div class="modal fade" id="heldReceiptsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bekleyen Fişler</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="held-receipts-list"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Fiş Listesi - bugün kesilmiş fişlerin kısa listesi, istenirse satırları sepete klonlanıp
     düzeltilebilir (Edip, 2026-09-03: "fiş listesi günlük fiş listesini gösterir isterse ekrana
     alıp düzeltebilir"). -->
<div class="modal fade" id="receiptListModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Fiş Listesi — Bugün</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="receipt-list-body" class="price-check-results"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Fiş Notu - adisyonun TAMAMINI ilgilendiren not (ürün bazlı Not'tan ayrı). -->
<div class="modal fade" id="ticketNoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="UpdateCheckNote">
                @Html.AntiForgeryToken()
                <input type="hidden" name="checkId" value="@Model.CheckId" />
                <div class="modal-header">
                    <h5 class="modal-title">Fiş Notu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary small">Bu not ürüne değil, adisyonun tamamına aittir.</p>
                    <textarea name="note" class="form-control" rows="4" maxlength="500" placeholder="Örn: Müşteri alerjik, fındık istemiyor.">@Model.TicketNote</textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-erp-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Fiyat Gör - müşteri kasada ürünün fiyatını/KDV'sini sormak için, kataloğu tekrar sorgulamadan
     (Edip, 2026-09-03: "müşteri rafta fiyatı göremedi, kasaya geldi, fiyat göre tıkla, ürün adı
     fiyatı KDV'si gelsin, ister iptal ister ekrana alsın"). Sunucudan zaten yüklü kataloğu
     kullanır - bkz. restaurant-pos.js. -->
<div class="modal fade" id="priceCheckModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Fiyat Gör</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="price-check-search" class="product-search-input" style="max-width:none;" placeholder="Ürün ara..." autocomplete="off" />
                <div id="price-check-results" class="price-check-results"></div>
                <div id="price-check-detail" class="price-check-detail" style="display:none;">
                    <div class="price-check-detail-name" id="price-check-name"></div>
                    <div class="price-check-detail-row"><span>Fiyat (KDV Dahil)</span><strong id="price-check-price"></strong></div>
                    <div class="price-check-detail-row"><span>KDV Oranı</span><strong id="price-check-tax"></strong></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-erp" id="price-check-add-btn" disabled>Ekrana Al</button>
            </div>
        </div>
    </div>
</div>

<!-- Klavye - dokunmatik ekranlarda fiziksel klavye olmadığı için sayfa üzerinde açılıp kapanan
     sanal klavye (Edip, 2026-09-03: "ekranlar dokunmatik olduğu için klavye gibi kullansın").
     Odaklanılan son metin alanına yazar - bkz. restaurant-pos.js. -->
<div class="pos-virtual-keyboard" id="pos-virtual-keyboard" style="display:none;">
    <div class="pos-vk-row">
        <button type="button" data-key="1">1</button><button type="button" data-key="2">2</button><button type="button" data-key="3">3</button><button type="button" data-key="4">4</button><button type="button" data-key="5">5</button><button type="button" data-key="6">6</button><button type="button" data-key="7">7</button><button type="button" data-key="8">8</button><button type="button" data-key="9">9</button><button type="button" data-key="0">0</button>
        <button type="button" class="pos-vk-wide" data-action="backspace">⌫</button>
    </div>
    <div class="pos-vk-row">
        <button type="button" data-key="q">q</button><button type="button" data-key="w">w</button><button type="button" data-key="e">e</button><button type="button" data-key="r">r</button><button type="button" data-key="t">t</button><button type="button" data-key="y">y</button><button type="button" data-key="u">u</button><button type="button" data-key="ı">ı</button><button type="button" data-key="o">o</button><button type="button" data-key="p">p</button><button type="button" data-key="ğ">ğ</button><button type="button" data-key="ü">ü</button>
    </div>
    <div class="pos-vk-row">
        <button type="button" data-key="a">a</button><button type="button" data-key="s">s</button><button type="button" data-key="d">d</button><button type="button" data-key="f">f</button><button type="button" data-key="g">g</button><button type="button" data-key="h">h</button><button type="button" data-key="j">j</button><button type="button" data-key="k">k</button><button type="button" data-key="l">l</button><button type="button" data-key="ş">ş</button><button type="button" data-key="i">i</button>
    </div>
    <div class="pos-vk-row">
        <button type="button" class="pos-vk-wide" data-action="shift">⇧</button>
        <button type="button" data-key="z">z</button><button type="button" data-key="x">x</button><button type="button" data-key="c">c</button><button type="button" data-key="v">v</button><button type="button" data-key="b">b</button><button type="button" data-key="n">n</button><button type="button" data-key="m">m</button><button type="button" data-key="ö">ö</button><button type="button" data-key="ç">ç</button>
        <button type="button" class="pos-vk-wide" data-action="close">✕ Kapat</button>
    </div>
    <div class="pos-vk-row">
        <button type="button" class="pos-vk-space" data-key=" ">boşluk</button>
    </div>
</div>

<!-- Satır iptal modalı -->
<div class="modal fade" id="cancelLineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="CancelOrderLine">
                @Html.AntiForgeryToken()
                <input type="hidden" name="checkId" value="@Model.CheckId" />
                <input type="hidden" name="lineId" id="cancelLineId" />
                <div class="modal-header">
                    <h5 class="modal-title">Sipariş Satırını İptal Et</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">İptal Gerekçesi</label>
                    <div id="cancel-reason-presets" class="mb-2 d-flex flex-wrap gap-1"></div>
                    <input type="text" name="reason" id="cancelReasonInput" class="form-control" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-danger">İptal Et</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.IsSelfSaleCheck)
{
    <!-- Masaya Aktar modalı - yalnızca Self Satış adisyonlarında render edilir -->
    <div class="modal fade" id="transferToTableModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-controller="RestaurantSelfSale" asp-action="TransferToTable" id="transfer-to-table-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="checkId" value="@Model.CheckId" />
                    <div class="modal-header">
                        <h5 class="modal-title">Masaya Aktar</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-secondary small">Sepetteki ürünler seçtiğiniz masanın adisyonuna taşınır. Masada açık adisyon varsa oraya eklenir, yoksa yeni açılır.</p>
                        <label class="form-label">Hedef Masa</label>
                        <select name="targetTableId" class="form-select" required>
                            <option value="">Seçiniz...</option>
                            @foreach (var table in Model.AvailableTables)
                            {
                                <option value="@table.TableId">@table.SectionName — @table.TableName @(table.IsOccupied ? "(dolu)" : "(boş)")</option>
                            }
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-erp-primary" id="confirm-transfer-btn">Masaya Aktar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Kapat / Öde modalı (master tasarım: parçalı ödeme, numpad, hazır para) -->
<div class="modal fade" id="closePaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content pay-modal">
            <div class="modal-header">
                <div>
                    <div class="pay-eyebrow" id="pay-partial-badge" style="display:none;">PARÇALI ÖDEME AKTİF</div>
                    <h5 class="modal-title mb-0">Ödeme Al</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="pay-summary-row">
                    <div><small>Toplam</small><strong id="pay-total"></strong></div>
                    <div><small>Ödenen</small><strong id="pay-paid">0,00 ₺</strong></div>
                    <div><small>Kalan</small><strong id="pay-remaining" class="text-danger"></strong></div>
                </div>

                <div id="close-payment-error" class="alert alert-danger py-2" style="display:none;"></div>

                <div id="close-payment-lines" class="pay-lines"></div>

                <div class="pay-split-row">
                    <span class="pay-split-label">Kalanı Böl:</span>
                    <button type="button" class="pay-split-btn" data-split="5">1/5</button>
                    <button type="button" class="pay-split-btn" data-split="4">1/4</button>
                    <button type="button" class="pay-split-btn" data-split="3">1/3</button>
                    <button type="button" class="pay-split-btn" data-split="2">1/2</button>
                    <button type="button" class="pay-split-btn" data-split="1">1/1</button>
                </div>

                <div class="pay-amount-card">
                    <small>ALINACAK TUTAR</small>
                    <div class="pay-amount-value" id="pay-entry-amount">0,00 ₺</div>
                </div>

                <div class="pay-numpad">
                    <button type="button" data-num="7">7</button>
                    <button type="button" data-num="8">8</button>
                    <button type="button" data-num="9">9</button>
                    <button type="button" data-num="4">4</button>
                    <button type="button" data-num="5">5</button>
                    <button type="button" data-num="6">6</button>
                    <button type="button" data-num="1">1</button>
                    <button type="button" data-num="2">2</button>
                    <button type="button" data-num="3">3</button>
                    <button type="button" data-num=",">,</button>
                    <button type="button" data-num="0">0</button>
                    <button type="button" id="pay-num-clear">CL</button>
                </div>

                <div class="pay-cash-row">
                    <button type="button" class="pay-cash-quick" data-cash="5">5</button>
                    <button type="button" class="pay-cash-quick" data-cash="10">10</button>
                    <button type="button" class="pay-cash-quick" data-cash="20">20</button>
                    <button type="button" class="pay-cash-quick" data-cash="50">50</button>
                    <button type="button" class="pay-cash-quick" data-cash="100">100</button>
                    <button type="button" class="pay-cash-quick" data-cash="200">200</button>
                </div>

                <div class="pay-method-row">
                    <button type="button" class="pay-method-btn n" data-method="1">₺ Nakit</button>
                    <button type="button" class="pay-method-btn c" data-method="2">▣ Kredi Kartı</button>
                    <button type="button" class="pay-method-btn y" data-method="3">◇ Yemek Çeki</button>
                </div>
            </div>
            <div class="modal-footer pay-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">× Ödeme İptal</button>
                <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">‹ Adisyona Dön</button>
                <button type="button" class="btn btn-erp" id="confirm-close-payment-btn" disabled>Siparişi Tamamla</button>
            </div>
        </div>
    </div>
</div>

<style>
    .pay-eyebrow { font-size: 11px; letter-spacing: .1em; color: #C99935; font-weight: 800; text-transform: uppercase; margin-bottom: 2px; }
    .pay-summary-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-bottom: 12px; }
    .pay-summary-row > div { background: #FAFBFD; border: 1px solid #E3E8EF; border-radius: 10px; padding: 10px 12px; }
    .pay-summary-row small { display: block; color: #6F7F92; font-size: 11px; }
    .pay-summary-row strong { display: block; font-size: 17px; margin-top: 2px; }
    .pay-lines { margin-bottom: 10px; max-height: 140px; overflow-y: auto; }
    .pay-line-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; border: 1px solid #E3E8EF; border-radius: 8px; margin-bottom: 6px; font-size: 13.5px; background: #fff; }
    .pay-line-row button { border: none; background: none; color: #D94A4A; font-weight: 700; cursor: pointer; }
    .pay-split-row { display: flex; align-items: center; gap: 6px; margin-bottom: 10px; flex-wrap: wrap; }
    .pay-split-label { font-size: 12px; color: #6F7F92; margin-right: 4px; }
    .pay-split-btn, .pay-cash-quick { border: 1px solid #E3E8EF; background: #fff; border-radius: 8px; padding: 6px 12px; font-weight: 700; font-size: 12.5px; cursor: pointer; }
    .pay-split-btn:hover, .pay-cash-quick:hover { border-color: #D2DAE5; background: #F4F6F9; }
    .pay-amount-card { background: #FAFBFD; border: 1px solid #E3E8EF; border-radius: 10px; padding: 10px 14px; margin-bottom: 10px; }
    .pay-amount-card small { color: #6F7F92; font-size: 11px; }
    .pay-amount-value { font-size: 26px; font-weight: 800; letter-spacing: -.02em; }
    .pay-numpad { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; margin-bottom: 10px; }
    .pay-numpad button { min-height: 46px; border: 1px solid #E3E8EF; background: #fff; border-radius: 8px; font-weight: 700; font-size: 16px; cursor: pointer; }
    .pay-numpad button:active { background: #F4F6F9; }
    .pay-cash-row { display: grid; grid-template-columns: repeat(6,1fr); gap: 8px; margin-bottom: 12px; }
    .pay-method-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; }
    .pay-method-btn { min-height: 48px; border: 0; border-radius: 9px; font-weight: 800; cursor: pointer; font-size: 13.5px; }
    .pay-method-btn.n { background: #b6dfc8; }
    .pay-method-btn.c { background: #c2afe9; }
    .pay-method-btn.y { background: #f3d09a; }
    .pay-footer { display: grid; grid-template-columns: 1fr 1fr 1.5fr; gap: 10px; }

    /* Self Satış hızlı ödeme kısayolları - MASTER tasarımdaki ürün panelinin altındaki
       Nakit/Kredi Kartı/Yemek Çeki satırı (bkz. restaurant-pos.js/restaurant-close-payment.js). */
    .self-quickpay { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; margin-top: 1rem; }
    .self-quickpay .pay-method-btn:disabled { opacity: .5; cursor: default; }

    /* Self Satış sepet altı - MASTER'ın order-foot/payrow'u birebir (Mutfağa Gönder + Ödemeyi Al
       yan yana, aynı renkler); toolbar'daki Kapat/Öde bu ekranda gizlenir (bkz. self-pay-btn'in
       onu tetiklediği restaurant-close-payment.js). */
    .self-payrow { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 0.5rem; }
    .self-payrow button { padding: 14px; border: 0; border-radius: 9px; font-weight: 800; cursor: pointer; font-size: 0.95rem; }
    .self-payrow button:disabled { opacity: .5; cursor: default; }
    .self-payrow-kitchen { background: #FFF2D1; color: #A96E00; }
    .self-payrow-pay { background: #E5A600; color: #fff; }
</style>

@section Scripts {
    @{
        // System.Text.Json.JsonSerializer.Serialize varsayılanı PascalCase üretir (MVC'nin Json()
        // yardımcısındaki camelCase politikasını KULLANMAZ) — JS tarafı camelCase okuduğu için
        // burada açıkça belirtilmesi gerekiyor, aksi halde her alan sessizce undefined döner.
        var catalogJsonOptions = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
        // Yazar kasa entegrasyonu için - sadece iptal edilmemiş, gönderilmiş satırlar. Kapat/Öde
        // anında JS bunu okuyup fiscal agent'a gönderir (bkz. data-fiscal-enabled).
        var fiscalLines = Model.SentOrders
            .SelectMany(o => o.Lines)
            .Where(l => l.Status != "Cancelled")
            .Select(l => new { name = l.ProductName, quantity = l.Quantity, unitPrice = l.UnitPrice, discountAmount = l.DiscountAmount });
    }
    <script id="pos-catalog-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Catalog, catalogJsonOptions))</script>
    <script id="pos-financial-accounts-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FinancialAccounts, catalogJsonOptions))</script>
    <script id="pos-fiscal-lines-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(fiscalLines, catalogJsonOptions))</script>
    <script id="pos-cancellation-reasons-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CancellationReasonPresets, catalogJsonOptions))</script>
    <script id="pos-quick-notes-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.QuickNotePresets, catalogJsonOptions))</script>
    <script src="~/js/restaurant-pos.js" asp-append-version="true"></script>
    <script>
        (function () {
            // İptal gerekçesi sorulsun mu - parametre (Edip, 2026-09-03: "iptal nedeni sorulsun
            // mu diye parametre bağla, şimdilik default sorulmasın"). Kapalıyken modal hiç
            // açılmaz, otomatik bir gerekçeyle direkt iptal edilir.
            var requireReason = document.getElementById('pos-root').getAttribute('data-require-cancellation-reason') === 'true';
            var reasonPresets = JSON.parse(document.getElementById('pos-cancellation-reasons-data').textContent || '[]');
            var cancelForm = document.querySelector('#cancelLineModal form');
            var reasonInput = document.getElementById('cancelReasonInput');
            var presetsEl = document.getElementById('cancel-reason-presets');

            reasonPresets.forEach(function (reasonText) {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn btn-sm btn-outline-secondary';
                btn.textContent = reasonText;
                btn.addEventListener('click', function () { reasonInput.value = reasonText; });
                presetsEl.appendChild(btn);
            });

            document.querySelectorAll('.cancel-line-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('cancelLineId').value = btn.getAttribute('data-line-id');
                    if (requireReason) {
                        new bootstrap.Modal(document.getElementById('cancelLineModal')).show();
                    } else {
                        reasonInput.value = 'Kasiyer iptali';
                        cancelForm.submit();
                    }
                });
            });
        })();
    </script>
    <script src="~/js/restaurant-close-payment.js" asp-append-version="true"></script>
}
