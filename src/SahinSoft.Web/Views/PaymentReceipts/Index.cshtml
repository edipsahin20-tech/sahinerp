@using SahinSoft.Domain.Enums
@model IReadOnlyList<SahinSoft.Domain.Entities.PaymentReceipt>
@{
    ViewData["Title"] = "Tahsilat/Tediye";
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-hand-holding-dollar"></i> Tahsilat / Tediye</h2>
        <div class="d-flex gap-2">
            <a asp-action="Create" asp-route-type="@ReceiptType.Payment" class="btn-erp-list-new">+ Tediye (Ödeme)</a>
            <a asp-action="Create" asp-route-type="@ReceiptType.Collection" class="btn-erp-list-new">+ Tahsilat</a>
        </div>
    </div>
    <div class="erp-list-body">
        <div class="erp-list-topbar">
            <div class="erp-list-topbar-left">
                <div class="erp-list-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" class="form-control" autocomplete="off" placeholder="Fiş no veya cari ara..." data-live-search="#paymentReceiptsTable">
                </div>
                <form method="get" class="erp-list-filter d-flex gap-2">
                    <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<ReceiptType>()" onchange="this.form.submit()">
                        <option value="">Tüm türler</option>
                    </select>
                    <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<PaymentReceiptStatus>()" onchange="this.form.submit()">
                        <option value="">Tüm durumlar</option>
                    </select>
                </form>
            </div>
            <span class="text-secondary">Toplam <strong>@Model.Count</strong> kayıt.</span>
        </div>

        <div class="erp-table-wrap">
            <table class="erp-table" id="paymentReceiptsTable">
                <thead>
                    <tr>
                        <th>Fiş No</th>
                        <th>Tür</th>
                        <th>Tarih</th>
                        <th>Cari</th>
                        <th>Durum</th>
                        <th class="text-end">Tutar</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var statusClass = item.Status switch
                    {
                        PaymentReceiptStatus.Draft => "gray",
                        PaymentReceiptStatus.Approved => "green",
                        _ => "red"
                    };
                    var statusText = item.Status switch
                    {
                        PaymentReceiptStatus.Draft => "Taslak",
                        PaymentReceiptStatus.Approved => "Onaylı",
                        _ => "İptal"
                    };
                    <tr>
                        <td><span class="erp-code-badge">@item.ReceiptNumber</span></td>
                        <td>@(item.ReceiptType == ReceiptType.Collection ? "Tahsilat" : "Tediye")</td>
                        <td>@item.ReceiptDateUtc.ToString("dd.MM.yyyy")</td>
                        <td class="fw-semibold">@item.Customer.Name</td>
                        <td><span class="erp-status-pill @statusClass">@statusText</span></td>
                        <td class="text-end fw-semibold">@item.TotalAmount.ToString("N2") ₺</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-erp-list-action">Görüntüle</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-4">Kayıt bulunamadı.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
