@model SahinSoft.Web.Models.StockValuationViewModel
@{
    ViewData["Title"] = "Stok Değer Raporu";
}
<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-boxes-stacked"></i> Stok Değer Raporu</h2>
        <div class="d-flex gap-2 no-print"><button type="button" class="btn-erp-list-new" onclick="window.print()">Yazdır</button></div>
    </div>
    <div class="erp-list-body">
        <p class="text-secondary small">Maliyet (muhasebe): giriş hareketlerinin ağırlıklı ortalaması — alış faturası iskonto düşülmüş KDV hariç net birim fiyatı. KDV dahil sütunlar bilgi içindir (indirilebilir KDV maliyete girmez). Satış değeri KDV hariç satış fiyatıyla hesaplanır.</p>
        <form method="get" class="erp-filter-bar">
            <div class="erp-field"><label>Depo</label><select name="warehouseId" class="form-select" asp-items="Model.Warehouses"><option value="">Tüm depolar</option></select></div>
            <div class="erp-field"><label>Kategori</label><select name="categoryId" class="form-select" asp-items="Model.Categories"><option value="">Tüm kategoriler</option></select></div>
            <div class="erp-field"><label>Stok</label><select name="onlyInStock" class="form-select"><option value="true" selected="@Model.OnlyInStock">Yalnız stokta olanlar</option><option value="false" selected="@(!Model.OnlyInStock)">Tümü</option></select></div>
            <button class="btn btn-erp-primary">Filtrele</button>
        </form>
        <div class="erp-summary-row">
            <div class="erp-summary-box"><div class="erp-summary-label">Toplam Miktar</div><div class="erp-summary-value">@Model.TotalQuantity.ToString("N3")</div></div>
            <div class="erp-summary-box"><div class="erp-summary-label">Stok Maliyet Değeri</div><div class="erp-summary-value">@Model.TotalValue.ToString("N2") ₺</div></div>
            <div class="erp-summary-box"><div class="erp-summary-label">Satış Değeri (KDV hariç)</div><div class="erp-summary-value">@Model.TotalSaleValue.ToString("N2") ₺</div></div>
            <div class="erp-summary-box"><div class="erp-summary-label">Potansiyel Brüt Kâr</div><div class="erp-summary-value">@((Model.TotalSaleValue - Model.TotalValue).ToString("N2")) ₺</div></div>
        </div>
        <div class="erp-list-search mb-2" style="max-width: 320px;"><i class="fa-solid fa-magnifying-glass"></i><input type="text" class="form-control" autocomplete="off" placeholder="Stok ara..." data-live-search="#valuationTable"></div>
        <div class="erp-table-wrap">
            <table class="erp-table" id="valuationTable" data-sortable>
                <thead><tr><th data-sort="text">Stok Kodu</th><th data-sort="text">Stok Adı</th><th data-sort="text">Kategori</th><th class="text-end" data-sort="number">Miktar</th><th class="text-end" data-sort="number">Ort. Maliyet (KDV hariç)</th><th class="text-end" data-sort="number">Maliyet Değeri (KDV hariç)</th><th class="text-end" data-sort="number">Ort. Maliyet (KDV dahil)</th><th class="text-end" data-sort="number">Maliyet Değeri (KDV dahil)</th><th class="text-end" data-sort="number">Satış Fiyatı (KDV hariç)</th><th class="text-end" data-sort="number">Satış Değeri</th></tr></thead>
                <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr><td><span class="erp-code-badge">@r.StockCode</span></td><td>@r.Name</td><td>@r.Category</td>
                        <td class="text-end">@r.Quantity.ToString("N3")</td><td class="text-end">@r.AverageCost.ToString("N4")</td><td class="text-end fw-semibold">@r.Value.ToString("N2")</td><td class="text-end">@r.AverageCostInclTax.ToString("N4")</td><td class="text-end">@r.ValueInclTax.ToString("N2")</td>
                        <td class="text-end">@r.SaleNet.ToString("N2")</td><td class="text-end">@r.SaleValue.ToString("N2")</td></tr>
                }
                @if (Model.Rows.Count == 0) { <tr data-live-search-empty><td colspan="10" class="text-center text-secondary py-4">Kayıt yok.</td></tr> }
                </tbody>
                @if (Model.Rows.Count > 0) { <tfoot><tr><td colspan="3" class="text-end fw-bold">Toplam</td><td class="text-end fw-bold">@Model.TotalQuantity.ToString("N3")</td><td></td><td class="text-end fw-bold">@Model.TotalValue.ToString("N2")</td><td></td><td class="text-end fw-bold">@Model.TotalValueInclTax.ToString("N2")</td><td></td><td class="text-end fw-bold">@Model.TotalSaleValue.ToString("N2")</td></tr></tfoot> }
            </table>
        </div>
    </div>
</div>
<style media="print">
    @@page { size: A4 landscape; margin: 8mm; }
    .erp-list-header .no-print, .erp-filter-bar, .erp-list-search { display: none !important; }
    .erp-table-wrap { overflow: visible !important; }
    .erp-table { font-size: 8pt; }
    .erp-table th, .erp-table td { padding: 2px 4px !important; }
</style>
