@model SahinSoft.Web.Models.RestaurantCheckViewModel
@{
    Layout = "_RestaurantShellLayout";
    ViewData["Title"] = $"Adisyon {Model.CheckNumber}";
    // GERÇEK HATA (2026-09-05, Edip'in bildirimiyle bulundu: "alt taraf sabit kalmıyor, Cari/
    // İndirim/Kapat tuşları gidiyor") - .rest-main (kabuk içeriği) varsayılan olarak KENDİSİ
    // overflow:auto'dur (bkz. restaurant-shell.css) - bu sayfa büyüdükçe (satır sayısı arttıkça)
    // sadece kendi içindeki .cart-lines/.cart-sent-lines DEĞİL, TÜM .rest-main kaymaya başlıyor,
    // alttaki sabit kalması gereken özet/butonlar ekran dışına düşüyordu - .pos-check-page'in
    // KENDİ "height:100%; overflow:hidden" sabitlemesi ancak ebeveyni de sabitse işe yarar.
    // MainFixed=true, .rest-main'i .rest-main-fixed'e çevirir (overflow:hidden) - Raporlar'ın
    // kullandığı AYNI kabuk mekanizması, .report-scroll-area'ya gerek yok çünkü bu sayfa zaten
    // kendi iç kaydırmasını (.cart-lines/.cart-sent-lines) kendisi yönetiyor.
    ViewData["MainFixed"] = true;
    ViewData["MainNoRightPad"] = true;
    // Self Satış/Paket gizli sanal masaları bölüm adıyla AYNI masa adını taşır (bkz.
    // RestaurantPostingService.CreateSelfSaleCheckAsync yorumu) - başlıkta "Self Satış — Self
    // Satış" gibi anlamsız tekrar göstermemek için sadece görünümde birleştiriliyor, veri modeli
    // dokunulmadı.
    var tableLabel = Model.SectionName == Model.TableName ? Model.SectionName : $"{Model.SectionName} — {Model.TableName}";
}

@section Head {
    <link rel="stylesheet" href="~/css/restaurant-pos.css" asp-append-version="true" />
}

<div class="restaurant-pos pos-check-page" id="pos-root"
     data-check-id="@Model.CheckId"
     data-check-number="@Model.CheckNumber"
     data-table-label="@tableLabel"
     data-is-self-sale="@Model.IsSelfSaleCheck.ToString().ToLowerInvariant()"
     data-hold-url="@Url.Action("Hold", "RestaurantSelfSale")"
     data-send-url="@Url.Action("SendToKitchen")"
     data-close-url="@Url.Action("ClosePayment")"
     data-back-url="@Url.Action("Index")"
     data-self-sale-url="@Url.Action("Index", "RestaurantSelfSale")"
     data-held-receipts-url="@Url.Action("HeldReceipts", "RestaurantSelfSale")"
     data-recall-held-url="@Url.Action("Recall", "RestaurantSelfSale")"
     data-filtered-receipts-url="@Url.Action("FilteredReceipts")"
     data-receipt-lines-url="@Url.Action("ReceiptLines")"
     data-search-products-url="@Url.Action("SearchProducts")"
     data-cancel-receipt-url="@Url.Action("CancelReceiptForEdit")"
     data-apply-discount-url="@Url.Action("ApplyDiscount")"
     data-apply-receipt-comp-url="@Url.Action("ApplyReceiptComplimentary")"
     data-is-admin="@User.IsInRole(SahinSoft.Domain.Constants.AppRoles.Administrator).ToString().ToLowerInvariant()"
     data-require-cancellation-reason="@Model.RequireCancellationReason.ToString().ToLowerInvariant()"
     data-require-second-approval-cancel-line="@Model.RequireSecondApprovalForCancelOrderLine.ToString().ToLowerInvariant()"
     data-require-second-approval-edit-kitchen-sent="@Model.RequireSecondApprovalForEditKitchenSentLines.ToString().ToLowerInvariant()"
     data-require-second-approval-complimentary="@Model.RequireSecondApprovalForComplimentary.ToString().ToLowerInvariant()"
     data-require-second-approval-discount="@Model.RequireSecondApprovalForDiscount.ToString().ToLowerInvariant()"
     data-require-receipt-prompt-after-quickpay="@Model.RequireReceiptPromptAfterQuickPay.ToString().ToLowerInvariant()"
     data-add-pending-payment-url="@Url.Action("AddPendingPayment")"
     data-remove-pending-payment-url="@Url.Action("RemovePendingPayment")"
     data-cancel-pending-payments-url="@Url.Action("CancelPendingPayments")"
     data-receipt-url-template="@Url.Action("Receipt", new { id = -1 })"
     data-payable-total="@Model.PayableTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     data-ticket-discount-amount="@Model.TicketDiscountAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     data-sent-lines-gross-total="@Model.SentOrders.SelectMany(o => o.Lines).Where(l => l.Status != "Cancelled").Sum(l => l.Quantity * l.UnitPrice).ToString(System.Globalization.CultureInfo.InvariantCulture)"
     data-fiscal-enabled="@Model.IsFiscalEnabled.ToString().ToLowerInvariant()"
     data-fiscal-agent-url="@Model.FiscalAgentUrl"
     data-cashier-name="@(((SahinSoft.Web.Models.RestaurantShellViewModel)ViewBag.Shell).UserFullName)">
    @Html.AntiForgeryToken()
    <input type="hidden" id="pos-submission-key" value="@Model.SubmissionKey" />
    <input type="hidden" id="pos-close-submission-key" value="@Model.ClosePaymentSubmissionKey" />

    <div class="erp-toolbar">
        <div class="erp-toolbar-title">
            <h1>@tableLabel</h1>
            <span class="erp-toolbar-meta">Adisyon @Model.CheckNumber · @Model.GuestCount kişi · @Model.OpenedAtUtc.ToLocalTime().ToString("HH:mm")</span>
        </div>
        <!-- "Kapat/Öde" ayrı bir buton/mantık olarak kaldırıldı - ödeme artık masa satışta da
             self satıştaki AYNI tek "Ödemeyi Al" akışı (bkz. cart-footer, #self-pay-btn) -
             (Edip, 2026-09-03: "self satış mantığı ekranı ödeme ekranı masa satışla ortak olsun
             ikisi de aynı mantıkta ... kapat ve ödeme mantığı kalksın"). -->
        <div class="erp-toolbar-actions">
            @if (!Model.IsSelfSaleCheck && Model.PayableTotal > 0)
            {
                @if (Model.BillRequested)
                {
                    <span class="badge text-bg-warning-subtle text-warning-emphasis">Hesap İstendi</span>
                }
                else
                {
                    <form method="post" asp-action="RequestBill" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="checkId" value="@Model.CheckId" />
                        <button type="submit" class="btn btn-erp-outline btn-sm">Hesap İstendi</button>
                    </form>
                }
            }
        </div>
    </div>

    <div id="unrouted-warning" class="alert alert-warning py-2" style="display:none;"></div>

    <div class="pos-layout">
        <div class="product-panel">
            <div class="product-panel-actions">
                @if (!Model.IsSelfSaleCheck && Model.PayableTotal <= 0)
                {
                    <!-- Müşteri hiçbir şey almadan gitti / her şey iptal edildi - normal ödeme
                         akışı "Boş adisyon kapatılamaz" diyip masayı DOLU'da tutardı (Edip,
                         2026-09-03: "masa boşaldı ... o iptal hareketleri gelmesin boş gelsin"). -->
                    <form method="post" asp-action="VoidEmptyCheck" class="d-inline" onsubmit="return confirm('Masa boşaltılsın mı? Bu adisyon iptal edilecek.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="checkId" value="@Model.CheckId" />
                        <button type="submit" class="btn btn-erp-outline btn-sm">✕ Masayı Boşalt</button>
                    </form>
                }
            </div>
            <div class="category-tabs" id="category-tabs"></div>
            <div class="product-grid" id="product-grid"></div>
        </div>

        <div class="cart-panel">
            <!-- Sol taraftaki sabit numpad - Edip'in eski POS ekranındaki P/rakam şeridi
                 (Edip, 2026-09-03: "bide sol tarafında olsun turuncu ile işaretlediğim alana
                 koysun"). Rakamlar bir sonraki ürüne eklenecek ADEDİ belirler (örn: 5'e, sonra
                 çorbaya tıklarsa 5 çorba birden eklenir). P (Porsiyon) ise 0.5/1/1.5/Duble gibi
                 kesirli miktar seçtirir - fiyat zaten quantity*unitPrice ile orantılı hesaplandığı
                 için ayrı bir fiyat mantığı gerekmez, sadece miktar kesirli olur. ★'ın eski
                 ekrandaki tam karşılığı belirtilmediği için burada onun yerine o an bekleyen
                 miktarı canlı gösteren bir gösterge var (bkz. yanıt). -->
            <div class="cart-numpad" id="cart-numpad">
                <button type="button" class="cart-numpad-p" id="numpad-p-btn">P</button>
                <div class="cart-numpad-grid" id="numpad-digit-grid">
                    <button type="button" data-digit="1">1</button>
                    <button type="button" data-digit="2">2</button>
                    <button type="button" data-digit="3">3</button>
                    <button type="button" data-digit="4">4</button>
                    <button type="button" data-digit="5">5</button>
                    <button type="button" data-digit="6">6</button>
                </div>
                <div class="cart-numpad-portion-grid" id="numpad-portion-grid" style="display:none;">
                    <button type="button" data-portion="0.5">0.5</button>
                    <button type="button" data-portion="1">1</button>
                    <button type="button" data-portion="1.5">1.5</button>
                    <button type="button" data-portion="2">Duble</button>
                </div>
                <div class="cart-numpad-pending" id="numpad-pending" title="Eklenecek miktar">1</div>
                <button type="button" class="cart-numpad-clear" id="numpad-clear-btn">CL</button>
                <button type="button" class="cart-numpad-back" id="numpad-back-btn">⌫</button>
                <div class="cart-numpad-grid">
                    <button type="button" data-digit="7">7</button>
                    <button type="button" data-digit="8">8</button>
                    <button type="button" data-digit="9">9</button>
                    <button type="button" data-digit="0">0</button>
                </div>
            </div>

            <div class="cart-main">
                <!-- Masaya Aktar/Masa Durumu tekrar üst başlığa taşındı, "Yeni Sipariş"in
                     karşısına (Edip, 2026-09-05, onaylı görsel: "butun butonlar ... konumları
                     herşey") - eski 2026-09-03 kararının (sol tarafa taşı) YERİNE geçti. -->
                <div class="cart-header">
                    <div class="cart-header-title">
                        <strong>Yeni Sipariş</strong>
                        <span class="cart-header-checknum">@Model.CheckNumber</span>
                    </div>
                    <div class="cart-header-actions">
                        @if (Model.IsSelfSaleCheck)
                        {
                            <button type="button" class="btn btn-erp-outline btn-sm" data-bs-toggle="modal" data-bs-target="#transferToTableModal">⇄ Masaya Aktar</button>
                        }
                        <a asp-action="Index" class="btn btn-erp-outline btn-sm">▤ Masa Durumu</a>
                    </div>
                    <!-- Ürün arama/barkod okutma sağ tarafa, "Yeni Sipariş"in altına taşındı
                         (Edip, 2026-09-03: "ürün arama ve barkod arama sağ tarafta ürün
                         şablonunda yeni siparişin altında olsun"). -->
                    <div class="product-search-row">
                        <span class="product-search-icon">🔍</span>
                        <input type="text" id="product-search" class="product-search-input" placeholder="Ürün ara veya barkod okut..." autocomplete="off" />
                        <span class="product-search-scan">⌨</span>
                    </div>
                </div>
                <!-- Satır işlem çubuğu SABİT - her satırın altında tekrarlanmaz, seçili satıra
                     uygulanır (Edip, 2026-09-03: "Not İndirim İptal Sil İkram bölümleri sabit
                     olsun sana gönderdiğim resimdeki gibi" - eski POS ekranındaki tek, hep aynı
                     yerde duran işlem şeridi referansı). -->
                <div class="cart-line-toolbar" id="cart-line-toolbar">
                    <div class="cart-qty-stepper">
                        <button type="button" id="line-qty-minus">−</button>
                        <span id="line-qty-value">–</span>
                        <button type="button" id="line-qty-plus">+</button>
                    </div>
                    <button type="button" id="line-act-note">★ Not</button>
                    <button type="button" id="line-act-discount">✏ İndirim</button>
                    <button type="button" id="line-act-comp">★ İkram</button>
                    <button type="button" id="line-act-remove" class="danger">⊘ Sil</button>
                </div>
                <!-- Gönderilmiş (kalıcı) satırlar - "sepet"le AYNI yerde, ödeme ekranında
                     görünür, ayrı bir "mutfak" paneline hapsedilmez (Edip, 2026-09-03: "masa
                     sipariş girdiğimde ödeme ekranında gözüksün mutfağın içinde değil"). Durum
                     rozeti sadece KDS takibi açıkken anlamlı, kapalıyken hepsi zaten doğrudan
                     Servis Edildi olduğundan gösterilmez. -->
                <!-- Sabit şablon: Ürün Adı | Miktar | Birim | KDV | Fiyat | Tutar - gönderilmiş
                     ve bekleyen satırlarda AYNI (Edip, 2026-09-03: "ürün şablonu böyle olsun"). -->
                <div class="cart-lines-header-scroll">
                    <div class="cart-lines-header">
                        <!-- Baştaki "#" sıra numarası sütunu (Edip, 2026-09-05: "sıra numaralarını
                             göstersin 1,2,3 devam etsin kaç ürün varsa") - gönderilmiş VE bekleyen
                             satırlarda ortak, kesintisiz tek bir sayaç (bkz. aşağıdaki @@for ve
                             restaurant-pos.js renderCart() sentLineCount devamı). -->
                        <span>#</span><span>Ürün Adı</span><span>Miktar</span><span>Birim</span><span>KDV</span><span>Birim Fiyat</span><span>Tutar</span>
                    </div>
                </div>
                @{
                    // İptal edilen satırlar üzeri çizili göstermek yerine listeden TAMAMEN
                    // kaldırılır - kayıt DB'de reversal mantığıyla korunur, sadece ekranda
                    // görünmez (Edip, 2026-09-03: "iptal dediğimde direk silsin ekrandan, üzerini
                    // silmesin").
                    var visibleSentLines = Model.SentOrders.SelectMany(o => o.Lines.Select(l => (order: o, line: l)))
                        .Where(x => x.line.Status != "Cancelled")
                        .ToList();
                }
                @if (visibleSentLines.Count > 0)
                {
                    <div class="cart-sent-lines" id="cart-sent-lines">
                        @for (var sentIdx = 0; sentIdx < visibleSentLines.Count; sentIdx++)
                        {
                            var order = visibleSentLines[sentIdx].order;
                            var line = visibleSentLines[sentIdx].line;
                            <!-- Onaylı görsel isteği (Edip, 2026-09-05, "Adisyona Dön"dükten sonra
                                 sağ taraftaki küçük simgeler çıkmasın, sabit üst satırdaki
                                 miktar+/-/Sil/İkram alanlarından yapayım") - satır sağdaki KÜÇÜK
                                 ikonlar yerine PENDING (henüz gönderilmemiş) sepet satırlarıyla AYNI
                                 tıkla-seç + sabit araç çubuğu (#line-qty-minus/plus, #line-act-comp,
                                 #line-act-remove) mekanizmasını kullanıyor - AYNI sunucu uçları
                                 (adjust-line-qty-form/toggle-line-comp-form/cancel-line-btn akışı,
                                 PIN onayı dahil), sadece tetikleme yeri değişti. -->
                            <div class="cart-line sent@(line.CanCancel ? " selectable" : "")" data-line-id="@line.LineId" data-qty="@line.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-discount="@line.DiscountAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <div class="cart-line-col-no">@(sentIdx + 1)</div>
                                <div class="cart-line-col-name">
                                    <span class="cart-line-name-text">@line.ProductName@(!string.IsNullOrEmpty(line.PortionName) ? $" ({line.PortionName})" : "")</span>
                                    @if (line.IsComplimentary) { <span class="badge text-bg-info-subtle text-info-emphasis">İKRAM</span> }
                                    @if (line.DiscountAmount > 0 && !line.IsComplimentary) { <span class="badge text-bg-warning-subtle text-warning-emphasis">İndirim</span> }
                                    @if (Model.IsKitchenTrackingEnabled) { <span class="badge text-bg-secondary-subtle">@line.Status</span> }
                                    <!-- Mutfağa gönderildi işareti - satırı SOLUKLAŞTIRMAK yerine
                                         (Edip, 2026-09-05: "pasif görünüm oluşmasın") küçük bir
                                         metin etiketiyle belirtilir. -->
                                    <span class="cart-line-sent-badge">✓ Mutfağa gönderildi</span>
                                    @if (!string.IsNullOrEmpty(line.KitchenNote)) { <div class="small text-secondary">Not: @line.KitchenNote</div> }
                                </div>
                                <div class="cart-line-col-qty">@line.Quantity.ToString("N0")</div>
                                <div class="cart-line-col-unit">@line.Unit</div>
                                <div class="cart-line-col-kdv">%@line.TaxRate.ToString("N0")</div>
                                <div class="cart-line-col-price">@line.UnitPrice.ToString("N2") ₺</div>
                                <div class="cart-line-col-total">@((line.Quantity * line.UnitPrice - line.DiscountAmount).ToString("N2")) ₺</div>
                            </div>
                        }
                    </div>
                }
                <div class="cart-lines" id="cart-lines">
                    <p class="text-secondary small p-2">Ürün eklemek için soldan seçim yapın.</p>
                </div>
                <div class="cart-footer">
                    <!-- Alt özet (Edip, 2026-09-05 - önceki "her zaman 4 alan görünsün" kararının
                         YERİNE geçti): Ara Toplam ve Kalan Tutar HER ZAMAN görünür; İndirim SADECE
                         adisyon/tutar indirimi (TicketDiscountAmount, madde 4) varsa, Ödenen SADECE
                         gerçekten bir ödeme girildiyse gösterilir - ilgili tutar 0 ise satır
                         tamamen gizlenir ("indirim yoksa ve ödenen tutar yoksa göstermesin").
                         restaurant-close-payment.js updateMainScreenSummary() Ödenen satırının
                         görünürlüğünü ve Kalan'ı canlı günceller; İndirim yalnızca tam sayfa
                         yeniden yüklenmesiyle değiştiği için sunucu tarafı yeterli. Eski "Toplam"
                         satırı (Ara Toplam - İndirim ile aynı bilgiyi tekrarlıyordu, "gereksiz sil")
                         DOM'dan kaldırılmadı (renderCart() hâlâ #cart-total'a doğrudan yazıyor,
                         madde 22'deki JS güvenliği kuralı) - sadece görünürlüğü kapatıldı. -->
                    <div class="d-flex justify-content-between">
                        <span>Ara Toplam</span>
                        <span id="main-subtotal-total">@Model.AraToplam.ToString("N2") ₺</span>
                    </div>
                    <!-- d-none (style="display:none" DEĞİL) - Bootstrap'in .d-flex kuralı
                         "display:flex !important" olduğundan satır içi style buna karşı kaybeder;
                         .d-none de AYNI önem/özgüllükte ama Bootstrap'in kendi CSS'inde .d-flex'ten
                         SONRA tanımlı olduğu için ikisi birlikteyken kazanır (2026-09-05, ilk
                         denemede bulunan gerçek hata). -->
                    <div class="d-flex justify-content-between@(Model.TicketDiscountAmount > 0 ? "" : " d-none")" id="main-discount-row">
                        <span>İndirim</span>
                        <span class="text-danger" id="main-discount-total">@Model.TicketDiscountAmount.ToString("N2") ₺</span>
                    </div>
                    <div class="d-flex justify-content-between@(Model.PaidTotal > 0 ? "" : " d-none")" id="main-paid-row">
                        <span>Ödenen Tutar</span>
                        <span class="text-success fw-bold" id="main-paid-total">@Model.PaidTotal.ToString("N2") ₺</span>
                    </div>
                    <!-- "Kalan Tutar" -> "Toplam" (Edip, 2026-09-05, onaylı görsel: alt özette
                         vurgulanmış, kalın "Toplam" satırı) - DEĞER aynı kalıyor (Ara Toplam -
                         İndirim - Ödenen), sadece etiket/görsel vurgu görsele göre değişti. -->
                    <div class="d-flex justify-content-between cart-footer-total-row">
                        <span>Toplam</span>
                        <span class="text-danger fw-bold" id="main-remaining-total">@((Model.PayableTotal - Model.PaidTotal).ToString("N2")) ₺</span>
                    </div>
                    <div class="d-flex justify-content-between d-none">
                        <span>Toplam</span>
                        <span class="cart-total" id="cart-total">@Model.PayableTotal.ToString("N2") ₺</span>
                    </div>
                    <!-- Self satış ve masa satışta AYNI ödeme mantığı - "Kapat/Öde" ayrı bir buton
                         olarak kaldırıldı, tek "Ödemeyi Al" akışı ikisinde de burada
                         (Edip, 2026-09-03). -->
                    <div class="self-payrow">
                        <!-- Madde 22 - bu buton renderCart() içinde SIK SIK doğrudan (null
                             kontrolsüz) referans alınıyor, DOM'dan @@if ile kaldırmak yerine
                             görünürlüğü display:none ile kapatılıyor (JS güvenliği için). -->
                        <!-- GERÇEK HATA (2026-09-05, incelemede bulundu) - önceki hali burada
                             style="display:none;" yazmayı bir C# string içinde \" ile kaçırmaya
                             çalışıyordu, bu Razor'da HTML özniteliği olarak DEĞİL düz metin olarak
                             basılıyordu (tarayıcı geçersiz style'ı yok sayıp butonu GÖRÜNÜR
                             bırakıyordu) - ShowSendToKitchenButton hep true olduğu için şimdiye
                             kadar hiç fark edilmemişti. Native "hidden" özniteliği ile düzeltildi. -->
                        <button type="button" class="self-payrow-kitchen" id="send-kitchen-btn" disabled @(Model.ShowSendToKitchenButton ? "" : "hidden")>♨ Mutfağa Gönder</button>
                        <button type="button" class="self-payrow-pay" id="self-pay-btn"@(Model.PayableTotal > 0 ? "" : " disabled")>Ödemeyi Al</button>
                    </div>
                    <!-- Onaylı Self Satış mockup'ı bu satırda "Adisyon | Nakit | Kredi Kartı" gösteriyor
                         (Yemek Çeki YOK) - madde 36 checklist'i de zaten sadece "Hızlı Nakit, Hızlı
                         Kredi Kartı" diyor, Yemek Çeki hiç anılmıyor. "Adisyon" tam ödeme modalını
                         açar - #self-pay-btn ile AYNI davranış (bkz. restaurant-pos.js), yeni bir iş
                         kuralı UYDURULMADI, var olan "Ödemeyi Al" akışına ikinci bir giriş noktası. -->
                    <div class="self-quickpay" id="self-quickpay">
                        <button type="button" class="pay-method-btn a" id="self-adisyon-btn"@(Model.PayableTotal > 0 ? "" : " disabled")>▤ Adisyon</button>
                        <button type="button" class="pay-method-btn n" data-quick-method="1">₺ Nakit</button>
                        <button type="button" class="pay-method-btn c" data-quick-method="2">▣ Kredi Kartı</button>
                    </div>
                    <!-- Nakit satırının altında hızlı işlem sırası (Edip, 2026-09-03: "sağ taraf
                         nakit butonun altına sipariş sil indirim kapat butonlarına yanyana koy
                         renkli olsun"). -->
                    <div class="cart-quick-actions" id="cart-quick-actions">
                        <!-- Cari Ekle (madde 13, onaylı Self Satış tasarımı) - adisyona bir müşteri
                             bağlar; "Açık Hesap" ödeme yöntemi bu olmadan kullanılamaz. Seçim
                             sonrası buton etiketi cari adını gösterir (bkz. restaurant-pos.js). -->
                        <button type="button" class="quick-action-btn attach-customer lookup-trigger" id="attach-customer-btn"
                                data-lookup-endpoint="@Url.Action("Customers", "Lookup", new { type = "Customer" })"
                                data-lookup-title="Cari Seç" data-target-hidden="AttachedCustomerId" data-target-display="AttachedCustomerDisplayInput">
                            👤 <span id="attach-customer-label">@(string.IsNullOrWhiteSpace(Model.AttachedCustomerDisplay) ? "Cari Ekle" : Model.AttachedCustomerDisplay)</span>
                        </button>
                        <input type="hidden" id="AttachedCustomerId" value="@Model.AttachedCustomerId" />
                        <input type="hidden" id="AttachedCustomerDisplayInput" style="display:none;" />
                        <button type="button" class="quick-action-btn discount" id="ticket-discount-btn">% İndirim</button>
                        <button type="button" class="quick-action-btn close" id="close-check-btn">✕ Kapat</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağdaki sabit ikon şeridi - Edip'in eski POS ekranındaki hep aynı yerde duran
             yan panel (Edip, 2026-09-03: "sağ taraftaki sabit alanlar bizde de olsun").
             Madde 22 (2026-09-05): her buton İKİ katmanlı parametrik/yetki kontrollü - sunucu
             Model.ShowXButton'ı (sistem geneli AND kullanıcı yetkisi) hesaplayıp buraya koyuyor,
             kapalıysa buton DOM'dan tamamen kaldırılıyor (JS tarafında hepsi zaten null-güvenli). -->
        <div class="pos-side-icons">
            @if (Model.ShowTicketNoteButton)
            {
                <button type="button" class="pos-side-icon" data-bs-toggle="modal" data-bs-target="#ticketNoteModal">
                    <span class="pos-side-icon-glyph">🗒</span>Fiş<br />Notu
                </button>
            }
            @if (Model.IsSelfSaleCheck && Model.ShowTableTransferButton)
            {
                <button type="button" class="pos-side-icon" data-bs-toggle="modal" data-bs-target="#transferToTableModal">
                    <span class="pos-side-icon-glyph">⇄</span>Masa<br />Transfer
                </button>
            }
            <button type="button" class="pos-side-icon" id="side-kitchen-btn">
                <span class="pos-side-icon-glyph">♨</span>Mutfak
            </button>
            @if (Model.ShowPriceCheckButton)
            {
                <button type="button" class="pos-side-icon" data-bs-toggle="modal" data-bs-target="#priceCheckModal">
                    <span class="pos-side-icon-glyph">🔍</span>Fiyat<br />Gör
                </button>
            }
            @if (Model.ShowKeyboardButton)
            {
                <button type="button" class="pos-side-icon" id="side-keyboard-btn">
                    <span class="pos-side-icon-glyph">⌨</span>Klavye
                </button>
            }
            @if (Model.ShowProductListButton)
            {
                <!-- Ürün Listesi (madde 15-16) - tam stoktan arama (kategori kısayollarıyla SINIRLI
                     değil), ad/barkod modu seçilebilir, sonuç seçilince/Enter'a basılınca sepete
                     eklenir. Kategori alanına HİÇ dokunmaz - tamamen izole bir modal. -->
                <button type="button" class="pos-side-icon" data-bs-toggle="modal" data-bs-target="#productListModal">
                    <span class="pos-side-icon-glyph">📦</span>Ürün<br />Listesi
                </button>
            }
            @if (Model.ShowHoldReceiptButton)
            {
                <button type="button" class="pos-side-icon" id="side-hold-btn">
                    <span class="pos-side-icon-glyph">⏸</span>Fişi<br />Beklet
                </button>
            }
            @if (Model.ShowHeldReceiptsButton)
            {
                <button type="button" class="pos-side-icon" id="held-receipts-btn" data-bs-toggle="modal" data-bs-target="#heldReceiptsModal" style="position:relative;">
                    <span class="pos-side-icon-glyph">📋</span>Bekleyen<br />Fişler
                    <!-- Madde 18 - canlı sayaç rozeti, boşken gizli. -->
                    <span id="held-receipts-badge" class="held-receipts-count-badge" style="display:none;">0</span>
                </button>
            }
            @if (Model.ShowComplimentaryReceiptButton)
            {
                <button type="button" class="pos-side-icon" id="side-ticket-comp-btn">
                    <span class="pos-side-icon-glyph">🎁</span>Fiş<br />İkram
                </button>
            }
            @if (Model.ShowReceiptListButton)
            {
                <button type="button" class="pos-side-icon" data-bs-toggle="modal" data-bs-target="#receiptListModal">
                    <span class="pos-side-icon-glyph">🧾</span>Fiş<br />Listesi
                </button>
            }
            @if (Model.ShowClearOrderButton)
            {
                <!-- Sipariş Sil - onaylı Self Satış mockup'ında sağ ikon şeridinin EN ALTINDA,
                     Fiş Listesi'nin altında, AYRI kırmızı bir buton olarak duruyor (önceden alt
                     hızlı-işlem sırasındaydı, madde 23-24 piksel-doğruluk düzeltmesiyle buraya
                     taşındı; sıra Fiş Listesi/Sipariş Sil arasında ters olduğu 2026-09-05'te
                     mockup'la tekrar karşılaştırılıp düzeltildi). Fonksiyon aynı - clear-cart-btn
                     id'si korunuyor. -->
                <button type="button" class="pos-side-icon danger" id="clear-cart-btn">
                    <span class="pos-side-icon-glyph">🗑</span>Sipariş<br />Sil
                </button>
            }
        </div>
    </div>
</div>

@if (Model.IsSelfSaleCheck)
{
    <!-- "Fişi Beklet" self satışta BİLEREK yeni bir adisyon açar (bkz. RestaurantSelfSaleController.
         Hold ve restaurant-pos.js) - masa satışta buna gerek yok, masa zaten kendi kalıcı kaydı. -->
    <form method="post" asp-controller="RestaurantSelfSale" asp-action="Hold" id="hold-self-sale-form" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="checkId" value="@Model.CheckId" />
    </form>
}

<!-- "Kapat" butonu için - adisyonda hiçbir aktif ürün yoksa (hiç eklenmedi ya da hepsi iptal
     edildi) masa DOLU görünmeye devam etmesin diye Masayı Boşalt ile AYNI işlemi tetikler
     (Edip, 2026-09-03: "boş masayı açtım kapattım masada hiç işlem yapmasın masa 0.00 yazmasın
     ... kapat tuşuna bastığında masayı boşaltsın"). Üstteki "Masayı Boşalt" butonundan farklı
     olarak sayfa yüklendiğindeki PayableTotal'a değil, JS'in o anki (yeni iptal edilenler dahil)
     hesabına göre koşullu tetiklenir - bkz. restaurant-pos.js #close-check-btn. -->
<form method="post" asp-action="VoidEmptyCheck" id="void-empty-check-form" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="checkId" value="@Model.CheckId" />
</form>

<!-- Gönderilmiş satırda miktar düzeltme / ikram aç-kapa - satır kilidi TAMAMEN KALDIRILDI
     (Edip, 2026-09-04, madde 9), yerine sunucu tarafı yetki kontrolü geçti (bkz.
     RestaurantPermissionService, RestaurantPostingService). Butonlar her zaman görünür/
     tıklanabilir - yetkisiz kullanıcı tıkladığında sunucu hatayı TempData["Error"] ile döner. -->
<form method="post" asp-action="AdjustOrderLineQuantity" id="adjust-line-qty-form" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="checkId" value="@Model.CheckId" />
    <input type="hidden" name="lineId" id="adjustQtyLineId" />
    <input type="hidden" name="quantity" id="adjustQtyValue" />
    <input type="hidden" name="approverPin" id="adjustQtyApproverPin" />
</form>
<form method="post" asp-action="ToggleLineComplimentary" id="toggle-line-comp-form" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="checkId" value="@Model.CheckId" />
    <input type="hidden" name="lineId" id="toggleCompLineId" />
    <input type="hidden" name="approverPin" id="toggleCompApproverPin" />
</form>
<form method="post" asp-action="ApplyOrderLineDiscount" id="apply-line-discount-form" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="checkId" value="@Model.CheckId" />
    <input type="hidden" name="lineId" id="applyDiscountLineId" />
    <input type="hidden" name="amount" id="applyDiscountAmount" />
    <input type="hidden" name="approverPin" id="applyDiscountApproverPin" />
</form>
<!-- "Sipariş Sil" - bekleyen sepet boşken (her şey zaten mutfağa gönderilmiş) adisyondaki TÜM
     gönderilmiş satırları topluca iptal eder - bkz. restaurant-pos.js clear-cart-btn, madde
     11 fix'i (2026-09-05, "yetkisi varsa her koşulda çalışsın"). -->
<form method="post" asp-action="ClearOrder" id="clear-order-form" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="checkId" value="@Model.CheckId" />
    <input type="hidden" name="reason" id="clearOrderReason" />
    <input type="hidden" name="approverPin" id="clearOrderApproverPin" />
</form>

<!-- Bekleyen Fişler - "Fişi Beklet" ile bu tarayıcıda (localStorage) bekletilmiş, henüz mutfağa
     gönderilmemiş sepetlerin listesi (Edip, 2026-09-03). Sunucuya bağlı DEĞİL, sadece bu
     cihazda/tarayıcıda görünür - bkz. restaurant-pos.js. -->
<div class="modal fade" id="heldReceiptsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <!-- Madde 18 (Edip 2026-09-04) - başlıkta canlı sayaç, "Bekleyen Fişler (8)" gibi. -->
                <h5 class="modal-title" id="held-receipts-title">Bekleyen Fişler</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Kart tasarımı (madde 18) - Fiş/Adisyon No, satış türü, saat, bekleme süresi,
                     ürün adedi, toplam. En eski fiş tek bakışta ayırt edilebilsin diye ayrı
                     vurgulanır (bkz. restaurant-pos.js .held-receipt-card.oldest). -->
                <div id="held-receipts-list" class="held-receipts-grid"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Fiş Listesi (2026-09-05 teknik doküman madde 9, onaylı görsel 04_Fis_Listesi_ONAYLI.png) -
     Excel-vari filtrelenebilir profesyonel pencere. Satıra tıklamak (SADECE Administrator)
     eski davranışı korur: fiş İPTAL EDİLİP satırları düzeltme için sepete klonlanır (bkz.
     restaurant-pos.js, CancelReceiptForEdit). -->
<div class="modal fade" id="receiptListModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Fiş Listesi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap gap-2 mb-2 align-items-end">
                    <div>
                        <label class="form-label small mb-1">Tarih Aralığı</label>
                        <div class="d-flex gap-1">
                            <input type="date" id="receipt-list-from" class="form-control form-control-sm" />
                            <input type="date" id="receipt-list-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label small mb-1">Fiş Tipi</label>
                        <select id="receipt-list-source" class="form-select form-select-sm">
                            <option value="all">Tümü</option>
                            <option value="table">Masa</option>
                            <option value="self">Self Satış</option>
                            <option value="package">Paket / Gel-Al</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label small mb-1">Ödeme Türü</label>
                        <select id="receipt-list-payment" class="form-select form-select-sm">
                            <option value="">Tüm Ödemeler</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label small mb-1">Durum</label>
                        <select id="receipt-list-status" class="form-select form-select-sm">
                            <option value="">Tümü</option>
                            <option value="completed">Tamamlandı</option>
                            <option value="cancelled">İptal</option>
                        </select>
                    </div>
                    <div class="flex-grow-1" style="min-width:160px;">
                        <label class="form-label small mb-1">Ara</label>
                        <input type="text" id="receipt-list-search" class="form-control form-control-sm" placeholder="Fiş No, masa no, müşteri ara..." />
                    </div>
                    <button type="button" class="btn btn-erp-outline btn-sm" id="receipt-list-clear-btn">Filtreleri Temizle</button>
                    <button type="button" class="btn btn-success btn-sm" id="receipt-list-export-btn">📊 Excel'e Aktar</button>
                </div>
                <div id="receipt-list-totals" class="text-secondary small mb-2"></div>
                <div class="table-responsive" style="max-height:360px; overflow-y:auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr><th>Tarih</th><th>Saat</th><th>Fiş No</th><th>Masa/Kaynak</th><th>Müşteri</th><th>Kasiyer</th><th class="text-end">Tutar</th><th>Ödeme Türü</th><th>Durum</th></tr>
                        </thead>
                        <tbody id="receipt-list-body"></tbody>
                    </table>
                </div>
                <p id="receipt-list-empty" class="text-secondary small p-2" style="display:none;">Bu filtrede fiş yok.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Fiş Notu - adisyonun TAMAMINI ilgilendiren not (ürün bazlı Not'tan ayrı). -->
<div class="modal fade" id="ticketNoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="UpdateCheckNote">
                @Html.AntiForgeryToken()
                <input type="hidden" name="checkId" value="@Model.CheckId" />
                <div class="modal-header">
                    <h5 class="modal-title">Fiş Notu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary small">Bu not ürüne değil, adisyonun tamamına aittir.</p>
                    <textarea name="note" class="form-control" rows="4" maxlength="500" placeholder="Örn: Müşteri alerjik, fındık istemiyor.">@Model.TicketNote</textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-erp-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Fiyat Gör - müşteri kasada ürünün fiyatını/KDV'sini sormak için, kataloğu tekrar sorgulamadan
     (Edip, 2026-09-03: "müşteri rafta fiyatı göremedi, kasaya geldi, fiyat göre tıkla, ürün adı
     fiyatı KDV'si gelsin, ister iptal ister ekrana alsın"). Sunucudan zaten yüklü kataloğu
     kullanır - bkz. restaurant-pos.js. -->
<!-- Ürün Listesi (madde 15-16) - arama üstte, sonuçlar ortada, Stok Kodu|Barkod|Ürün Adı
     sütunları. Ad/Barkod modu arasında geçiş, arama sonuçları kategori alanını ETKİLEMEZ. -->
<div class="modal fade" id="productListModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Ürün Listesi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex gap-2 mb-2">
                    <input type="text" id="product-list-search" class="product-search-input" style="max-width:none; flex:1;" placeholder="Ürün adı ara..." autocomplete="off" />
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-erp-outline active" id="product-list-mode-name" data-mode="name">Ad</button>
                        <button type="button" class="btn btn-erp-outline" id="product-list-mode-barcode" data-mode="barcode">Barkod</button>
                    </div>
                </div>
                <div class="table-responsive" style="max-height:320px; overflow-y:auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr><th>Stok Kodu</th><th>Barkod</th><th>Ürün Adı</th><th class="text-end">Fiyat</th></tr>
                        </thead>
                        <tbody id="product-list-results"></tbody>
                    </table>
                </div>
                <p id="product-list-empty" class="text-secondary small p-2" style="display:none;">Sonuç bulunamadı.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Fiyat Gör (madde 5, 2026-09-05 teknik doküman) - Ürün Listesi ile AYNI gerçek stok DB
     araması (SearchProducts, Ad/Barkod modu), kategori paneline HİÇ dokunmaz. Eskiden sadece
     zaten yüklü kategori kısayolu kataloğunda (isim bazlı) arıyordu - artık tam stoktan barkod
     dahil arar. -->
<div class="modal fade" id="priceCheckModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Fiyat Gör</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex gap-2 mb-2">
                    <input type="text" id="price-check-search" class="product-search-input" style="max-width:none; flex:1;" placeholder="Ürün adı, stok kodu veya barkod ara..." autocomplete="off" />
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-erp-outline active" id="price-check-mode-name" data-mode="name">Ürün Adı ile Ara</button>
                        <button type="button" class="btn btn-erp-outline" id="price-check-mode-barcode" data-mode="barcode">Barkod ile Ara</button>
                    </div>
                </div>
                <div class="table-responsive" style="max-height:320px; overflow-y:auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr><th>Stok Kodu</th><th>Barkod</th><th>Ürün Adı</th><th>KDV</th><th class="text-end">Fiyat</th></tr>
                        </thead>
                        <tbody id="price-check-results"></tbody>
                    </table>
                </div>
                <p id="price-check-empty" class="text-secondary small p-2" style="display:none;">Sonuç bulunamadı.</p>
                <div id="price-check-detail" class="price-check-detail" style="display:none;">
                    <div class="price-check-detail-name" id="price-check-name"></div>
                    <div class="price-check-detail-row"><span>Fiyat (KDV Dahil)</span><strong id="price-check-price"></strong></div>
                    <div class="price-check-detail-row"><span>KDV Oranı</span><strong id="price-check-tax"></strong></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-erp" id="price-check-add-btn" disabled>Ekrana Al</button>
            </div>
        </div>
    </div>
</div>

<!-- Klavye (2026-09-05 teknik doküman madde 7) - harfler solda/numpad sağda, serbestçe
     sürüklenebilir (üst çubuğu tutup taşınır, EKRAN DIŞINA HİÇ TAŞMAZ - JS clamp eder), +/-
     ile kademeli büyütülüp küçültülebilir, son konum/boyut bu terminalde hatırlanır (bkz.
     restaurant-pos.js, localStorage). Hiçbir alanda OTOMATİK açılmaz - sadece "⌨ Klavye" ile
     elle açılır. Odaklanılan son metin alanına, imleç konumuna yazar. -->
<div class="pos-virtual-keyboard" id="pos-virtual-keyboard" style="display:none;">
    <div class="pos-vk-toolbar" id="pos-vk-drag-handle" title="Taşımak için tutup sürükleyin">
        <button type="button" class="pos-vk-tool" data-vk-action="size-down" title="Küçült">－</button>
        <button type="button" class="pos-vk-tool" data-vk-action="size-up" title="Büyüt">＋</button>
        <button type="button" class="pos-vk-tool pos-vk-tool-close" data-action="close" title="Kapat">✕</button>
    </div>
    <div class="pos-vk-body">
        <div class="pos-vk-letters">
            <div class="pos-vk-row">
                <button type="button" data-key="q">q</button><button type="button" data-key="w">w</button><button type="button" data-key="e">e</button><button type="button" data-key="r">r</button><button type="button" data-key="t">t</button><button type="button" data-key="y">y</button><button type="button" data-key="u">u</button><button type="button" data-key="ı">ı</button><button type="button" data-key="o">o</button><button type="button" data-key="p">p</button>
            </div>
            <div class="pos-vk-row">
                <button type="button" data-key="a">a</button><button type="button" data-key="s">s</button><button type="button" data-key="d">d</button><button type="button" data-key="f">f</button><button type="button" data-key="g">g</button><button type="button" data-key="h">h</button><button type="button" data-key="j">j</button><button type="button" data-key="k">k</button><button type="button" data-key="l">l</button>
            </div>
            <div class="pos-vk-row">
                <button type="button" class="pos-vk-wide" data-action="shift">⇧</button>
                <button type="button" data-key="z">z</button><button type="button" data-key="x">x</button><button type="button" data-key="c">c</button><button type="button" data-key="v">v</button><button type="button" data-key="b">b</button><button type="button" data-key="n">n</button><button type="button" data-key="m">m</button>
                <button type="button" class="pos-vk-wide" data-action="backspace">⌫</button>
            </div>
            <div class="pos-vk-row">
                <button type="button" data-key="ğ">ğ</button><button type="button" data-key="ü">ü</button><button type="button" data-key="ş">ş</button><button type="button" data-key="i">i</button><button type="button" data-key="ö">ö</button><button type="button" data-key="ç">ç</button>
                <button type="button" class="pos-vk-space" data-key=" ">boşluk</button>
            </div>
        </div>
        <div class="pos-vk-numpad">
            <div class="pos-vk-row"><button type="button" data-key="7">7</button><button type="button" data-key="8">8</button><button type="button" data-key="9">9</button></div>
            <div class="pos-vk-row"><button type="button" data-key="4">4</button><button type="button" data-key="5">5</button><button type="button" data-key="6">6</button></div>
            <div class="pos-vk-row"><button type="button" data-key="1">1</button><button type="button" data-key="2">2</button><button type="button" data-key="3">3</button></div>
            <div class="pos-vk-row"><button type="button" data-key="0">0</button><button type="button" data-key=",">,</button><button type="button" class="pos-vk-numpad-bs" data-action="backspace">⌫</button></div>
