@model IReadOnlyList<SahinSoft.Domain.Entities.Product>
@{
    ViewData["Title"] = "Stok Kartları";
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>Stok Kartları</h1>
        <span class="erp-toolbar-meta">@Model.Count kayıt</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-action="Create" class="btn btn-erp-primary btn-sm">+ Yeni Stok Kartı</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}

<div class="erp-filter-bar">
    <div class="erp-field flex-grow-1">
        <label>Ara</label>
        <input class="form-control" autocomplete="off" autofocus
               placeholder="Stok kodu, ürün, marka veya barkod ara (barkod okutabilirsiniz)..." data-live-search="#productsTable" />
    </div>
</div>

<div class="erp-panel">
    <div class="erp-panel-body p-0">
        <div class="erp-table-wrap">
            <table class="erp-table" id="productsTable">
                <thead>
                    <tr>
                        <th>Stok Kodu</th>
                        <th>Ürün</th>
                        <th>Kategori</th>
                        <th>KDV</th>
                        <th class="text-end">Miktar</th>
                        <th class="text-end">Satış Fiyatı</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.StockCode</td>
                        <td>
                            <div>@item.Name</div>
                            <small class="text-secondary">@item.Brand @item.Model</small>
                        </td>
                        <td>@item.Category.Name</td>
                        <td>@item.TaxRate.Name</td>
                        <td class="text-end">@item.StockQuantity.ToString("N3")</td>
                        <td class="text-end">@item.SalePrice.ToString("N2") ₺</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.78rem;">Düzenle</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
