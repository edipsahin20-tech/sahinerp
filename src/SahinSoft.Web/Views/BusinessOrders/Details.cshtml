@using SahinSoft.Domain.Enums
@model SahinSoft.Web.Models.BusinessOrderDetailsViewModel
@{
    ViewData["Title"] = $"Sipariş {Model.OrderNumber}";
    var statusClass = Model.Status switch
    {
        BusinessDocumentStatus.Draft => "erp-status-draft",
        BusinessDocumentStatus.Approved or BusinessDocumentStatus.Fulfilled => "erp-status-approved",
        _ => "erp-status-cancelled"
    };
    var statusText = Model.Status switch
    {
        BusinessDocumentStatus.Draft => "Taslak",
        BusinessDocumentStatus.Approved => "Onaylı",
        BusinessDocumentStatus.PartiallyFulfilled => "Kısmi",
        BusinessDocumentStatus.Fulfilled => "Tamamlandı",
        _ => "İptal"
    };
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>@(Model.OrderType == InvoiceType.Sales ? "Satış Siparişi" : "Alış Siparişi")</h1>
        <span class="erp-doc-no">@Model.OrderNumber</span>
        <span class="erp-status-badge @statusClass">@statusText</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-action="Index" class="btn btn-erp-outline btn-sm">Liste</a>
        @if (Model.Status == BusinessDocumentStatus.Draft)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-erp-outline btn-sm">Düzenle</a>
            <form method="post" asp-action="Approve" asp-route-id="@Model.Id" class="d-inline">
                <button type="submit" class="btn btn-erp-primary btn-sm">Onayla</button>
            </form>
        }
        @{
            var hasRemaining = Model.Lines.Any(x => x.RemainingQuantity > 0);
        }
        @if (Model.Status is BusinessDocumentStatus.Approved or BusinessDocumentStatus.PartiallyFulfilled && hasRemaining)
        {
            <a asp-controller="DispatchNotes" asp-action="CreateFromOrder" asp-route-orderId="@Model.Id" class="btn btn-erp-outline btn-sm">İrsaliyeye Dönüştür</a>
            <a asp-controller="Invoices" asp-action="CreateFromOrder" asp-route-orderId="@Model.Id" class="btn btn-erp-outline btn-sm">Faturaya Dönüştür</a>
        }
        @if (Model.Status is BusinessDocumentStatus.Draft or BusinessDocumentStatus.Approved)
        {
            <form method="post" asp-action="Cancel" asp-route-id="@Model.Id" class="d-inline">
                <button type="submit" class="btn btn-erp-danger btn-sm">İptal Et</button>
            </form>
        }
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="erp-panel">
    <div class="erp-panel-header">@Model.CustomerName &middot; @Model.OrderDateUtc.ToString("dd.MM.yyyy")</div>
    <div class="erp-panel-body p-0">
        <div class="erp-table-wrap">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>Ürün</th>
                        <th class="text-end">Miktar</th>
                        <th class="text-end">Karşılanan</th>
                        <th class="text-end">Kalan</th>
                        <th class="text-end">Birim Fiyat</th>
                        <th class="text-end">Tutar</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.ProductNameSnapshot <span class="text-secondary">(@line.UnitSnapshot)</span></td>
                        <td class="text-end">@line.Quantity.ToString("N3")</td>
                        <td class="text-end">@line.FulfilledQuantity.ToString("N3")</td>
                        <td class="text-end">@line.RemainingQuantity.ToString("N3")</td>
                        <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                        <td class="text-end">@line.LineTotal.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="p-3 d-flex">
            <div class="erp-totals">
                <div class="erp-totals-row"><span>Ara toplam</span><span>@Model.Subtotal.ToString("N2")</span></div>
                <div class="erp-totals-row"><span>İskonto</span><span>@Model.DiscountTotal.ToString("N2")</span></div>
                <div class="erp-totals-row"><span>KDV</span><span>@Model.TaxTotal.ToString("N2")</span></div>
                <div class="erp-totals-row erp-grand-total"><span>Genel Toplam</span><span class="erp-total-value">@Model.GrandTotal.ToString("N2") @Model.CurrencyCode</span></div>
            </div>
        </div>
    </div>
</div>

@if (Model.Notes is not null)
{
    <div class="erp-panel">
        <div class="erp-panel-header">Notlar</div>
        <div class="erp-panel-body">@Model.Notes</div>
    </div>
}

@if (Model.LinkedDispatchNotes.Count > 0 || Model.LinkedInvoices.Count > 0)
{
    <div class="erp-panel">
        <div class="erp-panel-header">Bağlı Belgeler</div>
        <div class="erp-panel-body">
            @if (Model.LinkedDispatchNotes.Count > 0)
            {
                <p class="mb-1"><strong>İrsaliyeler:</strong></p>
                <ul class="mb-2">
                    @foreach (var d in Model.LinkedDispatchNotes)
                    {
                        <li><a asp-controller="DispatchNotes" asp-action="Details" asp-route-id="@d.Id">@d.Number</a> — @d.StatusText</li>
                    }
                </ul>
            }
            @if (Model.LinkedInvoices.Count > 0)
            {
                <p class="mb-1"><strong>Faturalar:</strong></p>
                <ul class="mb-0">
                    @foreach (var inv in Model.LinkedInvoices)
                    {
                        <li><a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.Id">@inv.Number</a> — @inv.StatusText</li>
                    }
                </ul>
            }
        </div>
    </div>
}
