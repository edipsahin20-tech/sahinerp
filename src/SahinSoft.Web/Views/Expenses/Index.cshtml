@model IReadOnlyList<SahinSoft.Domain.Entities.Expense>
@{
    ViewData["Title"] = "Masraflar";
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>Masraflar</h1>
        <span class="erp-toolbar-meta">@Model.Count kayıt</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-action="Create" class="btn btn-erp-primary btn-sm">+ Yeni Masraf</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}

<form method="get" class="erp-filter-bar">
    <div class="erp-field">
        <label>Kategori</label>
        <select name="categoryId" class="form-select" style="min-width: 200px;" asp-items="(IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Categories">
            <option value="">Tüm kategoriler</option>
        </select>
    </div>
    <div class="erp-field flex-grow-1">
        <label>Ara</label>
        <input class="form-control" autocomplete="off" placeholder="Belge no veya açıklama ara..." data-live-search="#expensesTable" />
    </div>
    <button class="btn btn-erp-primary">Filtrele</button>
</form>

<div class="erp-panel">
    <div class="erp-panel-body p-0">
    <div class="erp-table-wrap">
        <table class="erp-table" id="expensesTable">
            <thead>
                <tr>
                    <th>Belge No</th>
                    <th>Tarih</th>
                    <th>Kategori</th>
                    <th>Açıklama</th>
                    <th class="text-end">Tutar</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.DocumentNumber</td>
                    <td>@item.ExpenseDateUtc.ToString("dd.MM.yyyy")</td>
                    <td>@item.ExpenseCategory.Name</td>
                    <td>@item.Description</td>
                    <td class="text-end">@item.TotalAmount.ToString("N2") @item.CurrencyCode</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.78rem;">Düzenle</a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
            }
            </tbody>
        </table>
    </div>
    </div>
</div>
