@using SahinSoft.Domain.Enums
@model IReadOnlyList<SahinSoft.Domain.Entities.InventoryCount>
@{
    ViewData["Title"] = "Sayımlar";
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-clipboard-check"></i> Sayım Girişi</h2>
        <a asp-action="Create" class="btn-erp-list-new">+ Yeni Sayım</a>
    </div>
    <div class="erp-list-body">
        <div class="erp-list-topbar">
            <div class="erp-list-topbar-left">
                <div class="erp-list-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" class="form-control" autocomplete="off" placeholder="Sayım no ara..." data-live-search="#inventoryCountsTable">
                </div>
                <form method="get" class="erp-list-filter">
                    <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<InventoryCountStatus>()" onchange="this.form.submit()">
                        <option value="">Tüm durumlar</option>
                    </select>
                </form>
            </div>
            <span class="text-secondary">Toplam <strong>@Model.Count</strong> kayıt.</span>
        </div>

        <div class="erp-table-wrap">
            <table class="erp-table" id="inventoryCountsTable">
                <thead>
                    <tr>
                        <th>Sayım No</th>
                        <th>Tarih</th>
                        <th>Depo</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var statusClass = item.Status switch
                    {
                        InventoryCountStatus.Draft => "gray",
                        InventoryCountStatus.Counting => "amber",
                        InventoryCountStatus.Approved => "green",
                        _ => "red"
                    };
                    var statusText = item.Status switch
                    {
                        InventoryCountStatus.Draft => "Taslak",
                        InventoryCountStatus.Counting => "Sayılıyor",
                        InventoryCountStatus.Approved => "Onaylı",
                        _ => "İptal"
                    };
                    <tr>
                        <td><span class="erp-code-badge">@item.CountNumber</span></td>
                        <td>@item.CountDateUtc.ToString("dd.MM.yyyy")</td>
                        <td>@item.Warehouse.Name</td>
                        <td><span class="erp-status-pill @statusClass">@statusText</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-erp-list-action">Görüntüle</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
