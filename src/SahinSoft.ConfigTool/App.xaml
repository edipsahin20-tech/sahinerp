<Application x:Class="SahinSoft.ConfigTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Renk paleti -->
            <SolidColorBrush x:Key="SidebarBg" Color="#0F1B2D"/>
            <SolidColorBrush x:Key="SidebarItemHover" Color="#1C2D47"/>
            <SolidColorBrush x:Key="SidebarItemActive" Color="#2563EB"/>
            <SolidColorBrush x:Key="SidebarText" Color="#CBD5E1"/>
            <SolidColorBrush x:Key="SidebarTextMuted" Color="#64748B"/>
            <SolidColorBrush x:Key="PageBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBorder" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB"/>
            <SolidColorBrush x:Key="PrimaryBlueHover" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="DangerRed" Color="#DC2626"/>
            <SolidColorBrush x:Key="DangerRedHover" Color="#B91C1C"/>
            <SolidColorBrush x:Key="SuccessGreen" Color="#16A34A"/>
            <SolidColorBrush x:Key="TextDark" Color="#111827"/>
            <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
            <SolidColorBrush x:Key="BadgeBlueBg" Color="#DBEAFE"/>
            <SolidColorBrush x:Key="BadgeBlueText" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="DangerBoxBg" Color="#FEF2F2"/>
            <SolidColorBrush x:Key="DangerBoxBorder" Color="#FECACA"/>
            <SolidColorBrush x:Key="DangerBoxText" Color="#B91C1C"/>
            <SolidColorBrush x:Key="SafeBoxBg" Color="#F0FDF4"/>
            <SolidColorBrush x:Key="SafeBoxBorder" Color="#BBF7D0"/>
            <SolidColorBrush x:Key="SafeBoxText" Color="#15803D"/>
            <SolidColorBrush x:Key="WarningBoxBg" Color="#FFFBEB"/>
            <SolidColorBrush x:Key="WarningBoxBorder" Color="#FDE68A"/>
            <SolidColorBrush x:Key="WarningBoxText" Color="#92400E"/>
            <SolidColorBrush x:Key="InfoBoxBg" Color="#EFF6FF"/>
            <SolidColorBrush x:Key="InfoBoxBorder" Color="#BFDBFE"/>
            <SolidColorBrush x:Key="InfoBoxText" Color="#1D4ED8"/>

            <!-- Kart kapsayıcı -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="24"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            </Style>
            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <!-- Metin kutusu -->
            <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FieldPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Butonlar -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="18,11"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryBlueHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="18,11"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Background" Value="{StaticResource DangerRed}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource DangerRedHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Segmentli seçim (SQL Server / Windows kimlik doğrulama, Yerel/Bulut vb.) -->
            <Style x:Key="AuthToggleStyle" TargetType="RadioButton">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="0,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1.5" CornerRadius="8">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BadgeBlueBg}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBlueHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Kenar çubuğu gezinme butonu -->
            <Style x:Key="SidebarItemStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource SidebarText}"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Padding" Value="14,11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="GroupName" Value="SidebarNav"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Margin="12,2">
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource SidebarItemHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource SidebarItemActive}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Açma/kapama anahtarı (toggle switch) -->
            <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="#CBD5E1">
                                <Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10" Background="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource PrimaryBlue}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rozet (badge) -->
            <Style x:Key="BadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BadgeBlueBg}"/>
                <Setter Property="CornerRadius" Value="999"/>
                <Setter Property="Padding" Value="10,3"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
