@using SahinSoft.Domain.Enums
@model SahinSoft.Web.Models.PaymentReceiptDetailsViewModel
@{
    ViewData["Title"] = $"Fiş {Model.ReceiptNumber}";
    var statusClass = Model.Status switch
    {
        PaymentReceiptStatus.Draft => "erp-status-draft",
        PaymentReceiptStatus.Approved => "erp-status-approved",
        _ => "erp-status-cancelled"
    };
    var statusText = Model.Status switch
    {
        PaymentReceiptStatus.Draft => "Taslak",
        PaymentReceiptStatus.Approved => "Onaylı",
        _ => "İptal"
    };
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>@(Model.ReceiptType == ReceiptType.Collection ? "Tahsilat Makbuzu" : "Tediye Makbuzu")</h1>
        <span class="erp-doc-no">@Model.ReceiptNumber</span>
        <span class="erp-status-badge @statusClass">@statusText</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-action="Index" class="btn btn-erp-outline btn-sm">Liste</a>
        <button type="button" class="btn btn-erp-outline btn-sm" onclick="window.print()">Yazdır</button>
        @if (Model.Status == PaymentReceiptStatus.Draft)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-erp-outline btn-sm">Düzenle</a>
            <form method="post" asp-action="Approve" asp-route-id="@Model.Id" class="d-inline">
                <button type="submit" class="btn btn-erp-primary btn-sm">Onayla</button>
            </form>
        }
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}
@if (Model.Status == PaymentReceiptStatus.Cancelled)
{
    <div class="alert alert-danger py-2">
        <strong>İptal edildi</strong> &middot; @Model.CancelledAtUtc?.ToString("dd.MM.yyyy HH:mm")<br />
        Gerekçe: @Model.CancellationReason
    </div>
}

<div class="print-only mb-3">
    <h2 class="mb-1">@(Model.ReceiptType == ReceiptType.Collection ? "Tahsilat Makbuzu" : "Tediye Makbuzu")</h2>
    <div>@Model.ReceiptNumber &middot; @Model.CustomerName &middot; @Model.ReceiptDateUtc.ToString("dd.MM.yyyy")</div>
</div>

<div class="erp-panel">
    <div class="erp-panel-header">@Model.CustomerName &middot; @Model.ReceiptDateUtc.ToString("dd.MM.yyyy")</div>
    <div class="erp-panel-body p-0">
        <div class="erp-table-wrap">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>Kasa/Banka</th>
                        <th>Ödeme Yöntemi</th>
                        <th>Referans No</th>
                        <th>Açıklama</th>
                        <th class="text-end">Tutar</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.FinancialAccountName</td>
                        <td>@line.PaymentMethod</td>
                        <td>@line.ReferenceNumber</td>
                        <td>@line.Description</td>
                        <td class="text-end">@line.Amount.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="p-3 d-flex">
            <div class="erp-totals">
                <div class="erp-totals-row erp-grand-total"><span>Genel Toplam</span><span class="erp-total-value">@Model.TotalAmount.ToString("N2") @Model.CurrencyCode</span></div>
            </div>
        </div>
    </div>
</div>

@if (Model.Description is not null)
{
    <div class="erp-panel">
        <div class="erp-panel-header">Açıklama</div>
        <div class="erp-panel-body">@Model.Description</div>
    </div>
}

@if (Model.Status == PaymentReceiptStatus.Approved && User.IsInRole(SahinSoft.Domain.Constants.AppRoles.Administrator))
{
    <div class="erp-panel">
        <div class="erp-panel-header">Fişi İptal Et</div>
        <div class="erp-panel-body">
            <p class="text-secondary small mb-2">İptal işlemi kaydı silmez; cari ve kasa/banka için ters hareket üretir.</p>
            <form method="post" asp-action="Cancel" asp-route-id="@Model.Id" class="d-flex gap-2">
                <input type="text" name="reason" class="form-control" placeholder="İptal gerekçesi" required />
                <button type="submit" class="btn btn-erp-danger text-nowrap">İptal Et</button>
            </form>
        </div>
    </div>
}
