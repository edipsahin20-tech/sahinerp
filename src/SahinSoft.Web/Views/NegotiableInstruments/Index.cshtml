@using SahinSoft.Domain.Enums
@model IReadOnlyList<SahinSoft.Domain.Entities.NegotiableInstrument>
@{
    ViewData["Title"] = "Çek/Senet";
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>Çek/Senet Yönetimi</h1>
        <span class="erp-toolbar-meta">@Model.Count kayıt</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-action="Create" asp-route-type="@NegotiableInstrumentType.Cheque" class="btn btn-erp-outline btn-sm">+ Çek</a>
        <a asp-action="Create" asp-route-type="@NegotiableInstrumentType.PromissoryNote" class="btn btn-erp-primary btn-sm">+ Senet</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<form method="get" class="erp-filter-bar">
    <div class="erp-field">
        <label>Tür</label>
        <select name="type" class="form-select" style="max-width: 160px;" asp-items="Html.GetEnumSelectList<NegotiableInstrumentType>()">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="erp-field">
        <label>Durum</label>
        <select name="status" class="form-select" style="max-width: 170px;" asp-items="Html.GetEnumSelectList<InstrumentStatus>()">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="erp-field flex-grow-1">
        <label>Ara</label>
        <input class="form-control" autocomplete="off" placeholder="Belge no veya cari ara..." data-live-search="#negotiableInstrumentsTable" />
    </div>
    <button class="btn btn-erp-primary">Filtrele</button>
</form>

<div class="erp-panel">
    <div class="erp-panel-body p-0">
    <div class="erp-table-wrap">
        <table class="erp-table" id="negotiableInstrumentsTable">
            <thead>
                <tr>
                    <th>Belge No</th>
                    <th>Tür</th>
                    <th>Yön</th>
                    <th>Cari</th>
                    <th>Vade</th>
                    <th class="text-end">Tutar</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.InstrumentNumber</td>
                    <td>@(item.InstrumentType == NegotiableInstrumentType.Cheque ? "Çek" : "Senet")</td>
                    <td>@(item.Direction == InstrumentDirection.Received ? "Alınan" : "Verilen")</td>
                    <td>@item.Customer.Name</td>
                    <td>@item.DueDateUtc.ToString("dd.MM.yyyy")</td>
                    <td class="text-end">@item.Amount.ToString("N2") @item.CurrencyCode</td>
                    <td><span class="badge text-bg-secondary-subtle text-secondary-emphasis">@item.Status.GetDisplayName()</span></td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.78rem;">Görüntüle</a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
            }
            </tbody>
        </table>
    </div>
    </div>
</div>
