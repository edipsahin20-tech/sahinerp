@model SahinSoft.Web.Models.ProductFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Stok Kartını Düzenle" : "Yeni Stok Kartı";
}

<form id="evrak-form" class="erp-compact-product-form" method="post" enctype="multipart/form-data" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <input asp-for="Id" type="hidden" />
    <div class="erp-toolbar">
        <div class="erp-toolbar-title">
            <h1>Stok Tanıtım Kartı</h1>
            <span class="erp-toolbar-meta">@(isEdit ? "Düzenleniyor" : "Yeni stok")</span>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card border-0 shadow-sm erp-panel">
        <div class="erp-tabs">
            <button type="button" class="active" data-tab-btn="genel">Genel Bilgiler</button>
            <button type="button" data-tab-btn="ek">Ek Bilgiler</button>
            @if (ViewBag.IsRestaurantModuleEnabled == true)
            {
                <button type="button" data-tab-btn="restoran">Restoran</button>
            }
            <button type="button" data-tab-btn="notlar">Notlar</button>
        </div>

        <div data-tab-panel="genel">
            <div class="erp-form-section">
                <div class="erp-section-header">
                    <span class="erp-section-number">1</span>
                    <div>
                        <h2>Temel Ürün Bilgileri</h2>
                        <p>Ürünü tanımlayan ana bilgiler.</p>
                    </div>
                </div>
                <div class="row g-3">
                    @if (!isEdit)
                    {
                        <div class="col-12">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="quick-entry-toggle">
                                <label class="form-check-label" for="quick-entry-toggle">Hızlı Stok Girişi (Stok kodu ve barkod otomatik oluşturulsun)</label>
                            </div>
                        </div>
                    }
                    <div class="col-md-4">
                        <label asp-for="StockCode" class="form-label"></label>
                        <input asp-for="StockCode" class="form-control" />
                        <span asp-validation-for="StockCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Name" class="form-control lookup-quicksearch" autofocus autocomplete="off"
                                   data-lookup-endpoint="@Url.Action("Products", "Lookup")"
                                   data-lookup-title="Benzer Stok Ara"
                                   data-target-display="Name"
                                   data-lookup-name-only="true"
                                   data-lookup-navigate-edit="true"
                                   data-lookup-edit-url="@Url.Action("Edit", "Products")"
                                   data-current-id="@Model.Id" />
                            <button type="button" class="btn btn-outline-secondary lookup-trigger"
                                    data-lookup-endpoint="@Url.Action("Products", "Lookup")"
                                    data-lookup-title="Benzer Stok Ara"
                                    data-target-display="Name"
                                    data-lookup-name-only="true"
                                    data-lookup-navigate-edit="true"
                                    data-lookup-edit-url="@Url.Action("Edit", "Products")"
                                    data-current-id="@Model.Id"
                                    title="Benzer Stok Ara">
                                <i class="fa-solid fa-ellipsis"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                        <div class="form-text">Yazarken benzer stoklar önerilir. Var olan bir stok seçilirse, onayınızla o stoğun düzenleme ekranı açılır. "..." ile veya F9'a basarak arayabilirsiniz.</div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <div class="input-group">
                            <select asp-for="CategoryId" class="form-select" asp-items="Model.CategoryOptions" id="CategoryId">
                                <option value="">Kategori seçin</option>
                            </select>
                            <button type="button" class="btn btn-outline-secondary option-picker-btn" data-target="CategoryId" data-title="Kategoriler" data-server-backed="true" title="Kategorileri görüntüle / yeni ekle">+</button>
                        </div>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="UnitOfMeasureId" class="form-label"></label>
                        <select asp-for="UnitOfMeasureId" class="form-select" asp-items="Model.UnitOfMeasureOptions">
                            <option value="">Birim seçin</option>
                        </select>
                        <span asp-validation-for="UnitOfMeasureId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="TaxRateId" class="form-label"></label>
                        <select asp-for="TaxRateId" class="form-select" asp-items="Model.TaxRateOptions">
                            <option value="">KDV oranı seçin</option>
                        </select>
                        <span asp-validation-for="TaxRateId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Brand" class="form-label"></label>
                        <div class="input-group">
                            <select class="form-select" id="brand-select">
                                <option value="">Marka seçin</option>
                                @foreach (var brand in Model.BrandOptions)
                                {
                                    <option value="@brand" selected="@(brand == Model.Brand)">@brand</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-secondary option-picker-btn" data-target="brand-select" data-title="Markalar" data-server-backed="false" title="Markaları görüntüle / yeni ekle">+</button>
                        </div>
                        <input asp-for="Brand" type="hidden" id="Brand" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Model" class="form-label"></label>
                        <div class="input-group">
                            <select class="form-select" id="model-select">
                                <option value="">Model seçin</option>
                                @foreach (var productModel in Model.ModelOptions)
                                {
                                    <option value="@productModel" selected="@(productModel == Model.Model)">@productModel</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-secondary option-picker-btn" data-target="model-select" data-title="Modeller" data-server-backed="false" title="Modelleri görüntüle / yeni ekle">+</button>
                        </div>
                        <input asp-for="Model" type="hidden" id="Model" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Barcode" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Barcode" class="form-control" inputmode="numeric" id="barcode-input" />
                            <select id="barcode-type-select" class="form-select barcode-type-select">
                                <option value="EAN13">EAN13</option>
                                <option value="EAN8">EAN8</option>
                                <option value="ASCII">ASCII</option>
                                <option value="TERAZI">Terazi</option>
                            </select>
                            <button type="button" class="btn btn-erp-outline" onclick="generateBarcode()">Barkod Üret</button>
                        </div>
                        <span asp-validation-for="Barcode" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="erp-form-section">
                <div class="erp-section-header">
                    <span class="erp-section-number">2</span>
                    <div>
                        <h2>Fiyat ve Vergi</h2>
                        <p>Alış ve satış fiyatı bilgileri.</p>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="PurchasePrice" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="PurchasePrice" class="form-control" />
                            <span class="input-group-text">₺</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SalePrice" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="SalePrice" class="form-control" />
                            <span class="input-group-text">₺</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Kar Oranı %</label>
                        <div class="input-group">
                            <input type="text" id="profit-margin-display" class="form-control" readonly tabindex="-1" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
                <div class="form-text mt-2">Not: Alış/Satış fiyatı her zaman KDV dahil girilir; teklif ve fatura satırlarında sistem otomatik olarak KDV hariç tutarı hesaplar.</div>
            </div>

            <div class="erp-form-section">
                <div class="erp-section-header">
                    <span class="erp-section-number">3</span>
                    <div>
                        <h2>Stok Takibi</h2>
                        <p>Depo ve kritik stok ayarları.</p>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="StockQuantity" class="form-label"></label>
                        @if (isEdit)
                        {
                            <input asp-for="StockQuantity" class="form-control" readonly data-val="false" />
                            <div class="form-text">Mevcut stok yalnızca stok fişi, fatura, sevk veya sayım ile değişir.</div>
                        }
                        else
                        {
                            <input asp-for="StockQuantity" class="form-control" />
                            <div class="form-text">Girilen değer varsayılan depoya açılış hareketi oluşturur.</div>
                        }
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MinimumStockQuantity" class="form-label"></label>
                        <input asp-for="MinimumStockQuantity" class="form-control" />
                    </div>
                    <div class="col-md-4 d-flex flex-wrap align-items-center gap-4">
                        <div class="form-check form-switch mb-0">
                            <input asp-for="TrackStock" class="form-check-input" />
                            <label asp-for="TrackStock" class="form-check-label"></label>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div data-tab-panel="ek" hidden>
            <div class="erp-form-section">
                <div class="erp-section-header">
                    <span class="erp-section-number">1</span>
                    <div>
                        <h2>Ek Bilgiler</h2>
                        <p>Diğer stok tanımlama bilgileri.</p>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="ProductType" class="form-label"></label>
                        <select asp-for="ProductType" class="form-select">
                            <option>Donanım</option>
                            <option>Yazılım</option>
                            <option>Hizmet</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AlternateName" class="form-label"></label>
                        <input asp-for="AlternateName" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ShelfLifeDays" class="form-label"></label>
                        <input asp-for="ShelfLifeDays" class="form-control" />
                        <span asp-validation-for="ShelfLifeDays" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CountryOfOrigin" class="form-label"></label>
                        <input asp-for="CountryOfOrigin" class="form-control" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Ürün Fotoğrafı</label>
                        <input asp-for="ImagePath" type="hidden" />
                        <div class="d-flex align-items-center gap-3">
                            <img src="@Model.ImagePath" alt=""
                                 style="width:64px;height:64px;object-fit:cover;border-radius:8px;border:1px solid #E3E8EF;@(string.IsNullOrWhiteSpace(Model.ImagePath) ? "display:none;" : "")"
                                 id="product-image-preview" />
                            <div class="flex-grow-1">
                                <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" id="product-image-file-input" />
                                <span asp-validation-for="ImageFile" class="text-danger small"></span>
                                @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                                {
                                    <div class="form-check mt-1">
                                        <input asp-for="RemoveImage" class="form-check-input" id="product-image-remove" />
                                        <label asp-for="RemoveImage" class="form-check-label small"></label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-center">
                        <div class="form-check form-switch mb-0">
                            <input asp-for="TrackSerialNumbers" class="form-check-input" />
                            <label asp-for="TrackSerialNumbers" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (ViewBag.IsRestaurantModuleEnabled == true)
        {
            <div data-tab-panel="restoran" hidden>
                <div class="erp-form-section">
                    <div class="erp-section-header">
                        <span class="erp-section-number">1</span>
                        <div>
                            <h2>Restoran</h2>
                            <p>Restoran Modülü açıkken kullanılan ek alanlar.</p>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="LoyaltyPoints" class="form-label"></label>
                            <input asp-for="LoyaltyPoints" class="form-control" />
                            <span asp-validation-for="LoyaltyPoints" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="KitchenPrinterName" class="form-label"></label>
                            <input asp-for="KitchenPrinterName" class="form-control" placeholder="Örn: Mutfak Yazıcısı 1" />
                        </div>
                        <div class="col-md-4 d-flex flex-wrap align-items-center gap-3">
                            <div class="form-check form-switch mb-0">
                                <input asp-for="ShowAsShortcut" class="form-check-input" />
                                <label asp-for="ShowAsShortcut" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-center">
                            <div class="form-check form-switch mb-0">
                                <input asp-for="ShowInMobile" class="form-check-input" />
                                <label asp-for="ShowInMobile" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-center">
                            <div class="form-check form-switch mb-0">
                                <input asp-for="ShowInOnlineOrder" class="form-check-input" />
                                <label asp-for="ShowInOnlineOrder" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div data-tab-panel="notlar" hidden>
            <div class="erp-form-section">
                <div class="erp-section-header">
                    <span class="erp-section-number">1</span>
                    <div>
                        <h2>Notlar</h2>
                        <p>Ürünle ilgili serbest metin açıklaması.</p>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!isEdit)
    {
        <div class="d-flex justify-content-end mt-3">
            <button type="submit" form="evrak-form" name="saveMode" value="saveAndNew" class="btn btn-erp-outline">
                Kaydet ve Yeni Ekle
            </button>
        </div>
    }
</form>

<partial name="_EvrakToolbar" model="(SahinSoft.Web.Models.EvrakToolbarViewModel?)ViewBag.Toolbar" />

@* Kategori/Marka/Model "+" düğmeleri bu TEK paylaşılan modalı açar: önce mevcut tüm kayıtların
   listesini gösterir (satıra tıklayınca o değer seçilir), üstteki mini formdan yeni kayıt eklenir —
   doğrudan bir prompt() ile "kör" ekleme yapılmaz. *@
<div class="modal fade" id="optionPickerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content op-modal">
            <div class="modal-header" style="border-bottom:0;">
                <div class="op-head">
                    <i class="fa-regular fa-folder-open op-head-ico" id="optionPickerIcon"></i>
                    <div>
                        <h5 class="modal-title mb-0" id="optionPickerTitle">Liste</h5>
                        <small class="text-secondary" id="optionPickerSubtitle">Kayıtları yönetin ve seçin.</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-2">
                    <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" id="optionPickerSearch" class="form-control" placeholder="Ara..." autocomplete="off" />
                    <span class="input-group-text small text-secondary" id="optionPickerCount">0 kayıt</span>
                </div>
                <div class="p-3 mb-3 rounded-3 op-new">
                    <label class="form-label fw-bold mb-1" id="optionPickerNewLabel">Yeni kayıt</label>
                    <div class="input-group">
                        <input type="text" id="optionPickerNewValue" class="form-control" placeholder="Yeni değer yazın" />
                        <button type="button" class="btn op-navy" id="optionPickerAddBtn"><i class="fa-solid fa-plus"></i> Ekle</button>
                    </div>
                </div>
                <div class="op-list-head"><span id="optionPickerColName">Ad</span><span>İşlemler</span></div>
                <div class="list-group op-list" id="optionPickerList"></div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #E3E8EF;">
                <div class="me-auto text-secondary">Seçili: <strong id="optionPickerSelected">—</strong></div>
                <button type="button" class="btn op-cancel" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn op-navy" id="optionPickerApplyBtn"><i class="fa-solid fa-check"></i> Seçimi Uygula</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var fileInput = document.getElementById('product-image-file-input');
            var preview = document.getElementById('product-image-preview');
            var removeCheckbox = document.getElementById('product-image-remove');
            if (!fileInput || !preview) return;
            fileInput.addEventListener('change', function () {
                var file = fileInput.files && fileInput.files[0];
                if (!file) return;
                if (removeCheckbox) removeCheckbox.checked = false;
                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = '';
                };
                reader.readAsDataURL(file);
            });
        })();

        function generateBarcode() {
            var type = document.getElementById('barcode-type-select').value;
            fetch('@Url.Action("GenerateBarcodeApi", "Products")?type=' + encodeURIComponent(type))
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data && data.barcode) {
                        document.getElementById('barcode-input').value = data.barcode;
                    }
                })
                .catch(function (err) {
                    console.error('Barkod üretme hatası:', err);
                    alert('Barkod üretilirken bir hata oluştu.');
                });
        }

        (function () {
            var quickEntryToggle = document.getElementById('quick-entry-toggle');
            if (!quickEntryToggle) return;

            var stockCodeInput = document.getElementById('StockCode');
            var barcodeInput = document.getElementById('barcode-input');
            var barcodeTypeSelect = document.getElementById('barcode-type-select');
            var barcodeGenerateButton = barcodeInput.closest('.input-group').querySelector('button');

            function applyQuickEntryState() {
                var quick = quickEntryToggle.checked;
                stockCodeInput.disabled = quick;
                barcodeInput.disabled = quick;
                barcodeTypeSelect.disabled = quick;
                barcodeGenerateButton.disabled = quick;
                if (quick) {
                    stockCodeInput.value = '';
                    barcodeInput.value = '';
                    stockCodeInput.placeholder = 'Kaydedince otomatik oluşturulacak';
                    barcodeInput.placeholder = 'Kaydedince otomatik oluşturulacak (EAN13)';
                } else {
                    stockCodeInput.placeholder = '';
                    barcodeInput.placeholder = '';
                }
            }

            quickEntryToggle.addEventListener('change', applyQuickEntryState);
            applyQuickEntryState();
        })();

        (function () {
            var purchaseInput = document.getElementById('PurchasePrice');
            var saleInput = document.getElementById('SalePrice');
            var marginDisplay = document.getElementById('profit-margin-display');
            if (!purchaseInput || !saleInput || !marginDisplay) return;

            function recalcMargin() {
                var purchase = parseFloat((purchaseInput.value || '0').replace(',', '.'));
                var sale = parseFloat((saleInput.value || '0').replace(',', '.'));
                if (!purchase || purchase <= 0 || isNaN(sale)) {
                    marginDisplay.value = '';
                    return;
                }
                var margin = ((sale - purchase) / purchase) * 100;
                marginDisplay.value = margin.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            purchaseInput.addEventListener('input', recalcMargin);
            saleInput.addEventListener('input', recalcMargin);
            recalcMargin();
        })();

        // Marka/Model: ayrı bir tanım tablosu yok, bu yüzden sabit dropdown mevcut ürünlerdeki
        // farklı değerlerden geliyor (bkz. ProductsController.PopulateSelectionsAsync). Seçilen
        // değer, formun asıl gönderdiği asp-for="Brand"/"Model" gizli input'una senkronize edilir.
        (function () {
            function wireSelect(selectId, hiddenId) {
                var select = document.getElementById(selectId);
                var hidden = document.getElementById(hiddenId);
                if (!select || !hidden) return;
                select.addEventListener('change', function () {
                    hidden.value = select.value;
                });
            }
            wireSelect('brand-select', 'Brand');
            wireSelect('model-select', 'Model');
        })();

        // Kategori/Marka/Model "+" düğmeleri: tıklanınca önce TÜM mevcut kayıtların listesini
        // gösteren tek paylaşılan modal açılır (satıra tıklayınca o değer seçilip modal kapanır);
        // yeni kayıt modalın üstündeki mini formdan eklenir — asla doğrudan bir prompt() ile "kör"
        // ekleme yapılmaz. Kategori "sunucu destekli" (data-server-backed="true"): gerçek bir
        // ProductCategory satırı oluşturur (bkz. CategoriesController.CreateQuickApi) — Kategori
        // zaten kapalı bir liste olduğu için (kullanıcı isteği: "sadece seçim yapılsın"). Marka/Model
        // ayrı bir tanım tablosuna sahip olmadığından yeni değer yalnızca istemci tarafında dropdown'a
        // eklenir; ürün kaydedildiğinde bir sonraki üründe listede kendiliğinden görünür (distinct
        // sorgusu sayesinde).
        (function () {
            var modalEl = document.getElementById('optionPickerModal');
            var titleEl = document.getElementById('optionPickerTitle');
            var listEl = document.getElementById('optionPickerList');
            var newValueInput = document.getElementById('optionPickerNewValue');
            var addBtn = document.getElementById('optionPickerAddBtn');
            var bsModal = null;
            var activeConfig = null;

            function ensureModal() {
                if (!bsModal) bsModal = new bootstrap.Modal(modalEl);
                return bsModal;
            }

            var pendingValue = null;

            function renderList() {
                var select = document.getElementById(activeConfig.targetSelectId);
                var query = (document.getElementById('optionPickerSearch').value || '').toLowerCase();
                var currentValue = pendingValue !== null ? pendingValue : select.value;
                listEl.innerHTML = '';
                var shown = 0;
                Array.from(select.options).forEach(function (option) {
                    if (!option.value) return;
                    if (query && option.textContent.toLowerCase().indexOf(query) === -1) return;
                    shown++;
                    var isSelected = option.value === String(currentValue);
                    var row = document.createElement('div');
                    row.className = 'list-group-item op-row d-flex align-items-center justify-content-between' + (isSelected ? ' op-selected' : '');
                    row.style.cursor = 'pointer';
                    var label = document.createElement('span');
                    label.className = 'op-label';
                    label.innerHTML = (isSelected ? '<i class="fa-solid fa-circle-check op-check"></i>' : '<i class="op-check-gap"></i>') +
                        '<i class="fa-regular ' + (activeConfig.serverBacked ? 'fa-folder' : 'fa-bookmark') + ' op-folder"></i>';
                    var text = document.createElement('span');
                    text.textContent = option.textContent;
                    label.appendChild(text);
                    row.appendChild(label);
                    row.addEventListener('click', function (e) {
                        if (e.target.closest('[data-action]')) return;
                        pendingValue = option.value;
                        renderList();
                    });
                    if (activeConfig.serverBacked) {
                        var actions = document.createElement('span');
                        actions.className = 'd-flex gap-3 op-actions';
                        var edit = document.createElement('a');
                        edit.href = '@Url.Action("Edit", "Categories")/' + option.value;
                        edit.target = '_blank';
                        edit.setAttribute('data-action', 'edit');
                        edit.title = 'Düzenle';
                        edit.innerHTML = '<i class="fa-solid fa-pencil"></i>';
                        var del = document.createElement('button');
                        del.type = 'button';
                        del.setAttribute('data-action', 'delete');
                        del.title = 'Sil';
                        del.innerHTML = '<i class="fa-regular fa-trash-can"></i>';
                        del.addEventListener('click', function () { deleteOption(option); });
                        actions.appendChild(edit);
                        actions.appendChild(del);
                        row.appendChild(actions);
                    }
                    listEl.appendChild(row);
                });
                document.getElementById('optionPickerCount').textContent = shown + ' ' + (activeConfig.serverBacked ? 'kategori' : 'kayıt');
                var selectedOpt = Array.from(select.options).find(function (o) { return o.value === String(currentValue); });
                document.getElementById('optionPickerSelected').textContent = selectedOpt && selectedOpt.value ? selectedOpt.textContent : '—';
                if (!listEl.children.length) {
                    listEl.innerHTML = '<p class="text-secondary small mb-0">Kayıt bulunamadı — üstteki kutudan ekleyebilirsiniz.</p>';
                }
            }

            function deleteOption(option) {
                if (!confirm('"' + option.textContent + '" silinsin mi?')) return;
                var formData = new FormData();
                var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);
                fetch('@Url.Action("Delete", "Categories")/' + option.value, { method: 'POST', body: formData })
                    .then(function (r) {
                        if (!r.ok) throw new Error('silinemedi');
                        var select = document.getElementById(activeConfig.targetSelectId);
                        option.remove();
                        if (select.value === option.value) select.value = '';
                        pendingValue = null;
                        renderList();
                    })
                    .catch(function () { alert('Kayıt silinemedi. Kullanımda olabilir.'); });
            }

            document.getElementById('optionPickerSearch').addEventListener('input', renderList);

            document.getElementById('optionPickerApplyBtn').addEventListener('click', function () {
                var select = document.getElementById(activeConfig.targetSelectId);
                var value = pendingValue !== null ? pendingValue : select.value;
                if (pendingValue !== null) {
                    select.value = value;
                    select.dispatchEvent(new Event('change'));
                }
                pendingValue = null;
                ensureModal().hide();
            });

            document.querySelectorAll('.option-picker-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    activeConfig = {
                        targetSelectId: btn.getAttribute('data-target'),
                        serverBacked: btn.getAttribute('data-server-backed') === 'true'
                    };
                    var listTitle = btn.getAttribute('data-title') || 'Liste';
                    titleEl.textContent = listTitle;
                    var singular = { 'Kategoriler': 'Kategori', 'Markalar': 'Marka', 'Modeller': 'Model' }[listTitle] || 'Kayıt';
                    document.getElementById('optionPickerSubtitle').textContent = listTitle === 'Kategoriler' ? 'Stok kartlarınız için kategorileri yönetin.' : 'Kayıtları yönetin ve seçin.';
                    document.getElementById('optionPickerColName').textContent = singular + ' adı';
                    document.getElementById('optionPickerNewLabel').textContent = 'Yeni ' + singular.toLowerCase();
                    document.getElementById('optionPickerNewValue').placeholder = singular + ' adı yazın';
                    document.getElementById('optionPickerSearch').placeholder = singular + ' ara...';
                    newValueInput.value = '';
                    pendingValue = null;
                    document.getElementById('optionPickerSearch').value = '';
                    renderList();
                    ensureModal().show();
                });
            });

            addBtn.addEventListener('click', function () {
                var value = newValueInput.value.trim();
                if (!value || !activeConfig) return;
                var select = document.getElementById(activeConfig.targetSelectId);

                function appendAndSelect(optionValue, optionLabel) {
                    var existing = Array.from(select.options).find(function (o) { return o.value === String(optionValue); });
                    if (!existing) {
                        existing = document.createElement('option');
                        existing.value = optionValue;
                        existing.textContent = optionLabel;
                        select.appendChild(existing);
                    }
                    select.value = optionValue;
                    select.dispatchEvent(new Event('change'));
                    bsModal.hide();
                }

                if (!activeConfig.serverBacked) {
                    appendAndSelect(value, value);
                    return;
                }

                var formData = new FormData();
                formData.append('name', value);
                var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);

                fetch('@Url.Action("CreateQuickApi", "Categories")', { method: 'POST', body: formData })
                    .then(function (r) {
                        if (!r.ok) throw new Error('İstek başarısız');
                        return r.json();
                    })
                    .then(function (data) {
                        appendAndSelect(data.id, data.name);
                    })
                    .catch(function () {
                        alert('Kategori eklenirken bir hata oluştu.');
                    });
            });
        })();
    </script>
}

<style>
    .op-modal { border-radius: 14px; border: 0; box-shadow: 0 20px 60px rgba(15,31,58,.28); }
    #optionPickerModal .modal-dialog { max-width: 740px; }
    #optionPickerModal .modal-header { padding: 22px 28px 6px; }
    #optionPickerModal .modal-body { padding: 8px 28px 16px; }
    .op-head { display: flex; gap: 16px; align-items: center; }
    .op-head-ico { font-size: 34px; color: #12305a; }
    #optionPickerTitle { font-size: 26px; font-weight: 800; color: #0f1f3a; }
    #optionPickerSubtitle { font-size: 16px; }
    #optionPickerSearch { height: 46px; font-size: 16px; }
    #optionPickerModal .input-group-text { background: #fff; color: #64748b; }
    .op-new { background: #eaf3fd; border: 1px solid #cfe2f7; }
    .op-new label { font-size: 17px; color: #0f1f3a; }
    #optionPickerNewValue { height: 46px; font-size: 16px; }
    .op-navy { background: #12305a; color: #fff; border: 0; height: 46px; padding: 0 22px; font-weight: 700; font-size: 16px; border-radius: 8px; }
    .op-navy:hover { background: #0d2547; color: #fff; }
    .op-cancel { background: #fff; color: #0f1f3a; border: 1px solid #12305a; height: 46px; padding: 0 28px; font-weight: 600; font-size: 16px; border-radius: 8px; }
    .op-list-head { display: flex; justify-content: space-between; background: #eef2f8; padding: 14px 20px 14px 52px; font-weight: 700; color: #1e293b; border-radius: 8px 8px 0 0; }
    .op-list { border: 1px solid #e6ecf4; border-top: 0; border-radius: 0 0 8px 8px; max-height: 380px; overflow: auto; }
    .op-row { border: 0; border-bottom: 1px solid #edf1f7; padding: 13px 20px; font-size: 17px; color: #0f1f3a; }
    .op-row:last-child { border-bottom: 0; }
    .op-row.op-selected { background: #e6f0fc; }
    .op-label { display: flex; align-items: center; gap: 14px; }
    .op-check { color: #12305a; font-size: 24px; width: 24px; }
    .op-check-gap { display: inline-block; width: 24px; }
    .op-folder { font-size: 22px; color: #334155; }
    .op-actions a, .op-actions button { background: none; border: 0; color: #334155; font-size: 18px; padding: 2px 6px; cursor: pointer; text-decoration: none; }
    .op-actions a:hover, .op-actions button:hover { color: #12305a; }
    #optionPickerModal .modal-footer { padding: 16px 28px; font-size: 17px; }
    #optionPickerModal .modal-footer strong { color: #0f1f3a; }
</style>
