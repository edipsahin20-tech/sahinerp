@model SahinSoft.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">ŞAHİNSOFT YÖNETİM SİSTEMİ</p>
        <h1 class="h2 mb-1">Yönetim Paneli</h1>
        <p class="text-secondary mb-0">Cari, ürün, stok, fatura ve tahsilat süreçlerinizi tek yerden yönetin.</p>
    </div>
    <a asp-controller="Invoices" asp-action="Create" asp-route-type="Sales" class="btn btn-primary btn-lg">+ Yeni satış faturası</a>
</div>

<div class="row g-3">
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-controller="Customers" asp-action="Index" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm"><div class="card-body">
                <div class="text-secondary small">Aktif cari</div>
                <div class="display-6 fw-semibold">@Model.ActiveCustomerCount</div>
            </div></div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-controller="Products" asp-action="Index" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm"><div class="card-body">
                <div class="text-secondary small">Aktif ürün</div>
                <div class="display-6 fw-semibold">@Model.ActiveProductCount</div>
            </div></div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-controller="Invoices" asp-action="Index" asp-route-status="Draft" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm"><div class="card-body">
                <div class="text-secondary small">Taslak fatura</div>
                <div class="display-6 fw-semibold">@Model.DraftInvoiceCount</div>
                <span class="badge text-bg-warning">Taslak</span>
            </div></div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-controller="Invoices" asp-action="Index" asp-route-status="Approved" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm"><div class="card-body">
                <div class="text-secondary small">Onaylı fatura</div>
                <div class="display-6 fw-semibold">@Model.ApprovedInvoiceCount</div>
                <span class="badge text-bg-success">Onaylandı</span>
            </div></div>
        </a>
    </div>
</div>
