@model SahinSoft.Web.Models.CustomerStatementViewModel
@{
    ViewData["Title"] = "Cari Hareket Föyü";
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>Cari Hareket Föyü</h1>
        <span class="erp-toolbar-meta">@Model.CustomerCode &middot; @Model.CustomerName</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-action="Index" class="btn btn-erp-outline btn-sm">Cari Listesi</a>
        <button type="button" class="btn btn-erp-outline btn-sm" onclick="window.print()">Yazdır</button>
    </div>
</div>

<form method="get" class="erp-filter-bar no-print">
    <input type="hidden" name="id" value="@Model.CustomerId" />
    <div class="erp-field">
        <label>İlk Tarih</label>
        <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="erp-field">
        <label>Son Tarih</label>
        <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <button class="btn btn-erp-primary">Filtrele</button>
</form>

<div class="print-only mb-3">
    <h2 class="mb-1">Cari Hareket Föyü</h2>
    <div>@Model.CustomerCode &middot; @Model.CustomerName</div>
    @if (Model.From.HasValue || Model.To.HasValue)
    {
        <div>@(Model.From?.ToString("dd.MM.yyyy") ?? "Baştan") - @(Model.To?.ToString("dd.MM.yyyy") ?? "Sona")</div>
    }
</div>

<div class="erp-summary-row">
    <div class="erp-summary-box">
        <div class="erp-summary-label">Devir</div>
        <div class="erp-summary-value">@Model.OpeningBalance.ToString("N2")</div>
    </div>
    <div class="erp-summary-box">
        <div class="erp-summary-label">Borç</div>
        <div class="erp-summary-value">@Model.Lines.Sum(x => x.Debit).ToString("N2")</div>
    </div>
    <div class="erp-summary-box">
        <div class="erp-summary-label">Alacak</div>
        <div class="erp-summary-value">@Model.Lines.Sum(x => x.Credit).ToString("N2")</div>
    </div>
    <div class="erp-summary-box" style="border-color: var(--erp-gold);">
        <div class="erp-summary-label">Bakiye</div>
        <div class="erp-summary-value" style="color: @(Model.ClosingBalance >= 0 ? "#8a2a2a" : "#1f7a4d");">
            @Model.ClosingBalance.ToString("N2")
        </div>
        <div class="text-secondary" style="font-size: 0.68rem;">@(Model.ClosingBalance >= 0 ? "CARİ BORÇLU" : "CARİ ALACAKLI")</div>
    </div>
</div>

<div class="erp-panel">
    <div class="erp-panel-body p-0">
        <div class="erp-table-wrap">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>İşlem</th>
                        <th>Belge No</th>
                        <th>Açıklama</th>
                        <th class="text-end">Borç</th>
                        <th class="text-end">Alacak</th>
                        <th class="text-end">Bakiye</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.OpeningBalance != 0)
                {
                    <tr style="background: var(--erp-header-bg); font-weight: 700;">
                        <td colspan="6">Devreden Bakiye</td>
                        <td class="text-end">@Model.OpeningBalance.ToString("N2")</td>
                    </tr>
                }
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.TransactionDateUtc.ToString("dd.MM.yyyy")</td>
                        <td>@line.TransactionType</td>
                        <td>@line.DocumentNumber</td>
                        <td>@line.Description</td>
                        <td class="text-end">@(line.Debit > 0 ? line.Debit.ToString("N2") : "")</td>
                        <td class="text-end">@(line.Credit > 0 ? line.Credit.ToString("N2") : "")</td>
                        <td class="text-end fw-semibold">@line.RunningBalance.ToString("N2")</td>
                    </tr>
                }
                @if (Model.Lines.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-4">Bu tarih aralığında hareket bulunmuyor.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
