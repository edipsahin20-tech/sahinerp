<UserControl x:Class="SahinSoft.ConfigTool.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Veritabanı Oluştur ve Bakım" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock Text="Yeni veritabanı oluşturun veya mevcut veritabanının bakımını yapın." Style="{StaticResource PageSubtitleStyle}"/>

        <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,20,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗄" FontSize="15" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,24,0">
                        <TextBlock Text="Sunucu (Server)" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock x:Name="ServerText" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Veritabanı" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock x:Name="DatabaseText" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Bağlantıyı Test Et" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" FontSize="12" Click="TestConnection_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Yeni Veritabanı Oluştur" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Sunucuda yeni bir veritabanı oluşturun. Tablolar ilk uygulama açılışında otomatik olarak kurulur." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Veritabanı Adı" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="NewDbNameBox" Style="{StaticResource FieldTextBoxStyle}"/>
                    </StackPanel>
                    <Button Content="🗄 Veritabanı Oluştur" Style="{StaticResource PrimaryButtonStyle}" Margin="0,14,0,0" HorizontalAlignment="Stretch" Click="CreateDatabase_Click"/>
                    <Button Content="🗑 Veritabanını Sil" Style="{StaticResource DangerButtonStyle}" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="DeleteDatabase_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Bakım İşlemleri" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Mevcut veritabanı üzerinde bakım işlemlerini gerçekleştirin." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <StackPanel Margin="0,16,0,0">
                        <CheckBox x:Name="CheckIntegrityCheck" FontSize="13" Margin="0,0,0,10">
                            <StackPanel><TextBlock Text="Veri Bütünlüğü Denetimi" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Yalnızca denetim raporu oluşturur." FontSize="11.5" Foreground="{StaticResource TextMuted}"/></StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="CleanupLogCheck" FontSize="13" Margin="0,0,0,10">
                            <StackPanel><TextBlock Text="Log Temizleme" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="İşlem loglarını temizler, veritabanı boyutunu azaltır." FontSize="11.5" Foreground="{StaticResource TextMuted}"/></StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="IndexMaintenanceCheck" FontSize="13" Margin="0,0,0,10">
                            <StackPanel><TextBlock Text="İndeks Bakımı" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="İndeksleri yeniden oluşturur, performansı iyileştirir." FontSize="11.5" Foreground="{StaticResource TextMuted}"/></StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="ShrinkCheck" FontSize="13">
                            <StackPanel><TextBlock Text="Dosya Boyutunu Küçült" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Veritabanı dosyalarının boyutunu küçültür." FontSize="11.5" Foreground="{StaticResource TextMuted}"/></StackPanel>
                        </CheckBox>
                    </StackPanel>
                    <Button Content="⚙ Seçili İşlemleri Çalıştır" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" HorizontalAlignment="Stretch" Click="RunMaintenance_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="Yedekleme Ayarları" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Oluşturma ve bakım işlemleri öncesinde yedekleme alınacak klasörü belirleyin." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="Yedek Klasörü" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackupFolderBox" Grid.Column="0" Style="{StaticResource FieldTextBoxStyle}"/>
                        <Button Grid.Column="2" Content="📁 Gözat..." Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Click="BrowseBackupFolder_Click"/>
                    </Grid>
                    <TextBlock Text="Boş bırakırsanız sunucunun varsayılan yedek klasörü kullanılır." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="Firmalar Arası Veri Aktarımı" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Kaynak firmadan hedef firmaya stok kartı, cari kartı ve kategori kopyalar. Hareketler ve bakiyeler taşınmaz; hedefte aynı kodlu kayıt varsa atlanır." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Kaynak Firma" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="TransferSourceCombo" Padding="8,6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hedef Firma" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="TransferTargetCombo" Padding="8,6"/>
                    </StackPanel>
                </Grid>
                <Button Content="Kaynaktan Listele" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="TransferList_Click"/>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Kategoriler" Style="{StaticResource SectionTitleStyle}" FontSize="13"/>
                        <CheckBox x:Name="CategoriesAll" Content="Tümünü seç" Margin="0,6,0,6" Checked="SelectAllCategories" Unchecked="UnselectAllCategories"/>
                        <ListBox x:Name="CategoriesList" SelectionMode="Multiple" MaxHeight="220"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Stok Kartları" Style="{StaticResource SectionTitleStyle}" FontSize="13"/>
                        <CheckBox x:Name="ProductsAll" Content="Tümünü seç" Margin="0,6,0,6" Checked="SelectAllProducts" Unchecked="UnselectAllProducts"/>
                        <ListBox x:Name="ProductsList" SelectionMode="Multiple" MaxHeight="220"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Cari Kartları" Style="{StaticResource SectionTitleStyle}" FontSize="13"/>
                        <CheckBox x:Name="CustomersAll" Content="Tümünü seç" Margin="0,6,0,6" Checked="SelectAllCustomers" Unchecked="UnselectAllCustomers"/>
                        <ListBox x:Name="CustomersList" SelectionMode="Multiple" MaxHeight="220"/>
                    </StackPanel>
                </Grid>

                <Button Content="Seçilenleri Aktar" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" HorizontalAlignment="Stretch" Click="TransferRun_Click"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="İşlem Kaydı" Style="{StaticResource SectionTitleStyle}"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SAAT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Grid.Column="1" Text="İŞLEM" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Grid.Column="2" Text="DURUM" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                </Grid>
                <Separator Margin="0,8,0,8"/>
                <ItemsControl x:Name="LogItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="12.5"/>
                                <TextBlock Grid.Column="1" Text="{Binding Operation}" FontSize="12.5" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12.5" Foreground="{Binding StatusColor}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyLogText" Text="Henüz işlem yapılmadı." FontSize="12.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
