@{
    // submitCancelReceipt koşulsuz tanımlanıyor - yukarıdaki "if bloğu" içine sarmalı hâli (büyük
    // modal markup + nested if + script) Razor derleyicisinde (SDK 10.0.302) markup'ı kod olarak
    // yorumlatan bir hataya yol açıyordu. Modal zaten Model.SelectedReceipt null'sa DOM'a hiç
    // girmediği için bu fonksiyon kullanılmadan kalır, zararsız.
}
<script>
    function submitCancelReceipt() {
        window.posPrompt('İptal gerekçesi (fiş silinip yerine ters kayıt oluşturulacak):', '', function (reason) {
            if (!reason || !reason.trim()) { return; }
            window.posConfirm('Bu fişi silmek istediğinize emin misiniz? Bu işlem geri alınamaz.', function () {
                document.getElementById('cancel-receipt-reason').value = reason.trim();
                document.getElementById('cancel-receipt-form').submit();
            }, null, { danger: true });
        });
    }
</script>

<!-- GERÇEK HATA (2026-09-06, Z dönem kapatma test talimatıyla bulundu) - bu sayfada Z kapatma/
     fiş silme akışları native confirm()/prompt()/alert() kullanıyordu ("native browser
     alert/confirm/prompt kullanılmayacak" kuralına aykırı, bkz. Check.cshtml/pos-dialog.js'teki
     AYNI kural). posDialogModal + pos-dialog.js Check.cshtml'e ÖZGÜ olduğundan (paylaşılan
     restoran shell layout'unda değil) burada sayfaya özel, bağımsız bir kopyası eklendi. -->
<div class="modal fade" id="posDialogModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ŞahinSoft Restoran</h5>
            </div>
            <div class="modal-body">
                <div id="posDialogMessage" style="white-space:pre-line;"></div>
                <input type="text" id="posDialogInput" class="form-control mt-2" style="display:none;" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-erp-outline" id="posDialogCancelBtn">Vazgeç</button>
                <button type="button" class="btn btn-erp-primary" id="posDialogOkBtn">Tamam</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pos-dialog.js" asp-append-version="true"></script>
    <script>
        (function () {
            var zConfirmText = 'Z raporu alınacak ve mevcut satış dönemi kapatılacaktır. Devam etmek istiyor musunuz?';
            ['close-shift-submit-btn', 'create-direct-z-submit-btn'].forEach(function (id) {
                var btn = document.getElementById(id);
                if (!btn) return;
                btn.addEventListener('click', function () {
                    window.posConfirm(zConfirmText, function () { btn.closest('form').submit(); }, null, { danger: true });
                });
            });
        })();
    </script>
    <script>
        // Detay Paneli sekme geçişi (2026-09-07) - Fiş/Ürün/Z/Ödeme Türü detay panellerinin
        // TÜMÜ aynı .detail-tab/.detail-pane işaretlemesini paylaşır, tek bir genel fonksiyon.
        function wireDetailPanelTabs(panelId) {
            var panel = document.getElementById(panelId);
            if (!panel) return;
            var tabs = panel.querySelectorAll('.detail-tab');
            var panes = panel.querySelectorAll('.detail-pane');
            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    tabs.forEach(function (t) { t.classList.remove('active'); });
                    panes.forEach(function (p) { p.classList.remove('active'); });
                    tab.classList.add('active');
                    panel.querySelector('.detail-pane[data-pane="' + tab.dataset.pane + '"]').classList.add('active');
                });
            });
        }
    </script>
    @if (Model.SelectedReceipt is not null)
    {
        <script>
            wireDetailPanelTabs('receipt-detail-panel');
            (function () {
                var copyBtn = document.getElementById('copy-receipt-btn');
                if (copyBtn) {
                    copyBtn.addEventListener('click', function () {
                        var text = document.querySelector('#receipt-detail-panel .receipt-preview').innerText;
                        navigator.clipboard.writeText(text).then(function () {
                            window.posAlert ? window.posAlert('Fiş içeriği kopyalandı.') : alert('Fiş içeriği kopyalandı.');
                        });
                    });
                }
            })();
        </script>
    }
    @if (Model.SelectedProduct is not null)
    {
        <script>
            wireDetailPanelTabs('product-detail-panel');
        </script>
    }
    @if (Model.SelectedPaymentMethodDetail is not null)
    {
        <script>
            wireDetailPanelTabs('payment-detail-panel');
        </script>
    }
    @if (Model.SelectedZShiftId is not null && Model.SelectedZSummary is not null)
    {
        <script>
            wireDetailPanelTabs('z-detail-panel');
        </script>
    }
    <script>
        // Excel'e Aktar (madde birebir-uygulama, 2026-09-05) - site.js'teki data-csv-export
        // GERÇEK <table> bekliyor, bu raporlar div-grid (.rthead/.rrow2) olduğu için AYNI CSV
        // mantığıyla ayrı, küçük bir dışa aktarıcı. Sayfadaki İLK ".report-table-wrap[id]"
        // (aktif sekmenin kendi tablosu) hedef alınır.
        (function () {
            var btn = document.getElementById('report-excel-btn');
            if (!btn) return;
            function csvCell(text) {
                var value = String(text || '').trim().replace(/\s+/g, ' ');
                return '"' + value.replace(/"/g, '""') + '"';
            }
            btn.addEventListener('click', function () {
                var wrap = document.querySelector('.report-table-wrap[id]');
                if (!wrap) { window.posAlert('Bu sekmede aktarılacak bir tablo yok.'); return; }
                var rows = [];
                var head = wrap.querySelector('.rthead');
                if (head) { rows.push(Array.from(head.children).map(function (c) { return csvCell(c.textContent); }).join(';')); }
                Array.from(wrap.querySelectorAll('.rrow2')).forEach(function (row) {
                    rows.push(Array.from(row.children).map(function (c) { return csvCell(c.textContent); }).join(';'));
                });
                var csv = '﻿' + rows.join('\r\n');
                var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                var url = URL.createObjectURL(blob);
                var link = document.createElement('a');
                link.href = url;
                link.download = 'rapor-' + '@Model.ActiveTab' + '.csv';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(url);
            });
        })();
    </script>
}
