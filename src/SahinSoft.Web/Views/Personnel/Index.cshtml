@model IReadOnlyList<SahinSoft.Web.Models.PersonnelListItemViewModel>
@{
    ViewData["Title"] = "Personel Listesi";
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>Personel Listesi</h1>
        <span class="erp-toolbar-meta">@Model.Count kayıt</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-action="Create" class="btn btn-erp-primary btn-sm">+ Yeni Personel</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="erp-panel">
    <div class="erp-panel-body p-0">
        <div class="erp-table-wrap">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>Adı Soyadı</th>
                        <th>E-posta</th>
                        <th>Kullanıcı Grubu</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var person in Model)
                {
                    <tr>
                        <td class="fw-semibold">@person.FullName</td>
                        <td>@person.Email</td>
                        <td>@person.RoleName</td>
                        <td>
                            @if (person.IsActive)
                            {
                                <span class="badge text-bg-success-subtle text-success-emphasis">Aktif</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary-subtle text-secondary-emphasis">Pasif</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@person.Id" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.78rem;">Düzenle</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
