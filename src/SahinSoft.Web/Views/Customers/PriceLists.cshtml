@model IReadOnlyList<SahinSoft.Web.Models.AllCustomerPriceListItemViewModel>
@{
    ViewData["Title"] = "Cari Özel Fiyat Listesi";
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>Cari Özel Fiyat Listesi</h1>
        <span class="erp-toolbar-meta">Tüm carilerin güncel özel fiyatları · @Model.Count kayıt</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-action="Index" class="btn btn-erp-outline btn-sm">Cari Listesi</a>
    </div>
</div>

<div class="alert alert-info py-2">
    Burada her cari için o an geçerli olan (en güncel) özel fiyatlar topluca listelenir. Bir cariye ait fiyat geçmişini
    görmek veya yeni fiyat eklemek için ilgili carinin "Özel Fiyatlar" ekranına gidin.
</div>

<form method="get" class="erp-filter-bar">
    <div class="erp-field flex-grow-1">
        <label>Ara</label>
        <input name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Cari kodu, cari adı, ürün kodu veya ürün adı ara..." />
    </div>
    <button class="btn btn-erp-primary">Ara</button>
</form>

<div class="erp-panel">
    <div class="erp-panel-body p-0">
        <div class="erp-table-wrap">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>Cari Kodu</th>
                        <th>Cari</th>
                        <th>Stok Kodu</th>
                        <th>Ürün</th>
                        <th class="text-end">Özel Fiyat (KDV Dahil)</th>
                        <th>Tarih</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var daysOld = (DateTime.UtcNow - item.UpdatedAtUtc).TotalDays;
                    var isStale = daysOld > 30;
                    <tr>
                        <td class="fw-semibold">@item.CustomerCode</td>
                        <td>@item.CustomerName</td>
                        <td class="fw-semibold">@item.ProductCode</td>
                        <td>@item.ProductName</td>
                        <td class="text-end fw-semibold">@item.UnitPrice.ToString("N2") ₺</td>
                        <td>
                            @item.UpdatedAtUtc.ToString("dd.MM.yyyy")
                            @if (isStale)
                            {
                                <span class="badge text-bg-warning-subtle text-warning-emphasis ms-1" title="Bu fiyat 30 günden eski, döviz kuru değişmiş olabilir">@((int)daysOld) gün önce</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="PriceList" asp-route-id="@item.CustomerId" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.78rem;">Geçmişi Gör</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">Tanımlanmış özel fiyat bulunamadı.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
