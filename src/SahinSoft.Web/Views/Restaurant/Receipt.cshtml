@model SahinSoft.Web.Models.RestaurantReceiptDetailViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Adisyon — @Model.DocumentNumber</title>
    <style>
        body { font-family: "Courier New", monospace; max-width: 380px; margin: 0 auto; padding: 20px; color: #1c2430; }
        .tr-center { text-align: center; }
        .tr-brand { font-weight: 800; font-size: 1.3rem; letter-spacing: 0.5px; color: #b8860b; }
        .tr-sub { font-size: 0.78rem; color: #6c7a89; }
        hr { border: none; border-top: 1px dashed #999; margin: 8px 0; }
        .tr-kv { display: flex; justify-content: space-between; font-size: 0.85rem; padding: 2px 0; }
        .tr-items { width: 100%; border-collapse: collapse; font-size: 0.82rem; margin-top: 4px; }
        .tr-items th { text-align: left; font-weight: 700; font-size: 0.75rem; padding-bottom: 4px; }
        .tr-items th:last-child, .tr-items td:last-child { text-align: right; }
        .tr-items td { padding: 2px 0; }
        .tr-total-row { display: flex; justify-content: space-between; font-size: 0.85rem; padding: 2px 0; }
        .tr-total-row.grand { font-weight: 800; font-size: 1rem; }
        .tr-footer { font-size: 0.78rem; }
        .no-print { margin-top: 16px; text-align: center; }
        .no-print button { padding: 10px 20px; border: 0; border-radius: 8px; background: #1c2430; color: #fff; font-weight: 700; cursor: pointer; }
        @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="tr-center tr-brand">ŞAHİNSOFT</div>
    <div class="tr-center tr-sub">@Model.BranchName</div>
    @if (!string.IsNullOrWhiteSpace(Model.BranchAddress))
    {
        <div class="tr-center tr-sub">@Model.BranchAddress</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.BranchPhone))
    {
        <div class="tr-center tr-sub">Tel: @Model.BranchPhone</div>
    }
    <hr />
    <div class="tr-center" style="font-weight:800;">ADİSYON</div>
    @if (Model.IsCancelled)
    {
        <div class="tr-center" style="color:#c0392b; font-weight:700;">İPTAL EDİLMİŞ FİŞ</div>
    }
    <hr />
    <div class="tr-kv"><span>Tarih</span><span>@Model.IssuedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span></div>
    <div class="tr-kv"><span>Fiş No</span><span>@Model.DocumentNumber</span></div>
    <div class="tr-kv"><span>@Model.SourceType</span><span>@Model.SourceLabel</span></div>
    @if (!string.IsNullOrWhiteSpace(Model.CashierName))
    {
        <div class="tr-kv"><span>Kasiyer</span><span>@Model.CashierName</span></div>
    }
    <hr />
    <table class="tr-items">
        <thead>
            <tr><th>Adet</th><th>Ürün</th><th>Tutar</th></tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.Quantity.ToString("0.##")</td>
                    <td>@line.ProductName</td>
                    <td>@line.LineTotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
    <hr />
    <div class="tr-total-row"><span>ARA TOPLAM</span><span>@Model.SubtotalAmount.ToString("N2") ₺</span></div>
    <div class="tr-total-row"><span>İNDİRİM</span><span>@Model.DiscountAmount.ToString("N2") ₺</span></div>
    <div class="tr-total-row grand"><span>GENEL TOPLAM</span><span>@Model.GrandTotal.ToString("N2") ₺</span></div>
    <hr />
    <div class="tr-center tr-footer">Teşekkür Ederiz</div>
    <div class="tr-center tr-footer">Yine Bekleriz...</div>
    <hr />
    <div class="tr-center tr-brand" style="font-size:1rem;">ŞAHİNSOFT</div>
    <div class="tr-center tr-sub">Restoran Çözümleri</div>

    <div class="no-print">
        <button type="button" onclick="window.print()">Yazdır</button>
    </div>
    <script>
        window.addEventListener('load', function () { window.print(); });
    </script>
</body>
</html>
