@model SahinSoft.Web.Models.CustomerStatementViewModel
@{
    ViewData["Title"] = "Cari Hareket Föyü";
}


<style media="print">
    @@page { size: A4 @(Model.Detailed ? "landscape" : "portrait"); margin: 8mm; }
    html, body { width: auto !important; background: #fff !important; }
    .erp-list-panel { box-shadow: none !important; border: 0 !important; border-radius: 0 !important; margin: 0 !important; }
    .erp-list-header { display: none !important; }
    .erp-list-body { padding: 0 !important; }
    .erp-table-wrap { overflow: visible !important; max-height: none !important; box-shadow: none !important; border: 0 !important; }
    #statementTable { width: 100% !important; min-width: 0 !important; table-layout: auto; }
    #statementTable th, #statementTable td { padding: 2px 3px !important; vertical-align: top; }
    #statementTable td:nth-child(1), #statementTable td:nth-child(3) { white-space: nowrap; }
    #statementTable td.text-end, #statementTable th.text-end { white-space: nowrap; }
    #statementTable thead { display: table-header-group; }
    #statementTable tr { page-break-inside: avoid; }
    .erp-statement-detail { font-size: 7pt !important; }
    .erp-statement-detail td.text-end { white-space: normal !important; }
    .erp-code-badge { font-size: 7pt !important; padding: 1px 3px !important; }
    @(Model.Lines.Any(x => x.RestaurantZNo != null) ? "" : "#statementTable th:nth-child(5), #statementTable td:nth-child(5) { display: none !important; }")
    #statementTable { font-size: 7.5pt; }
    .erp-statement-detail td { padding: 1px 4px !important; white-space: normal; }
    .erp-summary-row { margin-bottom: 6px !important; }
    .erp-summary-box { padding: 4px 8px !important; }
    .erp-summary-value { font-size: 11pt !important; }
    .card { box-shadow: none !important; }
    *::-webkit-scrollbar { display: none !important; }
</style>

<div class="print-only mb-3">
    <h2 class="mb-1">Cari Hareket Föyü</h2>
    <div>@Model.CustomerCode &middot; @Model.CustomerName</div>
    @if (Model.From.HasValue || Model.To.HasValue)
    {
        <div>@(Model.From?.ToString("dd.MM.yyyy") ?? "Baştan") - @(Model.To?.ToString("dd.MM.yyyy") ?? "Sona")</div>
    }
</div>

<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-file-invoice-dollar"></i> Cari Hareket Föyü</h2>
        <div class="d-flex gap-2 no-print">
            <a asp-action="Index" class="btn-erp-list-new">Cari Listesi</a>
            <button type="button" class="btn-erp-list-new" onclick="window.print()">Yazdır</button>
        </div>
    </div>
    <div class="erp-list-body">
        <span class="text-secondary d-block mb-3">@Model.CustomerCode &middot; @Model.CustomerName</span>

        <form method="get" class="erp-filter-bar no-print">
            <input type="hidden" name="id" value="@Model.CustomerId" />
            <div class="erp-field">
                <label>İlk Tarih</label>
                <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="erp-field">
                <label>Son Tarih</label>
                <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="erp-field">
                <label>Ekstre Türü</label>
                <select name="detail" class="form-select">
                    <option value="false" selected="@(!Model.Detailed)">Detaysız (özet)</option>
                    <option value="true" selected="@Model.Detailed">Detaylı (satırlarıyla)</option>
                </select>
            </div>
            <button class="btn btn-erp-primary">Filtrele</button>
        </form>

        <div class="erp-summary-row">
            <div class="erp-summary-box">
                <div class="erp-summary-label">Devir</div>
                <div class="erp-summary-value">@Model.OpeningBalance.ToString("N2")</div>
            </div>
            <div class="erp-summary-box">
                <div class="erp-summary-label">Borç</div>
                <div class="erp-summary-value">@Model.Lines.Sum(x => x.Debit).ToString("N2")</div>
            </div>
            <div class="erp-summary-box">
                <div class="erp-summary-label">Alacak</div>
                <div class="erp-summary-value">@Model.Lines.Sum(x => x.Credit).ToString("N2")</div>
            </div>
            <div class="erp-summary-box" style="border-color: var(--erp-gold);">
                <div class="erp-summary-label">Bakiye</div>
                <div class="erp-summary-value" style="color: @(Model.ClosingBalance > 0 ? "#1f8a4c" : Model.ClosingBalance < 0 ? "#c62828" : "inherit");">
                    @Model.ClosingBalance.ToString("N2")
                </div>
                <div class="text-secondary" style="font-size: 0.68rem;">@(Model.ClosingBalance > 0 ? "CARİ BORÇLU" : Model.ClosingBalance < 0 ? "CARİ ALACAKLI" : "BAKİYE YOK")</div>
                <div style="font-size: 0.78rem; font-weight: 700; color: @(Model.ClosingBalance > 0 ? "#1f8a4c" : Model.ClosingBalance < 0 ? "#c62828" : "inherit");">Kalan bakiye: @Math.Abs(Model.ClosingBalance).ToString("N2") ₺ @(Model.ClosingBalance > 0 ? "(size borçlu)" : Model.ClosingBalance < 0 ? "(sizin borcunuz)" : "")</div>
            </div>
        </div>

        <div class="erp-list-search mb-2 no-print" style="max-width: 320px;">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" class="form-control" autocomplete="off" placeholder="İşlem, belge no veya açıklama ara..." data-live-search="#statementTable">
        </div>

        <div class="erp-table-wrap">
            <table class="erp-table" id="statementTable" data-sortable>
                <thead>
                    <tr>
                        <th data-sort="date">Tarih</th>
                        <th data-sort="text">İşlem</th>
                        <th data-sort="text">Belge No</th>
                        <th data-sort="text">Şube</th>
                        <th data-sort="text">Z No</th>
                        @if (Model.Detailed)
                        {
                            <th>Stok İsmi / Ödeme</th>
                        }
                        <th data-sort="text">Açıklama</th>
                        <th class="text-end" data-sort="number">Borç</th>
                        <th class="text-end" data-sort="number">Alacak</th>
                        <th class="text-end">Bakiye</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.OpeningBalance != 0)
                {
                    <tr style="background: var(--erp-header-bg); font-weight: 700;" data-live-search-empty>
                        <td colspan="@(Model.Detailed ? 9 : 8)">Devreden Bakiye</td>
                        <td class="text-end">@Model.OpeningBalance.ToString("N2")</td>
                    </tr>
                }
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.TransactionDateUtc.ToString("dd.MM.yyyy")</td>
                        <td>@line.TransactionType</td>
                        <td><span class="erp-code-badge">@line.DocumentNumber</span></td>
                        <td>@line.BranchName</td>
                        <td>
                            @if (line.RestaurantZNo is not null)
                            {
                                <a asp-controller="RestaurantReports" asp-action="Index" asp-route-tab="zlist" asp-route-zShiftId="@line.RestaurantZPeriodId" asp-route-selected="@line.RestaurantRetailSaleId" class="erp-code-badge" style="text-decoration:none;" title="Z Detay ve fişe git">@line.RestaurantZNo</a>
                            }
                        </td>
                        @if (Model.Detailed)
                        {
                            <td>
                                @if (line.Details.Count > 0)
                                {
                                    <table class="erp-statement-detail" style="width:100%;font-size:.78rem;color:#475569;margin-top:4px;border-top:1px dashed #cbd5e1;">
                                    @foreach (var d in line.Details)
                                    {
                                        <tr>
                                            <td>@d.Name</td>
                                            <td class="text-end">@d.Quantity</td>
                                            <td class="text-end">@d.UnitPrice</td>
                                            <td class="text-end">@d.Total</td>
                                        </tr>
                                    }
                                </table>
                                }
                            </td>
                        }
                        <td>@line.Description</td>
                        <td class="text-end">@(line.Debit > 0 ? line.Debit.ToString("N2") : "")</td>
                        <td class="text-end">@(line.Credit > 0 ? line.Credit.ToString("N2") : "")</td>
                        <td class="text-end fw-semibold" style="color: @(line.RunningBalance > 0 ? "#1f8a4c" : line.RunningBalance < 0 ? "#c62828" : "inherit");">@line.RunningBalance.ToString("N2")</td>
                    </tr>
                }
                @if (Model.Lines.Count == 0)
                {
                    <tr data-live-search-empty>
                        <td colspan="@(Model.Detailed ? 10 : 9)" class="text-center text-secondary py-4">Bu tarih aralığında hareket bulunmuyor.</td>
                    </tr>
                }
                </tbody>
                @if (Model.Lines.Count > 0)
                {
                    <tfoot>
                        <tr>
                            <td colspan="@(Model.Detailed ? 7 : 6)" class="text-end">Toplam</td>
                            <td class="text-end" data-sum-col="@(Model.Detailed ? 7 : 6)"></td>
                            <td class="text-end" data-sum-col="@(Model.Detailed ? 8 : 7)"></td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

@{
    var branchOpen = ViewBag.BranchOpenBalances as List<(string Name, decimal Open)>;
}
@if (branchOpen is { Count: > 0 })
{
    <div class="card mt-3">
        <div class="card-header">Şube bazlı açık bakiye (FIFO)</div>
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead><tr><th>Kaynak Şube</th><th class="text-end">Açık Tutar</th></tr></thead>
                <tbody>
                @foreach (var b in branchOpen)
                {
                    <tr>
                        <td>@b.Name</td>
                        <td class="text-end">@b.Open.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
