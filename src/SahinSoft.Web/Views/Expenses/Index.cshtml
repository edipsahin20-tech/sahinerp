@model IReadOnlyList<SahinSoft.Domain.Entities.Expense>
@{
    ViewData["Title"] = "Masraflar";
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}

<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-receipt"></i> Masraflar</h2>
        <a asp-action="Create" class="btn-erp-list-new">+ Yeni Masraf</a>
    </div>
    <div class="erp-list-body">
        <div class="erp-list-topbar">
            <div class="erp-list-topbar-left">
                <div class="erp-list-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" class="form-control" autocomplete="off" placeholder="Belge no veya açıklama ara..." data-live-search="#expensesTable">
                </div>
                <form method="get" class="erp-list-filter">
                    <select name="categoryId" class="form-select" asp-items="(IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Categories" onchange="this.form.submit()">
                        <option value="">Tüm kategoriler</option>
                    </select>
                </form>
            </div>
            <span class="text-secondary">Toplam <strong>@Model.Count</strong> kayıt.</span>
        </div>

        <div class="erp-table-wrap">
            <table class="erp-table" id="expensesTable">
                <thead>
                    <tr>
                        <th>Belge No</th>
                        <th>Tarih</th>
                        <th>Kategori</th>
                        <th>Açıklama</th>
                        <th class="text-end">Tutar</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="erp-code-badge">@item.DocumentNumber</span></td>
                        <td>@item.ExpenseDateUtc.ToString("dd.MM.yyyy")</td>
                        <td>@item.ExpenseCategory.Name</td>
                        <td>@item.Description</td>
                        <td class="text-end fw-semibold">@item.TotalAmount.ToString("N2") @item.CurrencyCode</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-erp-list-action">Düzenle</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
