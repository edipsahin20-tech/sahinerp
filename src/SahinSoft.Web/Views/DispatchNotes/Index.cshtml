@using SahinSoft.Domain.Enums
@model IReadOnlyList<SahinSoft.Domain.Entities.DispatchNote>
@{
    ViewData["Title"] = "İrsaliyeler";
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>İrsaliyeler</h1>
        <span class="erp-toolbar-meta">@Model.Count kayıt</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-action="Create" asp-route-type="@InvoiceType.Purchase" class="btn btn-erp-outline btn-sm">+ Alış İrsaliyesi</a>
        <a asp-action="Create" asp-route-type="@InvoiceType.Sales" class="btn btn-erp-primary btn-sm">+ Satış İrsaliyesi</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<form method="get" class="erp-filter-bar">
    <div class="erp-field">
        <label>Tür</label>
        <select name="type" class="form-select" style="max-width: 160px;" asp-items="Html.GetEnumSelectList<InvoiceType>()">
            <option value="">Tüm türler</option>
        </select>
    </div>
    <div class="erp-field">
        <label>Durum</label>
        <select name="status" class="form-select" style="max-width: 170px;" asp-items="Html.GetEnumSelectList<BusinessDocumentStatus>()">
            <option value="">Tüm durumlar</option>
        </select>
    </div>
    <div class="erp-field flex-grow-1">
        <label>Ara</label>
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="İrsaliye no veya cari ara..." />
    </div>
    <button class="btn btn-erp-primary">Ara</button>
</form>

<div class="erp-panel">
    <div class="erp-panel-body p-0">
    <div class="erp-table-wrap">
        <table class="erp-table">
            <thead>
                <tr>
                    <th>İrsaliye No</th>
                    <th>Tür</th>
                    <th>Tarih</th>
                    <th>Cari</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.DispatchNumber</td>
                    <td>@(item.DispatchType == InvoiceType.Sales ? "Satış" : "Alış")</td>
                    <td>@item.DispatchDateUtc.ToString("dd.MM.yyyy")</td>
                    <td>@item.Customer.Name</td>
                    <td>
                        @{
                            var badgeClass = item.Status switch
                            {
                                BusinessDocumentStatus.Draft => "text-bg-secondary-subtle text-secondary-emphasis",
                                BusinessDocumentStatus.Approved or BusinessDocumentStatus.Fulfilled => "text-bg-success-subtle text-success-emphasis",
                                BusinessDocumentStatus.PartiallyFulfilled => "text-bg-warning-subtle text-warning-emphasis",
                                _ => "text-bg-danger-subtle text-danger-emphasis"
                            };
                            var statusText = item.Status switch
                            {
                                BusinessDocumentStatus.Draft => "Taslak",
                                BusinessDocumentStatus.Approved => "Onaylı",
                                BusinessDocumentStatus.PartiallyFulfilled => "Kısmi",
                                BusinessDocumentStatus.Fulfilled => "Tamamlandı",
                                _ => "İptal"
                            };
                        }
                        <span class="badge @badgeClass">@statusText</span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.78rem;">Görüntüle</a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
            }
            </tbody>
        </table>
    </div>
    </div>
</div>
