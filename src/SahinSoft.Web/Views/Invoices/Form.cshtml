@using SahinSoft.Domain.Enums
@model SahinSoft.Web.Models.InvoiceFormViewModel
@{
    var isEdit = Model.Id > 0;
    var isSales = Model.InvoiceType == InvoiceType.Sales;
    ViewData["Title"] = (isEdit ? "Düzenle: " : "Yeni ") + (isSales ? "Satış Faturası" : "Alış Faturası");
}

<form id="evrak-form" method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <input asp-for="Id" type="hidden" />
    <input asp-for="InvoiceType" type="hidden" />

    <div class="erp-toolbar">
        <div class="erp-toolbar-title">
            <h1>@(isSales ? "Satış Faturası" : "Alış Faturası")</h1>
            <span class="erp-toolbar-meta">@(isEdit ? "Taslak düzenleniyor" : "Yeni evrak")</span>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="erp-panel">
        <div class="erp-panel-header">Evrak Bilgileri</div>
        <div class="erp-panel-body">
            <div class="erp-field-grid">
                <div class="erp-field">
                    <label asp-for="CustomerId"></label>
                    <partial name="_LookupField" model="@(new LookupFieldViewModel {
                        Name = nameof(Model.CustomerId), Id = nameof(Model.CustomerId),
                        Value = Model.CustomerId?.ToString(),
                        DisplayValue = Model.CustomerDisplay,
                        Endpoint = Url.Action("Customers", "Lookup", new { type = isSales ? "Customer" : "Supplier" })!,
                        Title = "Cari Seç", Placeholder = "Cari seçin" })" />
                    <span asp-validation-for="CustomerId" class="text-danger small"></span>
                </div>
                <div class="erp-field">
                    <label asp-for="WarehouseId"></label>
                    <partial name="_LookupField" model="@(new LookupFieldViewModel {
                        Name = nameof(Model.WarehouseId), Id = nameof(Model.WarehouseId),
                        Value = Model.WarehouseId?.ToString(),
                        DisplayValue = Model.WarehouseDisplay,
                        Endpoint = Url.Action("Warehouses", "Lookup")!,
                        Title = "Depo Seç", Placeholder = "Depo seçin" })" />
                    <span asp-validation-for="WarehouseId" class="text-danger small"></span>
                </div>
                <div class="erp-field">
                    <label asp-for="InvoiceDateUtc"></label>
                    <input asp-for="InvoiceDateUtc" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="DueDateUtc"></label>
                    <input asp-for="DueDateUtc" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="CurrencyCode"></label>
                    <input asp-for="CurrencyCode" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="ExchangeRate"></label>
                    <input asp-for="ExchangeRate" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="ReferenceNumber"></label>
                    <input asp-for="ReferenceNumber" class="form-control" placeholder="Örn: 2341" />
                </div>
                <div class="erp-field">
                    <label asp-for="PaymentTerm"></label>
                    <input asp-for="PaymentTerm" class="form-control" list="payment-term-options" placeholder="Örn: PEŞİN" />
                    <datalist id="payment-term-options">
                        <option value="PEŞİN"></option>
                        <option value="Havale/EFT"></option>
                        <option value="Kredi Kartı"></option>
                        <option value="Çek"></option>
                        <option value="Senet"></option>
                        <option value="30 Gün Vadeli"></option>
                        <option value="60 Gün Vadeli"></option>
                    </datalist>
                </div>
                <div class="erp-field">
                    <label asp-for="TradeType"></label>
                    <input asp-for="TradeType" class="form-control" list="trade-type-options" placeholder="Örn: Toptan yurtiçi ticaret" />
                    <datalist id="trade-type-options">
                        <option value="Toptan yurtiçi ticaret"></option>
                        <option value="Perakende yurtiçi ticaret"></option>
                        <option value="İhracat"></option>
                        <option value="İthalat"></option>
                    </datalist>
                </div>
                <div class="erp-field">
                    <label asp-for="SettlementFinancialAccountId"></label>
                    <partial name="_LookupField" model="@(new LookupFieldViewModel {
                        Name = nameof(Model.SettlementFinancialAccountId), Id = nameof(Model.SettlementFinancialAccountId),
                        Value = Model.SettlementFinancialAccountId?.ToString(),
                        DisplayValue = Model.SettlementFinancialAccountDisplay,
                        Endpoint = Url.Action("FinancialAccounts", "Lookup")!,
                        Title = "Kapayan Hesap Seç", Placeholder = "Kasa/Banka seçin (opsiyonel)" })" />
                </div>
                <div class="erp-field">
                    <label asp-for="SalespersonUserId"></label>
                    <select asp-for="SalespersonUserId" asp-items="Model.Salespeople" class="form-select">
                        <option value="">Plasiyer seçilmedi</option>
                    </select>
                </div>
                <div class="erp-field d-flex align-items-center" style="padding-top: 1.7rem;">
                    <div class="form-check form-switch">
                        <input asp-for="IsReturn" class="form-check-input" />
                        <label asp-for="IsReturn" class="form-check-label"></label>
                    </div>
                </div>
                <div class="erp-field" style="grid-column: 1 / -1;">
                    <label asp-for="Notes"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="erp-panel">
        <div class="erp-panel-header d-flex justify-content-between align-items-center">
            <span>Satırlar</span>
            <button type="button" id="add-line" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.75rem;">+ Satır Ekle</button>
        </div>
        <div class="erp-panel-body p-0">
            <div class="erp-table-wrap">
                <table class="erp-table" id="lines-table">
                    <thead>
                        <tr>
                            <th style="min-width: 220px;">Ürün</th>
                            <th style="width: 100px;">Miktar</th>
                            <th style="width: 110px;">Birim Fiyat</th>
                            <th style="width: 90px;">İsk. %</th>
                            <th style="width: 90px;">KDV %</th>
                            <th>Açıklama</th>
                            <th style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="lines-body">
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr class="line-row">
                            <input type="hidden" name="Lines.Index" value="@i" />
                            <td>
                                <partial name="_LookupField" model="@(new LookupFieldViewModel {
                                    Name = $"Lines[{i}].ProductId", Id = $"Lines_{i}__ProductId",
                                    Value = Model.Lines[i].ProductId?.ToString(),
                                    DisplayValue = Model.Lines[i].ProductDisplay,
                                    Endpoint = Url.Action("Products", "Lookup")!,
                                    Title = "Ürün Seç", Placeholder = "Ürün adı/kod/barkod",
                                    AllowQuickSearch = true })" />
                            </td>
                            <td><input type="text" name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity" class="form-control quantity-input" /></td>
                            <td><input type="text" name="Lines[@i].UnitPrice" value="@Model.Lines[i].UnitPrice" class="form-control price-input" /></td>
                            <td><input type="text" name="Lines[@i].DiscountRate" value="@Model.Lines[i].DiscountRate" class="form-control discount-input" /></td>
                            <td><input type="text" name="Lines[@i].TaxRate" value="@Model.Lines[i].TaxRate" class="form-control tax-input" /></td>
                            <td><input type="text" name="Lines[@i].Description" value="@Model.Lines[i].Description" class="form-control" /></td>
                            <td><button type="button" class="btn btn-erp-danger remove-line" style="padding: 0.15rem 0.5rem; font-size: 0.75rem;">Sil</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="erp-panel-body pt-0">
            <div class="d-flex justify-content-end">
                <div class="erp-totals">
                    <div class="erp-totals-row"><span>Ara toplam</span><span id="totals-subtotal">0.00</span></div>
                    <div class="erp-totals-row"><span>İskonto</span><span id="totals-discount">0.00</span></div>
                    <div id="totals-kdv-breakdown"></div>
                    <div class="erp-totals-row erp-grand-total"><span>Genel Toplam</span><span class="erp-total-value" id="totals-grand">0.00</span></div>
                </div>
            </div>
        </div>
    </div>
</form>

<partial name="_EvrakToolbar" model="(SahinSoft.Web.Models.EvrakToolbarViewModel?)ViewBag.Toolbar" />

<template id="line-row-template">
    <tr class="line-row">
        <input type="hidden" name="Lines.Index" value="__index__" />
        <td>
            <div class="input-group">
                <input type="hidden" name="Lines[__index__].ProductId" id="Lines___index____ProductId" value="" />
                <input type="text" id="Lines___index____ProductId_display" class="form-control lookup-quicksearch"
                       placeholder="Ürün adı/kod/barkod" autocomplete="off"
                       data-lookup-endpoint="@Url.Action("Products", "Lookup")"
                       data-lookup-title="Ürün Seç"
                       data-target-hidden="Lines___index____ProductId"
                       data-target-display="Lines___index____ProductId_display" />
                <button type="button" class="btn btn-outline-secondary lookup-trigger"
                        data-lookup-endpoint="@Url.Action("Products", "Lookup")"
                        data-lookup-title="Ürün Seç"
                        data-target-hidden="Lines___index____ProductId"
                        data-target-display="Lines___index____ProductId_display">
                    ...
                </button>
            </div>
        </td>
        <td><input type="text" name="Lines[__index__].Quantity" value="1" class="form-control quantity-input" /></td>
        <td><input type="text" name="Lines[__index__].UnitPrice" value="0" class="form-control price-input" /></td>
        <td><input type="text" name="Lines[__index__].DiscountRate" value="0" class="form-control discount-input" /></td>
        <td><input type="text" name="Lines[__index__].TaxRate" value="0" class="form-control tax-input" /></td>
        <td><input type="text" name="Lines[__index__].Description" value="" class="form-control" /></td>
        <td><button type="button" class="btn btn-erp-danger remove-line" style="padding: 0.15rem 0.5rem; font-size: 0.75rem;">Sil</button></td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var linesBody = document.getElementById('lines-body');
            var template = document.getElementById('line-row-template');
            var addButton = document.getElementById('add-line');
            var nextIndex = @Model.Lines.Count;
            var isSales = @Json.Serialize(isSales);

            addButton.addEventListener('click', function () {
                var html = template.innerHTML.split('__index__').join(nextIndex);
                var wrapper = document.createElement('tbody');
                wrapper.innerHTML = html;
                linesBody.appendChild(wrapper.firstElementChild);
                nextIndex++;
            });

            linesBody.addEventListener('click', function (event) {
                if (event.target.classList.contains('remove-line')) {
                    var row = event.target.closest('tr');
                    if (linesBody.querySelectorAll('.line-row').length > 1) {
                        row.remove();
                    }
                }
            });

            linesBody.addEventListener('lookup:selected', function (event) {
                var row = event.target.closest('tr');
                if (!row) {
                    return;
                }
                var item = event.detail.item;
                row.querySelector('.price-input').value = isSales ? item.unitPrice : item.purchaseUnitPrice;
                row.querySelector('.tax-input').value = item.taxRate;
                recalcTotals();
            });

            function formatMoney(amount) {
                return Number(amount || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // Onaydan önce (taslak haldeyken) kullanıcı satırları girerken toplamları anında görsün diye;
            // sunucudaki (InvoicesController.CalculateDraftTotals / InvoicePostingService.ApproveAsync) ile
            // aynı formül burada da uygulanır.
            function recalcTotals() {
                var subtotal = 0, discountTotal = 0, grandTotal = 0;
                var kdvByRate = {};

                linesBody.querySelectorAll('.line-row').forEach(function (row) {
                    var qty = parseFloat(row.querySelector('.quantity-input').value) || 0;
                    var price = parseFloat(row.querySelector('.price-input').value) || 0;
                    var discRate = parseFloat(row.querySelector('.discount-input').value) || 0;
                    var taxRate = parseFloat(row.querySelector('.tax-input').value) || 0;

                    var gross = qty * price;
                    var discAmount = gross * discRate / 100;
                    var net = gross - discAmount;
                    var taxAmount = net * taxRate / 100;

                    subtotal += gross;
                    discountTotal += discAmount;
                    grandTotal += net + taxAmount;
                    kdvByRate[taxRate] = (kdvByRate[taxRate] || 0) + taxAmount;
                });

                document.getElementById('totals-subtotal').textContent = formatMoney(subtotal);
                document.getElementById('totals-discount').textContent = formatMoney(discountTotal);
                document.getElementById('totals-grand').textContent = formatMoney(grandTotal);
                document.getElementById('totals-kdv-breakdown').innerHTML = Object.keys(kdvByRate).sort(function (a, b) { return a - b; }).map(function (rate) {
                    return '<div class="erp-totals-row"><span>KDV %' + rate + '</span><span>' + formatMoney(kdvByRate[rate]) + '</span></div>';
                }).join('');
            }

            linesBody.addEventListener('input', recalcTotals);
            addButton.addEventListener('click', recalcTotals);
            linesBody.addEventListener('click', function (event) {
                if (event.target.classList.contains('remove-line')) {
                    recalcTotals();
                }
            });
            recalcTotals();
        })();
    </script>
}
