@model SahinSoft.Web.Models.RestaurantDataHealthViewModel
@{
    Layout = "_RestaurantShellLayout";
    ViewData["Title"] = "Veri Sağlığı ve Mutabakat Merkezi";
    var dateText = Model.FilterDate.ToString("yyyy-MM-dd");

    static string StatusChip(string status) => status switch
    {
        "YESIL" => "background:#DFF5E7;color:#1f7a4d;",
        "SARI" => "background:#FFF3D6;color:#8a6d1a;",
        _ => "background:#FBE1E1;color:#8a2a2a;"
    };

    static string StatusText(string status) => status switch
    {
        "YESIL" => "Eşleşti",
        "SARI" => "Bekliyor",
        _ => "Hatalı"
    };

    static string PartChip(string value) => value switch
    {
        "Tam" => "background:#DFF5E7;color:#1f7a4d;",
        "Bekliyor" => "background:#FFF3D6;color:#8a6d1a;",
        "Kapalı" or "Gerekmiyor" => "background:#EEF1F5;color:#5b6675;",
        _ => "background:#FBE1E1;color:#8a2a2a;"
    };

    static string ActionLabel(string action) => action switch
    {
        "Added" => "Eklendi",
        "Modified" => "Güncellendi",
        "Deleted" => "Silindi",
        _ => action
    };

    static string ActionChip(string action) => action switch
    {
        "Added" => "background:#DFF5E7;color:#1f7a4d;",
        "Modified" => "background:#E8F0FB;color:#2456a8;",
        "Deleted" => "background:#FBE1E1;color:#8a2a2a;",
        _ => "background:#EEF1F5;color:#5b6675;"
    };
}

<div class="dh-page">
    <div class="dh-head">
        <div>
            <h2 class="dh-title">Veri Sağlığı ve Mutabakat Merkezi</h2>
            <p class="dh-sub">Yerel, merkez ve muhasebe kayıtlarını karşılaştırın.</p>
        </div>
        <div class="dh-actions">
            <form method="get" asp-action="Index" class="dh-filter">
                <input type="hidden" name="tab" value="@Model.ActiveTab" />
                <input type="date" name="date" value="@dateText" class="form-control" />
                @if (Model.Branches.Count > 1)
                {
                    <select name="branchId" class="form-select dh-branch-select" onchange="this.form.submit()">
                        <option value="">Tüm şubeler</option>
                        @foreach (var b in Model.Branches)
                        {
                            <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                        }
                    </select>
                }
                <button type="submit" class="dh-btn dh-btn-primary">
                    <i class="fa-solid fa-filter"></i> Filtrele
                </button>
            </form>
            <form method="post" asp-action="Recheck">
                @Html.AntiForgeryToken()
                <input type="hidden" name="date" value="@dateText" />
                <button type="submit" class="dh-btn dh-btn-outline"><i class="fa-solid fa-rotate"></i> Tekrar Kontrol Et</button>
            </form>
        </div>
    </div>

    @if (TempData["Success"] is string successMsg)
    {
        <div class="alert alert-success">@successMsg</div>
    }
    @if (TempData["Error"] is string errorMsg)
    {
        <div class="alert alert-danger">@errorMsg</div>
    }

    @if (!Model.MerkezSyncEnabled)
    {
        <div class="dh-banner">
            <i class="fa-solid fa-circle-info"></i>
            <b>Merkez senkronizasyonu kapalı.</b> Merkez kayıtları karşılaştırmaya dahil edilmez.
        </div>
    }

    @if (Model.ActiveTab == "z")
    {
        var zTotal = Model.ZSummary.Count;
        var zMatched = Model.ZSummary.Count(z => !z.IsMismatched);
        var zDiffCount = zTotal - zMatched;
        var zAmountDiff = Model.ZSummary.Sum(z => z.LocalTotal - z.AccountingTotal);
        <div class="dh-kpis dh-kpis-4">
            <div class="dh-kpi dh-kpi-big"><span class="dh-kpi-circle" style="background:#EAF1FB;color:#2563eb;"><i class="fa-solid fa-file-lines"></i></span><div><small>Toplam Z</small><strong>@zTotal</strong></div></div>
            <div class="dh-kpi dh-kpi-big"><span class="dh-kpi-circle" style="background:#E6F6EC;color:#16a34a;"><i class="fa-solid fa-check"></i></span><div><small>Eşleşen Z</small><strong style="color:#16a34a;">@zMatched</strong></div></div>
            <div class="dh-kpi dh-kpi-big"><span class="dh-kpi-circle" style="background:#FBE4E4;color:#dc2626;"><i class="fa-solid fa-exclamation"></i></span><div><small>Farklı Z</small><strong style="color:@(zDiffCount > 0 ? "#dc2626" : "#13233a");">@zDiffCount</strong></div></div>
            <div class="dh-kpi dh-kpi-big"><span class="dh-kpi-circle" style="background:#EAF1FB;color:#2563eb;"><i class="fa-solid fa-coins"></i></span><div><small>Tutar Farkı</small><strong>@zAmountDiff.ToString("N2") ₺</strong></div></div>
        </div>
    }
    else
    {
    <div class="dh-kpis">
        <div class="dh-kpi"><div class="dh-kpi-top"><i class="fa-solid fa-receipt" style="color:#2456a8;"></i><small>Toplam Fiş</small></div><strong>@Model.TotalCount</strong><span class="dh-kpi-orb" style="background:#EAF1FB;"></span></div>
        <div class="dh-kpi"><div class="dh-kpi-top"><i class="fa-solid fa-circle-check" style="color:#1f7a4d;"></i><small>Eşleşen</small></div><strong style="color:#1f7a4d;">@Model.MatchedCount</strong><span class="dh-kpi-orb" style="background:#E6F6EC;"></span></div>
        <div class="dh-kpi"><div class="dh-kpi-top"><i class="fa-solid fa-clock" style="color:#b7791f;"></i><small>Bekleyen</small></div><strong style="color:#b7791f;">@Model.PendingCount</strong><span class="dh-kpi-orb" style="background:#FFF3D6;"></span></div>
        <div class="dh-kpi"><div class="dh-kpi-top"><i class="fa-solid fa-circle-exclamation" style="color:#c53030;"></i><small>Hatalı</small></div><strong style="color:#c53030;">@Model.ErrorCount</strong><span class="dh-kpi-orb" style="background:#FBE4E4;"></span></div>
        <div class="dh-kpi">
            <div class="dh-kpi-top"><i class="fa-solid fa-link" style="color:#5b6675;"></i><small>Eksik Merkez</small></div>
            @if (Model.MerkezSyncEnabled)
            {
                <strong style="color:#c53030;">@Model.MissingCentralCount</strong>
            }
            else
            {
                @Html.Raw("<strong>—</strong><em>Senkron kapalı</em>")
            }
            <span class="dh-kpi-orb" style="background:#EEF1F5;"></span>
        </div>
        <div class="dh-kpi"><div class="dh-kpi-top"><i class="fa-solid fa-file-lines" style="color:#5b6675;"></i><small>Eksik Muhasebe</small></div><strong style="color:@(Model.MissingAccountingCount > 0 ? "#c53030" : "#13233a");">@Model.MissingAccountingCount</strong><span class="dh-kpi-orb" style="background:#FBE4E4;"></span></div>
    </div>
    }

    <div class="dh-card">
        <div class="dh-tabs">
            <a class="dh-tab @(Model.ActiveTab == "fis" ? "active" : "")" href="@Url.Action("Index", new { date = dateText, tab = "fis" })"><i class="fa-solid fa-file-lines"></i> Fiş Bazında Mutabakat</a>
            <a class="dh-tab @(Model.ActiveTab == "z" ? "active" : "")" href="@Url.Action("Index", new { date = dateText, tab = "z" })"><i class="fa-solid fa-chart-column"></i> Z Bazında Mutabakat</a>
            <a class="dh-tab @(Model.ActiveTab == "log" ? "active" : "")" href="@Url.Action("Index", new { date = dateText, tab = "log" })"><i class="fa-solid fa-screwdriver-wrench"></i> Onarım Logu</a>
            <form method="get" asp-action="Index" class="dh-search">
                <input type="hidden" name="date" value="@dateText" />
                <input type="hidden" name="tab" value="@Model.ActiveTab" />
                <input type="hidden" name="branchId" value="@Model.BranchId" />
                <input type="search" name="q" value="@Model.Search" placeholder="@(Model.ActiveTab == "z" ? "Z no ara" : "Fiş veya Z no ara")" class="form-control" />
            </form>
        </div>

        @if (Model.ActiveTab == "fis")
        {
            <div class="dh-table-wrap">
                <table class="dh-table">
                    <thead>
                        <tr>
                            @{
                                string SortUrl(string col) => Url.Action("Index", new { date = dateText, tab = "fis", q = Model.Search, branchId = Model.BranchId, sort = col, dir = Model.SortBy == col && Model.SortDir == "asc" ? "desc" : "asc" })!;
                                string Arrow(string col) => Model.SortBy == col ? (Model.SortDir == "asc" ? " ▲" : " ▼") : " ⇅";
                            }
                            <th><a class="dh-sort" href="@SortUrl("saat")">Saat@Arrow("saat")</a></th>
                            <th><a class="dh-sort" href="@SortUrl("adisyon")">Adisyon No@Arrow("adisyon")</a></th>
                            <th><a class="dh-sort" href="@SortUrl("sube")">Şube@Arrow("sube")</a></th>
                            <th><a class="dh-sort" href="@SortUrl("z")">Z No@Arrow("z")</a></th>
                            <th class="num"><a class="dh-sort" href="@SortUrl("tutar")">Tutar@Arrow("tutar")</a></th>
                            <th><a class="dh-sort" href="@SortUrl("yerel")">Yerel@Arrow("yerel")</a></th>
                            <th><a class="dh-sort" href="@SortUrl("merkez")">Merkez@Arrow("merkez")</a></th>
                            <th><a class="dh-sort" href="@SortUrl("muhasebe")">Muhasebe@Arrow("muhasebe")</a></th>
                            <th><a class="dh-sort" href="@SortUrl("durum")">Durum@Arrow("durum")</a></th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Count == 0)
                        {
                            <tr><td colspan="10" class="dh-empty">Bu tarihte fiş bulunamadı.</td></tr>
                        }
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>@row.IssuedAtUtc.ToLocalTime().ToString("HH:mm")</td>
                                <td><span class="dh-code">@row.CheckNumber</span></td>
                                <td><span class="dh-branch">@(row.BranchName ?? "—")</span></td>
                                <td>@(row.ZNo ?? "—")</td>
                                <td class="num">@row.GrandTotal.ToString("N2") ₺</td>
                                <td><span class="dh-chip" style="@PartChip(row.LocalStatus)">● @row.LocalStatus</span></td>
                                <td><span class="dh-chip" style="@PartChip(row.CentralStatus)">● @row.CentralStatus</span></td>
                                <td><span class="dh-chip" style="@PartChip(row.AccountingStatus)">● @row.AccountingStatus</span></td>
                                <td><span class="dh-chip" style="@StatusChip(row.OverallStatus)">● @StatusText(row.OverallStatus)</span></td>
                                <td class="text-end">
                                    <a class="dh-btn dh-btn-sm" href="@Url.Action("Inspect", new { id = row.RetailSaleId, date = dateText })"><i class="fa-solid fa-eye"></i> İncele</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="dh-foot dh-foot-split">
                <span>@Model.TotalRows fiş</span>
                <span>Toplam: <strong>@Model.TotalAmount.ToString("N2") ₺</strong></span>
                @if (Model.PageCount > 1)
                {
                    <span class="dh-pager">
                        @{
                            string PageUrl(int p) => Url.Action("Index", new { date = dateText, tab = "fis", q = Model.Search, branchId = Model.BranchId, sort = Model.SortBy, dir = Model.SortDir, page = p })!;
                        }
                        <a class="dh-pg @(Model.Page == 1 ? "disabled" : "")" href="@PageUrl(1)">«</a>
                        <a class="dh-pg @(Model.Page == 1 ? "disabled" : "")" href="@PageUrl(Math.Max(1, Model.Page - 1))">‹</a>
                        @for (var pg = Math.Max(1, Model.Page - 2); pg <= Math.Min(Model.PageCount, Model.Page + 2); pg++)
                        {
                            <a class="dh-pg @(pg == Model.Page ? "active" : "")" href="@PageUrl(pg)">@pg</a>
                        }
                        <a class="dh-pg @(Model.Page == Model.PageCount ? "disabled" : "")" href="@PageUrl(Math.Min(Model.PageCount, Model.Page + 1))">›</a>
                        <a class="dh-pg @(Model.Page == Model.PageCount ? "disabled" : "")" href="@PageUrl(Model.PageCount)">»</a>
                    </span>
                }
            </div>
        }
        else if (Model.ActiveTab == "z")
        {
            <div class="dh-table-wrap">
                <table class="dh-table">
                    <thead>
                        <tr>
                            <th>Z No</th><th>Şube</th><th>Tarih</th><th class="num">Fiş Sayısı</th><th class="num">Yerel Toplam</th>
                            <th>Merkez Toplam</th><th class="num">Muhasebe Toplam</th><th class="num">Fark</th><th>Durum</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ZSummary.Count == 0)
                        {
                            <tr><td colspan="10" class="dh-empty">Bu tarihte Z kaydı bulunamadı.</td></tr>
                        }
                        @foreach (var z in Model.ZSummary)
                        {
                            var diff = z.LocalTotal - z.AccountingTotal;
                            <tr class="@(Model.ZDetail?.ZPeriodId == z.ZPeriodId ? "dh-selected" : "")">
                                <td><a class="dh-link" href="@Url.Action("Index", new { date = dateText, tab = "z", zId = z.ZPeriodId })">@z.ZNo</a></td>
                                <td><span class="dh-branch">@(z.BranchName ?? "—")</span></td>
                                <td>@z.OpenedAtUtc.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td class="num">@z.BranchCount</td>
                                <td class="num">@z.LocalTotal.ToString("N2") ₺</td>
                                <td><span class="dh-chip" style="@PartChip(Model.MerkezSyncEnabled ? (z.CentralCount == z.BranchCount ? "Tam" : "Hatalı") : "Kapalı")">@(Model.MerkezSyncEnabled ? (z.CentralCount == z.BranchCount ? "Tam" : "Hatalı") : "Kapalı")</span></td>
                                <td class="num">@z.AccountingTotal.ToString("N2") ₺</td>
                                <td class="num">@diff.ToString("N2") ₺</td>
                                <td><span class="dh-chip" style="@StatusChip(z.IsMismatched ? "KIRMIZI" : "YESIL")">● @(z.IsMismatched ? "Farklı" : "Eşleşti")</span></td>
                                <td class="text-end">
                                    <a class="dh-btn dh-btn-sm" href="@Url.Action("Index", new { date = dateText, tab = "z", zId = z.ZPeriodId })">Z Detayı</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="dh-foot dh-foot-split">
                <span>@Model.ZSummary.Count Z raporu • @Model.ZSummary.Sum(z => z.BranchCount) fiş</span>
                <span>Toplam: <strong>@Model.ZSummary.Sum(z => z.LocalTotal).ToString("N2") ₺</strong></span>
            </div>

            @if (Model.ZDetail is { } zd)
            {
                var zDiff = zd.LocalTotal - zd.AccountingTotal;
                <div class="dh-zdetail">
                    <div class="dh-zdetail-head">
                        <div>
                            <h3>Z Detayı • @zd.ZNo</h3>
                            <p>@zd.OpenedAtUtc.ToLocalTime().ToString("dd.MM.yyyy")@(string.IsNullOrEmpty(zd.BranchName) ? "" : " • " + zd.BranchName)</p>
                        </div>
                        <a class="dh-btn dh-btn-outline" target="_blank" href="@Url.Action("Detail", "ZPeriods", new { id = zd.ZPeriodId })"><i class="fa-solid fa-file-lines"></i> Z Raporunu Gör</a>
                    </div>

                    <div class="dh-grid2">
                        <div class="dh-panel">
                            <h4>Kayıt Karşılaştırması</h4>
                            <table class="dh-table dh-table-compact">
                                <thead><tr><th>Kontrol</th><th>Yerel</th><th>Merkez</th><th>Muhasebe</th></tr></thead>
                                <tbody>
                                    <tr><td>Fiş Sayısı</td><td>@zd.LocalCount</td><td><span class="dh-chip" style="@PartChip(Model.MerkezSyncEnabled ? "Tam" : "Kapalı")">@(Model.MerkezSyncEnabled ? "Tam" : "Kapalı")</span></td><td>@zd.Rows.Count(x => x.AccountingStatus is "Tam" or "Gerekmiyor")</td></tr>
                                    <tr><td>Satış Toplamı</td><td>@zd.LocalTotal.ToString("N2") ₺</td><td><span class="dh-chip" style="@PartChip("Kapalı")">Kapalı</span></td><td>@zd.AccountingTotal.ToString("N2") ₺</td></tr>
                                    <tr><td>Kayıt Durumu</td><td><span class="dh-chip" style="@PartChip(zd.Rows.All(x => x.LocalStatus == "Tam") ? "Tam" : "Hatalı")">@(zd.Rows.All(x => x.LocalStatus == "Tam") ? "Tam" : "Eksik")</span></td><td><span class="dh-chip" style="@PartChip("Kapalı")">Kapalı</span></td><td><span class="dh-chip" style="@PartChip(zd.Rows.All(x => x.AccountingStatus is "Tam" or "Gerekmiyor") ? "Tam" : "Hatalı")">@(zd.Rows.All(x => x.AccountingStatus is "Tam" or "Gerekmiyor") ? "Tam" : "Eksik")</span></td></tr>
                                </tbody>
                            </table>
                            <p class="dh-note">
                                @if (zDiff == 0 && zd.Rows.All(x => x.LocalStatus == "Tam" && x.AccountingStatus is "Tam" or "Gerekmiyor"))
                                {
                                    <span class="dh-ok"><i class="fa-solid fa-circle-check"></i> Yerel ve muhasebe kayıtları eşleşiyor.</span>
                                }
                                else
                                {
                                    <span style="color:#8a2a2a;">Yerel ve muhasebe kayıtları arasında fark var.</span>
                                }
                            </p>
                        </div>

                        <div class="dh-panel">
                            <div class="dh-panel-head">
                                <h4>Mutabakat Sonucu</h4>
                                <span class="dh-chip" style="@StatusChip(zDiff == 0 ? "YESIL" : "KIRMIZI")">@(zDiff == 0 ? "Fark yok" : "Fark var")</span>
                            </div>
                            <div class="dh-kv"><span>Fiş farkı:</span><strong>@(zd.LocalCount - zd.Rows.Count(x => x.AccountingStatus is "Tam" or "Gerekmiyor"))</strong></div>
                            <div class="dh-kv"><span>Tutar farkı:</span><strong>@zDiff.ToString("N2") ₺</strong></div>
                            <p class="dh-note">Merkez karşılaştırması @(Model.MerkezSyncEnabled ? "açık." : "kapalı.")</p>
                        </div>
                    </div>

                    <div class="dh-panel">
                        <div class="dh-panel-head">
                            <h4>Bu Z'ye Bağlı Fişler</h4>
                            <a class="dh-btn dh-btn-outline dh-btn-sm" href="@Url.Action("Index", new { date = dateText, tab = "fis" })"><i class="fa-solid fa-list"></i> Fiş Bazında Gör</a>
                        </div>
                        <table class="dh-table dh-table-compact">
                            <thead><tr><th>Saat</th><th>Adisyon No</th><th class="num">Tutar</th><th>Yerel</th><th>Muhasebe</th><th></th></tr></thead>
                            <tbody>
                                @if (zd.Rows.Count == 0)
                                {
                                    <tr><td colspan="6" class="dh-empty">Bu Z'ye bağlı fiş yok.</td></tr>
                                }
                                @foreach (var row in zd.Rows)
                                {
                                    <tr>
                                        <td>@row.IssuedAtUtc.ToLocalTime().ToString("HH:mm")</td>
                                        <td><span class="dh-code">@row.CheckNumber</span></td>
                                        <td class="num">@row.GrandTotal.ToString("N2") ₺</td>
                                        <td><span class="dh-chip" style="@PartChip(row.LocalStatus)">@row.LocalStatus</span></td>
                                        <td><span class="dh-chip" style="@PartChip(row.AccountingStatus)">@row.AccountingStatus</span></td>
                                        <td class="text-end"><a class="dh-btn dh-btn-sm" href="@Url.Action("Inspect", new { id = row.RetailSaleId, date = dateText })"><i class="fa-solid fa-eye"></i> İncele</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="dh-table-wrap">
                <table class="dh-table">
                    <thead>
                        <tr><th>Tarih / Saat</th><th>Kullanıcı</th><th>İşlem</th><th>Kayıt</th><th>Değişiklik</th><th>Detay</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentRepairs.Count == 0)
                        {
                            <tr><td colspan="6" class="dh-empty">Henüz onarım/denetim kaydı yok.</td></tr>
                        }
                        @foreach (var log in Model.RecentRepairs)
                        {
                            <tr>
                                <td>@log.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@log.UserName</td>
                                <td><span class="dh-chip" style="@ActionChip(log.Action)">@ActionLabel(log.Action)</span></td>
                                <td>@(log.EntityName) #@log.EntityId</td>
                                <td>@(log.Action == "Added" ? "Yeni kayıt oluşturuldu" : log.Action == "Modified" ? "Kayıt güncellendi" : "Kayıt silindi")</td>
                                <td>
                                    @if (log.EntityName == "RetailSale" && int.TryParse(log.EntityId, out var logSaleId))
                                    {
                                        <a class="dh-link" href="@Url.Action("Inspect", new { id = logSaleId, date = dateText })">Detayı Gör</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <details class="dh-raw mt-3">
                <summary><strong>Teknik Kayıt Ayrıntıları</strong> <span class="text-secondary small">Eski / yeni değerler ve ham kayıt ayrıntıları</span></summary>
                <div class="dh-table-wrap mt-2">
                    <table class="dh-table dh-table-compact">
                        <thead><tr><th>Tarih / Saat</th><th>Kayıt</th><th>Eski değer</th><th>Yeni değer</th></tr></thead>
                        <tbody>
                            @foreach (var raw in Model.RecentRepairs.Where(x => x.OldValuesJson is not null || x.NewValuesJson is not null).Take(30))
                            {
                                <tr>
                                    <td>@raw.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@raw.EntityName #@raw.EntityId</td>
                                    <td><code class="small">@(raw.OldValuesJson ?? "—")</code></td>
                                    <td><code class="small">@(raw.NewValuesJson ?? "—")</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    </div>

    @if (Model.ActiveTab == "fis")
    {
        var localOk = Model.Rows.All(r => r.LocalStatus == "Tam");
        var acctOk = Model.Rows.All(r => r.AccountingStatus is "Tam" or "Gerekmiyor");
        <div class="dh-card dh-summary">
            <h3><i class="fa-solid fa-file-lines"></i> Kontrol Özeti</h3>
            <div class="dh-summary-grid">
                <div class="dh-sum-item"><span class="dh-sum-ico @(localOk ? "ok" : "bad")"><i class="fa-solid @(localOk ? "fa-check" : "fa-xmark")"></i></span><div><b>@(localOk ? "Yerel kayıtlar tamam" : "Yerel kayıtlarda eksik var")</b><small>@(localOk ? "Tüm fişler yerel sistemde mevcut." : "Bazı fişler yerel sistemde eksik.")</small></div></div>
