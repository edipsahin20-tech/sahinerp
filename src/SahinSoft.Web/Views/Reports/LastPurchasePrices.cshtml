@model SahinSoft.Web.Models.LastPurchasePricesReportViewModel
@{
    ViewData["Title"] = "Son Alış Fiyatları";
}

<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-tags"></i> Son Alış Fiyatları</h2>
        <span class="text-white-50" style="font-size: 0.8rem;">Onaylı alış faturalarından hesaplanır</span>
    </div>
    <div class="erp-list-body">
        <form method="get" class="erp-filter-bar">
            <div class="erp-field">
                <label>Ürün</label>
                <select name="productId" class="form-select" style="min-width: 260px;" asp-items="Model.Products" onchange="this.form.submit()">
                    <option value="">Tüm ürünler</option>
                </select>
            </div>
            <button class="btn btn-erp-primary">Filtrele</button>
        </form>

        <div class="erp-list-search mb-2" style="max-width: 320px;">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" class="form-control" autocomplete="off" placeholder="Ürün veya cari ara..." data-live-search="#lastPurchasePricesTable">
        </div>

        <div class="erp-table-wrap">
            <table class="erp-table" id="lastPurchasePricesTable" data-sortable>
                <thead>
                    <tr>
                        <th data-sort="text">Stok Kodu</th>
                        <th data-sort="text">Ürün</th>
                        <th data-sort="text">Cari (Tedarikçi)</th>
                        <th data-sort="date">Son Alış Tarihi</th>
                        <th class="text-end" data-sort="number">Birim Fiyat (KDV Dahil)</th>
                        <th class="text-end" data-sort="number">Miktar</th>
                        <th data-sort="text">Belge No</th>
                        <th class="text-end" data-sort="number">Alım Sayısı</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td><span class="erp-code-badge">@line.StockCode</span></td>
                        <td class="fw-semibold">@line.ProductName</td>
                        <td>@line.SupplierName</td>
                        <td>@line.LastPurchaseDateUtc.ToString("dd.MM.yyyy")</td>
                        <td class="text-end fw-semibold">@line.UnitPriceInclTax.ToString("N2") ₺</td>
                        <td class="text-end">@line.Quantity.ToString("N3")</td>
                        <td><span class="erp-code-badge">@line.InvoiceNumber</span></td>
                        <td class="text-end">@line.PurchaseCount</td>
                    </tr>
                }
                @if (Model.Lines.Count == 0)
                {
                    <tr data-live-search-empty><td colspan="8" class="text-center text-secondary py-4">Onaylı alış faturası bulunamadı.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
