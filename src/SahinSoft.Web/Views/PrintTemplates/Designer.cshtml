@model SahinSoft.Web.Models.PrintTemplateDesignerViewModel
@{
    ViewData["Title"] = "Çıktı Tasarımcısı — " + Model.Name;
    var isEdit = Model.Id > 0;
    var fieldsByCategory = Model.AvailableFields.GroupBy(f => f.Category).ToList();
}

<div class="pr-designer" data-template-id="@Model.Id" data-template-type="@((int)Model.TemplateType)">
    <div class="pr-toolbar">
        <div class="pr-toolbar-row">
            <div class="pr-field-inline">
                <label>Şablon Adı</label>
                <input type="text" id="templateName" class="form-control form-control-sm" value="@Model.Name" style="width:220px;" />
            </div>
            <div class="pr-field-inline">
                <label>Kağıt Genişliği</label>
                <select id="paperWidthSelect" class="form-select form-select-sm" style="width:110px;">
                    <option value="58" selected="@(Model.PaperWidthMm == 58)">58 mm</option>
                    <option value="80" selected="@(Model.PaperWidthMm == 80)">80 mm</option>
                </select>
            </div>
            <div class="pr-field-inline">
                <label>Şube (opsiyonel)</label>
                <select id="branchSelect" class="form-select form-select-sm" style="width:180px;">
                    <option value="">Tüm Şubeler</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                    }
                </select>
            </div>
            <div class="pr-toolbar-spacer"></div>
            <button type="button" id="saveBtn" class="btn btn-erp-primary btn-sm">Kaydet</button>
            @if (isEdit)
            {
                <button type="button" id="setDefaultBtn" class="btn btn-erp-outline btn-sm">Varsayılan Yap</button>
            }
            <div class="dropdown d-inline-block">
                <button class="btn btn-erp-outline btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">Test Çıktısı Al</button>
                <ul class="dropdown-menu dropdown-menu-end" id="testPrinterMenu">
                    <li><span class="dropdown-item-text text-secondary small">Yazıcılar yükleniyor...</span></li>
                </ul>
            </div>
        </div>
        <div id="saveStatus" class="small text-secondary mt-1"></div>
    </div>

    <div class="pr-body">
        <div class="pr-left">
            <div class="pr-tabs">
                <button type="button" class="pr-tab active" data-tab="fields">Alanlar</button>
                <button type="button" class="pr-tab" data-tab="layout">Düzen</button>
            </div>
            <div class="pr-tab-panel" data-panel="fields">
                @foreach (var group in fieldsByCategory)
                {
                    <div class="pr-field-group">
                        <div class="pr-field-group-title">@group.Key</div>
                        @foreach (var f in group)
                        {
                            <div class="pr-palette-item" draggable="true"
                                 data-element-type="@f.ElementType" data-binding-key="@f.Key" data-label="@f.Label">
                                @f.Label
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="pr-tab-panel" data-panel="layout" style="display:none;">
                <ol id="layoutOrderList" class="pr-layout-order-list"></ol>
            </div>
        </div>

        <div class="pr-center">
            <div class="pr-center-header">
                <span>Önizleme</span>
            </div>
            <div class="pr-canvas" id="canvasDropZone">
                <div id="layoutCanvas"></div>
                <div id="canvasEmptyHint" class="text-secondary small text-center py-5">Soldan bir alanı buraya sürükleyin</div>
            </div>
        </div>

        <div class="pr-right">
            <div class="pr-right-title">Seçili Alan Özellikleri</div>
            <div id="propertiesPanel">
                <p class="text-secondary small">Düzenlemek için soldaki bir öğeyi seçin veya önizlemede bir öğeye tıklayın.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .pr-designer { display: flex; flex-direction: column; gap: 10px; }
    .pr-toolbar { background: #fff; border: 1px solid var(--erp-border); border-radius: 10px; padding: 10px 14px; }
    .pr-toolbar-row { display: flex; align-items: flex-end; gap: 14px; flex-wrap: wrap; }
    .pr-field-inline { display: flex; flex-direction: column; gap: 3px; }
    .pr-field-inline label { font-size: .72rem; color: #8793a3; font-weight: 600; }
    .pr-toolbar-spacer { flex: 1; }
    .pr-body { display: grid; grid-template-columns: 260px 1fr 300px; gap: 10px; align-items: start; }
    .pr-left, .pr-center, .pr-right { background: #fff; border: 1px solid var(--erp-border); border-radius: 10px; min-height: 520px; }
    .pr-tabs { display: flex; border-bottom: 1px solid var(--erp-border); }
    .pr-tab { flex: 1; padding: 8px; border: 0; background: none; font-size: .8rem; font-weight: 600; color: #8793a3; cursor: pointer; }
    .pr-tab.active { color: var(--erp-ink); border-bottom: 2px solid var(--erp-gold-dark); }
    .pr-tab-panel { padding: 10px; max-height: 620px; overflow-y: auto; }
    .pr-field-group-title { font-size: .7rem; font-weight: 700; color: #8793a3; text-transform: uppercase; margin: 10px 0 4px; }
    .pr-field-group:first-child .pr-field-group-title { margin-top: 0; }
    .pr-palette-item { padding: 6px 8px; margin-bottom: 4px; background: #f7f8fa; border: 1px solid var(--erp-border); border-radius: 6px; font-size: .78rem; cursor: grab; }
    .pr-palette-item:hover { background: #eef0f4; }
    .pr-center-header { padding: 8px 12px; border-bottom: 1px solid var(--erp-border); font-size: .8rem; font-weight: 600; color: #8793a3; }
    .pr-canvas { padding: 16px; min-height: 480px; background: #ececec; }
    .pr-canvas.drag-over { outline: 2px dashed var(--erp-gold-dark); outline-offset: -6px; }
    .pr-right { padding: 10px; }
    .pr-right-title { font-size: .8rem; font-weight: 700; color: #8793a3; margin-bottom: 8px; }
    .pr-layout-order-list { list-style: none; padding: 0; margin: 0; }
    .pr-layout-order-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 8px; border: 1px solid var(--erp-border); border-radius: 6px; margin-bottom: 4px; font-size: .78rem; cursor: pointer; background: #fff; }
    .pr-layout-order-row.selected { border-color: var(--erp-gold-dark); background: #fff8e8; }
    .pr-layout-order-row .del-btn { color: #c0392b; border: 0; background: none; cursor: pointer; font-weight: 700; }
    .pr-prop-field { margin-bottom: 10px; }
    .pr-prop-field label { font-size: .72rem; color: #8793a3; font-weight: 600; display: block; margin-bottom: 3px; }
</style>

<script>
(function () {
    var templateId = @Model.Id;
    var templateType = @((int)Model.TemplateType);
    var elements = @Html.Raw(Model.LayoutJson);
    var selectedIndex = null;
    var previewTimer = null;

    var canvas = document.getElementById('layoutCanvas');
    var emptyHint = document.getElementById('canvasEmptyHint');
    var orderList = document.getElementById('layoutOrderList');
    var propertiesPanel = document.getElementById('propertiesPanel');
    var saveStatus = document.getElementById('saveStatus');

    function paperWidth() { return parseInt(document.getElementById('paperWidthSelect').value, 10); }

    function typeLabel(t) {
        return { text: 'Metin', staticText: 'Sabit Metin', divider: 'Çizgi', lineItemsTable: 'Ürün Tablosu',
            totalsBlock: 'Toplamlar', paymentBreakdown: 'Ödeme Dökümü', discountBreakdown: 'İndirim/İkram Dökümü',
            cancellationBreakdown: 'İptal Dökümü', qrcode: 'QR Kod', barcode: 'Barkod', image: 'Görsel',
            spacer: 'Boşluk', cut: 'Kesme' }[t] || t;
    }

    function rowDisplayName(el) {
        if (el.label) return el.label;
        if (el.type === 'staticText') return el.staticText ? ('"' + el.staticText + '"') : 'Sabit Metin';
        if (el.bindingKey) return el.bindingKey;
        return typeLabel(el.type);
    }

    function renderOrderList() {
        orderList.innerHTML = '';
        elements.forEach(function (el, idx) {
            var li = document.createElement('li');
            li.className = 'pr-layout-order-row' + (idx === selectedIndex ? ' selected' : '');
            li.draggable = true;
            li.dataset.index = idx;
            li.innerHTML = '<span>' + (idx + 1) + '. ' + typeLabel(el.type) + ' — ' + escapeHtml(rowDisplayName(el)) + '</span><button type="button" class="del-btn" data-index="' + idx + '">&times;</button>';
            li.addEventListener('click', function (e) {
                if (e.target.classList.contains('del-btn')) return;
                selectElement(idx);
            });
            li.addEventListener('dragstart', function (e) {
                e.dataTransfer.setData('text/plain', JSON.stringify({ reorderIndex: idx }));
            });
            orderList.appendChild(li);
            li.querySelector('.del-btn').addEventListener('click', function () {
                elements.splice(idx, 1);
                if (selectedIndex === idx) selectedIndex = null;
                refreshAll();
            });
        });
    }

    function escapeHtml(s) {
        var d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
    }

    function selectElement(idx) {
        selectedIndex = idx;
        renderOrderList();
        renderProperties();
    }

    function renderProperties() {
        if (selectedIndex === null || !elements[selectedIndex]) {
            propertiesPanel.innerHTML = '<p class="text-secondary small">Düzenlemek için soldaki bir öğeyi seçin veya önizlemede bir öğeye tıklayın.</p>';
            return;
        }
        var el = elements[selectedIndex];
        var html = '';
        html += '<div class="pr-prop-field"><label>Tür</label><div class="small">' + typeLabel(el.type) + '</div></div>';

        if (el.type === 'staticText') {
            html += '<div class="pr-prop-field"><label>Metin</label><input type="text" class="form-control form-control-sm" id="propStaticText" value="' + escapeHtml(el.staticText || '') + '" /></div>';
        }
        if (el.type === 'text') {
            html += '<div class="pr-prop-field"><label>Sol Etiket (opsiyonel)</label><input type="text" class="form-control form-control-sm" id="propLabel" value="' + escapeHtml(el.label || '') + '" placeholder="Örn: TARİH" /></div>';
        }
        if (['text', 'staticText'].indexOf(el.type) >= 0) {
            html += '<div class="pr-prop-field"><label>Hizalama</label><select class="form-select form-select-sm" id="propAlign">' +
                ['left', 'center', 'right'].map(function (a) { return '<option value="' + a + '"' + (el.align === a ? ' selected' : '') + '>' + (a === 'left' ? 'Sol' : a === 'center' ? 'Orta' : 'Sağ') + '</option>'; }).join('') +
                '</select></div>';
            html += '<div class="form-check form-switch pr-prop-field"><input type="checkbox" class="form-check-input" id="propBold"' + (el.bold ? ' checked' : '') + '><label class="form-check-label">Kalın</label></div>';
            html += '<div class="form-check form-switch pr-prop-field"><input type="checkbox" class="form-check-input" id="propUnderline"' + (el.underline ? ' checked' : '') + '><label class="form-check-label">Altı Çizili</label></div>';
        }
        if (el.type === 'spacer') {
            html += '<div class="pr-prop-field"><label>Yükseklik (mm)</label><input type="number" min="1" max="30" class="form-control form-control-sm" id="propHeight" value="' + (el.heightMm || 4) + '" /></div>';
        }
        propertiesPanel.innerHTML = html;

        var bind = function (id, evt, handler) {
            var node = document.getElementById(id);
            if (node) node.addEventListener(evt, handler);
        };
        bind('propStaticText', 'input', function (e) { el.staticText = e.target.value; refreshAll(); });
        bind('propLabel', 'input', function (e) { el.label = e.target.value; refreshAll(); });
        bind('propAlign', 'change', function (e) { el.align = e.target.value; refreshAll(); });
        bind('propBold', 'change', function (e) { el.bold = e.target.checked; refreshAll(); });
        bind('propUnderline', 'change', function (e) { el.underline = e.target.checked; refreshAll(); });
        bind('propHeight', 'input', function (e) { el.heightMm = parseInt(e.target.value, 10) || 4; refreshAll(); });
    }

    function refreshAll() {
        renderOrderList();
        emptyHint.style.display = elements.length === 0 ? '' : 'none';
        schedulePreview();
    }

    function schedulePreview() {
        clearTimeout(previewTimer);
        previewTimer = setTimeout(fetchPreview, 300);
    }

    function fetchPreview() {
        var form = new URLSearchParams();
        form.set('templateType', templateType);
        form.set('paperWidthMm', paperWidth());
        form.set('layoutJson', JSON.stringify(elements));
        fetch('@Url.Action("PreviewAjax")', { method: 'POST', body: form })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                canvas.innerHTML = data.html;
                Array.prototype.forEach.call(canvas.querySelectorAll('span,div'), function (node, i) {
                    node.addEventListener('click', function () {
                        // Basit eşleme: tıklanan görsel satırın index'i, elements dizisindeki DOM sırasına en yakın olanı seçer.
                    });
                });
            });
    }

    function newElementFromPalette(item) {
        var type = item.dataset.elementType;
        var el = { type: type, align: 'left', bold: false, underline: false, heightMm: 4 };
        if (type === 'staticText') {
            el.staticText = item.dataset.label;
        } else if (['text', 'image', 'qrcode', 'barcode'].indexOf(type) >= 0) {
            el.bindingKey = item.dataset.bindingKey;
            if (type === 'text') el.label = '';
        }
        return el;
    }

    // Palet öğelerini sürükle
    document.querySelectorAll('.pr-palette-item').forEach(function (item) {
        item.addEventListener('dragstart', function (e) {
            e.dataTransfer.setData('text/plain', JSON.stringify({ fromPalette: true, elementType: item.dataset.elementType, bindingKey: item.dataset.bindingKey, label: item.dataset.label }));
        });
    });

    var dropZone = document.getElementById('canvasDropZone');
    dropZone.addEventListener('dragover', function (e) { e.preventDefault(); dropZone.classList.add('drag-over'); });
    dropZone.addEventListener('dragleave', function () { dropZone.classList.remove('drag-over'); });
    dropZone.addEventListener('drop', function (e) {
        e.preventDefault();
        dropZone.classList.remove('drag-over');
        var raw = e.dataTransfer.getData('text/plain');
        if (!raw) return;
        var payload = JSON.parse(raw);
        if (payload.fromPalette) {
            var el = { type: payload.elementType, align: 'left', bold: false, underline: false, heightMm: 4 };
            if (payload.elementType === 'staticText') {
                el.staticText = payload.label;
            } else if (['text', 'image', 'qrcode', 'barcode'].indexOf(payload.elementType) >= 0) {
                el.bindingKey = payload.bindingKey;
                if (payload.elementType === 'text') el.label = '';
            }
            elements.push(el);
            selectElement(elements.length - 1);
        } else if (typeof payload.reorderIndex === 'number') {
            // sürüklenen öğeyi listenin sonuna taşı (basit yeniden sıralama)
            var moved = elements.splice(payload.reorderIndex, 1)[0];
            elements.push(moved);
            refreshAll();
        }
    });

    // Düzen listesindeki satırlar üzerine bırakınca ARA sıraya ekleme
    orderList.addEventListener('dragover', function (e) { e.preventDefault(); });
    orderList.addEventListener('drop', function (e) {
        e.preventDefault();
        var raw = e.dataTransfer.getData('text/plain');
        if (!raw) return;
        var payload = JSON.parse(raw);
        var targetRow = e.target.closest('.pr-layout-order-row');
        var targetIndex = targetRow ? parseInt(targetRow.dataset.index, 10) : elements.length;

        if (payload.fromPalette) {
            var el = { type: payload.elementType, align: 'left', bold: false, underline: false, heightMm: 4 };
            if (payload.elementType === 'staticText') { el.staticText = payload.label; }
            else if (['text', 'image', 'qrcode', 'barcode'].indexOf(payload.elementType) >= 0) { el.bindingKey = payload.bindingKey; if (payload.elementType === 'text') el.label = ''; }
            elements.splice(targetIndex, 0, el);
            selectElement(targetIndex);
        } else if (typeof payload.reorderIndex === 'number') {
            var moved = elements.splice(payload.reorderIndex, 1)[0];
            var insertAt = targetIndex > payload.reorderIndex ? targetIndex - 1 : targetIndex;
            elements.splice(insertAt, 0, moved);
            refreshAll();
        }
    });

    // Sekmeler
    document.querySelectorAll('.pr-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
            document.querySelectorAll('.pr-tab').forEach(function (t) { t.classList.remove('active'); });
            tab.classList.add('active');
            document.querySelectorAll('.pr-tab-panel').forEach(function (p) { p.style.display = 'none'; });
            document.querySelector('.pr-tab-panel[data-panel="' + tab.dataset.tab + '"]').style.display = '';
        });
    });

    document.getElementById('paperWidthSelect').addEventListener('change', schedulePreview);

    // Kaydet
    document.getElementById('saveBtn').addEventListener('click', function () {
        var form = new URLSearchParams();
        form.set('id', templateId);
        form.set('name', document.getElementById('templateName').value);
        form.set('templateType', templateType);
        form.set('paperWidthMm', paperWidth());
        form.set('layoutJson', JSON.stringify(elements));
        var branchVal = document.getElementById('branchSelect').value;
        if (branchVal) form.set('branchId', branchVal);
        form.set('setAsDefault', 'false');

        saveStatus.textContent = 'Kaydediliyor...';
        fetch('@Url.Action("Save")', {
            method: 'POST', body: form,
            headers: { 'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    saveStatus.textContent = 'Kaydedildi (v' + data.version + ') — ' + new Date().toLocaleTimeString('tr-TR');
                    templateId = data.id;
                    document.querySelector('.pr-designer').dataset.templateId = data.id;
                    if (!document.getElementById('setDefaultBtn')) {
                        window.location.href = '@Url.Action("Designer")/' + data.id;
                    }
                } else {
                    saveStatus.textContent = 'Hata: ' + data.error;
                }
            })
            .catch(function (err) { saveStatus.textContent = 'Kaydetme başarısız: ' + err; });
    });

    var setDefaultBtn = document.getElementById('setDefaultBtn');
    if (setDefaultBtn) {
        setDefaultBtn.addEventListener('click', function () {
            fetch('@Url.Action("SetDefault")/' + templateId, {
                method: 'POST',
                headers: { 'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
            }).then(function () { saveStatus.textContent = 'Varsayılan şablon olarak ayarlandı.'; });
        });
    }

    // Test Çıktısı Al menüsü
    var testMenu = document.getElementById('testPrinterMenu');
    fetch('@Url.Action("PrintersForType")?templateType=' + templateType)
        .then(function (r) { return r.json(); })
        .then(function (printers) {
            if (!printers.length) {
                testMenu.innerHTML = '<li><span class="dropdown-item-text text-secondary small">Bu tip için tanımlı yazıcı yok</span></li>';
                return;
            }
            testMenu.innerHTML = printers.map(function (p) {
                return '<li><button type="button" class="dropdown-item test-print-item" data-printer-id="' + p.id + '">' + escapeHtml(p.name) + '</button></li>';
            }).join('');
            testMenu.querySelectorAll('.test-print-item').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var form = new URLSearchParams();
                    form.set('printerId', btn.dataset.printerId);
                    form.set('templateType', templateType);
                    form.set('paperWidthMm', paperWidth());
                    form.set('layoutJson', JSON.stringify(elements));
                    saveStatus.textContent = 'Test çıktısı gönderiliyor...';
                    fetch('@Url.Action("TestPrintDraft")', {
                        method: 'POST', body: form,
                        headers: { 'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
                    })
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            saveStatus.textContent = data.success ? ('Test çıktısı gönderildi: Başarılı (İş #' + data.jobId + ')') : ('Test çıktısı gönderilemedi: ' + data.error);
                        });
                });
            });
        });

    refreshAll();
})();
</script>

<form id="antiForgeryHolder" style="display:none;">@Html.AntiForgeryToken()</form>
