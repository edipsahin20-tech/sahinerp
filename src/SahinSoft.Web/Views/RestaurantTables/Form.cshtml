@model SahinSoft.Web.Models.RestaurantTableFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Masayı Düzenle" : "Yeni Masa";
}

<form id="evrak-form" method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <input asp-for="Id" type="hidden" />

    <div class="erp-toolbar">
        <div class="erp-toolbar-title"><h1>@ViewData["Title"]</h1></div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="erp-panel">
        <div class="erp-panel-header">Masa Bilgileri</div>
        <div class="erp-panel-body">
            <div class="erp-field-grid">
                <div class="erp-field" style="grid-column: span 2;">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" class="form-control" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="erp-field">
                    <label asp-for="Capacity"></label>
                    <input asp-for="Capacity" class="form-control" type="number" />
                    <span asp-validation-for="Capacity" class="text-danger small"></span>
                </div>
                <div class="erp-field">
                    <label asp-for="RestaurantSectionId"></label>
                    <select asp-for="RestaurantSectionId" asp-items="Model.Sections" class="form-select">
                        <option value="">Salon seçin</option>
                    </select>
                    <span asp-validation-for="RestaurantSectionId" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-4 mt-3">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>
</form>

<partial name="_EvrakToolbar" model="(SahinSoft.Web.Models.EvrakToolbarViewModel?)ViewBag.Toolbar" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
