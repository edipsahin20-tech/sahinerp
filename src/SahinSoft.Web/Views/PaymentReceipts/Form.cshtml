@using SahinSoft.Domain.Enums
@model SahinSoft.Web.Models.PaymentReceiptFormViewModel
@{
    var isEdit = Model.Id > 0;
    var isCollection = Model.ReceiptType == ReceiptType.Collection;
    ViewData["Title"] = (isEdit ? "Düzenle: " : "Yeni ") + (isCollection ? "Tahsilat" : "Tediye");
}

<form id="evrak-form" method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <input asp-for="Id" type="hidden" />
    <input asp-for="SubmissionKey" type="hidden" />
    <input asp-for="ReceiptType" type="hidden" />

    <div class="erp-toolbar">
        <div class="erp-toolbar-title">
            <h1>@(isCollection ? "Tahsilat Makbuzu" : "Tediye Makbuzu")</h1>
            <span class="erp-toolbar-meta">@(isEdit ? "Taslak düzenleniyor" : "Yeni evrak")</span>
        </div>
    </div>

    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

    <div class="erp-panel">
        <div class="erp-evrak-header">
            <div class="erp-evrak-badge">
                <span class="erp-evrak-icon"><i class="fa-solid fa-money-bill-transfer"></i></span>
                <div class="erp-evrak-label">
                    <small>@(isCollection ? "Tahsilat" : "Tediye")</small>
                    <strong>Evrak Bilgileri</strong>
                </div>
            </div>
            <div class="erp-evrak-fields">
                <div class="erp-field">
                    <label>Evrak Belge Seri</label>
                    <input class="form-control" value="@(isCollection ? "TAH" : "TED")" readonly title="Evrak serisi sistem tarafından yönetilir." />
                </div>
                <div class="erp-field">
                    <label>Evrak Belge Sıra</label>
                    <input class="form-control" value="@(isEdit ? Model.ReceiptNumber : "Otomatik")" readonly title="Sıra numarası kayıt sırasında otomatik verilir." />
                </div>
                <div class="erp-field">
                    <label asp-for="ReceiptDateUtc"></label>
                    <input asp-for="ReceiptDateUtc" class="form-control" />
                </div>
            </div>
        </div>
        <div class="erp-panel-body">
            <div class="erp-field-grid">
                <div class="erp-field">
                    <label asp-for="CustomerId"></label>
                    <partial name="_LookupField" model="@(new LookupFieldViewModel {
                        Name = nameof(Model.CustomerId), Id = nameof(Model.CustomerId),
                        Value = Model.CustomerId?.ToString(),
                        DisplayValue = Model.CustomerDisplay,
                        Endpoint = Url.Action("Customers", "Lookup")!,
                        Title = "Cari Seç", Placeholder = "Cari seçin" })" />
                    <span asp-validation-for="CustomerId" class="text-danger small"></span>
                </div>
                <div class="erp-field">
                    <label asp-for="CurrencyCode"></label>
                    <input asp-for="CurrencyCode" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="ExchangeRate"></label>
                    <input asp-for="ExchangeRate" class="form-control" />
                </div>
                <div class="erp-field" style="grid-column: 1 / -1;">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="erp-panel">
        <div class="erp-panel-header d-flex justify-content-between align-items-center">
            <span>Satırlar</span>
            <button type="button" id="add-line" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.75rem;">+ Satır Ekle</button>
        </div>
        <div class="erp-panel-body p-0">
            <div class="erp-table-wrap">
                <table class="erp-table" id="lines-table">
                    <thead>
                        <tr>
                            <th style="min-width: 180px;">Kasa/Banka</th>
                            <th style="min-width: 150px;">Ödeme Yöntemi</th>
                            <th style="width: 140px;">Referans No</th>
                            <th style="width: 130px;">Tutar</th>
                            <th>Açıklama</th>
                            <th style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="lines-body">
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr class="line-row">
                            <input type="hidden" name="Lines.Index" value="@i" />
                            <td>
                                <partial name="_LookupField" model="@(new LookupFieldViewModel {
                                    Name = $"Lines[{i}].FinancialAccountId", Id = $"Lines_{i}__FinancialAccountId",
                                    Value = Model.Lines[i].FinancialAccountId?.ToString(),
                                    DisplayValue = Model.Lines[i].FinancialAccountDisplay,
                                    Endpoint = Url.Action("FinancialAccounts", "Lookup")!,
                                    Title = "Kasa/Banka Seç", Placeholder = "Hesap seçin" })" />
                            </td>
                            <td>
                                <select name="Lines[@i].PaymentMethod" class="form-select">
                                    @foreach (var method in Enum.GetValues<PaymentMethod>())
                                    {
                                        <option value="@((int)method)" selected="@(Model.Lines[i].PaymentMethod == method)">@method.GetDisplayName()</option>
                                    }
                                </select>
                            </td>
                            <td><input type="text" name="Lines[@i].ReferenceNumber" value="@Model.Lines[i].ReferenceNumber" class="form-control" /></td>
                            <td><input type="text" name="Lines[@i].Amount" value="@Model.Lines[i].Amount" class="form-control" /></td>
                            <td><input type="text" name="Lines[@i].Description" value="@Model.Lines[i].Description" class="form-control" /></td>
                            <td><button type="button" class="btn btn-erp-danger remove-line" style="padding: 0.15rem 0.5rem; font-size: 0.75rem;">Sil</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>

<partial name="_EvrakToolbar" model="(SahinSoft.Web.Models.EvrakToolbarViewModel?)ViewBag.Toolbar" />

<template id="line-row-template">
    <tr class="line-row">
        <input type="hidden" name="Lines.Index" value="__index__" />
        <td>
            <div class="input-group">
                <input type="hidden" name="Lines[__index__].FinancialAccountId" id="Lines___index____FinancialAccountId" value="" />
                <input type="text" id="Lines___index____FinancialAccountId_display" class="form-control" readonly
                       placeholder="Hesap seçin" autocomplete="off"
                       data-lookup-endpoint="@Url.Action("FinancialAccounts", "Lookup")"
                       data-lookup-title="Kasa/Banka Seç"
                       data-target-hidden="Lines___index____FinancialAccountId"
                       data-target-display="Lines___index____FinancialAccountId_display" />
                <button type="button" class="btn btn-outline-secondary lookup-trigger"
                        data-lookup-endpoint="@Url.Action("FinancialAccounts", "Lookup")"
                        data-lookup-title="Kasa/Banka Seç"
                        data-target-hidden="Lines___index____FinancialAccountId"
                        data-target-display="Lines___index____FinancialAccountId_display">
                    ...
                </button>
            </div>
        </td>
        <td>
            <select name="Lines[__index__].PaymentMethod" class="form-select">
                @foreach (var method in Enum.GetValues<PaymentMethod>())
                {
                    <option value="@((int)method)">@method.GetDisplayName()</option>
                }
            </select>
        </td>
        <td><input type="text" name="Lines[__index__].ReferenceNumber" value="" class="form-control" /></td>
        <td><input type="text" name="Lines[__index__].Amount" value="0" class="form-control" /></td>
        <td><input type="text" name="Lines[__index__].Description" value="" class="form-control" /></td>
        <td><button type="button" class="btn btn-erp-danger remove-line" style="padding: 0.15rem 0.5rem; font-size: 0.75rem;">Sil</button></td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var linesBody = document.getElementById('lines-body');
            var template = document.getElementById('line-row-template');
            var addButton = document.getElementById('add-line');
            var nextIndex = @Model.Lines.Count;

            addButton.addEventListener('click', function () {
                var html = template.innerHTML.split('__index__').join(nextIndex);
                var wrapper = document.createElement('tbody');
                wrapper.innerHTML = html;
                linesBody.appendChild(wrapper.firstElementChild);
                nextIndex++;
            });

            linesBody.addEventListener('click', function (event) {
                if (event.target.classList.contains('remove-line')) {
                    var row = event.target.closest('tr');
                    if (linesBody.querySelectorAll('.line-row').length > 1) {
                        row.remove();
                    }
                }
            });
        })();
    </script>
}
