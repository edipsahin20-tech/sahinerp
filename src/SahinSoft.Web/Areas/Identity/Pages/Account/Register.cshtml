@page
@model RegisterModel
@{
    ViewData["Title"] = "Kayıt Ol";
    ViewData["Subtitle"] = "Yeni bir hesap oluşturun";
}

<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

    <div class="auth-field">
        <label asp-for="Input.FullName" class="form-label"></label>
        <div class="auth-field-control">
            <input asp-for="Input.FullName" class="form-control" autocomplete="name" aria-required="true" placeholder="Ad Soyad" />
            <svg class="auth-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
        </div>
        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
    </div>
    <div class="auth-field">
        <label asp-for="Input.Email" class="form-label">E-posta</label>
        <div class="auth-field-control">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ornek@sahinsoft.com.tr" />
            <svg class="auth-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 6 8 6 8-6" /></svg>
        </div>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>
    <div class="auth-field">
        <label asp-for="Input.Password" class="form-label">Şifre</label>
        <div class="auth-field-control">
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
            <svg class="auth-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
        </div>
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>
    <div class="auth-field">
        <label asp-for="Input.ConfirmPassword" class="form-label">Şifre (tekrar)</label>
        <div class="auth-field-control">
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
            <svg class="auth-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
    </div>

    <button id="registerSubmit" type="submit" class="btn btn-auth-primary">Kayıt Ol</button>
</form>

<div class="auth-divider">ya da</div>

<a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-auth-secondary">Zaten Hesabım Var</a>

@{
    if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <div class="auth-divider">veya</div>
        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            @foreach (var provider in Model.ExternalLogins!)
            {
                <button type="submit" class="btn btn-auth-secondary mb-2" name="provider" value="@provider.Name" title="@provider.DisplayName ile kayıt ol">@provider.DisplayName ile Kayıt Ol</button>
            }
        </form>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
