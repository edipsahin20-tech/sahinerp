@model IReadOnlyList<SahinSoft.Domain.Entities.RestaurantSection>
@{
    ViewData["Title"] = "Salonlar";
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>Salonlar</h1>
        <span class="erp-toolbar-meta">@Model.Count kayıt</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-action="Create" class="btn btn-erp-primary btn-sm">+ Yeni Salon</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}

<div class="erp-panel">
    <div class="erp-panel-body p-0">
    <div class="erp-table-wrap">
        <table class="erp-table">
            <thead>
                <tr>
                    <th>Sıra</th>
                    <th>Salon Adı</th>
                    <th>Şube</th>
                    <th>Masa Sayısı</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(item.IsActive ? "" : "text-secondary")">
                    <td>@item.DisplayOrder</td>
                    <td class="fw-semibold">@item.Name</td>
                    <td>@item.Branch.Name</td>
                    <td>@item.Tables.Count</td>
                    <td>
                        @if (item.IsActive) { <span class="badge text-bg-success-subtle text-success-emphasis">Aktif</span> }
                        else { <span class="badge text-bg-danger-subtle text-danger-emphasis">Pasif</span> }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.78rem;">Düzenle</a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
            }
            </tbody>
        </table>
    </div>
    </div>
</div>
