@using SahinSoft.Domain.Enums
@model SahinSoft.Web.Models.InvoiceFormViewModel
@{
    var isEdit = Model.Id > 0;
    var isSales = Model.InvoiceType == InvoiceType.Sales;
    ViewData["Title"] = (isEdit ? "Düzenle: " : "Yeni ") + (isSales ? "Satış Faturası" : "Alış Faturası");
}

<form id="evrak-form" method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <input asp-for="Id" type="hidden" />
    <input asp-for="SubmissionKey" type="hidden" />
    <input asp-for="InvoiceType" type="hidden" />

    <div class="erp-toolbar">
        <div class="erp-toolbar-title">
            <h1>@(isSales ? "Satış Faturası" : "Alış Faturası")</h1>
            <span class="erp-toolbar-meta">@(isEdit ? (Model.Status == InvoiceStatus.Approved ? "Onaylı fatura düzenleniyor" : "Taslak düzenleniyor") : "Yeni evrak")</span>
        </div>
        <a class="btn btn-erp-outline btn-sm" asp-action="Index" asp-controller="Invoices" asp-route-type="@Model.InvoiceType" asp-route-status="@InvoiceStatus.Draft">
            <i class="fa-solid fa-list-check"></i> Taslağa Git
        </a>
    </div>

    @if (isEdit && Model.Status == InvoiceStatus.Approved)
    {
        <div class="alert alert-warning py-2">
            <strong>Dikkat:</strong> Bu fatura onaylı. Kaydettiğinizde eski stok ve cari hareketleri otomatik olarak geri alınıp, yeni satırlarınıza göre yeniden oluşturulacak.
        </div>
    }

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success py-2">@success</div>
    }
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="erp-panel">
        <div class="erp-evrak-header">
            <div class="erp-evrak-badge">
                <span class="erp-evrak-icon"><i class="fa-solid fa-file-invoice"></i></span>
                <div class="erp-evrak-label">
                    <small>@(isSales ? "Satış" : "Alış") Faturası</small>
                    <strong>Evrak Bilgileri</strong>
                </div>
            </div>
            <div class="erp-evrak-fields">
                <div class="erp-field">
                    <label asp-for="DocumentSeries"></label>
                    <input asp-for="DocumentSeries" class="form-control" autocomplete="off" title="Boş bırakılırsa otomatik seri kullanılır." />
                </div>
                <div class="erp-field">
                    <label asp-for="DocumentSequence"></label>
                    <div class="input-group">
                        <input asp-for="DocumentSequence" class="form-control" autocomplete="off" title="Boş bırakılırsa sıradaki numara otomatik verilir. Elle değiştirirseniz sonraki otomatik numaralar bunun devamından gelir." />
                        <button type="button" class="btn btn-erp-outline lookup-trigger" id="invoice-browse-trigger"
                                data-lookup-endpoint="@Url.Action("InvoicesBrowse", "Lookup", new { type = Model.InvoiceType })"
                                data-lookup-title="Faturalarda Gözat"
                                data-target-hidden="invoice-browse-dummy-hidden"
                                data-target-display="invoice-browse-dummy-display"
                                title="Tüm faturalarda gözat">
                            <i class="fa-solid fa-ellipsis"></i>
                        </button>
                    </div>
                    <span asp-validation-for="DocumentSequence" class="text-danger small"></span>
                </div>
                <div class="erp-field">
                    <label asp-for="ReferenceNumber"></label>
                    <input asp-for="ReferenceNumber" class="form-control" placeholder="Harici belge numarası" />
                </div>
                <div class="erp-field">
                    <label asp-for="InvoiceDateUtc"></label>
                    <input asp-for="InvoiceDateUtc" class="form-control" />
                </div>
            </div>
            <label class="erp-vat-check">
                <input asp-for="PricesIncludeTax" id="prices-include-tax" />
                <span>Fiyatlara KDV Dahil</span>
            </label>
        </div>
        <div class="erp-panel-body">
            <div class="erp-field-grid">
                <div class="erp-field">
                    <label asp-for="CustomerId"></label>
                    <partial name="_LookupField" model="@(new LookupFieldViewModel {
                        Name = nameof(Model.CustomerId), Id = nameof(Model.CustomerId),
                        Value = Model.CustomerId?.ToString(),
                        DisplayValue = Model.CustomerDisplay,
                        Endpoint = Url.Action("Customers", "Lookup", new { type = isSales ? "Customer" : "Supplier" })!,
                        Title = "Cari Seç", Placeholder = "Cari seçin" })" />
                    <span asp-validation-for="CustomerId" class="text-danger small"></span>
                </div>
                <div class="erp-field d-flex align-items-center" style="padding-top: 1.7rem;">
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" id="planned-mode-toggle" />
                        <label class="form-check-label" for="planned-mode-toggle">Planlı İşlem</label>
                    </div>
                </div>
                <div class="erp-field">
                    <label asp-for="WarehouseId"></label>
                    <partial name="_LookupField" model="@(new LookupFieldViewModel {
                        Name = nameof(Model.WarehouseId), Id = nameof(Model.WarehouseId),
                        Value = Model.WarehouseId?.ToString(),
                        DisplayValue = Model.WarehouseDisplay,
                        Endpoint = Url.Action("Warehouses", "Lookup")!,
                        Title = "Depo Seç", Placeholder = "Depo seçin" })" />
                    <span asp-validation-for="WarehouseId" class="text-danger small"></span>
                </div>
                <div class="erp-field">
                    <label asp-for="DueDateUtc"></label>
                    <input asp-for="DueDateUtc" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="CurrencyCode"></label>
                    <input asp-for="CurrencyCode" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="ExchangeRate"></label>
                    <input asp-for="ExchangeRate" class="form-control" />
                </div>
                <div class="erp-field">
                    <label asp-for="PaymentTerm"></label>
                    <input asp-for="PaymentTerm" class="form-control" list="payment-term-options" placeholder="Örn: PEŞİN" />
                    <datalist id="payment-term-options">
                        <option value="PEŞİN"></option>
                        <option value="Havale/EFT"></option>
                        <option value="Kredi Kartı"></option>
                        <option value="Çek"></option>
                        <option value="Senet"></option>
                        <option value="30 Gün Vadeli"></option>
                        <option value="60 Gün Vadeli"></option>
                    </datalist>
                </div>
                <div class="erp-field">
                    <label asp-for="TradeType"></label>
                    <input asp-for="TradeType" class="form-control" list="trade-type-options" placeholder="Örn: Toptan yurtiçi ticaret" />
                    <datalist id="trade-type-options">
                        <option value="Toptan yurtiçi ticaret"></option>
                        <option value="Perakende yurtiçi ticaret"></option>
                        <option value="İhracat"></option>
                        <option value="İthalat"></option>
                    </datalist>
                </div>
                <div class="erp-field">
                    <label asp-for="SalespersonUserId"></label>
                    <select asp-for="SalespersonUserId" asp-items="Model.Salespeople" class="form-select">
                        <option value="">Plasiyer seçilmedi</option>
                    </select>
                </div>
                <div class="erp-field d-flex align-items-center" style="padding-top: 1.7rem;">
                    <div class="form-check form-switch">
                        <input asp-for="IsReturn" class="form-check-input" />
                        <label asp-for="IsReturn" class="form-check-label"></label>
                    </div>
                </div>
                <div class="erp-field d-flex align-items-center" style="padding-top: 1.7rem;">
                    <div class="form-check form-switch">
                        <input asp-for="IsClosedInvoice" class="form-check-input" id="is-closed-invoice-switch" />
                        <label asp-for="IsClosedInvoice" class="form-check-label"></label>
                    </div>
                </div>
                <div id="closed-invoice-fields" class="erp-field-grid" style="grid-column: 1 / -1; padding: 0;" hidden>
                    <div class="erp-field">
                        <label asp-for="SettlementPaymentMethod"></label>
                        <select asp-for="SettlementPaymentMethod" class="form-select">
                            <option value="">Seçiniz</option>
                            @foreach (var method in Enum.GetValues<PaymentMethod>())
                            {
                                <option value="@((int)method)" selected="@(Model.SettlementPaymentMethod == method)">@method.GetDisplayName()</option>
                            }
                        </select>
                        <span asp-validation-for="SettlementPaymentMethod" class="text-danger small"></span>
                    </div>
                    <div class="erp-field">
                        <label asp-for="SettlementFinancialAccountId"></label>
                        <partial name="_LookupField" model="@(new LookupFieldViewModel {
                            Name = nameof(Model.SettlementFinancialAccountId), Id = nameof(Model.SettlementFinancialAccountId),
                            Value = Model.SettlementFinancialAccountId?.ToString(),
                            DisplayValue = Model.SettlementFinancialAccountDisplay,
                            Endpoint = Url.Action("FinancialAccounts", "Lookup")!,
                            Title = "Kapanacak Kasa/Banka Seç", Placeholder = "Kasa/Banka seçin" })" />
                        <span asp-validation-for="SettlementFinancialAccountId" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="erp-panel">
        <div class="erp-panel-header d-flex justify-content-between align-items-center">
            <span>Satırlar</span>
            <button type="button" id="add-line" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.75rem;">+ Satır Ekle</button>
        </div>
        <div class="erp-panel-body p-0">
            <div class="erp-table-wrap">
                <table class="erp-table" id="lines-table">
                    <thead>
                        <tr>
                            <th style="width: 140px;">Stok Kodu</th>
                            <th style="min-width: 220px;">Ürün Adı</th>
                            <th style="width: 90px;">Miktar</th>
                            <th style="width: 100px;">Birim Fiyat</th>
                            <th style="width: 80px;">İsk. %</th>
                            <th style="width: 80px;">KDV %</th>
                            <th style="width: 100px;">Tutar</th>
                            <th style="width: 100px;">Net Tutar</th>
                            <th>Açıklama</th>
                            <th style="width: 110px;">Kaynak</th>
                            <th style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="lines-body">
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        var rawDisplay = Model.Lines[i].ProductDisplay ?? "";
                        var codeVal = rawDisplay.Contains(" - ") ? rawDisplay.Split(" - ")[0] : "";
                        var nameVal = rawDisplay.Contains(" - ") ? string.Join(" - ", rawDisplay.Split(" - ").Skip(1)) : rawDisplay;
                        <tr class="line-row">
                            <input type="hidden" name="Lines.Index" value="@i" />
                            <input type="hidden" name="Lines[@i].DispatchNoteLineId" value="@Model.Lines[i].DispatchNoteLineId" class="dispatch-line-id-input" />
                            <input type="hidden" name="Lines[@i].BusinessOrderLineId" value="@Model.Lines[i].BusinessOrderLineId" class="order-line-id-input" />
                            <td>
                                <input type="text" class="form-control stock-code-input lookup-quicksearch" 
                                       placeholder="Stok Kodu/Barkod" autocomplete="off" value="@codeVal"
                                       data-lookup-endpoint="@Url.Action("Products", "Lookup")"
                                       data-lookup-title="Ürün Seç"
                                       data-target-hidden="Lines_@(i)__ProductId"
                                       data-target-display="Lines_@(i)__ProductId_display" />
                            </td>
                            <td>
                                <partial name="_LookupField" model="@(new LookupFieldViewModel {
                                    Name = $"Lines[{i}].ProductId", Id = $"Lines_{i}__ProductId",
                                    Value = Model.Lines[i].ProductId?.ToString(),
                                    DisplayValue = nameVal,
                                    Endpoint = Url.Action("Products", "Lookup")!,
                                    Title = "Ürün Seç", Placeholder = "Ürün adı/kod/barkod",
                                    AllowQuickSearch = true })" />
                            </td>
                            <td><input type="text" name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity" class="form-control quantity-input" /></td>
                            <td><input type="text" name="Lines[@i].UnitPrice" value="@Model.Lines[i].UnitPrice" class="form-control price-input" /></td>
                            <td><input type="text" name="Lines[@i].DiscountRate" value="@Model.Lines[i].DiscountRate" class="form-control discount-input" /></td>
                            <td><input type="text" name="Lines[@i].TaxRate" value="@Model.Lines[i].TaxRate" class="form-control tax-input" /></td>
                            <td class="text-end line-gross">0.00</td>
                            <td class="text-end fw-semibold line-net">0.00</td>
                            <td><input type="text" name="Lines[@i].Description" value="@Model.Lines[i].Description" class="form-control description-input" /></td>
                            <td class="source-cell"><small class="text-muted">@Model.Lines[i].SourceDisplay</small></td>
                            <td><button type="button" class="btn btn-erp-danger remove-line" style="padding: 0.15rem 0.5rem; font-size: 0.75rem;">Sil</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="erp-panel-body pt-0">
            <div class="d-flex justify-content-end">
                <div class="erp-totals">
                    <div class="erp-totals-row"><span>Ara toplam</span><span id="totals-subtotal">0.00</span></div>
                    <div class="erp-totals-row">
                        <label asp-for="AmountDiscount" class="mb-0"></label>
                        <input asp-for="AmountDiscount" class="form-control" style="width: 140px; padding: 4px; text-align: right;" id="amount-discount-input" />
                    </div>
                    <div class="erp-totals-row"><span>İskonto (satır + tutar)</span><span id="totals-discount">0.00</span></div>
                    <div id="totals-kdv-breakdown"></div>
                    <div class="erp-totals-row erp-grand-total"><span>Genel Toplam</span><span class="erp-total-value" id="totals-grand">0.00</span></div>
                </div>
            </div>
        </div>
    </div>
</form>

<partial name="_EvrakToolbar" model="(SahinSoft.Web.Models.EvrakToolbarViewModel?)ViewBag.Toolbar" />

<template id="line-row-template">
    <tr class="line-row">
        <input type="hidden" name="Lines.Index" value="__index__" />
        <input type="hidden" name="Lines[__index__].DispatchNoteLineId" value="" class="dispatch-line-id-input" />
        <input type="hidden" name="Lines[__index__].BusinessOrderLineId" value="" class="order-line-id-input" />
        <td>
            <input type="text" class="form-control stock-code-input lookup-quicksearch"
                   placeholder="Stok Kodu/Barkod" autocomplete="off"
                   data-lookup-endpoint="@Url.Action("Products", "Lookup")"
                   data-lookup-title="Ürün Seç"
                   data-target-hidden="Lines___index____ProductId"
                   data-target-display="Lines___index____ProductId_display" />
        </td>
        <td>
            <div class="input-group">
                <input type="hidden" name="Lines[__index__].ProductId" id="Lines___index____ProductId" value="" />
                <input type="text" id="Lines___index____ProductId_display" class="form-control lookup-quicksearch product-name-input"
                       placeholder="Ürün adı/kod/barkod" autocomplete="off"
                       data-lookup-endpoint="@Url.Action("Products", "Lookup")"
                       data-lookup-title="Ürün Seç"
                       data-target-hidden="Lines___index____ProductId"
                       data-target-display="Lines___index____ProductId_display" />
                <button type="button" class="btn btn-outline-secondary lookup-trigger"
                        data-lookup-endpoint="@Url.Action("Products", "Lookup")"
                        data-lookup-title="Ürün Seç"
                        data-target-hidden="Lines___index____ProductId"
                        data-target-display="Lines___index____ProductId_display">
                    ...
                </button>
            </div>
        </td>
        <td><input type="text" name="Lines[__index__].Quantity" value="1" class="form-control quantity-input" /></td>
        <td><input type="text" name="Lines[__index__].UnitPrice" value="0" class="form-control price-input" /></td>
        <td><input type="text" name="Lines[__index__].DiscountRate" value="0" class="form-control discount-input" /></td>
        <td><input type="text" name="Lines[__index__].TaxRate" value="0" class="form-control tax-input" /></td>
        <td class="text-end line-gross">0.00</td>
        <td class="text-end fw-semibold line-net">0.00</td>
        <td><input type="text" name="Lines[__index__].Description" value="" class="form-control description-input" /></td>
        <td class="source-cell"></td>
        <td><button type="button" class="btn btn-erp-danger remove-line" style="padding: 0.15rem 0.5rem; font-size: 0.75rem;">Sil</button></td>
    </tr>
</template>

@* Planlı İşlem (F5): seçili cariye ait, onaylı ve henüz tamamen faturalanmamış irsaliyeleri listeler.
   Kullanıcı bir/birden fazla irsaliye seçip Aktar'a basınca, o irsaliyelerin kalan satırları
   (ürün/miktar/fiyat/KDV/iskonto + kaynak bağlantısı) doğrudan satır tablosuna eklenir. *@
<div class="modal fade" id="plannedConversionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-truck"></i> Onaylı İrsaliyelerden Çağır</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" id="planned-conversion-body">
                <div class="text-center text-secondary py-3">Yükleniyor...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-erp-primary" id="planned-conversion-confirm">Seçilenleri Faturaya Aktar</button>
            </div>
        </div>
    </div>
</div>

<div id="conversion-auto-approve-hint" class="alert py-2 mb-3" style="display:none;"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // "Kapalı Fatura mı?" işaretliyken Ödeme Yöntemi/Kapanacak Kasa alanlarını gösterir —
        // bu alanlar yalnızca Kapalı işaretliyken zorunludur (bkz. InvoicesController.ValidateSettlement).
        (function () {
            var toggle = document.getElementById('is-closed-invoice-switch');
            var fields = document.getElementById('closed-invoice-fields');
            if (!toggle || !fields) return;
            function sync() { fields.hidden = !toggle.checked; }
            toggle.addEventListener('change', sync);
            sync();
        })();

        // "..." ile açılan Faturalarda Gözat penceresinden bir fatura seçilince, o faturanın
        // Detay ekranına gidilir (satır doldurma değil, gerçek sayfa geçişi).
        (function () {
            var trigger = document.getElementById('invoice-browse-trigger');
            if (!trigger) return;
            trigger.addEventListener('lookup:selected', function (e) {
                window.location.href = '@Url.Action("Details", "Invoices")/' + e.detail.item.id;
            });
        })();

        // Evrak başlığındaki alanlarda Enter'a basınca form kazara gönderilmesin (hataya sebep
        // oluyordu); bunun yerine Tab gibi bir sonraki alana geçsin. Satırlar tablosu ve
        // cari/depo gibi lookup-quicksearch alanları kendi Enter mantığını zaten yönetiyor,
        // burada onlara dokunulmuyor.
        (function () {
            var seriesInput = document.getElementById('DocumentSeries');
            var sequenceInput = document.getElementById('DocumentSequence');
            if (seriesInput && sequenceInput) {
                var lastCheckedSeries = seriesInput.value.trim();

                // Seri alanından ayrılınca (Enter, Tab, tıklama, mobilde Sıra alanına dokunma —
                // hangi yoldan olursa olsun) o seriye ait güncel sıra numarası sunucudan sorgulanıp
                // Sıra alanına yazılır (her seri kendi sırasını takip eder — ör. "EDP" hiç
                // kullanılmadıysa 00001'den başlar). Önceden yalnızca masaüstünde Enter tuşuna
                // bağlıydı; mobilde Enter her zaman aynı şekilde tetiklenmediği ve kullanıcılar
                // genelde doğrudan bir sonraki alana dokunduğu için 'blur' kullanmak daha güvenilir
                // — hangi yolla olursa olsun alan terk edilince tetiklenir.
                seriesInput.addEventListener('blur', function () {
                    var currentSeries = seriesInput.value.trim();
                    if (currentSeries === lastCheckedSeries) return;
                    lastCheckedSeries = currentSeries;

                    var url = '@Url.Action("PeekSequence", "Invoices")?type=@Model.InvoiceType&series=' + encodeURIComponent(currentSeries);
                    fetch(url)
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            sequenceInput.value = data.sequence;
                        });
                });
            }

            document.getElementById('evrak-form').addEventListener('keydown', function (event) {
                if (event.key !== 'Enter') return;
                var target = event.target;
                if (target.tagName === 'TEXTAREA' || target.tagName === 'BUTTON') return;
                if (target.closest('#lines-table')) return;
                if (target.classList.contains('lookup-quicksearch')) return;

                event.preventDefault();
                var focusable = Array.from(target.form.querySelectorAll('input, select, textarea')).filter(function (el) {
                    return !el.disabled && el.type !== 'hidden' && el.offsetParent !== null;
                });
                var idx = focusable.indexOf(target);
                if (idx >= 0 && idx < focusable.length - 1) {
                    var next = focusable[idx + 1];
                    next.focus();
                    if (typeof next.select === 'function') next.select();
                }
            });
        })();

        (function () {
            var linesBody = document.getElementById('lines-body');
            var template = document.getElementById('line-row-template');
            var addButton = document.getElementById('add-line');
            var nextIndex = @Model.Lines.Count;
            var isSales = @Json.Serialize(isSales);
            var pricesIncludeTax = document.getElementById('prices-include-tax');

            function addRow() {
                var html = template.innerHTML.split('__index__').join(nextIndex);
                var wrapper = document.createElement('tbody');
                wrapper.innerHTML = html;
                var row = wrapper.firstElementChild;
                linesBody.appendChild(row);
                nextIndex++;
                return row;
            }

            addButton.addEventListener('click', function () {
                addRow();
                recalcTotals();
            });

            linesBody.addEventListener('click', function (event) {
                if (event.target.classList.contains('remove-line')) {
                    var row = event.target.closest('tr');
                    if (linesBody.querySelectorAll('.line-row').length > 1) {
                        row.remove();
                        recalcTotals();
                    }
                }
            });

            linesBody.addEventListener('lookup:selected', function (event) {
                var row = event.target.closest('tr');
                if (!row) {
                    return;
                }
                var item = event.detail.item;
                if (item.code) {
                    var codeInput = row.querySelector('.stock-code-input');
                    if (codeInput) codeInput.value = item.code;
                }
                row.querySelector('.price-input').value = isSales ? item.unitPrice : item.purchaseUnitPrice;
                row.querySelector('.tax-input').value = item.taxRate;
                recalcTotals();
                var qtyInput = row.querySelector('.quantity-input');
                if (qtyInput) {
                    qtyInput.focus();
                    qtyInput.select();
                }
            });

            var rowFieldOrder = ['.stock-code-input', '.lookup-quicksearch', '.quantity-input', '.price-input', '.discount-input', '.tax-input', '.description-input'];

            linesBody.addEventListener('keydown', function (event) {
                if (event.key !== 'Enter') return;
                
                var dropdownOpen = document.querySelector('.lookup-quick-dropdown') && document.querySelector('.lookup-quick-dropdown').style.display === 'block';
                if (dropdownOpen) return;

                var fieldClass = rowFieldOrder.find(function (cls) { return event.target.classList.contains(cls.slice(1)); });
                if (!fieldClass) return;
                event.preventDefault();

                var row = event.target.closest('tr');
                var fieldIndex = rowFieldOrder.indexOf(fieldClass);

                if (fieldIndex < rowFieldOrder.length - 1) {
                    var nextField = row.querySelector(rowFieldOrder[fieldIndex + 1]);
                    if (nextField) {
                        nextField.focus();
                        if (typeof nextField.select === 'function') nextField.select();
                        return;
                    }
                }

                var allRows = Array.from(linesBody.querySelectorAll('.line-row'));
                var isLastRow = allRows[allRows.length - 1] === row;

                var targetRow;
                if (isLastRow) {
                    targetRow = addRow();
                    recalcTotals();
                } else {
                    targetRow = allRows[allRows.indexOf(row) + 1];
                }

                var firstInput = targetRow.querySelector('.stock-code-input') || targetRow.querySelector('.lookup-quicksearch');
                if (firstInput) {
                    firstInput.focus();
                    if (typeof firstInput.select === 'function') firstInput.select();
                }
            });

            function formatMoney(amount) {
                return Number(amount || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // Onaydan önce (taslak haldeyken) kullanıcı satırları girerken toplamları anında görsün diye;
            // sunucudaki (InvoiceTotalsCalculator) ile aynı formül burada da uygulanır. Tutar İskontosu,
            // KDV matrahını doğru düşürmek için satırlar arasında net tutar payına göre orantılı dağıtılır.
            function recalcTotals() {
                var rows = Array.from(linesBody.querySelectorAll('.line-row')).map(function (row) {
                    var qty = parseFloat(row.querySelector('.quantity-input').value) || 0;
                    var price = parseFloat(row.querySelector('.price-input').value) || 0;
                    var discRate = parseFloat(row.querySelector('.discount-input').value) || 0;
                    var taxRate = parseFloat(row.querySelector('.tax-input').value) || 0;

                    var netUnitPrice = pricesIncludeTax.checked && taxRate > 0
                        ? price / (1 + taxRate / 100)
                        : price;
                    var gross = qty * netUnitPrice;
                    var lineDiscAmount = gross * discRate / 100;
                    var netAfterLineDiscount = gross - lineDiscAmount;
                    return { row: row, gross: gross, lineDiscAmount: lineDiscAmount, netAfterLineDiscount: netAfterLineDiscount, taxRate: taxRate };
                });

                var netAfterLineDiscountTotal = rows.reduce(function (s, r) { return s + r.netAfterLineDiscount; }, 0);
                var rawAmountDiscount = parseFloat(document.getElementById('amount-discount-input').value) || 0;
                var amountDiscount = Math.min(Math.max(rawAmountDiscount, 0), Math.max(netAfterLineDiscountTotal, 0));

                var subtotal = 0, discountTotal = 0, grandTotal = 0, allocated = 0;
                var kdvByRate = {};
                rows.forEach(function (r, idx) {
                    var share = idx === rows.length - 1
                        ? (amountDiscount - allocated)
                        : (netAfterLineDiscountTotal > 0 ? amountDiscount * (r.netAfterLineDiscount / netAfterLineDiscountTotal) : 0);
                    allocated += share;

                    var totalDiscAmount = r.lineDiscAmount + share;
                    var net = r.gross - totalDiscAmount;
                    var taxAmount = net * r.taxRate / 100;

                    r.row.querySelector('.line-gross').textContent = formatMoney(r.gross);
                    r.row.querySelector('.line-net').textContent = formatMoney(net);

                    subtotal += r.gross;
                    discountTotal += totalDiscAmount;
                    grandTotal += net + taxAmount;
                    kdvByRate[r.taxRate] = (kdvByRate[r.taxRate] || 0) + taxAmount;
                });

                document.getElementById('totals-subtotal').textContent = formatMoney(subtotal);
                document.getElementById('totals-discount').textContent = formatMoney(discountTotal);
                document.getElementById('totals-grand').textContent = formatMoney(grandTotal);
                document.getElementById('totals-kdv-breakdown').innerHTML = Object.keys(kdvByRate).sort(function (a, b) { return a - b; }).map(function (rate) {
                    return '<div class="erp-totals-row"><span>KDV %' + rate + '</span><span>' + formatMoney(kdvByRate[rate]) + '</span></div>';
                }).join('');
            }

            document.getElementById('amount-discount-input').addEventListener('input', recalcTotals);
            pricesIncludeTax.addEventListener('change', recalcTotals);

            linesBody.addEventListener('input', recalcTotals);
            addButton.addEventListener('click', recalcTotals);
            linesBody.addEventListener('click', function (event) {
                if (event.target.classList.contains('remove-line')) {
                    recalcTotals();
                }
            });
            recalcTotals();

            // Planlı İşlem (F5): seçili cariye ait, onaylı irsaliyeleri çağırıp kalan satırlarını
            // fatura satır tablosuna aktarır — bkz. InvoicesController.EligibleDispatchNotes.
            // addRow/recalcTotals yukarıdaki kapanıştan (closure) aynen yeniden kullanılıyor.
            (function () {
                var plannedToggle = document.getElementById('planned-mode-toggle');
                var modalEl = document.getElementById('plannedConversionModal');
                var bodyEl = document.getElementById('planned-conversion-body');
                var confirmBtn = document.getElementById('planned-conversion-confirm');
                var customerHidden = document.getElementById('CustomerId');
                var bsModal = null;
                var loadedDispatches = [];

                function escapeHtml(s) {
                    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
                    });
                }

                function ensureModal() {
                    if (!bsModal && modalEl) bsModal = new bootstrap.Modal(modalEl);
                    return bsModal;
                }

                function renderPicker() {
                    if (loadedDispatches.length === 0) {
                        bodyEl.innerHTML = '<div class="text-center text-secondary py-3">Bu cari için onaylı, faturalanacak irsaliye bulunamadı.</div>';
                        return;
                    }
                    bodyEl.innerHTML = loadedDispatches.map(function (d, idx) {
                        var linesHtml = d.lines.map(function (l) {
                            return '<tr><td>' + escapeHtml(l.productDisplay) + '</td><td class="text-end">' +
                                Number(l.remainingQuantity).toLocaleString('tr-TR', { minimumFractionDigits: 3 }) + ' ' + escapeHtml(l.unitSnapshot) + '</td></tr>';
                        }).join('');
                        return '<div class="erp-panel mb-2">' +
                            '<div class="erp-panel-header d-flex align-items-center gap-2">' +
                            '<input type="checkbox" class="form-check-input dispatch-select" data-idx="' + idx + '" id="dispatch-select-' + idx + '" />' +
                            '<label for="dispatch-select-' + idx + '"><strong>' + escapeHtml(d.dispatchNumber) + '</strong> <small class="text-muted">' +
                            escapeHtml(d.dateUtc) + ' — ' + escapeHtml(d.warehouseDisplay) + '</small></label>' +
                            '</div>' +
                            '<table class="table table-sm mb-0"><tbody>' + linesHtml + '</tbody></table>' +
                            '</div>';
                    }).join('');
                }

                function openPicker() {
                    var customerId = customerHidden ? customerHidden.value : '';
                    if (!customerId) {
                        alert('Önce cari seçilmelidir.');
                        return;
                    }
                    bodyEl.innerHTML = '<div class="text-center text-secondary py-3">Yükleniyor...</div>';
                    ensureModal().show();
                    fetch('@Url.Action("EligibleDispatchNotes")?customerId=' + encodeURIComponent(customerId) + '&invoiceType=@Model.InvoiceType')
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            loadedDispatches = data.items || [];
                            renderPicker();
                        })
                        .catch(function () {
                            bodyEl.innerHTML = '<div class="text-center text-danger py-3">Yüklenirken hata oluştu.</div>';
                        });
                }

                confirmBtn.addEventListener('click', function () {
                    var checked = Array.from(bodyEl.querySelectorAll('.dispatch-select:checked'));
                    checked.forEach(function (cb) {
                        var dispatch = loadedDispatches[Number(cb.getAttribute('data-idx'))];
                        dispatch.lines.forEach(function (line) {
                            var row = addRow();
                            row.querySelector('.dispatch-line-id-input').value = line.dispatchNoteLineId;
                            var productHidden = row.querySelector('input[id$="__ProductId"]');
                            var productDisplay = row.querySelector('input[id$="__ProductId_display"]');
                            if (productHidden) productHidden.value = line.productId;
                            if (productDisplay) productDisplay.value = line.productDisplay;
                            var codeInput = row.querySelector('.stock-code-input');
                            if (codeInput && line.productDisplay && line.productDisplay.indexOf(' - ') !== -1) {
                                codeInput.value = line.productDisplay.split(' - ')[0];
                            }
                            row.querySelector('.quantity-input').value = line.remainingQuantity;
                            row.querySelector('.price-input').value = line.unitPrice;
                            row.querySelector('.discount-input').value = line.discountRate;
                            row.querySelector('.tax-input').value = line.taxRate;
                            row.querySelector('.source-cell').innerHTML = '<small class="text-muted">İrsaliye ' + escapeHtml(dispatch.dispatchNumber) + '</small>';
                        });
                        // Depo ilk seçilen irsaliyeden aktarılır (fatura tek bir depo taşır) — henüz
                        // seçilmemişse.
                        var warehouseHidden = document.getElementById('WarehouseId');
                        if (warehouseHidden && !warehouseHidden.value) {
                            warehouseHidden.value = dispatch.warehouseId;
                            var warehouseDisplay = document.getElementById('WarehouseId_display');
                            if (warehouseDisplay) warehouseDisplay.value = dispatch.warehouseDisplay;
                        }
                    });
                    recalcTotals();
                    if (bsModal) bsModal.hide();

                    // Ekranda uygulanacak sonucu açıkça göster: bu fatura İrsaliye→Fatura dönüşümüyle
                    // (kaynak satır bağlantısı taşıyan en az bir satırla) kaydedilecek, dolayısıyla
                    // DispatchToInvoice otomatik onay parametresi geçerli olacak.
                    var hintEl = document.getElementById('conversion-auto-approve-hint');
                    var willAutoApprove = @Json.Serialize((bool)(ViewBag.DispatchToInvoiceAutoApprove ?? false));
                    if (hintEl) {
                        hintEl.style.display = '';
                        hintEl.className = 'alert py-2 mb-3 ' + (willAutoApprove ? 'alert-success' : 'alert-secondary');
                        hintEl.textContent = 'Bu işlem sonucunda: ' + (willAutoApprove ? 'Kaydedilecek ve otomatik onaylanacak' : 'Taslak oluşturulacak');
                    }
                });

                document.addEventListener('keydown', function (event) {
                    if (event.key !== 'F5') return;
                    if (!plannedToggle || !plannedToggle.checked) return;
                    event.preventDefault();
                    openPicker();
                });
            })();
        })();
    </script>
}
