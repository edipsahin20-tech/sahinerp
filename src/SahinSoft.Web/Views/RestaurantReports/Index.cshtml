        <div class="rcard rkpi-compact"><span class="ico" style="background:#EAF3FF;color:#2563EB;">🛍</span><div><small>TOPLAM CİRO</small><strong>@xr.NetRevenue.ToString("N2") ₺</strong></div></div>
        <div class="rcard rkpi-compact"><span class="ico" style="background:#F1EEFF;color:#6D5AE0;">▥</span><div><small>TOPLAM FİŞ</small><strong>@xr.ReceiptCount</strong></div></div>
        <div class="rcard rkpi-compact"><span class="ico" style="background:#E8F6EE;color:#1F9D55;">₺</span><div><small>NAKİT</small><strong>@((xr.PaymentBreakdown.FirstOrDefault(x => x.Label == "Nakit")?.Amount ?? 0m).ToString("N2")) ₺</strong></div></div>
        <div class="rcard rkpi-compact"><span class="ico" style="background:#FFF3E0;color:#C77700;">▣</span><div><small>KREDİ KARTI</small><strong>@((xr.PaymentBreakdown.FirstOrDefault(x => x.Label == "Kredi Kartı")?.Amount ?? 0m).ToString("N2")) ₺</strong></div></div>
        <div class="rcard rkpi-compact"><span class="ico" style="background:#FDEDF0;color:#C22B57;">◔</span><div><small>AÇIK HESAP</small><strong>@((xr.PaymentBreakdown.FirstOrDefault(x => x.Label == "Açık Hesap")?.Amount ?? 0m).ToString("N2")) ₺</strong></div></div>
        <div class="rcard rkpi-compact"><span class="ico" style="background:#FFF3E0;color:#C77700;">🎁</span><div><small>İKRAM</small><strong>@xr.ComplimentaryTotal.ToString("N2") ₺</strong></div></div>
        <div class="rcard rkpi-compact"><span class="ico" style="background:#FDEDF0;color:#C22B57;">%</span><div><small>İNDİRİM</small><strong>@xr.DiscountTotal.ToString("N2") ₺</strong></div></div>
        <div class="rcard rkpi-compact"><span class="ico" style="background:#EAF3FF;color:#2563EB;">💳</span><div><small>DİĞER TAHSİLAT</small><strong>@(xr.PaymentBreakdown.Where(x => x.Label != "Nakit" && x.Label != "Kredi Kartı" && x.Label != "Açık Hesap" && x.Label != "Ödenmez").Sum(x => x.Amount).ToString("N2")) ₺</strong></div></div>
        <div class="rcard rkpi-compact"><span class="ico" style="background:#F1EEFF;color:#6D5AE0;">🍽</span><div><small>AKTİF MASA</small><strong>@xr.ActiveTableCount</strong></div></div>
        <div class="rcard rkpi-compact"><span class="ico" style="background:#E8F6EE;color:#1F9D55;">🛵</span><div><small>AKTİF PAKET</small><strong>@xr.ActivePackageCount</strong></div></div>
    </div>
