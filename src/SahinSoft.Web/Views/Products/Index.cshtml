@model IReadOnlyList<SahinSoft.Domain.Entities.Product>
@{
    ViewData["Title"] = "Stok Kartları";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Stok Kartları</h1>
        <p class="text-secondary mb-0">@Model.Count kayıt listeleniyor.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Yeni stok kartı</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<form method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex gap-2">
        <input name="search" value="@ViewBag.Search" class="form-control" autofocus
               placeholder="Stok kodu, ürün, marka veya barkod ara (barkod okutabilirsiniz)..." />
        <button class="btn btn-outline-primary">Ara</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Stok kodu</th>
                    <th>Ürün</th>
                    <th>Kategori</th>
                    <th>KDV</th>
                    <th class="text-end">Miktar</th>
                    <th class="text-end">Satış fiyatı</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.StockCode</td>
                    <td>
                        <div>@item.Name</div>
                        <small class="text-secondary">@item.Brand @item.Model</small>
                    </td>
                    <td>@item.Category.Name</td>
                    <td>@item.TaxRate.Name</td>
                    <td class="text-end">@item.StockQuantity.ToString("N3")</td>
                    <td class="text-end">@item.SalePrice.ToString("N2") ₺</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
