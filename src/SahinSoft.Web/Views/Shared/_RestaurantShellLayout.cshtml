@using SahinSoft.Web.Models
@{
    var shell = (RestaurantShellViewModel)ViewBag.Shell;
    string NavClass(string page) => shell.ActivePage == page ? "active" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — ŞahinSoft Restoran</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- erp.css SADECE .modal/.alert/.btn-erp-* gibi bileşen sınıfları için yükleniyor - restoran
         shell'inin kendi renk/layout dili (restaurant-shell.css, sonra yükleniyor) bunların
         üzerine yazıyor, ön muhasebenin sidebar/topbar kuralları burada hiç kullanılmıyor. -->
    <link rel="stylesheet" href="~/css/erp.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/restaurant-shell.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="rest-shell">
        <div class="rest-topbar">
            <div class="rest-brand">
                <img src="~/images/logo-icon.png" alt="ŞahinSoft" class="rest-logo" />
                <span class="rest-brand-text"><span class="l1">ŞahinSoft</span><span class="l2">Restoran</span></span>
            </div>
            <div class="rest-pill">📍 @shell.BranchName ▾</div>
            <div class="rest-spacer"></div>
            @if (shell.IsShiftOpen)
            {
                <div class="rest-pill green">🟢 Vardiya Açık @(shell.ShiftOpenedAtUtc.HasValue ? "· " + shell.ShiftOpenedAtUtc.Value.ToLocalTime().ToString("HH:mm") : "")</div>
            }
            else
            {
                <a href="@Url.Action("Index", "RestaurantShift")" class="rest-pill" style="color:#FF7A7A;">● Vardiya Kapalı</a>
            }
            <div class="rest-pill" id="rest-clock" style="font-weight:800;"></div>
            <a href="@Url.Action("Index", "RestaurantKitchen")" class="rest-pill" style="text-decoration:none; color:inherit;">
                🔔 <span style="background:#D94A4A;color:#fff;border-radius:99px;padding:2px 6px;">@shell.KitchenPendingCount</span>
            </a>
            <div class="rest-pill">👤 @shell.UserFullName</div>
            <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Login", "RestaurantAuth")">
                @Html.AntiForgeryToken()
                <button type="submit" class="rest-danger-btn">⏻ Programı Kapat</button>
            </form>
        </div>

        <aside class="rest-sidebar">
            <div class="rest-nav">
                <a class="@NavClass("dashboard")" href="@Url.Action("Index", "RestaurantDashboard")"><span>⌂</span><div><b>Dashboard</b><small>Günlük kontrol merkezi</small></div></a>
                @* Madde 26 (Ayarlar, 2026-09-05) - "Self Satış görünsün mü / Masa Satış görünsün mü /
                   Paket görünsün mü" - InventorySettings'teki 3 bayrak (bkz. RestaurantControllerBase.
                   BuildShellAsync). Kapalıysa modülün kendisi menüden TAMAMEN kalkar. *@
                @if (shell.ShowTableSaleNav)
                {
                    <a class="@NavClass("tables")" href="@Url.Action("Index", "Restaurant")"><span>▦</span><div><b>Masa Satış</b><small>Salon &amp; adisyon</small></div></a>
                }
                @if (shell.ShowPackageNav)
                {
                    <a class="@NavClass("package")" href="@Url.Action("Index", "RestaurantPackage")"><span>▣</span><div><b>Paket</b><small>Paket &amp; gel-al</small></div></a>
                }
                @if (shell.ShowSelfSaleNav)
                {
                    <a class="@NavClass("self")" href="@Url.Action("Index", "RestaurantSelfSale")"><span>◇</span><div><b>Self Satış</b><small>Hızlı satış</small></div></a>
                }
                <a class="@NavClass("reports")" href="@Url.Action("Index", "RestaurantReports")"><span>▥</span><div><b>Raporlar</b><small>Ciro &amp; vardiya</small></div></a>

                <!-- Ayarlar/Mutfak/Vardiya artık ayrı bir alt ızgara DEĞİL, ANA listenin devamı
                     (Edip, 2026-09-05, onaylı görsel: "butun butonlar ... konumları herşey").
                     Bölümden Çık, eskiden bu üçünün ÜSTÜNDEYDİ - görselde EN ALTTA, bu üçünden
                     SONRA geliyor, sırası buna göre değişti. -->
                <div class="rest-nav-divider"></div>
                @if (User.IsInRole(SahinSoft.Domain.Constants.AppRoles.Administrator) || User.IsInRole(SahinSoft.Domain.Constants.AppRoles.RestaurantManager))
                {
                    <a class="rest-nav-simple" href="@Url.Action("Index", "RestaurantSettings")"><span>⚙</span><div><b>Ayarlar</b></div></a>
                }
                <a class="rest-nav-simple" href="@Url.Action("Index", "RestaurantKitchen")"><span>♨</span><div><b>Mutfak</b></div></a>
                <a class="rest-nav-simple" href="@Url.Action("Index", "RestaurantShift")"><span>▤</span><div><b>Vardiya</b></div></a>
                <a class="exit" href="@Url.Action("Index", "RestaurantDashboard")"><span>↪</span><div><b>Bölümden Çık</b><small>Dashboard'a geri dön</small></div></a>
            </div>
        </aside>

        <!-- ViewData["MainFixed"] opsiyonel - sayfa kendi üst kısmını (toolbar/özet/sekmeler)
             sabit tutup yalnızca ALT içeriği kendi içinde kaydırmak isterse (Edip, 2026-09-04:
             "raporlar kısmı tam otursun sadece alt taraf ... kaysın") kullanılır; başka sayfa
             bunu ayarlamazsa .rest-main eskisi gibi TEK BÜTÜN olarak kayar - davranış değişmez.
             ViewData["MainNoRightPad"] (2026-09-05, Edip: "sağ raftaki boşluğu sil biraz daha
             sağa kaydır") - Check.cshtml'deki sağ sabit ikon şeridi .rest-main'in standart 22px
             sağ dolgusu yüzünden pencere kenarından ayrık duruyordu; SADECE bu sayfa için kaldırır,
             diğer restoran sayfalarının dolgusuna dokunmaz. -->
        <main class="rest-main @(ViewData["MainFixed"] as bool? == true ? "rest-main-fixed" : "") @(ViewData["MainNoRightPad"] as bool? == true ? "rest-main-no-right-pad" : "")">
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger py-2">@error</div>
            }
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success py-2">@success</div>
            }
            @RenderBody()
        </main>

        <div class="rest-statusbar">
            <span>▣ Aktif Masa <b>@shell.ActiveTableCount/@shell.TotalTableCount</b></span>
            <span>▥ Açık Adisyon <b>@shell.OpenCheckTotal.ToString("N2") ₺</b></span>
            <span class="rest-spacer"></span>
            <span>● Çevrimiçi</span>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function updateRestClock() {
            var el = document.getElementById('rest-clock');
            if (!el) return;
            var now = new Date();
            el.textContent = '◷ ' + String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
        }
        updateRestClock();
        setInterval(updateRestClock, 15000);
    </script>
    <!-- Cari Ekle (madde 13) gibi cari/ürün arama ihtiyaçları için ana ERP'nin lookup-picker
         altyapısı - restoran kabuğunda daha önce hiç kullanılmıyordu, ilk kez burada ekleniyor. -->
    <partial name="_LookupModal" />
    <script src="~/js/lookup-picker.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
