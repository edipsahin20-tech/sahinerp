@model IReadOnlyList<SahinSoft.Domain.Entities.Product>
@{
    ViewData["Title"] = "Stok Kartları";
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}

<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-box"></i> Stok Kartları</h2>
        <a asp-action="Create" class="btn-erp-list-new">+ Yeni Stok Kartı</a>
    </div>
    <div class="erp-list-body">
        <div class="erp-list-topbar">
            <div class="erp-list-topbar-left">
                <div class="erp-list-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" class="form-control" autocomplete="off" autofocus placeholder="Stok kodu, ürün, marka veya barkod ara (barkod okutabilirsiniz)..." data-live-search="#productsTable">
                </div>
            </div>
            <span class="text-secondary">Toplam <strong>@Model.Count</strong> kayıt.</span>
        </div>

        <div class="erp-table-wrap">
            <table class="erp-table" id="productsTable">
                <thead>
                    <tr>
                        <th>Stok Kodu</th>
                        <th>Ürün</th>
                        <th>Kategori</th>
                        <th>KDV</th>
                        <th class="text-end">Miktar</th>
                        <th class="text-end">Satış Fiyatı</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="erp-code-badge">@item.StockCode</span></td>
                        <td>
                            <div class="fw-semibold">@item.Name</div>
                            <small class="text-secondary">@item.Brand @item.Model</small>
                        </td>
                        <td>@item.Category.Name</td>
                        <td>@item.TaxRate.Name</td>
                        <td class="text-end">
                            @if (item.StockQuantity <= 0)
                            {
                                <span class="erp-status-pill red">Stokta Yok</span>
                            }
                            else
                            {
                                @item.StockQuantity.ToString("N3")
                            }
                        </td>
                        <td class="text-end fw-semibold">@item.SalePrice.ToString("N2") ₺</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-erp-list-action">Düzenle</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
