@model SahinSoft.Web.Models.RestaurantFloorViewModel
@{
    Layout = "_RestaurantShellLayout";
    ViewData["Title"] = "Masa Satış";
    var allTables = Model.Sections.SelectMany(s => s.Tables).ToList();
    var occupiedCount = allTables.Count(t => t.IsOccupied);
    var totalGuestCount = allTables.Where(t => t.IsOccupied).Sum(t => t.GuestCount ?? 0);

    // Süre "kalan dakika" değil, masanın AÇIK KALDIĞI SÜRE (Edip, 2026-09-27: referans tasarımda
    // saat değil "32 dk"/"1 sa 12 dk" gibi geçen süre gösteriliyor) - server-render anında hesaplanır.
    static string FormatElapsed(DateTime? openedAtUtc)
    {
        if (!openedAtUtc.HasValue) { return "-"; }
        var elapsed = DateTime.UtcNow - openedAtUtc.Value;
        if (elapsed.TotalMinutes < 0) { elapsed = TimeSpan.Zero; }
        var totalMinutes = (int)elapsed.TotalMinutes;
        return totalMinutes >= 60 ? $"{totalMinutes / 60} sa {totalMinutes % 60} dk" : $"{totalMinutes} dk";
    }

    // Bölüm başlık şeridi renkleri (Edip'in referans görselindeki gibi her salon farklı pastel
    // tonda) - RestaurantSection'da bir Color alanı YOK, yeni bir alan/özellik İCAT EDİLMEDİ,
    // sadece görünüm için sabit bir palet sırayla döndürülüyor.
    string[] sectionPalette = ["blue", "orange", "green", "purple"];
}

@section Head {
    <link rel="stylesheet" href="~/css/restaurant-pos.css" asp-append-version="true" />
}

<div class="ms-toolbar">
    <div>
        <div class="ms-h1">Masa Satış</div>
        <div class="ms-sub">Açık masaları yönetin, masa taşıyın, birleştirin ve siparişleri hızlıca oluşturun.</div>
    </div>
    <div class="ms-toolbar-actions">
        <button type="button" class="ms-action-btn orange" id="move-table-btn" disabled>⇄ Masa Taşı</button>
        <button type="button" class="ms-action-btn purple" id="merge-table-btn" disabled>⇄ Masa Birleştir</button>
        <div class="ms-stat-card">
            <span class="ms-stat-icon green">▤</span>
            <div><strong>@occupiedCount</strong><small>Açık Masa</small></div>
        </div>
        <div class="ms-stat-card">
            <span class="ms-stat-icon blue">👤</span>
            <div><strong>@totalGuestCount</strong><small>Toplam Kişi</small></div>
        </div>
    </div>
</div>

<div class="restaurant-pos">
    @if (Model.Sections.Count > 1)
    {
        <div class="ms-salon-tabs" id="sectionTabs">
            <button type="button" class="ms-salon-tab active" data-section-filter="all">Tümü <span>@allTables.Count</span></button>
            @foreach (var floorSection in Model.Sections)
            {
                <button type="button" class="ms-salon-tab" data-section-filter="@floorSection.Name">@floorSection.Name <span>@floorSection.Tables.Count</span></button>
            }
        </div>
    }

    @for (var sectionIndex = 0; sectionIndex < Model.Sections.Count; sectionIndex++)
    {
        var floorSection = Model.Sections[sectionIndex];
        var paletteColor = sectionPalette[sectionIndex % sectionPalette.Length];
        <div class="floor-section" data-section-id="@floorSection.Name">
            <div class="ms-section-header @paletteColor">@floorSection.Name <span>@floorSection.Tables.Count</span></div>
            <div class="floor-grid">
                @foreach (var table in floorSection.Tables)
                {
                    if (table.IsOccupied)
                    {
                        <div class="table-tile-wrap">
                            <button type="button" class="table-tile @(table.BillRequested ? "bill-requested" : "occupied")" data-open-check="@table.CheckId"
                                    data-select-table="@table.TableId" data-session-id="@table.SessionId" data-table-name="@table.Name">
                                <span class="ms-tile-num">@table.Name</span>
                                <span class="ms-tile-row">👤 @table.GuestCount</span>
                                <span class="ms-tile-row">🕐 @FormatElapsed(table.OpenedAtUtc)</span>
                                <span class="ms-tile-amt">@table.RunningTotal.ToString("N0") ₺</span>
                            </button>
                        </div>
                    }
                    else if (table.IsReserved)
                    {
                        <div class="table-tile-wrap">
                            <button type="button" class="table-tile reserved" data-open-table="@table.TableId" data-table-name="@table.Name"
                                    data-capacity="@(table.ReservationGuestCount ?? table.Capacity)"
                                    data-select-table="@table.TableId" data-session-id="">
                                <span class="ms-tile-num">@table.Name</span>
                                <span class="ms-tile-row">👤 @table.ReservationGuestCount</span>
                                <span class="ms-tile-row">🕐 @(table.ReservedForUtc.HasValue ? table.ReservedForUtc.Value.ToLocalTime().ToString("HH:mm") : "-")</span>
                                <span class="ms-tile-tag">REZERVE@(string.IsNullOrWhiteSpace(table.ReservationNote) ? "" : " · " + table.ReservationNote)</span>
                            </button>
                            <form method="post" asp-action="CancelReservation" class="table-cancel-reservation"
                                  data-confirm-cancel-reservation="@table.Name">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="reservationId" value="@table.ReservationId" />
                                <button type="submit" title="Rezervasyonu İptal Et">✕</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="table-tile-wrap">
                            <button type="button" class="table-tile" data-open-table="@table.TableId" data-table-name="@table.Name" data-capacity="@table.Capacity"
                                    data-select-table="@table.TableId" data-session-id="">
                                <span class="ms-tile-num">@table.Name</span>
                                <span class="ms-tile-row">👤 -</span>
                                <span class="ms-tile-row">🕐 -</span>
                            </button>
                            <button type="button" class="table-reserve-btn" data-reserve-table="@table.TableId" data-table-name="@table.Name" title="Rezerve Et">▤</button>
                        </div>
                    }
                }
                @if (floorSection.Tables.Count == 0)
                {
                    <span class="text-secondary">Bu salonda masa tanımlı değil.</span>
                }
            </div>
        </div>
    }

    @if (Model.Sections.Count == 0)
    {
        <div class="erp-panel"><div class="erp-panel-body">Henüz salon/masa tanımlanmamış. <a asp-controller="RestaurantSections" asp-action="Create">Salon ekle</a></div></div>
    }

    <!-- Durum lejantı (Edip'in referans tasarımındaki gibi) - status-badge renkleriyle AYNI. -->
    <div class="floor-legend">
        <span><i class="dot empty"></i>BOŞ</span>
        <span><i class="dot busy"></i>DOLU</span>
        <span><i class="dot bill"></i>HESAP İSTENDİ</span>
        <span><i class="dot res"></i>REZERVE</span>
    </div>
</div>

<!-- Masa açma modalı - dokunmatik numpad ile kişi sayısı (2026-09-05 teknik doküman madde 13).
     Bu modal SADECE "Masa açılışında kişi sayısı sorulsun mu?" (Ayarlar) açıkken tetiklenir -
     kapalıysa masa doğrudan varsayılan kapasiteyle açılır (bkz. aşağıdaki JS). Açık bir masaya
     tekrar girildiğinde bu modal zaten hiç tetiklenmez (data-open-check farklı bir akış). -->
<div class="modal fade" id="openTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="OpenTable">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tableId" id="openTableId" />
                <input type="hidden" name="submissionKey" id="openTableSubmissionKey" />
                <input type="hidden" name="guestCount" id="openTableGuestCount" value="2" />
                <div class="modal-header">
                    <h5 class="modal-title">Masa Aç — <span id="openTableName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label d-block text-center">Kişi Sayısı</label>
                    <div class="text-center" style="font-size:2rem; font-weight:800; margin:6px 0 14px;" id="openTableGuestCountDisplay">2</div>
                    <div class="pin-pad" id="guestCountNumpad" style="display:grid; grid-template-columns:repeat(3,1fr); gap:8px; max-width:280px; margin:0 auto;">
                        <button type="button" class="btn btn-erp-outline" data-guest-digit="1">1</button>
                        <button type="button" class="btn btn-erp-outline" data-guest-digit="2">2</button>
                        <button type="button" class="btn btn-erp-outline" data-guest-digit="3">3</button>
                        <button type="button" class="btn btn-erp-outline" data-guest-digit="4">4</button>
                        <button type="button" class="btn btn-erp-outline" data-guest-digit="5">5</button>
                        <button type="button" class="btn btn-erp-outline" data-guest-digit="6">6</button>
                        <button type="button" class="btn btn-erp-outline" data-guest-digit="7">7</button>
                        <button type="button" class="btn btn-erp-outline" data-guest-digit="8">8</button>
                        <button type="button" class="btn btn-erp-outline" data-guest-digit="9">9</button>
                        <button type="button" class="btn btn-erp-outline" id="guestCountClear">C</button>
                        <button type="button" class="btn btn-erp-outline" data-guest-digit="0">0</button>
                        <button type="button" class="btn btn-erp-outline" id="guestCountBackspace">⌫</button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-erp-primary">Masayı Aç</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Masa taşıma modalı -->
<div class="modal fade" id="moveTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="MoveTable">
                @Html.AntiForgeryToken()
                <input type="hidden" name="sessionId" id="moveSessionId" />
                <div class="modal-header">
                    <h5 class="modal-title">Masa Taşı — <span id="moveFromName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Hedef Masa (boş)</label>
                    <select name="toTableId" id="moveToTableId" class="form-select" required>
                        <option value="">Seçiniz...</option>
                        @foreach (var table in allTables.Where(t => !t.IsOccupied))
                        {
                            <option value="@table.TableId">@table.Name</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-erp-primary">Taşı</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Masa birleştirme modalı -->
<div class="modal fade" id="mergeTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="MergeTables">
                @Html.AntiForgeryToken()
                <input type="hidden" name="fromSessionId" id="mergeFromSessionId" />
                <div class="modal-header">
                    <h5 class="modal-title">Masaları Birleştir — <span id="mergeFromName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary small">Seçilen masadaki siparişler, aşağıda seçeceğiniz dolu masanın adisyonuna taşınır.</p>
                    <label class="form-label">Hedef Masa (dolu)</label>
                    <select name="intoSessionId" id="mergeIntoSessionId" class="form-select" required>
                        <option value="">Seçiniz...</option>
                        @foreach (var table in allTables.Where(t => t.IsOccupied))
                        {
                            <option value="@table.SessionId" data-table-id="@table.TableId">@table.Name</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-erp-primary">Birleştir</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Masa rezervasyon modalı -->
<div class="modal fade" id="reserveTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="Reserve">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tableId" id="reserveTableId" />
                <div class="modal-header">
                    <h5 class="modal-title">Masa Rezerve Et — <span id="reserveTableName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Saat</label>
                        <input type="datetime-local" name="reservedForLocal" id="reserveDateTime" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Kişi Sayısı</label>
                        <input type="number" name="guestCount" class="form-control" min="1" value="2" required />
                    </div>
                    <div class="mb-1">
                        <label class="form-label">Not (opsiyonel)</label>
                        <input type="text" name="note" class="form-control" maxlength="300" placeholder="Örn: Doğum günü" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-erp-outline" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-erp-primary">Rezerve Et</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ŞahinSoft masaüstü-hissi onay penceresi (bkz. pos-dialog.js) - Check.cshtml'deki AYNI
     mekanizma, bu ekranda da tarayıcının native confirm()'üne dönülmesin diye. -->
<div class="modal fade" id="posDialogModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ŞahinSoft Restoran</h5>
            </div>
            <div class="modal-body">
                <div id="posDialogMessage" style="white-space:pre-line;"></div>
                <input type="text" id="posDialogInput" class="form-control mt-2" style="display:none;" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-erp-outline" id="posDialogCancelBtn">Vazgeç</button>
                <button type="button" class="btn btn-erp-primary" id="posDialogOkBtn">Tamam</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pos-dialog.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('[data-confirm-cancel-reservation]').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                if (form.dataset.confirmed === 'true') return;
                e.preventDefault();
                var tableName = form.getAttribute('data-confirm-cancel-reservation');
                window.posConfirm('"' + tableName + '" rezervasyonu iptal edilsin mi?', function () {
                    form.dataset.confirmed = 'true';
                    form.submit();
                }, null, { danger: true });
            });
        });

        var sectionTabs = document.getElementById('sectionTabs');
        if (sectionTabs) {
            sectionTabs.querySelectorAll('[data-section-filter]').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    sectionTabs.querySelectorAll('.rtab').forEach(function (t) { t.classList.remove('active'); });
                    tab.classList.add('active');
                    var filter = tab.getAttribute('data-section-filter');
                    document.querySelectorAll('.floor-section').forEach(function (section) {
                        var show = filter === 'all' || section.getAttribute('data-section-id') === filter;
                        section.style.display = show ? '' : 'none';
                    });
                });
            });
        }

        document.querySelectorAll('[data-reserve-table]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('reserveTableId').value = btn.getAttribute('data-reserve-table');
                document.getElementById('reserveTableName').textContent = btn.getAttribute('data-table-name');
                // Varsayılan: bir sonraki saat başı (Edip'in eliyle saat girmesini kolaylaştırmak için).
                var d = new Date();
                d.setMinutes(0, 0, 0);
                d.setHours(d.getHours() + 1);
                var pad = function (n) { return String(n).padStart(2, '0'); };
                document.getElementById('reserveDateTime').value = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':00';
                new bootstrap.Modal(document.getElementById('reserveTableModal')).show();
            });
        });

        var selectedTableId = null;
        var selectedSessionId = null;

        document.querySelectorAll('[data-select-table]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.table-tile').forEach(function (t) { t.style.outline = ''; });
                selectedTableId = btn.getAttribute('data-select-table');
                selectedSessionId = btn.getAttribute('data-session-id') || null;
                btn.style.outline = '2px solid var(--pos-navy, #0B2239)';
                document.getElementById('move-table-btn').disabled = !selectedSessionId;
                document.getElementById('merge-table-btn').disabled = !selectedSessionId;
            });
        });

        // Masa açılışında kişi sayısı sorulsun mu (2026-09-05 teknik doküman madde 13, Ayarlar
        // parametresi) - kapalıysa modal hiç gösterilmeden masa doğrudan varsayılan kapasiteyle
        // açılır. Açık bir masaya tekrar girmek zaten AYRI bir akış (data-open-check) - buraya hiç
        // uğramaz, bu yüzden "açık masaya tekrar girildiğinde sorulmayacak" otomatik sağlanır.
        var askGuestCount = @Json.Serialize(Model.AskGuestCountOnTableOpen);
        var openTableForm = document.getElementById('openTableModal').querySelector('form');

        var guestCountDigits = '2';
        function renderGuestCount() {
            document.getElementById('openTableGuestCountDisplay').textContent = guestCountDigits === '' ? '0' : guestCountDigits;
            document.getElementById('openTableGuestCount').value = guestCountDigits === '' ? '1' : guestCountDigits;
        }
        document.querySelectorAll('[data-guest-digit]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (guestCountDigits.length >= 3) return;
                guestCountDigits = (guestCountDigits === '0' ? '' : guestCountDigits) + btn.getAttribute('data-guest-digit');
                renderGuestCount();
            });
        });
        document.getElementById('guestCountBackspace').addEventListener('click', function () {
            guestCountDigits = guestCountDigits.slice(0, -1);
            renderGuestCount();
        });
        document.getElementById('guestCountClear').addEventListener('click', function () {
            guestCountDigits = '';
            renderGuestCount();
        });

        document.querySelectorAll('[data-open-table]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var capacity = Math.min(2, parseInt(btn.getAttribute('data-capacity'), 10) || 2);
                document.getElementById('openTableId').value = btn.getAttribute('data-open-table');
                document.getElementById('openTableName').textContent = btn.getAttribute('data-table-name');
                document.getElementById('openTableSubmissionKey').value = (crypto.randomUUID ? crypto.randomUUID() : (Date.now() + '-' + Math.random()));

                if (!askGuestCount) {
                    document.getElementById('openTableGuestCount').value = capacity;
                    openTableForm.submit();
                    return;
                }

                guestCountDigits = String(capacity);
                renderGuestCount();
                new bootstrap.Modal(document.getElementById('openTableModal')).show();
            });
        });
        document.querySelectorAll('[data-open-check]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                window.location.href = '@Url.Action("Check")?id=' + btn.getAttribute('data-open-check');
            });
        });

        document.getElementById('move-table-btn').addEventListener('click', function () {
            if (!selectedSessionId) { return; }
            document.getElementById('moveSessionId').value = selectedSessionId;
            document.getElementById('moveFromName').textContent = document.querySelector('[data-select-table="' + selectedTableId + '"] .table-name').textContent;
            new bootstrap.Modal(document.getElementById('moveTableModal')).show();
        });

        document.getElementById('merge-table-btn').addEventListener('click', function () {
            if (!selectedSessionId) { return; }
            document.getElementById('mergeFromSessionId').value = selectedSessionId;
            document.getElementById('mergeFromName').textContent = document.querySelector('[data-select-table="' + selectedTableId + '"] .table-name').textContent;
            // Hedef listeden kendi masasını çıkar - bir masa kendisiyle birleştirilemez.
            var select = document.getElementById('mergeIntoSessionId');
            Array.from(select.options).forEach(function (opt) {
                opt.hidden = opt.getAttribute('data-table-id') === selectedTableId;
            });
            new bootstrap.Modal(document.getElementById('mergeTableModal')).show();
        });
    </script>
}
