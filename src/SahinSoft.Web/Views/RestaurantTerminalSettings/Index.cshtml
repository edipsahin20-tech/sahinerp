@model SahinSoft.Web.Models.RestaurantTerminalSettingsViewModel
@using SahinSoft.Domain.Enums
@{
    Layout = null;
    ViewData["Title"] = "Terminal Ayarları";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Terminal Ayarları — ŞahinSoft Restoran</title>
    <style>
        :root {
            --ts-navy: #0B1524;
            --ts-navy2: #0F2033;
            --ts-gold: #E2A400;
            --ts-gold-light: #F2B813;
            --ts-bg: #F4F7FB;
            --ts-surface: #FFFFFF;
            --ts-border: #E3E8EF;
            --ts-text: #132238;
            --ts-text-2: #6F7F92;
            --ts-danger: #D94A4A;
            --ts-ok: #1F9D55;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: Inter, "Segoe UI", system-ui, sans-serif; background: var(--ts-bg); color: var(--ts-text); }
        .ts-topbar { background: linear-gradient(90deg, var(--ts-navy), var(--ts-navy2)); color: #fff; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; }
        .ts-topbar h1 { font-size: 17px; margin: 0; }
        .ts-topbar .sub { font-size: 12px; color: #9FB0C4; margin-top: 2px; }
        .ts-back { color: var(--ts-gold-light); text-decoration: none; font-weight: 700; font-size: 13px; border: 1px solid rgba(226,164,0,.4); padding: 8px 14px; border-radius: 10px; }
        .ts-back:hover { background: rgba(226,164,0,.1); }
        .ts-body { max-width: 900px; margin: 0 auto; padding: 24px; }
        .ts-flash { border-radius: 10px; padding: 10px 14px; margin-bottom: 16px; font-size: 13.5px; font-weight: 600; }
        .ts-flash.ok { background: #E8F6EE; color: var(--ts-ok); }
        .ts-flash.err { background: #FDEDF0; color: var(--ts-danger); }
        .ts-card { background: var(--ts-surface); border: 1px solid var(--ts-border); border-radius: 16px; padding: 20px 22px; margin-bottom: 20px; box-shadow: 0 6px 18px rgba(15,35,55,.05); }
        .ts-card h2 { font-size: 15px; margin: 0 0 4px; display: flex; align-items: center; gap: 8px; }
        .ts-card .ts-card-sub { font-size: 12.5px; color: var(--ts-text-2); margin: 0 0 16px; }
        .ts-field { margin-bottom: 12px; }
        .ts-field label { display: block; font-size: 12px; font-weight: 700; color: var(--ts-text-2); margin-bottom: 4px; }
        .ts-field input, .ts-field select { width: 100%; padding: 10px 12px; border: 1px solid var(--ts-border); border-radius: 9px; font-size: 13.5px; font-family: inherit; }
        .ts-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .ts-grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
        .ts-btn { padding: 10px 18px; border: 0; border-radius: 10px; background: linear-gradient(90deg,#f0cf73,#e9bd46); font-weight: 800; cursor: pointer; font-size: 13.5px; }
        .ts-btn.outline { background: #fff; border: 1px solid var(--ts-border); color: var(--ts-text); }
        .ts-btn.danger { background: #FDEDF0; color: var(--ts-danger); }
        .ts-register-row { display: grid; grid-template-columns: 1.2fr 1fr 1fr 1fr auto; gap: 10px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--ts-border); font-size: 13px; }
        .ts-register-row:last-child { border-bottom: none; }
        .ts-register-head { font-weight: 800; color: var(--ts-text-2); font-size: 11px; text-transform: uppercase; }
        .ts-empty { color: var(--ts-text-2); font-size: 13px; padding: 10px 0; }
        .ts-branch-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
        .ts-branch-tab { padding: 8px 14px; border-radius: 999px; border: 1px solid var(--ts-border); background: #fff; font-size: 12.5px; font-weight: 700; cursor: pointer; }
        .ts-branch-tab.active { background: var(--ts-navy); color: #fff; border-color: var(--ts-navy); }
        .ts-branch-panel { display: none; }
        .ts-branch-panel.active { display: block; }
    </style>
</head>
<body>
    <div class="ts-topbar">
        <div>
            <h1>⚙ Terminal Ayarları</h1>
            <div class="sub">Şube, kasa ve yazar kasa ayarları — bu terminale özel</div>
        </div>
        <a class="ts-back" href="@Url.Action("Login", "RestaurantAuth")">← Giriş Ekranına Dön</a>
    </div>
    <div class="ts-body">
        @if (TempData["Success"] is string ok)
        {
            <div class="ts-flash ok">✓ @ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="ts-flash err">⚠ @err</div>
        }

        <!-- Şube Ayarları -->
        <div class="ts-card">
            <h2>📍 Şube Ayarları</h2>
            <p class="ts-card-sub">Bu terminalin bağlı olduğu şube(ler)in ad/adres/telefon bilgileri.</p>
            @if (Model.Branches.Count == 0)
            {
                <div class="ts-empty">Henüz şube tanımlı değil.</div>
            }
            else
            {
                <div class="ts-branch-tabs">
                    @for (var i = 0; i < Model.Branches.Count; i++)
                    {
                        <button type="button" class="ts-branch-tab @(i == 0 ? "active" : "")" data-branch-tab="@Model.Branches[i].Id">@Model.Branches[i].Name</button>
                    }
                </div>
                @for (var i = 0; i < Model.Branches.Count; i++)
                {
                    var b = Model.Branches[i];
                    <form method="post" asp-action="SaveBranch" class="ts-branch-panel @(i == 0 ? "active" : "")" data-branch-panel="@b.Id">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@b.Id" />
                        <div class="ts-grid2">
                            <div class="ts-field"><label>Şube Adı</label><input name="name" value="@b.Name" required /></div>
                            <div class="ts-field"><label>Telefon</label><input name="phone" value="@b.Phone" /></div>
                        </div>
                        <div class="ts-field"><label>Adres</label><input name="address" value="@b.Address" /></div>
                        <button type="submit" class="ts-btn">Şube Bilgilerini Kaydet</button>
                    </form>
                }
            }
        </div>

        <!-- Kasa Ayarları -->
        <div class="ts-card">
            <h2>🧾 Kasa Ayarları</h2>
            <p class="ts-card-sub">Kasa numarası ve her kasanın hangi Nakit/Kredi Kartı hesabına bağlı olduğu.</p>
            @if (Model.CashRegisters.Count > 0)
            {
                <div class="ts-register-row ts-register-head">
                    <span>Kasa Numarası</span><span>Şube</span><span>Nakit Hesabı</span><span>Kredi Kartı Hesabı</span><span></span>
                </div>
                @foreach (var r in Model.CashRegisters)
                {
                    <div class="ts-register-row">
                        <span>@r.Name</span>
                        <span>@r.Branch.Name</span>
                        <span>@r.CashFinancialAccount.Name</span>
                        <span>@r.CreditCardFinancialAccount.Name</span>
                        <form method="post" asp-action="DeactivateCashRegister" onsubmit="return confirm('Bu kasa pasif yapılsın mı?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="ts-btn danger" style="padding:6px 10px;">Pasif Yap</button>
                        </form>
                    </div>
                }
            }
            else
            {
                <div class="ts-empty">Henüz kasa tanımı yok.</div>
            }
            <h3 style="font-size:13px;margin:18px 0 10px;">Yeni Kasa Ekle / Güncelle</h3>
            <form method="post" asp-action="SaveCashRegister">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="0" />
                <div class="ts-grid3">
                    <div class="ts-field">
                        <label>Kasa Numarası / Adı</label>
                        <input name="name" placeholder="Kasa 1" required />
                    </div>
                    <div class="ts-field">
                        <label>Şube</label>
                        <select name="branchId" required>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div></div>
                    <div class="ts-field">
                        <label>Nakit Kasası (Hesap)</label>
                        <select name="cashFinancialAccountId" required>
                            @foreach (var a in Model.FinancialAccounts)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>
                    <div class="ts-field">
                        <label>Kredi Kartı Kasası (Hesap)</label>
                        <select name="creditCardFinancialAccountId" required>
                            @foreach (var a in Model.FinancialAccounts)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>
                    <div class="ts-field">
                        <label>Yemek Kartı Hesabı (opsiyonel)</label>
                        <select name="mealCardFinancialAccountId">
                            <option value="">— Kredi kartı hesabı kullanılsın —</option>
                            @foreach (var a in Model.FinancialAccounts)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <button type="submit" class="ts-btn">Kasayı Kaydet</button>
            </form>
        </div>

        <!-- Yazar Kasa Ayarları -->
        <div class="ts-card">
            <h2>🖨 Yazar Kasa Ayarları</h2>
            <p class="ts-card-sub">Fiskal cihaz (yazar kasa) bağlantısı — kapalıyken satışlar cihaza hiç gönderilmez.</p>
            <form method="post" asp-action="SaveFiscal">
                @Html.AntiForgeryToken()
                <div class="ts-grid2">
                    <div class="ts-field">
                        <label>Cihaz</label>
                        <select name="fiscalDeviceType" id="fiscal-device-select">
                            @foreach (FiscalDeviceType t in Enum.GetValues<FiscalDeviceType>())
                            {
                                <option value="@t" selected="@(t == Model.FiscalDeviceType)">@(t == FiscalDeviceType.None ? "Yok" : "İnpos M530")</option>
                            }
                        </select>
                    </div>
                    <div class="ts-field">
                        <label>Yazar Kasa Ajan Adresi (URL)</label>
                        <input name="fiscalAgentUrl" id="fiscal-url-input" value="@Model.FiscalAgentUrl" placeholder="http://localhost:9200" @(Model.FiscalDeviceType == FiscalDeviceType.None ? "disabled" : "") />
                    </div>
                </div>
                <button type="submit" class="ts-btn">Yazar Kasa Ayarlarını Kaydet</button>
            </form>
        </div>
    </div>
    <script>
        document.querySelectorAll('[data-branch-tab]').forEach(function (tab) {
            tab.addEventListener('click', function () {
                document.querySelectorAll('[data-branch-tab]').forEach(function (t) { t.classList.remove('active'); });
                document.querySelectorAll('[data-branch-panel]').forEach(function (p) { p.classList.remove('active'); });
                tab.classList.add('active');
                document.querySelector('[data-branch-panel="' + tab.getAttribute('data-branch-tab') + '"]').classList.add('active');
            });
        });
        var fiscalSelect = document.getElementById('fiscal-device-select');
        var fiscalUrlInput = document.getElementById('fiscal-url-input');
        if (fiscalSelect && fiscalUrlInput) {
            fiscalSelect.addEventListener('change', function () {
                fiscalUrlInput.disabled = fiscalSelect.value === 'None';
            });
        }
    </script>
</body>
</html>
