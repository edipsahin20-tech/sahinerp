@model SahinSoft.Web.Models.RestaurantPinLoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
    Layout = null;

    // Giriş ekranı arka planı - Edip'in kendi PIN klasörüne (wwwroot/uploads/branding) attığı
    // dosya varsa o kullanılır, yoksa paketle gelen varsayılana (images/login-hero.jpg) düşülür.
    // "uploads/" klasörü .gitignore'da zaten hariç tutulan ve dotnet publish çıktısının HİÇ
    // parçası olmayan tek klasör (bkz. ProductsController'daki AYNI desen, "uploads/products") -
    // bu yüzden Kurulum.ps1'in Expand-Archive -Force ile üzerine yazdığı her güncellemede
    // korunur, YENİDEN KOD DEĞİŞİKLİĞİ/DERLEME GEREKMEDEN buraya bırakılan görsel kalıcı olur.
    var brandingDir = System.IO.Path.Combine(WebHostEnvironment.WebRootPath, "uploads", "branding");
    var customBackgroundUrl = (string?)null;
    foreach (var ext in new[] { "jpg", "jpeg", "png", "webp" })
    {
        if (System.IO.File.Exists(System.IO.Path.Combine(brandingDir, "giris-arkaplan." + ext)))
        {
            customBackgroundUrl = Url.Content("~/uploads/branding/giris-arkaplan." + ext);
            break;
        }
    }
    var backgroundUrl = customBackgroundUrl ?? Url.Content("~/images/login-hero.jpg");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ŞahinSoft Restoran — Kasiyer Girişi</title>
    <style>
        :root {
            --pn-navy: #0B1524;
            --pn-navy2: #0F2033;
            --pn-gold: #E2A400;
            --pn-gold-light: #F2B813;
            --pn-bg: #F4F7FB;
            --pn-surface: #FFFFFF;
            --pn-border: #E3E8EF;
            --pn-text: #132238;
            --pn-text-2: #6F7F92;
            --pn-danger: #D94A4A;
        }
        * { box-sizing: border-box; }
        html, body { height: 100%; margin: 0; }
        body {
            font-family: Inter, "Segoe UI", system-ui, sans-serif;
            color: var(--pn-text);
            display: flex;
        }
        .login-left, .login-right {
            width: 50%;
            min-height: 100vh;
            position: relative;
            overflow: hidden;
        }

        /* Sol tanıtım paneli - Edip'in kendi onaylı GÖRSELİ (2026-09-05: "bu görseli giriş
           sayfasına ekle", dosya: GÖRSEL/GİRİŞ.jpeg) GERÇEK fotoğraf olarak kullanılıyor - logo/
           başlık/özellik listesi/slogan/altbilgi ARTIK ayrı HTML/CSS metni DEĞİL, hepsi bu tek
           görselin içinde birebir zaten var. Önceki (bu görsel elimde olmadan yapılan) gradyan +
           el yapımı metin yaklaşımı bununla DEĞİŞTİRİLDİ. */
        .login-left {
            /* Edip, 2026-09-05: "görsel otomatik sığdırsın, ne eklersen ekle otomatik resmi
               göstersin" - "cover" farklı en-boy oranındaki görsellerde kenarlardaki metni/
               logoyu KIRPIYORDU (Edip'in kendi denediği farklı bir görselde görüldü). "contain"
               ile hangi görsel eklenirse eklensin TAMAMI (hiç kırpılmadan) görünür - olası boş
               kenar şeritleri markanın kendi koyu lacivertiyle (--pn-navy) dolduruluyor, bu
               yüzden göz batan beyaz boşluk oluşmaz. */
            background-color: var(--pn-navy);
            background-image: url('@backgroundUrl');
            background-size: contain;
            background-position: center;
            background-repeat: no-repeat;
        }

        /* Sağ giriş paneli */
        .login-right {
            background:
                radial-gradient(ellipse 600px 500px at 100% 0%, rgba(226,164,0,.08), transparent 55%),
                radial-gradient(ellipse 700px 550px at 100% 100%, rgba(11,34,57,.06), transparent 55%),
                var(--pn-bg);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .login-date { position: absolute; top: 20px; right: 24px; text-align: right; color: var(--pn-text-2); font-size: 12.5px; }

        .login-card { width: 100%; max-width: 380px; background: var(--pn-surface); border: 1px solid var(--pn-border); border-radius: 20px; padding: 32px 28px; box-shadow: 0 12px 32px rgba(15,35,55,.1); }
        .lock-badge { width: 68px; height: 68px; border-radius: 50%; background: #FBEFD2; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto 16px; }
        .login-title { text-align: center; margin: 0 0 4px; font-size: 21px; font-weight: 800; }
        .login-sub { text-align: center; color: var(--pn-text-2); font-size: 13px; margin: 0 0 18px; }

        .pin-dots { text-align: center; margin: 14px 0; letter-spacing: 10px; font-size: 20px; color: var(--pn-navy); }
        .pin-pad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 16px; }
        .pin-pad button { padding: 18px; border: 1px solid var(--pn-border); background: #fff; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 17px; box-shadow: 0 2px 6px rgba(15,35,55,.05); transition: transform 100ms ease, background-color 120ms ease; }
        .pin-pad button:active { transform: scale(.96); background: var(--pn-bg); }
        .login-btn { width: 100%; margin-top: 16px; padding: 15px; border: 0; border-radius: 12px; background: linear-gradient(90deg,#f0cf73,#e9bd46); font-weight: 800; cursor: pointer; font-size: 15px; }
        .login-btn:active { transform: scale(.99); }
        .pin-error { color: var(--pn-danger); font-size: 13px; text-align: center; margin: 0 0 12px; min-height: 18px; }

        .login-footer-block { text-align: center; margin-top: 22px; }
        .login-footer-rule { display: flex; align-items: center; gap: 10px; color: var(--pn-border); margin-bottom: 10px; }
        .login-footer-rule::before, .login-footer-rule::after { content: ""; flex: 1; height: 1px; background: var(--pn-border); }
        .login-footer-brand { font-weight: 800; font-size: 13.5px; color: var(--pn-text); }
        .login-footer-sub { font-size: 12px; color: var(--pn-text-2); margin-top: 2px; }
        .admin-login { text-align: center; margin-top: 12px; }
        .admin-login a { color: var(--pn-text-2); font-size: 12px; text-decoration: none; }
        .admin-login a:hover { text-decoration: underline; }

        /* Çıkış/Ayarlar (Edip, 2026-09-27: "giriş sayfasına 2 tane buton istiyorum çıkış kırmızı
           buton ve ayarlar bölümü") - kiosk/masaüstü uygulama hissini tamamlayan iki alt buton.
           Ayarlar, mevcut Identity admin girişini (zaten [Authorize] ile korunuyor) kullanır - ayrı
           bir PIN/parola İCAT EDİLMEDİ. */
        .login-bottom-actions { display: flex; gap: 10px; margin-top: 16px; }
        .login-bottom-btn { flex: 1; padding: 12px; border-radius: 12px; font-weight: 800; font-size: 13px; cursor: pointer; text-align: center; text-decoration: none; border: 1px solid var(--pn-border); background: #fff; color: var(--pn-text); }
        .login-bottom-btn.settings:hover { border-color: var(--pn-gold); color: var(--pn-gold); }
        .login-bottom-btn.exit { background: var(--pn-danger); border-color: var(--pn-danger); color: #fff; }
        .login-bottom-btn.exit:hover { opacity: .92; }

        @@media (max-width: 860px) {
            .login-left { display: none; }
            .login-right { width: 100%; }
        }
    </style>
</head>
<body>
    <!-- Sol panel artık TAMAMEN gerçek görsel (bkz. yukarıdaki .login-left background-image) -
         içerik metni/logosu/özellik listesi görselin kendi içinde, burada ayrıca tekrarlanmıyor. -->
    <div class="login-left"></div>
    <div class="login-right">
        <!-- Personel PIN giriş ekranı (2026-09-05 teknik doküman madde 12, onaylı görsel
             01_Giris_Ekrani_ONAYLI.png) - personel/kasiyer LİSTESİ TAMAMEN KALDIRILDI, sağda
             SADECE PIN pad var. Doğru PIN doğru personeli kendisi bulur (bkz.
             RestaurantAuthController.Login) - hatalı PIN'de kullanıcı adı İFŞA EDİLMEZ.
             Sol tanıtım paneli + genel kart düzeni (2026-09-05, Edip'in gönderdiği yeni onaylı
             görsel) - "bunun aynısını giriş ekranına koy". -->
        <div class="login-date" id="login-date"></div>
        <div class="login-card">
            <div class="lock-badge">🔒</div>
            <div class="login-title">Personel Şifresi</div>
            @if (TempData["Error"] is string error)
            {
                <div class="pin-error">@error</div>
            }
            else
            {
                <p class="login-sub">Devam etmek için şifrenizi giriniz.</p>
            }

            <div class="pin-dots" id="pin-dots">○ ○ ○ ○</div>
            <div class="pin-pad" id="pin-pad">
                <button type="button" data-digit="1">1</button>
                <button type="button" data-digit="2">2</button>
                <button type="button" data-digit="3">3</button>
                <button type="button" data-digit="4">4</button>
                <button type="button" data-digit="5">5</button>
                <button type="button" data-digit="6">6</button>
                <button type="button" data-digit="7">7</button>
                <button type="button" data-digit="8">8</button>
                <button type="button" data-digit="9">9</button>
                <button type="button" id="pin-clear">C</button>
                <button type="button" data-digit="0">0</button>
                <button type="button" id="pin-back">⌫</button>
            </div>
            <button type="button" class="login-btn" id="pin-confirm">Giriş Yap →</button>
            <div class="login-bottom-actions">
                <a class="login-bottom-btn settings" href="@Url.Action("Index", "RestaurantTerminalSettings")">⚙ Ayarlar</a>
                <button type="button" class="login-bottom-btn exit" id="app-exit-btn">⏻ Çıkış</button>
            </div>
        </div>

        <div class="login-footer-block">
            <div class="login-footer-rule"></div>
            <div class="login-footer-brand">ŞahinSoft Restoran POS</div>
            <div class="login-footer-sub">İşletmenizin Güçlü Çözüm Ortağı</div>
            <div class="admin-login">
                <a href="/Identity/Account/Login?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl)">Yönetici Girişi (e-posta/şifre)</a>
            </div>
        </div>
    </div>

    <form id="pin-submit-form" method="post" asp-controller="RestaurantAuth" asp-action="Login" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="pin" id="pin-value" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    </form>

    <script>
        (function () {
            var pinDots = document.getElementById('pin-dots');
            var pinValue = document.getElementById('pin-value');
            var pin = '';
            var maxLength = 6;

            var dateEl = document.getElementById('login-date');
            if (dateEl) {
                var months = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
                var days = ['Pazar','Pazartesi','Salı','Çarşamba','Perşembe','Cuma','Cumartesi'];
                var now = new Date();
                dateEl.innerHTML = now.getDate() + ' ' + months[now.getMonth()] + ' ' + now.getFullYear() + '<br />' + days[now.getDay()];
            }

            function renderDots() {
                var count = Math.max(pin.length, 4);
                var parts = [];
                for (var i = 0; i < count; i++) { parts.push(i < pin.length ? '●' : '○'); }
                pinDots.textContent = parts.join(' ');
            }

            // PIN yazılırken/bekletilirken KENDİLİĞİNDEN gönderilmez - yalnızca "Giriş Yap"a
            // BASILINCA gönderilir (Edip, 2026-09-03: "şifre yazıp beklediğimde direk programı
            // açıyor öyle olmasın, giriş butonuna basmadan girmesin").
            function submitPin() {
                if (pin.length === 0) { return; }
                pinValue.value = pin;
                document.getElementById('pin-submit-form').submit();
            }

            document.getElementById('pin-back').addEventListener('click', function () {
                pin = pin.slice(0, -1);
                renderDots();
            });

            document.getElementById('pin-clear').addEventListener('click', function () {
                pin = '';
                renderDots();
            });

            document.getElementById('pin-pad').querySelectorAll('[data-digit]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    if (pin.length >= maxLength) { return; }
                    pin += btn.getAttribute('data-digit');
                    renderDots();
                });
            });

            document.getElementById('pin-confirm').addEventListener('click', submitPin);

            // Çıkış (2026-09-27, Edip: "çıkış kırmızı buton") - masaüstü kabuk (SahinSoft.exe,
            // WebView2) çalışıyorsa window.chrome.webview.postMessage ile GERÇEKTEN pencereyi/
            // programı kapatır (bkz. SahinSoft.DesktopShell/MainForm.cs WebMessageReceived).
            // Sıradan bir tarayıcıda (ör. bu sayfa geliştirme/test için Chrome'da açıldıysa)
            // window.chrome.webview YOKTUR - o durumda sekmeyi kapatmaya çalışır, olmazsa
            // kullanıcıya açıkça söyler (sessizce hiçbir şey yapmaz diye).
            document.getElementById('app-exit-btn').addEventListener('click', function () {
                if (window.chrome && window.chrome.webview) {
                    window.chrome.webview.postMessage('exit-app');
                    return;
                }
                window.close();
                setTimeout(function () { alert('Programı kapatmak için pencereyi kapatın.'); }, 300);
            });
        })();
    </script>
</body>
</html>
