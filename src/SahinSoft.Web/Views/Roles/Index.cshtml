@model IReadOnlyList<SahinSoft.Web.Models.RoleListItemViewModel>
@{
    ViewData["Title"] = "Yetkiler";
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>Yetkiler</h1>
        <span class="erp-toolbar-meta">@Model.Count kayıt</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-action="Create" class="btn btn-erp-primary btn-sm">+ Yeni Yetki</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger py-2">@error</div>
}

<div class="erp-panel">
    <div class="erp-panel-body p-0">
        <div class="erp-table-wrap">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th>Yetki Adı</th>
                        <th class="text-end">Personel Sayısı</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td class="fw-semibold">@role.Name</td>
                        <td class="text-end">@role.UserCount</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.78rem;">Düzenle</a>
                            @if (role.Name != "Administrator")
                            {
                                <form method="post" asp-action="Delete" asp-route-id="@role.Id" class="d-inline" onsubmit="return confirm('Bu yetkiyi silmek istediğinize emin misiniz?');">
                                    <button type="submit" class="btn btn-erp-danger" style="padding: 0.15rem 0.6rem; font-size: 0.78rem;">Sil</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
