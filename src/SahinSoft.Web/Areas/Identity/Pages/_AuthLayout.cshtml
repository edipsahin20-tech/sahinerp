<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ŞahinSoft</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell">
        <img src="~/images/logo.png" alt="ŞahinSoft" class="auth-logo" />
        <div class="auth-card">
            @if (!string.IsNullOrEmpty(ViewData["Subtitle"] as string))
            {
                <p class="auth-subtitle">@ViewData["Subtitle"]</p>
            }
            @RenderBody()
        </div>
        <p class="auth-footnote">&copy; 2026 ŞahinSoft &middot; Ön Muhasebe Sistemi</p>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
