@model IReadOnlyList<SahinSoft.Web.Models.AllCustomerPriceListItemViewModel>
@{
    ViewData["Title"] = "Cari Özel Fiyat Listesi";
}

<div class="alert alert-info py-2">
    Burada her cari için o an geçerli olan (en güncel) özel fiyatlar topluca listelenir. Bir cariye ait fiyat geçmişini
    görmek veya yeni fiyat eklemek için ilgili carinin "Özel Fiyatlar" ekranına gidin.
</div>

<div class="erp-list-panel">
    <div class="erp-list-header">
        <h2><i class="fa-solid fa-tags"></i> Cari Özel Fiyat Listesi</h2>
        <a asp-action="Index" class="btn-erp-list-new">Cari Listesi</a>
    </div>
    <div class="erp-list-body">
        <div class="erp-list-topbar">
            <div class="erp-list-topbar-left">
                <div class="erp-list-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" class="form-control" autocomplete="off" placeholder="Cari kodu, cari adı, ürün kodu veya ürün adı ara..." data-live-search="#priceListsTable">
                </div>
            </div>
            <span class="text-secondary">Toplam <strong>@Model.Count</strong> kayıt.</span>
        </div>

        <div class="erp-table-wrap">
            <table class="erp-table" id="priceListsTable">
                <thead>
                    <tr>
                        <th>Cari Kodu</th>
                        <th>Cari</th>
                        <th>Stok Kodu</th>
                        <th>Ürün</th>
                        <th class="text-end">Özel Fiyat (KDV Dahil)</th>
                        <th>Tarih</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var daysOld = (DateTime.UtcNow - item.UpdatedAtUtc).TotalDays;
                    var isStale = daysOld > 30;
                    <tr>
                        <td><span class="erp-code-badge">@item.CustomerCode</span></td>
                        <td class="fw-semibold">@item.CustomerName</td>
                        <td><span class="erp-code-badge">@item.ProductCode</span></td>
                        <td>@item.ProductName</td>
                        <td class="text-end fw-semibold">@item.UnitPrice.ToString("N2") ₺</td>
                        <td>
                            @item.UpdatedAtUtc.ToString("dd.MM.yyyy")
                            @if (isStale)
                            {
                                <span class="erp-status-pill amber ms-1" title="Bu fiyat 30 günden eski, döviz kuru değişmiş olabilir">@((int)daysOld) gün önce</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="PriceList" asp-route-id="@item.CustomerId" class="btn-erp-list-action">Geçmişi Gör</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">Tanımlanmış özel fiyat bulunamadı.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
