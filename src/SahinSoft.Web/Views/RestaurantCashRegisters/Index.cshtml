@model IReadOnlyList<SahinSoft.Domain.Entities.RestaurantCashRegister>
@{
    ViewData["Title"] = "Kasa Tanımları";
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>Kasa Tanımları</h1>
        <span class="erp-toolbar-meta">@Model.Count kayıt</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-controller="RestaurantSettings" asp-action="Index" class="btn btn-erp-outline btn-sm">← Ayarlar</a>
        <a asp-action="Create" class="btn btn-erp-primary btn-sm">+ Yeni Kasa</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}

<p class="text-secondary small">Her kasanın hangi şubede, hangi ödeme yöntemi (Nakit / Kredi Kartı-Banka / Yemek Kartı) için hangi hesaba tahsilat yazacağı burada tanımlanır. Restoran POS ekranında ödeme alınırken kasiyerin şubesine bağlı kasa otomatik kullanılır.</p>

<div class="erp-panel">
    <div class="erp-panel-body p-0">
    <div class="erp-table-wrap">
        <table class="erp-table">
            <thead>
                <tr>
                    <th>Kasa Adı</th>
                    <th>Şube</th>
                    <th>Nakit Hesabı</th>
                    <th>Kredi Kartı/Banka Hesabı</th>
                    <th>Yemek Kartı Hesabı</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(item.IsActive ? "" : "text-secondary")">
                    <td class="fw-semibold">@item.Name</td>
                    <td>@item.Branch.Name</td>
                    <td>@item.CashFinancialAccount.Name</td>
                    <td>@item.CreditCardFinancialAccount.Name</td>
                    <td>@(item.MealCardFinancialAccount?.Name ?? "—")</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge text-bg-success-subtle text-success-emphasis">Aktif</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger-subtle text-danger-emphasis">Pasif</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.78rem;">Düzenle</a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-secondary py-4">Kayıt bulunamadı.</td></tr>
            }
            </tbody>
        </table>
    </div>
    </div>
</div>
