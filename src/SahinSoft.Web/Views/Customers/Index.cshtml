@model IReadOnlyList<SahinSoft.Domain.Entities.Customer>
@{
    ViewData["Title"] = "Cariler";
}

<div class="erp-toolbar">
    <div class="erp-toolbar-title">
        <h1>Cariler</h1>
        <span class="erp-toolbar-meta">@Model.Count kayıt</span>
    </div>
    <div class="erp-toolbar-actions">
        <a asp-action="Create" class="btn btn-erp-primary btn-sm">+ Yeni Cari</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success py-2">@success</div>
}

<form method="get" class="erp-filter-bar">
    <div class="erp-field flex-grow-1">
        <label>Ara</label>
        <input name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Cari kodu, unvan veya vergi no ara..." />
    </div>
    <button class="btn btn-erp-primary">Ara</button>
</form>

<div class="erp-panel">
    <div class="erp-panel-body p-0">
    <div class="erp-table-wrap">
        <table class="erp-table">
            <thead>
                <tr>
                    <th>Cari Kodu</th>
                    <th>Unvan</th>
                    <th>Vergi No</th>
                    <th>Telefon</th>
                    <th>Tür</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(item.IsActive ? "" : "text-secondary")">
                    <td class="fw-semibold">@item.Code</td>
                    <td>
                        <div>@item.Name</div>
                        <small class="text-secondary">@item.City @item.District</small>
                    </td>
                    <td>@item.TaxNumber</td>
                    <td>@item.Phone</td>
                    <td>
                        @if (item.IsCustomer) { <span class="badge text-bg-primary-subtle text-primary-emphasis">Müşteri</span> }
                        @if (item.IsSupplier) { <span class="badge text-bg-secondary-subtle text-secondary-emphasis">Tedarikçi</span> }
                        @if (!item.IsActive) { <span class="badge text-bg-danger-subtle text-danger-emphasis">Pasif</span> }
                    </td>
                    <td class="text-end">
                        <a asp-action="Statement" asp-route-id="@item.Id" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.78rem;">Ekstre</a>
                        <a asp-action="PriceList" asp-route-id="@item.Id" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.78rem;">Özel Fiyatlar</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-erp-outline" style="padding: 0.15rem 0.6rem; font-size: 0.78rem;">Düzenle</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    </div>
</div>
