        <div class="rcard analytics-card">
            <div class="analytics-head"><div><h3>Saatlik Ciro Grafiği</h3></div></div>
            @if (xr.HourlyRevenue.Sum() == 0)
            {
                <div class="analytics-empty">Bu dönemde satış verisi yok.</div>
            }
            else
            {
                <div class="premium-chart">
                    @for (var i = 0; i < xr.HourlyRevenue.Count; i++)
                    {
                        var v = xr.HourlyRevenue[i];
                        var heightPct = Math.Max(2, (int)Math.Round(v / xMaxHourly * 100));
                        <div class="pc-col @(v == xr.HourlyRevenue.Max() && v > 0 ? "hot" : "")">
                            <div class="pc-value">@(v > 0 ? v.ToString("N0") + " ₺" : "")</div>
                            <div class="pc-bar" style="height:@(heightPct)%"></div>
                            <div class="pc-label">@xr.HourlyLabels[i]</div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="rcard analytics-card">
            <div class="analytics-head"><div><h3>KDV Oranlarına Göre Dağılım</h3></div></div>
            @if (xr.VatBreakdown.Count == 0)
            {
                <div class="analytics-empty">Bu dönemde satış verisi yok.</div>
            }
            else
            {
                <table class="detail-table">
                    <tr><th>ORAN</th><th>TUTAR</th><th>PAY</th></tr>
                    @foreach (var v in xr.VatBreakdown)
                    {
                        <tr><td>%@v.TaxRate.ToString("0.##")</td><td>@v.Gross.ToString("N2") ₺</td><td>%@(xr.VatBreakdown.Sum(x => x.Gross) is var vatTotal2 && vatTotal2 > 0 ? Math.Round(v.Gross / vatTotal2 * 100, 1) : 0)</td></tr>
                    }
                </table>
            }
        </div>
    </div>
    <div class="detail-cols" style="margin-top:14px;">
        <div>
            <h6 style="margin:0 0 6px;font-size:12px;color:var(--rs-muted);">KATEGORİ BAZLI SATIŞLAR</h6>
            <table class="detail-table">
                <tr><th>KATEGORİ</th><th>TUTAR</th><th>PAY</th></tr>
                @foreach (var c in xr.CategorySales)
                {
                    <tr><td>@c.CategoryName</td><td>@c.Total.ToString("N2") ₺</td><td>%@c.Percent.ToString("0.0")</td></tr>
                }
            </table>
            @if (xr.PaymentBreakdown.Count > 0)
            {
                <h6 style="margin:14px 0 6px;font-size:12px;color:var(--rs-muted);">ÖDEME TÜRÜNE GÖRE SATIŞLAR</h6>
                <table class="detail-table">
                    <tr><th>ÖDEME TÜRÜ</th><th>TUTAR</th><th>PAY</th></tr>
                    @foreach (var pb in xr.PaymentBreakdown)
                    {
                        <tr><td>@pb.Label</td><td>@pb.Amount.ToString("N2") ₺</td><td>%@pb.Percent.ToString("0.0")</td></tr>
                    }
                </table>
            }
        </div>
        <div>
            <h6 style="margin:0 0 6px;font-size:12px;color:var(--rs-muted);">EN ÇOK SATAN 5 ÜRÜN</h6>
            <table class="detail-table">
                <tr><th>#</th><th>ÜRÜN ADI</th><th>ADET</th><th>TUTAR</th></tr>
                @foreach (var p in xr.Top5Products)
                {
                    <tr><td>@p.Rank</td><td>@p.ProductName</td><td>@p.Quantity.ToString("N0")</td><td>@p.Total.ToString("N2") ₺</td></tr>
                }
            </table>
        </div>
    </div>
    <div class="znote sub" style="margin-top:12px;">X Raporu anlık durum raporudur. Vardiyayı kapatmaz, istediğiniz zaman tekrar alabilirsiniz.</div>
    <div class="actions no-print" style="margin-top:10px;">
        <button type="button" class="rbtn gold" onclick="window.print()">🖨 X Raporu Yazdır</button>
        <button type="button" class="rbtn pdf" onclick="window.print()">📄 PDF İndir</button>
        <form method="post" asp-action="SendXReportToPrinter" asp-route-returnTab="x" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")" class="d-inline">
            <button type="submit" class="rbtn">🧾 Termal Yazıcıya Gönder</button>
        </form>
    </div>
}
