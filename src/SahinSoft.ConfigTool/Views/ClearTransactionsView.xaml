<UserControl x:Class="SahinSoft.ConfigTool.Views.ClearTransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Tüm Hareketleri Sil" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock Text="Cari ve stok kartlarını koruyarak işlem geçmişini sıfırlayın." Style="{StaticResource PageSubtitleStyle}"/>

        <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,20,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗄" FontSize="15" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,24,0">
                        <TextBlock Text="Sunucu" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock x:Name="ServerText" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Veritabanı" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock x:Name="DatabaseText" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✏ Bağlantıyı Düzenle" Style="{StaticResource PrimaryButtonStyle}" Padding="12,8" FontSize="12" HorizontalAlignment="Right" Click="EditConnection_Click"/>
            </Grid>
        </Border>

        <Border Background="{StaticResource WarningBoxBg}" BorderBrush="{StaticResource WarningBoxBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="13" Foreground="{StaticResource WarningBoxText}"/>
                <TextBlock Text="İşlem öncesinde veritabanı yedeği alınır." FontSize="12.5" Foreground="{StaticResource WarningBoxText}" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource DangerBoxBg}" BorderBrush="{StaticResource DangerBoxBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel>
                    <TextBlock Text="🗑 Silinecek Veriler" FontWeight="Bold" FontSize="14" Foreground="{StaticResource DangerBoxText}"/>
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding DeletedItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12.5" Foreground="{StaticResource DangerBoxText}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource SafeBoxBg}" BorderBrush="{StaticResource SafeBoxBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel>
                    <TextBlock Text="🛡 Korunacak Veriler" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SafeBoxText}"/>
                    <TextBlock Text="Cari kartları" FontSize="12.5" Foreground="{StaticResource SafeBoxText}" Margin="0,10,0,6"/>
                    <TextBlock Text="Stok kartları" FontSize="12.5" Foreground="{StaticResource SafeBoxText}" Margin="0,0,0,6"/>
                    <TextBlock Text="Program ayarları" FontSize="12.5" Foreground="{StaticResource SafeBoxText}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Background="{StaticResource InfoBoxBg}" BorderBrush="{StaticResource InfoBoxBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
            <TextBlock Text="Stok miktarları ve bakiyeler sıfırlanır. Numaralandırma sayaçları 1'e döner." FontSize="12" Foreground="{StaticResource InfoBoxText}" TextWrapping="Wrap"/>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="⚙ İşlem Onayı" Style="{StaticResource SectionTitleStyle}"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Veritabanı" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="DatabaseSummaryBox" Style="{StaticResource FieldTextBoxStyle}" IsReadOnly="True" Background="#F9FAFB"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Onaylamak için SİL yazın" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="ConfirmBox" Style="{StaticResource FieldTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource DangerBoxBg}" BorderBrush="{StaticResource DangerBoxBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                    <TextBlock Text="⚠ Bu işlem mevcut kayıtları kalıcı olarak siler." FontSize="12" Foreground="{StaticResource DangerBoxText}"/>
                </Border>

                <Expander Header="Gelişmiş Seçenekler" Margin="0,16,0,0" FontSize="13">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Yedek Klasörü" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BackupFolderBox" Grid.Column="0" Style="{StaticResource FieldTextBoxStyle}" Text="C:\SahinSoft\Yedekler"/>
                            <Button Grid.Column="2" Content="📁" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Click="BrowseBackupFolder_Click"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <Grid Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🗑 Yedek Al ve Hareketleri Sil" Style="{StaticResource DangerButtonStyle}" Click="Execute_Click"/>
                        <Button Content="Vazgeç" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="Cancel_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="İşlem Kaydı" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock x:Name="LogText" Text="Henüz işlem yapılmadı." FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
