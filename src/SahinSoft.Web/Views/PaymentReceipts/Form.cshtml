@using SahinSoft.Domain.Enums
@model SahinSoft.Web.Models.PaymentReceiptFormViewModel
@{
    var isEdit = Model.Id > 0;
    var isCollection = Model.ReceiptType == ReceiptType.Collection;
    ViewData["Title"] = (isEdit ? "Düzenle: " : "Yeni ") + (isCollection ? "Tahsilat" : "Tediye");
}

<form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <input asp-for="Id" type="hidden" />
    <input asp-for="ReceiptType" type="hidden" />
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
        <div>
            <h1 class="h3 mb-1">@ViewData["Title"]</h1>
            <p class="text-secondary mb-0">Taslağı kaydedip onayladığınızda cari ve kasa/banka hareketleri birlikte oluşur.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            <button type="submit" class="btn btn-primary px-4">Taslağı kaydet</button>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-3 p-lg-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="CustomerId" class="form-label"></label>
                    <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
                        <option value="">Cari seçin</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ReceiptDateUtc" class="form-label"></label>
                    <input asp-for="ReceiptDateUtc" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="CurrencyCode" class="form-label"></label>
                    <input asp-for="CurrencyCode" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="ExchangeRate" class="form-label"></label>
                    <input asp-for="ExchangeRate" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Satırlar</h2>
                <button type="button" id="add-line" class="btn btn-sm btn-outline-primary">+ Satır ekle</button>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0" id="lines-table">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width: 180px;">Kasa/Banka</th>
                            <th style="min-width: 160px;">Ödeme yöntemi</th>
                            <th style="width: 140px;">Referans no</th>
                            <th style="width: 130px;">Tutar</th>
                            <th>Açıklama</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="lines-body">
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr class="line-row">
                            <input type="hidden" name="Lines.Index" value="@i" />
                            <td>
                                <select name="Lines[@i].FinancialAccountId" class="form-select">
                                    <option value="">Hesap seçin</option>
                                    @foreach (var account in Model.FinancialAccounts)
                                    {
                                        <option value="@account.Value" selected="@(Model.Lines[i].FinancialAccountId?.ToString() == account.Value)">@account.Text</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <select name="Lines[@i].PaymentMethod" class="form-select">
                                    @foreach (var method in Enum.GetValues<PaymentMethod>())
                                    {
                                        <option value="@((int)method)" selected="@(Model.Lines[i].PaymentMethod == method)">@method</option>
                                    }
                                </select>
                            </td>
                            <td><input type="text" name="Lines[@i].ReferenceNumber" value="@Model.Lines[i].ReferenceNumber" class="form-control" /></td>
                            <td><input type="text" name="Lines[@i].Amount" value="@Model.Lines[i].Amount" class="form-control" /></td>
                            <td><input type="text" name="Lines[@i].Description" value="@Model.Lines[i].Description" class="form-control" /></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger remove-line">Sil</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white d-flex justify-content-end gap-2 py-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            <button type="submit" class="btn btn-primary px-4">Taslağı kaydet</button>
        </div>
    </div>
</form>

<template id="line-row-template">
    <tr class="line-row">
        <input type="hidden" name="Lines.Index" value="__index__" />
        <td>
            <select name="Lines[__index__].FinancialAccountId" class="form-select">
                <option value="">Hesap seçin</option>
                @foreach (var account in Model.FinancialAccounts)
                {
                    <option value="@account.Value">@account.Text</option>
                }
            </select>
        </td>
        <td>
            <select name="Lines[__index__].PaymentMethod" class="form-select">
                @foreach (var method in Enum.GetValues<PaymentMethod>())
                {
                    <option value="@((int)method)">@method</option>
                }
            </select>
        </td>
        <td><input type="text" name="Lines[__index__].ReferenceNumber" value="" class="form-control" /></td>
        <td><input type="text" name="Lines[__index__].Amount" value="0" class="form-control" /></td>
        <td><input type="text" name="Lines[__index__].Description" value="" class="form-control" /></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger remove-line">Sil</button></td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var linesBody = document.getElementById('lines-body');
            var template = document.getElementById('line-row-template');
            var addButton = document.getElementById('add-line');
            var nextIndex = @Model.Lines.Count;

            addButton.addEventListener('click', function () {
                var html = template.innerHTML.split('__index__').join(nextIndex);
                var wrapper = document.createElement('tbody');
                wrapper.innerHTML = html;
                linesBody.appendChild(wrapper.firstElementChild);
                nextIndex++;
            });

            linesBody.addEventListener('click', function (event) {
                if (event.target.classList.contains('remove-line')) {
                    var row = event.target.closest('tr');
                    if (linesBody.querySelectorAll('.line-row').length > 1) {
                        row.remove();
                    }
                }
            });
        })();
    </script>
}
